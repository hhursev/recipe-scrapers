  #ckw-rail .ckw-panel{width:326px;max-height:78vh;overflow-y:auto;background:#fff;border-left:1px solid #E0E0E0;box-shadow:-10px 0 34px rgba(14,27,77,.16);border-radius:10px 0 0 10px;box-sizing:border-box;}
