<div class="Article-text Article-recipeText">
	<div class="Article-recipeTitle fakeH">Infos pratiques</div>
	<ul class="Article-recipeItems">
		<li class="Article-recipeItem"><label class="Article-recipeItemLabel">Nombre de personnes</label><span class="Article-recipeItemValue">4</span></li>
		<li class="Article-recipeItem"><label class="Article-recipeItemLabel">Temps de pr&eacute;paration</label><span class="Article-recipeItemValue">15 minutes</span></li>
		<li class="Article-recipeItem"><label class="Article-recipeItemLabel">Degr&eacute; de difficult&eacute;</label><span class="Article-recipeItemValue">Tr&egrave;s facile</span></li>
		<li class="Article-recipeItem"><label class="Article-recipeItemLabel">Co&ucirc;t</label><span class="Article-recipeItemValue">Bon march&eacute;</span></li>
	</ul>
	</div>
	<div class="Article-text Article-recipeText">
		<h2 class="Article-recipeTitle ">Les ingr&eacute;dients de la recette</h2>
<ul>
<li>2 concombres</li>
<li data-section-id="t1mxot" data-start="689" data-end="711">400 g de yaourt grec</li>
<li data-section-id="5naana" data-start="712" data-end="728">1 gousse d'ail</li>
<li data-section-id="1sgfj6k" data-start="729" data-end="769">2 c. &agrave; soupe de menthe fra&icirc;che cisel&eacute;e</li>
<li data-section-id="17ni5w9" data-start="770" data-end="814">1 c. &agrave; soupe de menthe s&eacute;ch&eacute;e (facultatif)</li>
<li data-section-id="uegyxb" data-start="815" data-end="845">2 c. &agrave; soupe d'huile d'olive</li>
<li data-section-id="1tb4pcf" data-start="846" data-end="867">Le jus d'1/2 citron</li>
<li data-section-id="1o4ryq" data-start="868" data-end="873">Sel</li>
<li data-section-id="32pqpr" data-start="874" data-end="882">Poivre</li>
</ul>
<p>&nbsp;</p>
<!--@@@feature@@@-->

<!--@@@videoGroup@@@-->
<div class="VideoGroup VideoGroup--intext">
	<div class="VideoGroup-intextTitle"><span>Vid&eacute;o - Plats familiaux</span></div>

<!--@@@MediaPlayer@@@-->
<div id="m6a84c51e7bf3b467918321" class="MediaPlayer" data-event-monitoring-category="Bloc" data-event-monitoring-action="Dailymotion"><script type="text/javascript">
