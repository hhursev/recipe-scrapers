08650889411822829\u002F1.m3u8",poster_url:cl,webp_poster_url:cm},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F308650889411822829\u002F1.mp4",poster_url:cl,webp_poster_url:cm},ingredient_groups:[{recipe_ingredients:[{name:"ゆで卵"}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:R,id_str:R,lead:k,title:cn,description:co,state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:cp,poster_url:S,webp_poster_url:T},square_mp4_video:{url:cq,poster_url:S,webp_poster_url:T},ingredient_groups:[{recipe_ingredients:[{name:o},{name:j}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:cr,id_str:cr,lead:"丁寧に美味しく♪",title:"おでんの下ごしらえ",description:"おでんは用意する材料が多く、下ごしらえだけがたくさんあります！今回は一つずつ丁寧にご紹介します。前日などに用意すると良いですね♪丁寧に下ごしらえしたおでんは、味がしみ込みやすくなったり、臭みをとってくれたりするのでおいしく仕上がりますよ。",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F520563618203305089\u002F1.m3u8",poster_url:cs,webp_poster_url:ct},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F520563618203305089\u002F1.mp4",poster_url:cs,webp_poster_url:ct},ingredient_groups:[{recipe_ingredients:[{name:"牛すじ肉"},{name:l},{name:"大根"},{name:"こんにゃく"},{name:"焼きちくわ"},{name:"厚揚げ"},{name:"さつま揚げ"}]},{recipe_ingredients:[{name:"長ねぎ[青い部分]"},{name:"しょうが(薄切り)"},{name:"酒"}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a}]}],relatedCurations:[{id:16422,title:"2026\u002F08\u002F14のおすすめ",description:"2026\u002F08\u002F14のおすすめを紹介! ピリ辛スタミナ炒め イカのビリヤニ 温泉卵(温玉)などおすすめの料理動画が簡単に見つかります!",image_url:"https:\u002F\u002Fimage.delishkitchen.tv\u002Frecipe\u002F128322717379199361\u002F1.jpg?version=1746080162",opened_at:"2026-08-13T15:00:00Z"},{id:15366,title:"【定番の和食レシピ】毎日の献立に役立つ！レビュー多数レシピ88選",description:"定番和食のレシピを簡単動画でご紹介。\n定番の和食料理を肉、魚、卵、豆腐などを中心に少しアレンジを加えた和食など、初心者やチャレンジしたい方にぴったりなレシピも含めた88本のレシピを集めています！\n和食の基本定番を知りたい方、いつもと違うレシピを知りたい方はぜひ参考にしてくださいね♪",image_url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Fcuration\u002F15366\u002Fdqh9fnk5jso.jpeg?version=1722235891",opened_at:"2024-03-31T15:00:00Z"},{id:14040,title:"正確に作ってトロトロ♪温泉卵の作り方レシピ3選",description:"温泉卵の作り方を簡単レシピ動画でご紹介。基本の温泉卵や、レンジで作れる温泉卵、温泉卵のたれなど全部で3本のレシピを紹介していますので、日々の献立にぜひお役立てください。",image_url:_,opened_at:"2023-08-20T01:30:35Z"},{id:13655,title:"美味しい朝食が食べたい♪和食のレシピ15選",description:"朝食におすすめの和食レシピを簡単動画でご紹介。だし巻き卵や焼き魚、きんぴら、ご飯の炊き方など15本のレシピを紹介していますので、朝ごはんの献立にぜひお役立てください。",image_url:"https:\u002F\u002Fimage.delishkitchen.tv\u002Frecipe\u002F140552853935620595\u002F1.jpg?version=1769761234",opened_at:"2023-08-07T01:30:45Z"},{id:8508,title:"トロっと♪温泉卵のレシピ30選！簡単温泉卵の作り方もご紹介",description:"温度のコツさえ掴めば自宅でも簡単に作れる温泉卵。どんぶりやパスタ、サラダなど何に乗せても美味しくなるとろ〜りとした食感とまろやかさがたまらない！という人も多いのではないでしょうか。\n\n今回はそんな温泉卵を使った絶品レシピや、温泉卵の作り方をご紹介します。\n\n基本の温泉卵の作り方から、豚ひき肉のキムたま丼やサーモンとアボカドのユッケ丼まで30本紹介していますので、日々の献立にぜひお役立てください。",image_url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Fcuration\u002F8508\u002Fbgapq8mn9y.jpeg?version=1696298270",opened_at:"2023-05-23T01:30:35Z"},{id:6562,title:"【めんつゆ】お手軽味付け特集！出汁がきいた絶品料理40選",description:"めんつゆを使ったレシピを簡単動画でご紹介。メインになるおかずから主食まで40レシピを紹介しているので、日々の献立に是非役立ててみてください。",image_url:"https:\u002F\u002Fimage.delishkitchen.tv\u002Frecipe\u002F318056148601144338\u002F1.jpg?version=1698200101",opened_at:"2023-02-28T15:00:00Z"},{id:4597,title:"ネギトロ丼の献立にもう1品！おすすめレシピ20選",description:"ネギトロ丼の献立はお決まりですか？ここでは副菜・汁物などネギトロ丼に合うレシピをご紹介します。組み合わせ次第で新たなおいしさに出会えます。ぜひネギトロ丼に合わせて作ってみてください。\t",image_url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Fcuration\u002F4597\u002F55g7yqlz0sj.jpeg?version=1664450921",opened_at:"2022-07-31T15:00:00Z"},{id:3199,title:"2020\u002F05\u002F22のおすすめ",description:"2020\u002F05\u002F22のおすすめを紹介! カツオとアボカドのおかずサラダ 鶏肉とこんにゃくのねぎだく和え 鶏むねロールのねぎ塩レモンがけなどおすすめの料理動画が簡単に見つかります!",image_url:"https:\u002F\u002Fimage.delishkitchen.tv\u002Frecipe\u002F160481837951484396\u002F1.jpg?version=1714005721",opened_at:"2020-05-21T15:00:00Z"}]},recipes:{latestRecipes:[],rankingRecipes:[]},recommend:{recommend:a},"related-recipes":{list:[cu,{id:cv,id_str:cv,lead:"味付け簡単！",title:"めんつゆで作る煮卵",description:"人気の煮卵を、めんつゆを使って作ります！たれの味がすぐキマる時短レシピです。おろしにんにくを小さじ1\u002F2〜1程度加えても美味しくいただけます。今回は半熟に仕上げていますが、固ゆでがお好みでしたら、ゆで時間はQ&Aを参考にしてください。そのままはもちろん、お好みでラーメン、鶏肉や大根の煮物、丼物などに添えてアレンジするのもおすすめです。",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F357543133396862086\u002F1.m3u8",poster_url:cw,webp_poster_url:cx},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F357543133396862086\u002F1.mp4",poster_url:cw,webp_poster_url:cx},ingredient_groups:[{recipe_ingredients:[{name:l},{name:$},{name:j}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:cy,id_str:cy,lead:"SNSで話題沸騰！",title:"麻薬卵",description:"SNSで韓国風のやみつき卵として人気のレシピ♪ねぎなどの薬味をたっぷりと入れた漬けだれがごはんとマッチ。めんつゆを使って簡単に味が決まるのも嬉しいポイント！ぜひお試しください。",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F407088154110067894\u002F1.m3u8",poster_url:cz,webp_poster_url:cA},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F407088154110067894\u002F1.mp4",poster_url:cz,webp_poster_url:cA},ingredient_groups:[{recipe_ingredients:[{name:l},{name:"長ねぎ"},{name:"玉ねぎ"}]},{recipe_ingredients:[{name:j},{name:$},{name:s},{name:Z},{name:"白いりごま"},{name:cB}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:I,id_str:I,lead:k,title:bZ,description:b_,state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:b$,poster_url:J,webp_poster_url:K},square_mp4_video:{url:ca,poster_url:J,webp_poster_url:K},ingredient_groups:[{recipe_ingredients:[{name:n}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:w,id_str:w