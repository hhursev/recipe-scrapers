age_url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Fimage\u002F64a14aa375339db90ab91f5692ce24e0.png",square_image_url:aK}]},publisher:{pagination:{currentPage:h,hasNext:b,pagePer:i,pageTotalCount:e},id:e,publisher:{},recipes:[]},publishers:{pagination:{currentPage:h,hasNext:b,pagePer:i,pageTotalCount:e},list:[]},"ranking-premium-recipes":{pagination:{currentPage:h,hasNext:b,pagePer:i,pageTotalCount:e},list:[]},"receipt-campaign":{receipt_campaign:{}},recipe:{data:{id:f,id_str:f,lead:aL,title:"温泉卵(温玉)",description:"簡単で失敗しない温泉卵の作り方をご紹介します♪お湯に入れて時間になったら取り出すだけ！お好みのたれをかけてお召し上がりください。【レシピリニューアル】",attention:c,custom_head_title:"簡単15分！失敗しない温泉たまごの作り方",food_creator_comment:c,is_favorite:b,is_favorite_free:b,is_cooked:b,is_visible:d,can_cooking_report:d,state:g,state_premium:e,state_meal_menu:e,cooking_time_value:900,cooking_time:"調理時間 約15分",cooking_cost:"費用目安 50円以内",nutrient_unit:aM,recipe_detail:{cooking_time:{value:15,unit:"分",prefix:"約",suffix:c},cooking_cost:{value:50,unit:"円",suffix:"以内"},calorie:{value:93,unit:"kcal",suffix:c},nutrient_unit:aM},created_at:"2017-07-27T02:29:51Z",updated_at:"2026-04-01T07:43:05Z",advertiser:a,food_creator:a,articles:[{id:14,advertiser_id:a,title:"トロッと美味しい！温玉を使った人気のレシピ9選",description:"温玉（温泉玉子）は、どの年代にも好まれ、こってりとした料理にもさっぱりとした料理にも相性良く食べることができます。温玉をつぶしたときのトロッと流れ出る黄身は何とも言えない美味しさがあり、料理の上にのせて食べるだけで不思議とその料理の味をぐんとグレードアップさせてくれます。そこで、温玉を使った人気のレシピを9つ選んでみました。すぐに作って食べてもらいたいイチオシの料理を紹介します。",thumbnail:a,image_url:W,has_indexes:d,opened_at:"2019-11-12T02:00:00Z",revised_at:"2019-11-12T01:48:16Z",indexes:a,contents:a,display_metadata:d},{id:982,advertiser_id:a,title:"卵と玉子の違いは？使い分け方とおすすめのレシピをご紹介",description:"卵かけご飯や目玉焼き、オムライスなどさまざまな料理に活用でき、毎日の生活に欠かせない「卵」。\n\n文字にすると「卵」や「玉子」と書かれていることがあります。この2つの文字はどのように使い分けられているのでしょうか。\n",thumbnail:a,image_url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Farticle\u002F982\u002Fehk26ejbz8c.jpeg?version=1772010851",has_indexes:d,opened_at:"2021-10-22T06:00:00Z",revised_at:"2026-02-25T09:14:12Z",indexes:a,contents:a,display_metadata:d}],square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F153667539426083235\u002F1.m3u8",poster_url:W,webp_poster_url:aN},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F153667539426083235\u002F1.mp4",poster_url:W,webp_poster_url:aN},ingredient_groups:[{id:e,name:a,recipe_ingredients:[{ingredient_id:91,name:"卵(60g 程度)",servings1:"2個",link:"\u002Fcategories\u002F1343"},{ingredient_id:3248,name:"めんつゆ（3倍濃縮）",servings1:"大さじ1",link:c},{ingredient_id:35,name:j,servings1:"適量",link:c}]}],recipe_tags:[{recipe_id:f,recipe_id_str:f,tag_id:X,tag_name:aO},{recipe_id:f,recipe_id_str:f,tag_id:U,tag_name:V},{recipe_id:f,recipe_id_str:f,tag_id:17493,tag_name:"基本・定番料理"},{recipe_id:f,recipe_id_str:f,tag_id:17627,tag_name:"作り方"},{recipe_id:f,recipe_id_str:f,tag_id:18247,tag_name:"温泉卵の作り方"},{recipe_id:f,recipe_id_str:f,tag_id:18529,tag_name:"めんつゆ"},{recipe_id:f,recipe_id_str:f,tag_id:q,tag_name:r},{recipe_id:f,recipe_id_str:f,tag_id:19839,tag_name:"温泉卵"}],recipe_genre:{id:7,kind_id:432,name:"和食"},recipe_category:{id:h,kind_id:g,name:aO},recipe_qas:[{recipe_id:f,recipe_id_str:f,num:h,question:"2個以上でもできますか？",answer:"このレシピでは2個でお作りいただくことを前提にレシピをお作りしています。 2個以上でお作りいただく場合は水の温度、調理時間が変わりますため、別の鍋を使用し2個ずつお作りいただきますようお願いします！"},{recipe_id:f,recipe_id_str:f,num:X,question:"めんつゆの濃縮倍数を調整したい場合、どうすれば良いですか？",answer:"めんつゆの濃縮倍数違いは[こちら](https:\u002F\u002Fhelp.delishkitchen.tv\u002Fhc\u002Fja\u002Farticles\u002F360001642448)をご確認ください。"}],recipe_servings:[{recipe_id:f,recipe_id_str:f,servings:h,name:"2個分"}],recipe_steps:[{recipe_id:f,recipe_id_str:f,step:h,description:"鍋に1〜1.2Lの水を入れ、沸騰直前で火を止め、火からおろす。",point:"卵は冷蔵庫から出したてのものを使ってください。容量約1.7L、幅約19cm、高さ9.5cmの鍋を使用しています。鍋の大きさや水の量が変わると仕上がりに影響があるのでなるべく近いものでお作りください。沸騰直前の目安は鍋底全体の気泡がゆっくりと上がってくるくらいです。温度が低いとかたまらないので注意してください。",square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F153667539426083235\u002Fsteps\u002F1.m3u8",poster_url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F153667539426083235\u002Fsteps\u002F1.jpg?version=1775029283"}},{recipe_id:f,recipe_id_str:f,step:X,description:"卵をおたまでそっと入れ、ふたをして10〜12分おく。",point:"おたまなどにのせて優しく入れましょう。使用する調理器具により出来上がりに違いがあります。30秒ずつ調整してお好みの固さを見つけてみて下さい♪",square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F153667539426083235\u002Fsteps\u002F2.m3u8",poster_url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F153667539426083235\u002Fsteps\u002F2.jpg?version=1775029283"}},{recipe_id:f,recipe_id_str:f,step:g,description:"冷水に取り出し、お好みでめんつゆ(3倍濃縮)をかける。",point:c,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F153667539426083235\u002Fsteps\u002F3.m3u8",poster_url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F153667539426083235\u002Fsteps\u002F3.jpg?version=1775029283"}}],nutrient:{recipe_id:f,recipe_id_str:f,items:[{name:aP,display_name:aP,icon_type:"calorie",amount:"93kcal",is_locked:b,iconComponent:"delish-icon-cooking-kcal"},{name:aQ,display_name:aQ,icon_type:"carbohydrate",amount:aR,is_locked:b,iconComponent:"delish-icon-cooking-bread"},{name:aS,display_name:aS,icon_type:"lipid",amount:"5.7g",is_locked:b,iconComponent:"delish-icon-cooking-oil"},{name:"タンパク質",display_name:"たんぱく質",icon_type:"protein",amount:"7.2g",is_locked:b,iconComponent:"delish-icon-cooking-egg"},{name:aT,display_name:aT,icon_type:"saccharide",amount:aR,is_locked:b,iconComponent:"delish-icon-cooking-candy"},{name:"塩分量",display_name:"塩分",icon_type:"salt",amount:"1.3g",is_locked:b,iconComponent:"delish-icon-cooking-salt"}]},banner:a,content_taxonomy_ids:[]},breadcrumbs:{main:[{id:U,name:V,title:a,description:a,recommended_recipe_heading:a,parents:a,children:a,representative_recipe:a,recommended_recipes:a,recipes:[{id:aU,id_str:aU,lead:aL,title:"ニラ玉",description:"中華屋さんで頼む定番メニュー、ニラ玉のご紹介です。シンプルな材料であっという間にできて、 困った時の一品に使えるレシピです！ 豚肉を加えてニラ玉丼にしても美味しく召し上がれます。ぜひご家庭でお試しください。",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F176151634785599846\u002F1.m3u8",poster_url:aV,webp_poster_url:aW},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F176151634785599846\u002F1.mp4",poster_url:aV,webp_poster_url:aW},ingredient_groups:[{recipe_ingredients:[{name:"ニラ"},{name:l},{name:Y},{name:p},{name:"こしょう"},{name:s}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a}],suggests:a,basic_cooking_recipes:a},{id:q,name:r,title:a,description:a,recommended_recipe_heading:a,parents:a,children:a,representative_recipe:a,recommended_recipes:a,recipes:[{id:t,id_str:t,lead:aX,title:aY,description:aZ,state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:a_,poster_url:u,webp_poster_url:v},square_mp4_video:{url:a$,poster_url:u,webp_poster_url:v},ingredient_groups:[{recipe_ingredients:[{name:o}]},{recipe_ingredients:[{name:p},{name:Y},{name:s},{name:Z},{name:j}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a}],suggests:a,basic_cooking_recipes:a}],sub:[{id:q,name:r,recipe:{id:t,id_str:t,lead:aX,title:aY,description:aZ,state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:a_,poster_url:u,webp_poster_url:v},square_mp4_video:{url:a$,poster_url:u,webp_poster_url:v},ingredient_groups:[{recipe_ingredients:[{name:o}]},{recipe_ingredients:[{name:p},{name:Y},{name:s},{name:Z},{name:j}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a}}]},basicRecipe:{},topSummaryCookingReport:{rate_average:4.1,star:4,total_report_count:490,list:[{id:"374922093021627410",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F374922093021627410.unknown?version=1786607055",comment:"ポットで沸騰させたお湯をボウルへ、冷蔵庫から出したて卵2こを、蓋なしで時々転がして10分。成功でした！",rate:m,likes_count:237,posted_at:ba,liked:b,state:h,updated_at:"2026-08-13T07:44:15Z",created_at:ba,user:{id:bb,has_name:d,name:bc,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:bb,has_name:d,name:bc,has_image:b,image_url:c},reply:a},{id:"396797921892237689",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F396797921892237689.jpg?version=1785746408",comment:"4個・蓋あり15分で完璧でした！\n今まで何回か失敗してるけど、これが一番でした。",rate:m,likes_count:120,posted_at:bd,liked:b,state:h,updated_at:"2026-08-03T08:40:08Z",created_at:bd,user:{id:be,has_name:d,name:bf,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:be,has_name:d,name:bf,has_image:b,image_url:c},reply:a},{id:"421264315786461452",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F421264315786461452.unknown?version=1786605413",comment:"ビビンバ用につくりました。\n沸騰したお湯に蓋なし12分後、冷水流ししました。\n上手にできました。",rate:m,likes_count:103,posted_at:bg,liked:b,state:h,updated_at:"2026-08-13T07:16:53Z",created_at:bg,user:{id:bh,has_name:d,name:bi,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:bh,has_name:d,name:bi,has_image:b,image_url:c},reply:a},{id:"437103916065227167",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F437103916065227167.jpg?version=1786605248",comment:"ポットで沸騰させたお湯を、冷蔵庫から出した卵2個を入れた鍋に移して蓋有りで。12分でこんな感じ。黄身トロトロであまり固まっておらずちょうど良かったです。",rate:m,likes_count:71,posted_at:bj,liked:b,state:h,updated_at:"2026-08-13T07:14:08Z",created_at:bj,user:{id:bk,has_name:d,name:bl,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:bk,has_name:d,name:bl,has_image:b,image_url:c},reply:a},{id:"349405718622765358",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F349405718622765358.jpg?version=1785657533",comment:"みなさんのレビューを参考に、蓋ありで４個15分。氷水で冷やしていい感じに出来ました。",rate:m,likes_count:62,posted_at:bm,liked:b,state:h,updated_at:"2026-08-02T07:58:53Z",created_at:bm,user:{id:bn,has_name:d,name:bo,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:bn,has_name:d,name:bo,has_image:b,image_url:c},reply:a},{id:"476658637360595336",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F476658637360595336.jpg?version=1786675601",comment:"沸騰したら火をとめて、ふたをせず、そのままたまごをいれて放置でもできますよー。すぐ使うなら15分～20分ぐらい。あとふたをして放置したらゆで卵になります。",rate:m,likes_count:52,posted_at:bp,liked:b,state:h,updated_at:"2026-08-14T02:46:41Z",created_at:bp,user:{id:bq,has_name:d,name:br,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:bq,has_name:d,name:br,has_image:b,image_url:c},reply:a},{id:"356949812320404574",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F356949812320404574.unknown?version=1786676755",comment:"初めてでも、簡単に出来ました！",rate:m,likes_count:36,posted_at:bs,liked:b,state:h,updated_at:"2026-08-14T03:05:55Z",created_at:bs,user:{id:bt,has_name:d,name:bu,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:bt,has_name:d,name:bu,has_image:b,image_url:c},reply:a},{id:"495532219868120224",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F495532219868120224.jpg?version=1786674788",comment:"蓋なしで8分→冷水 でやってみました。\n一回で成功！\nカラの周りにある程度ついてしまうのはしょうがないですね。100均の電子レンジの温泉卵メーカーだと上手く思うようにうまくいかないのでこれからはこのレシピで作ります！\n\n追記:その後ボウルにケトルのお湯を入れて作ったりしたのですが上手くいかず...私は鍋で作った方が相性が良いみたいです。",rate:m,likes_count:bv,posted_at:bw,liked:b,state:h,updated_at:"2026-08-14T02:33:08Z",created_at:bw,user:{id:bx,has_name:d,name:by,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:bx,has_name:d,name:by,has_image:b,image_url:c},reply:a},{id:"334041090690646308",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F334041090690646308.unknown?version=1786667107",comment:"すぐ食べたいときでも簡単に作れる温泉卵♫温泉卵って3つ入って100円前後しますよね…。そんなときもっと早く知りたかったと思った1品です。大家族には非常に家計が助かりますwわが家はサラダにも温泉卵します。",rate:m,likes_count:bv,posted_at:bz,liked:b,state:h,updated_at:"2026-08-14T00:25:07Z",created_at:bz,user:{id:bA,has_name:d,name:bB,has_image:b,image_url:c,zip_code:c,address_city_name:c,email:c,agree_to_use_email:b,token:c,link_facebook:b,link_line:b,link_twitter:b,link_email:b,link_docomo:b,link_softbank:b,link_au:b,link_apple:b,created_at:c},user_profile:{id:bA,has_name:d,name:bB,has_image:b,image_url:c},reply:a},{id:"380090889365619042",recipe_id:f,image_url:"https:\u002F\u002Fuser-image.delishkitchen.tv\u002Fcooking_report\u002Foriginal\u002F380090889365619042.unknown?version=1786666347",comment:"ビビンバ用に作りました。簡単にできて嬉しい😄です。",rate:m,likes_count:31,posted_at:bC,liked:b,state:h,upd