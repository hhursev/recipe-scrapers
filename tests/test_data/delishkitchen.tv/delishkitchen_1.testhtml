state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F330947582211654073\u002F1.m3u8",poster_url:_,webp_poster_url:cD},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F330947582211654073\u002F1.mp4",poster_url:_,webp_poster_url:cD},ingredient_groups:[{recipe_ingredients:[{name:n},{name:"熱湯"}]},{recipe_ingredients:[{name:"細ねぎ"},{name:"白すりごま"},{name:$}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:cE,id_str:cE,lead:"クセになる食感！",title:"蒸し卵",description:"いつものゆで卵を蒸し器で作ってみませんか？蒸すことでゆでたものよりもプリッとした食感に仕上がります♪ぜひお試しください！",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F375897128225997143\u002F1.m3u8",poster_url:cF,webp_poster_url:cG},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F375897128225997143\u002F1.mp4",poster_url:cF,webp_poster_url:cG},ingredient_groups:[{recipe_ingredients:[{name:l}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:cH,id_str:cH,lead:"調味料ひとつで作る♪",title:"白だし味付け玉子",description:"白だしで作るとっても簡単な味付け玉子のご紹介です！必要な調味料は白だしだけ♪そのまま食卓に出せるのはもちろん、お酒のおつまみにもおすすめです。卵のゆで時間や白だしに漬ける時間をお好みで調整してお試しください♪白だしは製品によって塩分量に違いがあります。詳しい内容は注意点をご確認ください。",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F296887540219118717\u002F1.m3u8",poster_url:cI,webp_poster_url:cJ},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F296887540219118717\u002F1.mp4",poster_url:cI,webp_poster_url:cJ},ingredient_groups:[{recipe_ingredients:[{name:l}]},{recipe_ingredients:[{name:"白だし"},{name:j}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:cK,id_str:cK,lead:"味が染みて絶品！",title:"とろっと半熟煮卵",description:"一晩寝かせることで白身にも黄身にもしっかり味が染み込んだ半熟の味付き卵♪人気ラーメン屋さんのようにとろっとした黄身にするためには、ゆで時間を正確に計るのがコツです。みりんなしで家にある調味料で気軽に作れます。ラーメンに添えたり、お酒のおつまみとしてそのまま食べたりするのもおすすめです。",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F207024624397975956\u002F1.m3u8",poster_url:cL,webp_poster_url:cM},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F207024624397975956\u002F1.mp4",poster_url:cL,webp_poster_url:cM},ingredient_groups:[{recipe_ingredients:[{name:o},{name:"細ねぎ(刻み)"}]},{recipe_ingredients:[{name:cN},{name:aa},{name:cO},{name:j}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:cP,id_str:cP,lead:"炊飯器にお任せ♪",title:"とろとろ温泉卵",description:"保温機能のおかげで温度が一定に保たれるので簡単に温泉卵ができます。丼ものに大活躍すること間違いなしです。",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F221837584517562727\u002F1.m3u8",poster_url:cQ,webp_poster_url:cR},square_mp4_video:{url:"https:\u002F\u002Fmedia.delishkitchen.tv\u002Frecipe\u002F221837584517562727\u002F1.mp4",poster_url:cQ,webp_poster_url:cR},ingredient_groups:[{recipe_ingredients:[{name:l},{name:"お湯"}]},{recipe_ingredients:[{name:"みりん"},{name:aa},{name:p},{name:cO},{name:j}]},{recipe_ingredients:[{name:"かいわれ"}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:L,id_str:L,lead:k,title:cb,description:cc,state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,square_video:{url:cd,poster_url:M,webp_poster_url:N},square_mp4_video:{url:ce,poster_url:M,webp_poster_url:N},ingredient_groups:[{recipe_ingredients:[{name:n}]}],calorie:c,cooking_time:c,cooking_tags:a,recipe_detail:a,cooking_reports_container:a},{id:cS,id_str:cS,lead:"酸味がたまらない♪",title:"酢醤油の半熟味卵",description:"酢醤油の酸味と黄身のまろやかさが絶妙にマッチした一品！ラーメンなどのトッピングやごはんのお供にいかがですか？",state:g,state_premium:e,is_visible:d,is_favorite_free:b,advertiser:a,sq