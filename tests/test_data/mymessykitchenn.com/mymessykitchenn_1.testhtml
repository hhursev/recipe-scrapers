	<style type="text/css">.wprm-recipe-template-my-messy-kitchen-template {
    margin: 20px auto;
    background-color: #ffffff; /*wprm_background type=color*/
    font-family: inherit; /*wprm_main_font_family type=font*/
    font-size: 1em; /*wprm_main_font_size type=font_size*/
    line-height: 1.5em !important; /*wprm_main_line_height type=font_size*/
    color: #333333; /*wprm_main_text type=color*/
    max-width: 950px; /*wprm_max_width type=size*/
}
.wprm-recipe-template-my-messy-kitchen-template a {
    color: #e9cdcb; /*wprm_link type=color*/
}
.wprm-recipe-template-my-messy-kitchen-template p, .wprm-recipe-template-my-messy-kitchen-template li {
    font-family: inherit; /*wprm_main_font_family type=font*/
    font-size: 1em !important;
    line-height: 1.5em !important; /*wprm_main_line_height type=font_size*/
}
.wprm-recipe-template-my-messy-kitchen-template li {
    margin: 0 0 0 32px !important;
    padding: 0 !important;
}
.rtl .wprm-recipe-template-my-messy-kitchen-template li {
    margin: 0 32px 0 0 !important;
}
.wprm-recipe-template-my-messy-kitchen-template ol, .wprm-recipe-template-my-messy-kitchen-template ul {
    margin: 0 !important;
    padding: 0 !important;
}
.wprm-recipe-template-my-messy-kitchen-template br {
    display: none;
}
.wprm-recipe-template-my-messy-kitchen-template .wprm-recipe-name,
.wprm-recipe-template-my-messy-kitchen-template .wprm-recipe-header {
    font-family: inherit; /*wprm_header_font_family type=font*/
    color: #212121; /*wprm_header_text type=color*/
    line-height: 1.3em; /*wprm_header_line_height type=font_size*/
}
.wprm-recipe-template-my-messy-kitchen-template h1,
.wprm-recipe-template-my-messy-kitchen-template h2,
.wprm-recipe-template-my-messy-kitchen-template h3,
.wprm-recipe-template-my-messy-kitchen-template h4,
.wprm-recipe-template-my-messy-kitchen-template h5,
.wprm-recipe-template-my-messy-kitchen-template h6 {
    font-family: inherit; /*wprm_header_font_family type=font*/
    color: #212121; /*wprm_header_text type=color*/
    line-height: 1.3em; /*wprm_header_line_height type=font_size*/
    margin: 0 !important;
    padding: 0 !important;
}
.wprm-recipe-template-my-messy-kitchen-template .wprm-recipe-header {
    margin-top: 1.2em !important;
}
.wprm-recipe-template-my-messy-kitchen-template h1 {
    font-size: 2em; /*wprm_h1_size type=font_size*/
}
.wprm-recipe-template-my-messy-kitchen-template h2 {
    font-size: 1.8em; /*wprm_h2_size type=font_size*/
}
.wprm-recipe-template-my-messy-kitchen-template h3 {
    font-size: 1.2em; /*wprm_h3_size type=font_size*/
}
.wprm-recipe-template-my-messy-kitchen-template h4 {
    font-size: 1em; /*wprm_h4_size type=font_size*/
}
.wprm-recipe-template-my-messy-kitchen-template h5 {
    font-size: 1em; /*wprm_h5_size type=font_size*/
}
.wprm-recipe-template-my-messy-kitchen-template h6 {
    font-size: 1em; /*wprm_h6_size type=font_size*/
}.wprm-recipe-template-my-messy-kitchen-template {
    font-size: 1em; /*wprm_main_font_size type=font_size*/
	border-style: solid; /*wprm_border_style type=border*/
	border-width: 1px; /*wprm_border_width type=size*/
	border-color: #E0E0E0; /*wprm_border type=color*/
    padding: 10px;
    background-color: #ffffff; /*wprm_background type=color*/
    max-width: 950px; /*wprm_max_width type=size*/
}
.wprm-recipe-template-my-messy-kitchen-template a {
    color: #e9cdcb; /*wprm_link type=color*/
}
.wprm-recipe-template-my-messy-kitchen-template .wprm-recipe-name {
    line-height: 1.3em;
    font-weight: bold;
}
.wprm-recipe-template-my-messy-kitchen-template .wprm-template-chic-buttons {
	clear: both;
    font-size: 0.9em;
    text-align: center;
}
.wprm-recipe-template-my-messy-kitchen-template .wprm-template-chic-buttons .wprm-recipe-icon {
    margin-right: 5px;
}
.wprm-recipe-template-my-messy-kitchen-template .wprm-recipe-header {
	margin-bottom: 0.5em !important;
}
.wprm-recipe-template-my-messy-kitchen-template .wprm-nutrition-label-container {
	font-size: 0.9em;
}
.wprm-recipe-template-my-messy-kitchen-template .wprm-call-to-action {
	border-radius: 3px;
}</style>		<script type="text/javascript">
			(function() {
				// Always start from a fresh object: a `||` fallback would keep a same-named DOM element alive.
				window.wcAnalytics = {};
				const wcAnalytics = window.wcAnalytics;

				// Set the assets URL for webpack to find the split assets.
				wcAnalytics.assets_url = 'https://mymessykitchenn.com/wp-content/plugins/jetpack/jetpack_vendor/automattic/woocommerce-analytics/src/../build/';

				// Set the REST API tracking endpoint URL.
								wcAnalytics.trackEndpoint = "https://mymessykitchenn.com/wp-json/woocommerce-analytics/v1/track";

				// Set common properties for all events.
				wcAnalytics.commonProps = {"ui":0,"blog_id":209323108,"store_id":"504c491f-94db-4886-b99a-98cc03b9ddb4","url":"https://mymessykitchenn.com","woo_version":"11.2.2","wp_version":"7.1.4","store_admin":0,"device":"desktop","store_currency":"USD","timezone":"+00:00","is_guest":1,"package_version":"0.18.1"};

				// Set the event queue.
				wcAnalytics.eventQueue = [];

				// Features.
				wcAnalytics.features = {
					ch: false,
					sessionTracking: false,
					proxy: false,
				};

				// A delay-JS plugin can hold back the consent API script, so the client cannot rely on its functions to know it has to wait.
				wcAnalytics.consentManaged = false;

				wcAnalytics.breadcrumbs = ["Breakfast","Everything Bagel Buns"];

				// Page context flags.
				wcAnalytics.pages = {
					isAccountPage: false,
					isCart: false,
				};
			})();
