hen10\/","https:\/\/x.com\/mymessykitchenn","https:\/\/www.instagram.com\/mymessykitchenn\/?hl=en","https:\/\/www.pinterest.com\/mymessykitchenn\/"]},{"@type":"Person","@id":"https:\/\/mymessykitchenn.com\/#\/schema\/person\/078470dbc94709e6118834320e80331d","name":"Emily","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/755bf36073a3f5c5cecf0f8ebe6c1bc40e7fe6d251fa73f19193df8a13b81df3?s=96&d=mm&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/755bf36073a3f5c5cecf0f8ebe6c1bc40e7fe6d251fa73f19193df8a13b81df3?s=96&d=mm&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/755bf36073a3f5c5cecf0f8ebe6c1bc40e7fe6d251fa73f19193df8a13b81df3?s=96&d=mm&r=g","caption":"Emily"}},{"@type":"Recipe","name":"Everything Bagel Buns","author":{"@type":"Person","name":"Emily - My Messy Kitchen","url":"https:\/\/my-messy-kitchen.com\/everything-bagel-buns\/"},"description":"These Everything Bagel Buns are a fun take on the classic bagel and cream cheese! Easy to put together the night before and bake up in the morning, and made with simple, affordable ingredients!","datePublished":"2020-04-04T20:31:51+00:00","image":["https:\/\/mymessykitchenn.com\/wp-content\/uploads\/2020\/04\/bun5-1-of-1.jpg","https:\/\/mymessykitchenn.com\/wp-content\/uploads\/2020\/04\/bun5-1-of-1-500x500.jpg","https:\/\/mymessykitchenn.com\/wp-content\/uploads\/2020\/04\/bun5-1-of-1-500x375.jpg","https:\/\/mymessykitchenn.com\/wp-content\/uploads\/2020\/04\/bun5-1-of-1-480x270.jpg"],"recipeYield":["8","8 buns"],"prepTime":"PT75M","cookTime":"PT15M","recipeIngredient":["8 frozen raw dinner rolls (These can be found in the frozen section, they must be raw dough! I use Rhodes frozen dinner rolls)","8 tbsp plain cream cheese","3 tbsp water","3 tbsp everything bagel seasoning"],"recipeInstructions":[{"@type":"HowToStep","text":"Remove raw dinner rolls from the freezer and let defrost for 45-60 minutes.  The rolls are ready once they are soft. Spray nonstick cooking spray on a sheet pan and space the dough out about 2 inches apart.","name":"Remove raw dinner rolls from the freezer and let defrost for 45-60 minutes.  The rolls are ready once they are soft. Spray nonstick cooking spray on a sheet pan and space the dough out about 2 inches apart.","url":"https:\/\/mymessykitchenn.com\/everything-bagel-buns\/#wprm-recipe-1367-step-0-0"},{"@type":"HowToStep","text":"Spray hands lightly with nonstick and press the dough into about 3 -inch circles. Using the small ice cream scoop, or simply cut the cream cheese into 8 cubes, place cream cheese into the center. Dip your finger into the water and wet the edges of the dough. Fold up each side to completely seal the dough (use extra water if necessary)","name":"Spray hands lightly with nonstick and press the dough into about 3 -inch circles. Using the small ice cream scoop, or simply cut the cream cheese into 8 cubes, place cream cheese into the center. Dip your finger into the water and wet the edges of the dough. Fold up each side to completely seal the dough (use extra water if necessary)","url":"https:\/\/mymessykitchenn.com\/everything-bagel-buns\/#wprm-recipe-1367-step-0-1"},{"@type":"HowToStep","text":"If you plan to bake them up now, cover with saran wrap that you sprayed with nonstick cooking spray to make sure it doesn&#39;t stick to the dough. Let them rise for 30 minutes.If you&#39;re baking them up the next day, cover the rolls with saran wrap sprayed with nonstick cooking spray and return to the refrigerator. When you want to bake them, remove from the fridge and allow to come to room temp for 30 minutes. Then proceed to the next step!","name":"If you plan to bake them up now, cover with saran wrap that you sprayed with nonstick cooking spray to make sure it doesn&#39;t stick to the dough. Let them rise for 30 minutes.If you&#39;re baking them up the next day, cover the rolls with saran wrap sprayed with nonstick cooking spray and return to the refrigerator. When you want to bake them, remove from the fridge and allow to come to room temp for 30 minutes. Then proceed to the next step!","url":"https:\/\/mymessykitchenn.com\/everything-bagel-buns\/#wprm-recipe-1367-step-0-2"},{"@type":"HowToStep","text":"Preheat the oven according to the dinner roll bag, although most are 350°. Right before baking, add the everything bagel seasoning into a small bowl and dunk the tops of the rolls in. Space dough balls approximately 2 inches apart on a baking sheet lined with parchment paper or sprayed with nonstick cooking spray. Bake according to the package, usually 12-15 minutes. Remove from the oven and let cool for 10-15 minutes before eating, because the cream cheese can be really hot so you want them to cool for a bit! Enjoy!","name":"Preheat the oven according to the dinner roll bag, although most are 350°. Right before baking, add the everything bagel seasoning into a small bowl and dunk the tops of the rolls in. Space dough balls approximately 2 inches apart on a baking sheet lined with parchment paper or sprayed with nonstick cooking spray. Bake according to the package, usually 12-15 minutes. Remove from the oven and let cool for 10-15 minutes before eating, because the cream cheese can be really hot so you want them to cool for a bit! Enjoy!","url":"https:\/\/mymessykitchenn.com\/everything-bagel-buns\/#wprm-recipe-1367-step-0-3"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"5","ratingCount":"4","reviewCount":"4"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"So easy to make, and so delicious. I\"ve made them a few times now, and they are ALWAYS a hit.","author":{"@type":"Person","name":"Laura R."},"datePublished":"2025-09-02"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"These are going on my must make list. I’m thinking I could also fill with a bit of marinara, a small, cooked meatball and some grated mozzarella, then serve marinara for dipping.","author":{"@type":"Person","name":"Diana"},"datePublished":"2023-10-25"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"These are UNREAL and a must-have for guests or a brunch! Literally, I’ve learned these are everyone’s favorite at a brunch. I love how easy these are to make. Most important thing is to let the dough rise enough and they come out perfect every time.","author":{"@type":"Person","name":"Laura BT"},"datePublished":"2022-08-13"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Was looking for a good bagel recipe and stumbled upon your site.  These are sooooooo good!  Thanks for sharing Emily!","author":{"@type":"Person","name":"Cheryl Batone"},"datePublished":"2020-08-26"}],"recipeCategory":["Breakfast"],"keywords":"easy breakfast, everything bagels, everything seasoning","@id":"https:\/\/mymessykitchenn.com\/everything-bagel-buns\/#recipe","isPartOf":{"@id":"https:\/\/mymessykitchenn.com\/everything-bagel-buns\/#article"},"mainEntityOfPage":"https:\/\/mymessykitchenn.com\/everything-bagel-buns\/"}]}</script>
