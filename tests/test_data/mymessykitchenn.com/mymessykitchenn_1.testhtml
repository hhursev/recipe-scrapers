.d .st-d-subheading.se-rc a:hover {text-decoration:underline;color:rgba(0,0,0,1);opacity:0.8;}
.m .st-m-subheading,.m .se-wpt h3 {color:rgba(0,0,0,1);text-transform:uppercase;line-height:1.4;letter-spacing:0.1em;font-size:11px;text-align:center;font-family:'Poppins';font-weight:400;font-style:normal;}
