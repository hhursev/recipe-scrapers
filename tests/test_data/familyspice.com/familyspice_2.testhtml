,"logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/familyspice.com\/#\/schema\/logo\/image\/","url":"https:\/\/familyspice.com\/wp-content\/uploads\/2020\/03\/new_FS_logo_2020_SQ.jpg","contentUrl":"https:\/\/familyspice.com\/wp-content\/uploads\/2020\/03\/new_FS_logo_2020_SQ.jpg","width":257,"height":258,"caption":"Family Spice"},"image":{"@id":"https:\/\/familyspice.com\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/familyspice","https:\/\/x.com\/familyspice","https:\/\/www.instagram.com\/familyspice\/","http:\/\/pinterest.com\/familyspice","https:\/\/www.youtube.com\/channel\/UC3Pk0r7ITtSVlWEHk1lnHKQ"]},{"@type":"Person","@id":"https:\/\/familyspice.com\/#\/schema\/person\/5a3ebcca21aea0ad7f6b5def103acd37","name":"Laura Bashar","sameAs":["https:\/\/familyspice.com\/about-me\/","https:\/\/www.facebook.com\/familyspice\/","https:\/\/x.com\/familyspice"],"url":"https:\/\/familyspice.com\/author\/laura\/"},{"@type":"Question","@id":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#faq-question-1682534464370","position":1,"url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#faq-question-1682534464370","name":"What is the best cornmeal for polenta?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Polenta is an Italian dish made with stone ground corn. Stone ground corn meal is more coarse than fine stuff you find at the grocery store. You want to look for corn meal that is labeled for polenta. Fine corn meal will cook faster than stone ground and the final texture will be much smoother.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#faq-question-1682535100504","position":2,"url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#faq-question-1682535100504","name":"How do you serve pork ragu?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Because pork ragu is a thick and hearty sauce, you should serve it over a thick pasta. You can use wide noodles like pappardelle or egg noodles. You can also serve with a crusty baguette. My personal favorite is over creamy, cheesy polenta.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Recipe","name":"Pulled Pork Ragu with Polenta","author":{"@type":"Person","name":"Laura Bashar | Family Spice"},"description":"Use up leftovers to make this incredible pulled pork ragu. Serve over pasta or my favorite, creamy polenta and you&#x27;ve got an incredible Italian comfort food that will blow you away!","datePublished":"2023-04-26T11:59:07+00:00","image":["https:\/\/familyspice.com\/wp-content\/uploads\/2023\/04\/pulled-pork-ragu7-1200.jpg"],"recipeYield":["4"],"prepTime":"PT10M","cookTime":"PT90M","totalTime":"PT100M","recipeIngredient":["1 tbsp extra virgin olive oil","1\/2 cup chopped onions","1\/4 cup chopped celery","3  garlic cloves","1 tbsp chopped fresh sage","1 tsp fresh thyme","1 tsp chopped fresh basil","1\/2 tsp chopped fresh rosemary","1 1\/2 tsp salt (divided)","1\/4 tsp ground black pepper","2 tbsp tomato paste","1\/3 cup dry red wine","15 oz canned diced tomatoes","8 oz cooked pulled pork","1 cup polenta corn meal","4 cups water","4 tbsp butter","1\/2 cup grated parmesan"],"recipeInstructions":[{"@type":"HowToSection","name":"Ragu Directions","itemListElement":[{"@type":"HowToStep","text":"In a medium pot over medium-high heat add olive oil.","name":"In a medium pot over medium-high heat add olive oil.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-0-0"},{"@type":"HowToStep","text":"When oil is hot, add onions and celery and sauté until softened, about 5 minutes.","name":"When oil is hot, add onions and celery and sauté until softened, about 5 minutes.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-0-1"},{"@type":"HowToStep","text":"Stir in herbs, garlic, 1\/2 tsp salt and 1\/4 tsp pepper until combined.","name":"Stir in herbs, garlic, 1\/2 tsp salt and 1\/4 tsp pepper until combined.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-0-2"},{"@type":"HowToStep","text":"Reduce heat to medium and stir in tomato paste. Work it into the vegetables and herbs and cook until color begins to darken.","name":"Reduce heat to medium and stir in tomato paste. Work it into the vegetables and herbs and cook until color begins to darken.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-0-3"},{"@type":"HowToStep","text":"Stir in wine and continue stirring and cooking for 2-3 minutes.","name":"Stir in wine and continue stirring and cooking for 2-3 minutes.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-0-4"},{"@type":"HowToStep","text":"Mix in diced tomatoes, then reduce heat to low and simmer ragu for at least one hour.","name":"Mix in diced tomatoes, then reduce heat to low and simmer ragu for at least one hour.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-0-5"},{"@type":"HowToStep","text":"Stir in pulled pork and let sauce simmer for 20 minutes.","name":"Stir in pulled pork and let sauce simmer for 20 minutes.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-0-6"},{"@type":"HowToStep","text":"If sauce gets too thick, add a little water to thin out.","name":"If sauce gets too thick, add a little water to thin out.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-0-7"}]},{"@type":"HowToSection","name":"Polenta Directions","itemListElement":[{"@type":"HowToStep","text":"In the meantime, make the polenta. If you are serving over pasta, prepare the pasta.","name":"In the meantime, make the polenta. If you are serving over pasta, prepare the pasta.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-1-0"},{"@type":"HowToStep","text":"Add 2 cups of water into a small pot, add 1 tsp salt and bring to boil.","name":"Add 2 cups of water into a small pot, add 1 tsp salt and bring to boil.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-1-1"},{"@type":"HowToStep","text":"When water is boiling, slowly pour in corn meal, whisking it into the water the whole time.","name":"When water is boiling, slowly pour in corn meal, whisking it into the water the whole time.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-1-2"},{"@type":"HowToStep","text":"Reduce heat to medium-high and continue whisking until mixture is smooth and begins to thicken.","name":"Reduce heat to medium-high and continue whisking until mixture is smooth and begins to thicken.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-1-3"},{"@type":"HowToStep","text":"Reduce heat to medium-low and cook until corn meal is tender and polenta is thick by creamy, stirring often, about 20 minutes.","name":"Reduce heat to medium-low and cook until corn meal is tender and polenta is thick by creamy, stirring often, about 20 minutes.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-1-4"},{"@type":"HowToStep","text":"Stir in butter and parmesan cheese.","name":"Stir in butter and parmesan cheese.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-1-5"},{"@type":"HowToStep","text":"To serve, spread cornmeal over a shallow bowl or pasta dish and top with pork ragu.","name":"To serve, spread cornmeal over a shallow bowl or pasta dish and top with pork ragu.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-1-6"},{"@type":"HowToStep","text":"Garnish fresh parsley and more grated parmesan, if desired.","name":"Garnish fresh parsley and more grated parmesan, if desired.","url":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#wprm-recipe-20558-step-1-7"}]}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.88","ratingCount":"8","reviewCount":"1"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Wow this recipe is so so delicious, thank you for sharing! I added red pepper flakes to my ragu for spice and I used homemade veggie stock as liquid for my polenta. If you can, use fresh herbs, I can taste each of them and they add so much depth to the flavors. So happy with how this meal turned out! 10\/10 would recommend and will be making again!","author":{"@type":"Person","name":"Suz"},"datePublished":"2021-12-08"}],"recipeCategory":["Main Course"],"recipeCuisine":["Italian"],"keywords":"leftover pulled pork, pork ragu, pulled pork ragu","nutrition":{"@type":"NutritionInformation","servingSize":"1 g","calories":"497 kcal","carbohydrateContent":"51 g","proteinContent":"17 g","fatContent":"25 g","saturatedFatContent":"12 g","transFatContent":"1 g","cholesterolContent":"68 mg","sodiumContent":"1909 mg","fiberContent":"6 g","sugarContent":"14 g","unsaturatedFatContent":"11 g"},"@id":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#recipe","isPartOf":{"@id":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/#article"},"mainEntityOfPage":"https:\/\/familyspice.com\/leftover-pulled-pork-ragu\/"}]}</script>
