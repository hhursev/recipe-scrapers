<!DOCTYPE html><html lang="zh-Hans" data-astro-cid-tq46r5sz><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#faf7f2"><title>醋溜白菜 · 中餐厨房图鉴</title><meta name="description" content="白菜帮斜切薄片，嫩叶撕大块分次下锅。用一汤匙香醋沿锅边烹一下，白菜帮还脆，叶子已经挂上酸香的汁。"><meta property="og:type" content="website"><meta property="og:site_name" content="中餐厨房图鉴"><meta property="og:title" content="醋溜白菜"><meta property="og:description" content="白菜帮斜切薄片，嫩叶撕大块分次下锅。用一汤匙香醋沿锅边烹一下，白菜帮还脆，叶子已经挂上酸香的汁。"><meta property="og:url" content="https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/"><meta property="og:locale" content="zh_CN"><meta property="og:image" content="https://chineserecipes.xyz/images/recipes/hot-and-sour-napa-cabbage--hero-1200.webp"><meta property="og:image:alt" content="醋溜白菜"><meta name="twitter:card" content="summary_large_image"><link rel="alternate" type="application/rss+xml" title="中餐厨房图鉴" href="/zh/feed.xml"><meta name="robots" content="index,follow,max-image-preview:large"><link rel="canonical" href="https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/"><link rel="alternate" hreflang="en-US" href="https://chineserecipes.xyz/recipes/hot-and-sour-napa-cabbage/"><link rel="alternate" hreflang="zh-Hans" href="https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/"><link rel="alternate" hreflang="x-default" href="https://chineserecipes.xyz/recipes/hot-and-sour-napa-cabbage/"><link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Recipe","@id":"https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/#recipe","url":"https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/","inLanguage":"zh-Hans","name":"醋溜白菜","description":"白菜帮斜切薄片，嫩叶撕大块分次下锅。用一汤匙香醋沿锅边烹一下，白菜帮还脆，叶子已经挂上酸香的汁。","datePublished":"2026-11-20","image":["https://chineserecipes.xyz/images/recipes/search/hot-and-sour-napa-cabbage--1x1.webp","https://chineserecipes.xyz/images/recipes/search/hot-and-sour-napa-cabbage--4x3.webp","https://chineserecipes.xyz/images/recipes/search/hot-and-sour-napa-cabbage--16x9.webp"],"author":{"@type":"Organization","name":"中餐厨房图鉴"},"recipeCuisine":"中餐","suitableForDiet":["https://schema.org/VeganDiet","https://schema.org/VegetarianDiet"],"recipeCategory":"配菜","keywords":"酸甜, 蒜香, 软嫩, 爽脆","prepTime":"PT8M","cookTime":"PT5M","totalTime":"PT13M","recipeYield":"2","recipeIngredient":["340 克 大白菜","7 克 蒜","1 克 干辣椒 (干制)","15 毫升 食用油","15 毫升 香醋","2 克 白糖","1.5 克 盐"],"recipeInstructions":[{"@type":"HowToStep","name":"菜帮斜切，菜叶撕大块","text":"白菜洗净擦干，把白色厚帮和叶子分开。菜帮平放，斜刀切成约半厘米厚的片；菜叶撕成约五厘米的块，与菜帮分开放。蒜切片，辣椒掰小段。把糖和盐放进香醋里搅匀。 菜帮切面宽、边缘薄，叶子提起来不滴水。","url":"https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/#step-hot-and-sour-napa-cabbage-cut","image":["https://chineserecipes.xyz/images/recipes/hot-and-sour-napa-cabbage--cut-1200.webp"]},{"@type":"HowToStep","name":"先煸香料，再炒菜帮","text":"油、干辣椒段和蒜片一起入锅，中火加热。蒜片滋滋作响、香气出来就倒入白菜帮，转中大火摊开，翻炒约两分钟。蒜片若上色太快，就铲到菜帮上。 菜帮的薄边略透明，用铲子轻压，中间仍挺实。","url":"https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/#step-hot-and-sour-napa-cabbage-pan"},{"@type":"HowToStep","name":"菜叶刚塌就沿锅边烹醋","text":"倒入菜叶，把菜帮从下面翻上来，炒一两分钟。叶子刚塌软就在锅边拨出一小块空处；有明显积水就先让水汽收一收。把碗里的醋汁再搅一下，沿这块热锅面烹入，翻匀约十五秒，趁菜帮还有脆劲就盛出。 能闻到醋香，叶子软软地贴着菜帮，盘里只有薄薄一层汁。","url":"https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/#step-hot-and-sour-napa-cabbage-finish","image":["https://chineserecipes.xyz/images/recipes/hot-and-sour-napa-cabbage--finish-1200.webp"]}],"nutrition":{"@type":"NutritionInformation","servingSize":"每份","calories":"102 calories","proteinContent":"2.8 g","fatContent":"7.4 g","carbohydrateContent":"8.5 g","sodiumContent":"362 mg","fiberContent":"2.3 g"}}</script><style>.policy-page[data-astro-cid-tntgkcfb]{max-width:780px}.policy-date[data-astro-cid-tntgkcfb]{color:var(--muted,#625e54);margin-bottom:2.5rem;font-size:.9rem}.policy-page[data-astro-cid-tntgkcfb] section[data-