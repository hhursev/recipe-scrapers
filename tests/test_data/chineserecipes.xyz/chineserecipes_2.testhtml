bel&quot;:[0,&quot;细盐&quot;]}],[0,&quot;。&quot;]]],&quot;用一只小碗或杯子搅匀醋、盐和糖。&quot;:[1,[[0,&quot;用一只小碗或杯子搅匀醋、&quot;],[0,{&quot;conceptId&quot;:[0,&quot;salt&quot;],&quot;label&quot;:[0,&quot;盐&quot;]}],[0,&quot;和糖。&quot;]]],&quot;白菜洗净擦干，把白色厚帮和叶子分开。菜帮平放，斜刀切成约半厘米厚的片；菜叶撕成约五厘米的块，与菜帮分开放。蒜切片，辣椒掰小段。把糖和盐放进香醋里搅匀。&quot;:[1,[[0,&quot;白菜洗净擦干，把白色厚帮和叶子分开。菜帮平放，斜刀切成约半厘米厚的片；菜叶撕成约五厘米的块，与菜帮分开放。&quot;],[0,{&quot;conceptId&quot;:[0,&quot;garlic&quot;],&quot;label&quot;:[0,&quot;蒜&quot;]}],[0,&quot;切片，辣椒掰小段。把糖和&quot;],[0,{&quot;conceptId&quot;:[0,&quot;salt&quot;],&quot;label&quot;:[0,&quot;盐&quot;]}],[0,&quot;放进&quot;],[0,{&quot;conceptId&quot;:[0,&quot;black-vinegar&quot;],&quot;label&quot;:[0,&quot;香醋&quot;]}],[0,&quot;里搅匀。&quot;]]],&quot;油、干辣椒段和蒜片一起入锅，中火加热。蒜片滋滋作响、香气出来就倒入白菜帮，转中大火摊开，翻炒约两分钟。蒜片若上色太快，就铲到菜帮上。&quot;:[1,[[0,&quot;油、&quot;],[0,{&quot;conceptId&quot;:[0,&quot;dried-chili&quot;],&quot;label&quot;:[0,&quot;干辣椒&quot;]}],[0,&quot;段和&quot;],[0,{&quot;conceptId&quot;:[0,&quot;garlic&quot;],&quot;label&quot;:[0,&quot;蒜&quot;]}],[0,&quot;片一起入锅，中火加热。蒜片滋滋作响、香气出来就倒入白菜帮，转中大火摊开，翻炒约两分钟。蒜片若上色太快，就铲到菜帮上。&quot;]]]}],&quot;shopping&quot;:[1,[[0,{&quot;ingredientId&quot;:[0,&quot;dried-chili&quot;],&quot;name&quot;:[0,&quot;干辣椒&quot;],&quot;shelf&quot;:[0,&quot;亚洲超市辣椒香料区或蔬菜区&quot;],&quot;choose&quot;:[0,&quot;核对辣椒品种、辣度、肉厚和鲜干形态。小米辣、墨西哥青椒、甜椒、干辣椒不能只按颜色或等克重互换。&quot;],&quot;channels&quot;:[1,[[0,{&quot;name&quot;:[0,&quot;大华超级市场&quot;],&quot;url&quot;:[0,&quot;https://www.99ranch.com/&quot;]}],[0,{&quot;name&quot;:[0,&quot;亚洲线上超市&quot;],&quot;url&quot;:[0,&quot;https://www.sayweee.com/en&quot;]}]]],&quot;alternatives&quot;:[1,[]]}],[0,{&quot;ingredientId&quot;:[0,&quot;neutral-oil&quot;],&quot;name&quot;:[0,&quot;食用油&quot;],&quot;shelf&quot;:[0,&quot;食用油货架&quot;],&quot;choose&quot;:[0,&quot;原味菜籽油气味淡，适合煎烙。选瓶装液体油，方便用茶匙量取。&quot;],&quot;channels&quot;:[1,[[0,{&quot;name&quot;:[0,&quot;沃尔玛&quot;],&quot;url&quot;:[0,&quot;https://www.walmart.com/browse/food/shop-all-cooking-oils-vinegars/976759_976794_4649724_4110919&quot;]}],[0,{&quot;name&quot;:[0,&quot;克罗格超市&quot;],&quot;url&quot;:[0,&quot;https://www.kroger.com/p/kroger-pure-canola-oil/0001111085634&quot;]}]]],&quot;alternatives&quot;:[1,[[0,{&quot;name&quot;:[0,&quot;精炼低芥酸菜籽油&quot;],&quot;note&quot;:[0,&quot;可按相同量使用精炼、淡味食用油；不适用于香油或风味强烈的油。&quot;]}],[0,{&quot;name&quot;:[0,&quot;精炼玉米油&quot;],&quot;note&quot;:[0,&quot;可按相同量使用精炼、淡味食用油；不适用于香油或风味强烈的油。&quot;]}],[0,{&quot;name&quot;:[0,&quot;精炼大豆油&quot;],&quot;note&quot;:[0,&quot;可按相同量使用精炼、淡味食用油；不适用于香油或风味强烈的油。&quot;]}]]]}],[0,{&quot;ingredientId&quot;:[0,&quot;black-vinegar&quot;],&quot;name&quot;:[0,&quot;香醋&quot;],&quot;shelf&quot;:[0,&quot;亚洲超市酱料区&quot;],&quot;choose&quot;:[0,&quot;选镇江风格香醋；意大利甜醋、调味寿司醋的甜度与香气不同。&quot;],&quot;channels&quot;:[1,[[0,{&quot;name&quot;:[0,&quot;大华超级市场&quot;],&quot;url&quot;:[0,&quot;https://www.99ranch.com/&quot;]}],[0,{&quot;name&quot;:[0,&quot;亚洲线上超市&quot;],&quot;url&quot;:[0,&quot;https://www.sayweee.com/en&quot;]}],[0,{&quot;name&quot;:[0,&quot;克罗格超市&quot;],&quot;url&quot;:[0,&quot;https://www.kroger.com/p/gold-plum-chinkiang-vinegar/0002845720500&quot;]}]]],&quot;alternatives&quot;:[1,[[0,{&quot;name&quot;:[0,&quot;米醋&quot;],&quot;note&quot;:[0,&quot;340 克白菜换一汤匙（15 毫升）无糖原味米醋。菜叶刚塌软就沿热锅边烹入，酸味更清亮，菜色也浅。&quot;]}]]]}]]],&quot;terms&quot;:[0,{&quot;napa-cabbage&quot;:[0,{&quot;id&quot;:[0,&quot;napa-cabbage&quot;],&quot;title&quot;:[0,&quot;大白菜&quot;],&quot;summary&quot;:[0,&quot;长圆形白菜，浅色皱叶连着宽白菜帮；菜帮多汁，煮后软嫩清甜。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/vegetables/page/3/#concept-napa-cabbage&quot;],&quot;article&quot;:[0,false]}],&quot;garlic&quot;:[0,{&quot;id&quot;:[0,&quot;garlic&quot;],&quot;title&quot;:[0,&quot;蒜&quot;],&quot;summary&quot;:[0,&quot;蒜瓣可切片、切末或压碎，用来增加香味。蒜盐含有额外的盐，不能直接当作鲜蒜使用。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/vegetables/page/3/#concept-garlic&quot;],&quot;article&quot;:[0,false]}],&quot;dried-chili&quot;:[0,{&quot;id&quot;:[0,&quot;dried-chili&quot;],&quot;title&quot;:[0,&quot;干辣椒&quot;],&quot;summary&quot;:[0,&quot;提供辣味和香气，品种、用量及是否去籽都会影响辣度。“几根”不代表固定辣度。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/seasonings/page/2/#concept-dried-chili&quot;],&quot;article&quot;:[0,false]}],&quot;neutral-oil&quot;:[0,{&quot;id&quot;:[0,&quot;neutral-oil&quot;],&quot;title&quot;:[0,&quot;食用油&quot;],&quot;summary&quot;:[0,&quot;味道较淡、用于日常烹调的油，帮助传热并减少食材黏连。根据锅具和烹调方式选择；香油另作调味。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/oils/#concept-neutral-oil&quot;],&quot;article&quot;:[0,false]}],&quot;black-vinegar&quot;:[0,{&quot;id&quot;:[0,&quot;black-vinegar&quot;],&quot;title&quot;:[0,&quot;香醋&quot;],&quot;summary&quot;:[0,&quot;带有谷物发酵香气的深色食醋，常用于凉拌汁、蘸汁和炒菜。镇江香醋是常见的一类，不能与甜味浓厚的其他醋完全等同。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/seasonings/#concept-black-vinegar&quot;],&quot;article&quot;:[0,false]}],&quot;sugar&quot;:[0,{&quot;id&quot;:[0,&quot;sugar&quot;],&quot;title&quot;:[0,&quot;白糖&quot;],&quot;summary&quot;:[0,&quot;白砂糖用来增加甜味、调整酸味。蜂蜜、糖浆还会带入液体，不能只按同一体积直接替换。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/seasonings/page/3/#concept-sugar&quot;],&quot;article&quot;:[0,false]}],&quot;salt&quot;:[0,{&quot;id&quot;:[0,&quot;salt&quot;],&quot;title&quot;:[0,&quot;盐&quot;],&quot;summary&quot;:[0,&quot;提供咸味的调料。粗盐和细盐同一勺的重量可能不同，菜谱给出克数时优先称重。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/seasonings/page/3/#concept-salt&quot;],&quot;article&quot;:[0,false]}],&quot;mixing-bowls&quot;:[0,{&quot;id&quot;:[0,&quot;mixing-bowls&quot;],&quot;title&quot;:[0,&quot;备料碗&quot;],&quot;summary&quot;:[0,&quot;把食材按下锅顺序提前分装。一起下锅的可放同一组，不同阶段使用的调料和食材分开放。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/equipment/#concept-mixing-bowls&quot;],&quot;article&quot;:[0,false]}],&quot;knife-board&quot;:[0,{&quot;id&quot;:[0,&quot;knife-board&quot;],&quot;title&quot;:[0,&quot;菜刀与砧板&quot;],&quot;summary&quot;:[0,&quot;合适的菜刀与稳定砧板便于备料。即食食材应与接触过生肉的刀板分开处理。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/equipment/#concept-knife-board&quot;],&quot;article&quot;:[0,false]}],&quot;skillet-stainless-12&quot;:[0,{&quot;id&quot;:[0,&quot;skillet-stainless-12&quot;],&quot;title&quot;:[0,&quot;不锈钢平底锅&quot;],&quot;summary&quot;:[0,&quot;没有不粘涂层、适合翻炒和煎制的平底锅。实际锅底面积与炉头大小影响每次能做多少，不能只看标称口径。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/equipment/#concept-skillet-stainless-12&quot;],&quot;article&quot;:[0,false]}],&quot;spatula&quot;:[0,{&quot;id&quot;:[0,&quot;spatula&quot;],&quot;title&quot;:[0,&quot;不伤锅铲&quot;],&quot;summary&quot;:[0,&quot;用来翻动食材的木质或适合的硅胶锅铲，帮助保护涂层。使用前确认其耐热范围。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/equipment/#concept-spatula&quot;],&quot;article&quot;:[0,false]}],&quot;aromatic-oil&quot;:[0,{&quot;id&quot;:[0,&quot;aromatic-oil&quot;],&quot;title&quot;:[0,&quot;用油激香&quot;],&quot;summary&quot;:[0,&quot;葱、蒜或香辛料的香气可以借油带入菜中。依做法，用小火在油里煸香，或把热油浇在耐热碗里备好的香料上。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/technique/#concept-aromatic-oil&quot;],&quot;article&quot;:[0,false]}],&quot;rice-vinegar&quot;:[0,{&quot;id&quot;:[0,&quot;rice-vinegar&quot;],&quot;title&quot;:[0,&quot;米醋&quot;],&quot;summary&quot;:[0,&quot;以米发酵制成的醋，香气通常较柔和；调味米醋含额外调味料，不等同于原味米醋。&quot;],&quot;href&quot;:[0,&quot;/zh/wiki/browse/seasonings/page/3/#concept-rice-vinegar&quot;],&quot;article&quot;:[0,false]}]}],&quot;ingredients&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-napa&quot;],&quot;ingredientId&quot;:[0,&quot;napa-cabbage&quot;],&quot;name&quot;:[0,&quot;大白菜&quot;],&quot;amount&quot;:[0,{&quot;value&quot;:[0,340],&quot;unit&quot;:[0,&quot;g&quot;],&quot;basis&quot;:[0,&quot;edible_raw&quot;]}],&quot;preparation&quot;:[0,&quot;切去根部，取净菜 340 克。白色厚帮和卷曲的嫩叶都用。&quot;],&quot;workingMedium&quot;:[0,false]}],[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-garlic&quot;],&quot;ingredientId&quot;:[0,&quot;garlic&quot;],&quot;name&quot;:[0,&quot;蒜&quot;],&quot;amount&quot;:[0,{&quot;value&quot;:[0,7],&quot;unit&quot;:[0,&quot;g&quot;],&quot;basis&quot;:[0,&quot;edible_raw&quot;]}],&quot;preparation&quot;:[0,&quot;约两瓣，去皮切薄片。&quot;],&quot;workingMedium&quot;:[0,false]}],[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-chile&quot;],&quot;ingredientId&quot;:[0,&quot;dried-chili&quot;],&quot;name&quot;:[0,&quot;干辣椒&quot;],&quot;amount&quot;:[0,{&quot;value&quot;:[0,1],&quot;unit&quot;:[0,&quot;g&quot;],&quot;basis&quot;:[0,&quot;as_purchased&quot;]}],&quot;preparation&quot;:[0,&quot;取 1 克辣味较轻的干红辣椒，如华人超市的二荆条，掰成小段，抖去散籽。&quot;],&quot;workingMedium&quot;:[0,false]}],[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-oil&quot;],&quot;ingredientId&quot;:[0,&quot;neutral-oil&quot;],&quot;name&quot;:[0,&quot;食用油&quot;],&quot;amount&quot;:[0,{&quot;value&quot;:[0,15],&quot;unit&quot;:[0,&quot;mL&quot;],&quot;basis&quot;:[0,&quot;as_purchased&quot;]}],&quot;preparation&quot;:[0,&quot;一汤匙菜籽油或其他味道清淡的炒菜油。&quot;],&quot;workingMedium&quot;:[0,false]}],[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-vinegar&quot;],&quot;ingredientId&quot;:[0,&quot;black-vinegar&quot;],&quot;name&quot;:[0,&quot;香醋&quot;],&quot;amount&quot;:[0,{&quot;value&quot;:[0,15],&quot;unit&quot;:[0,&quot;mL&quot;],&quot;basis&quot;:[0,&quot;as_purchased&quot;]}],&quot;preparation&quot;:[0,&quot;一汤匙金梅牌镇江香醋，这款醋含麦麸。想吃清爽些也可以用无糖原味米醋。&quot;],&quot;workingMedium&quot;:[0,false]}],[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-sugar&quot;],&quot;ingredientId&quot;:[0,&quot;sugar&quot;],&quot;name&quot;:[0,&quot;白糖&quot;],&quot;amount&quot;:[0,{&quot;value&quot;:[0,2],&quot;unit&quot;:[0,&quot;g&quot;],&quot;basis&quot;:[0,&quot;as_purchased&quot;]}],&quot;preparation&quot;:[0,&quot;约半茶匙白砂糖。&quot;],&quot;workingMedium&quot;:[0,false]}],[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-salt&quot;],&quot;ingredientId&quot;:[0,&quot;salt&quot;],&quot;name&quot;:[0,&quot;盐&quot;],&quot;amount&quot;:[0,{&quot;value&quot;:[0,1.5],&quot;unit&quot;:[0,&quot;g&quot;],&quot;basis&quot;:[0,&quot;as_purchased&quot;]}],&quot;preparation&quot;:[0,&quot;约四分之一茶匙细盐。&quot;],&quot;workingMedium&quot;:[0,false]}]]],&quot;equipment&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;mixing-bowls&quot;],&quot;name&quot;:[0,&quot;独立备料碗&quot;],&quot;note&quot;:[0,&quot;用一只小碗或杯子搅匀醋、盐和糖。&quot;],&quot;required&quot;:[0,true]}],[0,{&quot;id&quot;:[0,&quot;knife-board&quot;],&quot;name&quot;:[0,&quot;刀与砧板&quot;],&quot;note&quot;:[0,&quot;用案板和利刀斜切厚菜帮。&quot;],&quot;required&quot;:[0,true]}],[0,{&quot;id&quot;:[0,&quot;skillet-stainless-12&quot;],&quot;name&quot;:[0,&quot;12 英寸不锈钢平底锅&quot;],&quot;note&quot;:[0,&quot;约 30 厘米的平底锅或宽口炒锅，菜帮能摊开即可。&quot;],&quot;required&quot;:[0,true]}],[0,{&quot;id&quot;:[0,&quot;spatula&quot;],&quot;name&quot;:[0,&quot;不刮涂层锅铲&quot;],&quot;note&quot;:[0,&quot;用宽锅铲把帮和叶翻匀。&quot;],&quot;required&quot;:[0,true]}]]],&quot;steps&quot;:[1,[[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-cut&quot;],&quot;phase&quot;:[0,&quot;prep&quot;],&quot;title&quot;:[0,&quot;菜帮斜切，菜叶撕大块&quot;],&quot;instruction&quot;:[0,&quot;白菜洗净擦干，把白色厚帮和叶子分开。菜帮平放，斜刀切成约半厘米厚的片；菜叶撕成约五厘米的块，与菜帮分开放。蒜切片，辣椒掰小段。把糖和盐放进香醋里搅匀。&quot;],&quot;completionCue&quot;:[0,&quot;菜帮切面宽、边缘薄，叶子提起来不滴水。&quot;],&quot;ingredientIds&quot;:[1,[[0,&quot;hot-and-sour-napa-cabbage-napa&quot;],[0,&quot;hot-and-sour-napa-cabbage-garlic&quot;],[0,&quot;hot-and-sour-napa-cabbage-chile&quot;],[0,&quot;hot-and-sour-napa-cabbage-vinegar&quot;],[0,&quot;hot-and-sour-napa-cabbage-sugar&quot;],[0,&quot;hot-and-sour-napa-cabbage-salt&quot;]]],&quot;techniqueLinks&quot;:[0],&quot;minutes&quot;:[1,[[0,7],[0,9]]],&quot;images&quot;:[1,[[0,{&quot;url&quot;:[0,&quot;/images/recipes/hot-and-sour-napa-cabbage--cut-1200.webp&quot;],&quot;thumbnailUrl&quot;:[0,&quot;/images/recipes/hot-and-sour-napa-cabbage--cut-600.webp&quot;],&quot;alt&quot;:[0,&quot;案板上一片完整白菜叶，旁边分开放着斜切的白色菜帮和撕开的嫩叶&quot;],&quot;width&quot;:[0,1200],&quot;height&quot;:[0,800]}]]]}],[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-pan&quot;],&quot;phase&quot;:[0,&quot;cook&quot;],&quot;title&quot;:[0,&quot;先煸香料，再炒菜帮&quot;],&quot;instruction&quot;:[0,&quot;油、干辣椒段和蒜片一起入锅，中火加热。蒜片滋滋作响、香气出来就倒入白菜帮，转中大火摊开，翻炒约两分钟。蒜片若上色太快，就铲到菜帮上。&quot;],&quot;completionCue&quot;:[0,&quot;菜帮的薄边略透明，用铲子轻压，中间仍挺实。&quot;],&quot;ingredientIds&quot;:[1,[[0,&quot;hot-and-sour-napa-cabbage-oil&quot;],[0,&quot;hot-and-sour-napa-cabbage-chile&quot;],[0,&quot;hot-and-sour-napa-cabbage-garlic&quot;],[0,&quot;hot-and-sour-napa-cabbage-napa&quot;]]],&quot;techniqueLinks&quot;:[1,[[0,&quot;aromatic-oil&quot;]]],&quot;minutes&quot;:[1,[[0,2],[0,4]]],&quot;images&quot;:[1,[]]}],[0,{&quot;id&quot;:[0,&quot;hot-and-sour-napa-cabbage-finish&quot;],&quot;phase&quot;:[0,&quot;cook&quot;],&quot;title&quot;:[0,&quot;菜叶刚塌就沿锅边烹醋&quot;],&quot;instruction&quot;:[0,&quot;倒入菜叶，把菜帮从下面翻上来，炒一两分钟。叶子刚塌软就在锅边拨出一小块空处；有明显积水就先让水汽收一收。把碗里的醋汁再搅一下，沿这块热锅面烹入，翻匀约十五秒，趁菜帮还有脆劲就盛出。&quot;],&quot;completionCue&quot;:[0,&quot;能闻到醋香，叶子软软地贴着菜帮，盘里只有薄薄一层汁。&quot;],&quot;ingredientIds&quot;:[1,[[0,&quot;hot-and-sour-napa-cabbage-napa&quot;],[0,&quot;hot-and-sour-napa-cabbage-vinegar&quot;],[0,&quot;hot-and-sour-napa-cabbage-sugar&quot;],[0,&quot;hot-and-sour-napa-cabbage-salt&quot;]]],&quot;techniqueLinks&quot;:[0],&quot;minutes&quot;:[1,[[0,1],[0,3]]],&quot;images&quot;:[1,[[0,{&quot;url&quot;:[0,&quot;/images/recipes/hot-and-sour-napa-cabbage--finish-1200.webp&quot;],&quot;thumbnailUrl&quot;:[0,&quot;/images/recipes/hot-and-sour-napa-cabbage--finish-600.webp&quot;],&quot;alt&quot;:[0,&quot;宽平底锅里，刚下的嫩叶覆在已炒亮的菜帮上&quot;],&quot;width&quot;:[0,1200],&quot;height&quot;:[0,800]}]]]}]]],&quot;safetyNotes&quot;:[1,[]],&quot;allergens&quot;:[1,[[0,&quot;小麦&quot;]]]}],&quot;locale&quot;:[0,&quot;zh&quot;],&quot;shareUrl&quot;:[0,&quot;https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/?via=recipe-share&quot;],&quot;cooklangUrl&quot;:[0]}" ssr client="load" opts="{&quot;name&quot;:&quot;RecipeExperience&quot;,&quot;value&quot;:true}" await-children><div class="launch-recipe"><section class="recipe-session-controls launch-controls no-print" aria-label="开始烹饪"><div><p class="eyebrow">2 人份配菜</p><h2>准备好了吗？一起开始。</h2></div><button class="primary" type="button" disabled>开始烹饪模式 →</button><div class="launch-secondary-controls"><a href="#preparation">查看食材</a><a href="#steps">查看步骤</a><button type="button">打印菜谱</button><details class="share-disclosure"><summary>分享菜谱</summary><label class="share-manual">复制菜谱链接<input type="url" readonly value="https://chineserecipes.xyz/zh/recipes/hot-and-sour-napa-cabbage/?via=recipe-share" data-recipe-share-url="true"/></label></details><div class="select-field"><label id="unit-select-label" for="unit-select">用量单位</label><select id="unit-select"><option selected value="metric">公制 · 克 / 毫升</option><option value="us">美制量杯、量勺与盎司</option></select></div></div></section><div id="preparation"><section class="complete-preparation panel" data-testid="preparation-inventory" aria-labelledby="complete-preparation-title"><p class="eyebrow">动手前，一次备齐</p><h2 id="complete-preparation-title">完整备料清单</h2><p class="small muted">2 人份配菜</p><div class="preparation-table-wrap"><table class="preparation-table"><thead><tr><th>原料</th><th>用量</th><th>备料</th></tr></thead><tbody><tr data-testid="preparation-line" data-ingredient-id="napa-cabbage" data-ingredient-line-id="hot-and-sour-napa-cabbage-napa"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/zh/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">大白菜</a></span></th><td data-label="用量">340 克</td><td data-label="备料">切去根部，取净菜 340 克。白色厚帮和卷曲的嫩叶都用。</td></tr><tr data-testid="preparation-line" data-ingredient-id="garlic" data-ingredient-line-id="hot-and-sour-napa-cabbage-garlic"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="garlic" href="/zh/wiki/browse/vegetables/page/3/#concept-garlic" aria-haspopup="dialog" aria-expanded="false">蒜</a></span></th><td data-label="用量">7 克</td><td data-label="备料">约两瓣，去皮切薄片。</td></tr><tr data-testid="preparation-line" data-ingredient-id="dried-chili" data-ingredient-line-id="hot-and-sour-napa-cabbage-chile"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="dried-chili" href="/zh/wiki/browse/seasonings/page/2/#concept-dried-chili" aria-haspopup="dialog" aria-expanded="false">干辣椒</a></span></th><td data-label="用量">1 克</td><td data-label="备料">取 1 克辣味较轻的干红辣椒，如华人超市的二荆条，掰成小段，抖去散籽。</td></tr><tr data-testid="preparation-line" data-ingredient-id="neutral-oil" data-ingredient-line-id="hot-and-sour-napa-cabbage-oil"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="neutral-oil" href="/zh/wiki/browse/oils/#concept-neutral-oil" aria-haspopup="dialog" aria-expanded="false">食用油</a></span></th><td data-label="用量">15 毫升</td><td data-label="备料">一汤匙菜籽油或其他味道清淡的炒菜油。</td></tr><tr data-testid="preparation-line" data-ingredient-id="black-vinegar" data-ingredient-line-id="hot-and-sour-napa-cabbage-vinegar"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="black-vinegar" href="/zh/wiki/browse/seasonings/#concept-black-vinegar" aria-haspopup="dialog" aria-expanded="false">香醋</a></span></th><td data-label="用量">15 毫升</td><td data-label="备料">一汤匙金梅牌镇江香醋，这款醋含麦麸。想吃清爽些也可以用无糖原味<span class="concept-term"><a class="concept-trigger" data-concept-id="rice-vinegar" href="/zh/wiki/browse/seasonings/page/3/#concept-rice-vinegar" aria-haspopup="dialog" aria-expanded="false">米醋</a></span>。<small><a href="/zh/learn/black-vinegar/">镇江香醋怎么买，原味米醋怎么用？</a></small></td></tr><tr data-testid="preparation-line" data-ingredient-id="sugar" data-ingredient-line-id="hot-and-sour-napa-cabbage-sugar"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="sugar" href="/zh/wiki/browse/seasonings/page/3/#concept-sugar" aria-haspopup="dialog" aria-expanded="false">白糖</a></span></th><td data-label="用量">2 克</td><td data-label="备料">约半茶匙白砂糖。</td></tr><tr data-testid="preparation-line" data-ingredient-id="salt" data-ingredient-line-id="hot-and-sour-napa-cabbage-salt"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="salt" href="/zh/wiki/browse/seasonings/page/3/#concept-salt" aria-haspopup="dialog" aria-expanded="false">盐</a></span></th><td data-label="用量">1.5 克</td><td data-label="备料">约四分之一茶匙细盐。</td></tr></tbody></table></div></section></div><section class="recipe-shopping" aria-labelledby="shopping-heading"><h2 id="shopping-heading">在美国买材料与替换</h2><p>按所在地查询门店或配送范围；替换后的口感与营养可能不同。</p><details><summary>干辣椒 <span class="small muted">— 亚洲超市辣椒香料区或蔬菜区</span></summary><p>核对辣椒品种、辣度、肉厚和鲜干形态。小米辣、墨西哥青椒、甜椒、干辣椒不能只按颜色或等克重互换。</p><p><a href="https://www.99ranch.com/" target="_blank" rel="noopener noreferrer">大华超级市场 ↗</a> · <a href="https://www.sayweee.com/en" target="_blank" rel="noopener noreferrer">亚洲线上超市 ↗</a></p></details><details><summary>食用油 <span class="small muted">— 食用油货架</span></summary><p>原味菜籽油气味淡，适合煎烙。选瓶装液体油，方便用茶匙量取。</p><p><a href="https://www.walmart.com/browse/food/shop-all-cooking-oils-vinegars/976759_976794_4649724_4110919" target="_blank" rel="noopener noreferrer">沃尔玛 ↗</a> · <a href="https://www.kroger.com/p/kroger-pure-canola-oil/0001111085634" target="_blank" rel="noopener noreferrer">克罗格超市 ↗</a></p><p><strong>精炼低芥酸菜籽油：</strong>可按相同量使用精炼、淡味食用油；不适用于香油或风味强烈的油。</p><p><strong>精炼玉米油：</strong>可按相同量使用精炼、淡味食用油；不适用于香油或风味强烈的油。</p><p><strong>精炼大豆油：</strong>可按相同量使用精炼、淡味食用油；不适用于香油或风味强烈的油。</p></details><details><summary>香醋 <span class="small muted">— 亚洲超市酱料区</span></summary><p>选镇江风格香醋；意大利甜醋、调味寿司醋的甜度与香气不同。</p><p><a href="https://www.99ranch.com/" target="_blank" rel="noopener noreferrer">大华超级市场 ↗</a> · <a href="https://www.sayweee.com/en" target="_blank" rel="noopener noreferrer">亚洲线上超市 ↗</a> · <a href="https://www.kroger.com/p/gold-plum-chinkiang-vinegar/0002845720500" target="_blank" rel="noopener noreferrer">克罗格超市 ↗</a></p><p><strong>米醋：</strong>340 克白菜换一汤匙（15 毫升）无糖原味米醋。菜叶刚塌软就沿热锅边烹入，酸味更清亮，菜色也浅。</p></details></section><section class="launch-equipment" id="equipment"><h2>需要的厨具</h2><ul><li><strong><span class="concept-term"><a class="concept-trigger" data-concept-id="mixing-bowls" href="/zh/wiki/browse/equipment/#concept-mixing-bowls" aria-haspopup="dialog" aria-expanded="false">独立备料碗</a></span></strong> — 用一只小碗或杯子搅匀醋、<span class="concept-term"><a class="concept-trigger" data-concept-id="salt" href="/zh/wiki/browse/seasonings/page/3/#concept-salt" aria-haspopup="dialog" aria-expanded="false">盐</a></span>和糖。</li><li><strong><span class="concept-term"><a class="concept-trigger" data-concept-id="knife-board" href="/zh/wiki/browse/equipment/#concept-knife-board" aria-haspopup="dialog" aria-expanded="false">刀与砧板</a></span></strong> — 用案板和利刀斜切厚菜帮。</li><li><strong><span class="concept-term"><a class="concept-trigger" data-concept-id="skillet-stainless-12" href="/zh/wiki/browse/equipment/#concept-skillet-stainless-12" aria-haspopup="dialog" aria-expanded="false">12 英寸不锈钢平底锅</a></span></strong> — 约 30 厘米的平底锅或宽口炒锅，菜帮能摊开即可。</li><li><strong><span class="concept-term"><a class="concept-trigger" data-concept-id="spatula" href="/zh/wiki/browse/equipment/#concept-spatula" aria-haspopup="dialog" aria-expanded="false">不刮涂层锅铲</a></span></strong> — 用宽锅铲把帮和叶翻匀。</li></ul></section><p class="allergen-line"><strong>过敏原：</strong>小麦</p><section id="steps" class="launch-method" data-pagefind-body="true"><h2>一步一步做</h2><ol class="steps"><li class="step" id="step-hot-and-sour-napa-cabbage-cut" data-testid="step"><p class="eyebrow">准备 · 7–9 分钟</p><h3>菜帮斜切，菜叶撕大块</h3><p class="step-uses"><strong>这一步用到：</strong><span><span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/zh/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">大白菜</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="garlic" href="/zh/wiki/browse/vegetables/page/3/#concept-garlic" aria-haspopup="dialog" aria-expanded="false">蒜</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="dried-chili" href="/zh/wiki/browse/seasonings/page/2/#concept-dried-chili" aria-haspopup="dialog" aria-expanded="false">干辣椒</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="black-vinegar" href="/zh/wiki/browse/seasonings/#concept-black-vinegar" aria-haspopup="dialog" aria-expanded="false">香醋</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="sugar" href="/zh/wiki/browse/seasonings/page/3/#concept-sugar" aria-haspopup="dialog" aria-expanded="false">白糖</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="salt" href="/zh/wiki/browse/seasonings/page/3/#concept-salt" aria-haspopup="dialog" aria-expanded="false">盐</a></span></span></p><p>白菜洗净擦干，把白色厚帮和叶子分开。菜帮平放，斜刀切成约半厘米厚的片；菜叶撕成约五厘米的块，与菜帮分开放。<span class="concept-term"><a class="concept-trigger" data-concept-id="garlic" href="/zh/wiki/browse/vegetables/page/3/#concept-garlic" aria-haspopup="dialog" aria-expanded="false">蒜</a></span>切片，辣椒掰小段。把糖和<span class="concept-term"><a class="concept-trigger" data-concept-id="salt" href="/zh/wiki/browse/seasonings/page/3/#concept-salt" aria-haspopup="dialog" aria-expanded="false">盐</a></span>放进<span class="concept-term"><a class="concept-trigger" data-concept-id="black-vinegar" href="/zh/wiki/browse/seasonings/#concept-black-vinegar" aria-haspopup="dialog" aria-expanded="false">香醋</a></span>里搅匀。</p><p class="step-techniques"><a href="/zh/learn/how-to-cut-napa-cabbage/">做这道菜，白菜帮和叶子要怎么切？</a></p><p class="step-techniques"><a href="/zh/collections/chinese-cabbage-recipes/">买的是圆包菜？按手里的菜选做法</a></p><figure class="step-diagram"><img src="/images/recipes/hot-and-sour-napa-cabbage--cut-1200.webp" srcset="/images/recipes/hot-and-sour-napa-cabbage--cut-600.webp 600w, /images/recipes/hot-and-sour-napa-cabbage--cut-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 800px" alt="案板上一片完整白菜叶，旁边分开放着斜切的白色菜帮和撕开的嫩叶" width="1200" height="800" loading="lazy" decoding="async"/></figure><p class="step-endpoint"><strong>完成状态：</strong>菜帮切面宽、边缘薄，叶子提起来不滴水。</p><div class="timer"><output aria-label="剩余时间" aria-live="off">7:00</output><button type="button">开始计时</button><button type="button">重置</button></div></li><li class="step" id="step-hot-and-sour-napa-cabbage-pan" data-testid="step"><p class="eyebrow">烹饪 · 2–4 分钟</p><h3>先煸香料，再炒菜帮</h3><p class="step-uses"><strong>这一步用到：</strong><span><span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/zh/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">大白菜</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="garlic" href="/zh/wiki/browse/vegetables/page/3/#concept-garlic" aria-haspopup="dialog" aria-expanded="false">蒜</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="dried-chili" href="/zh/wiki/browse/seasonings/page/2/#concept-dried-chili" aria-haspopup="dialog" aria-expanded="false">干辣椒</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="neutral-oil" href="/zh/wiki/browse/oils/#concept-neutral-oil" aria-haspopup="dialog" aria-expanded="false">食用油</a></span></span></p><p>油、<span class="concept-term"><a class="concept-trigger" data-concept-id="dried-chili" href="/zh/wiki/browse/seasonings/page/2/#concept-dried-chili" aria-haspopup="dialog" aria-expanded="false">干辣椒</a></span>段和<span class="concept-term"><a class="concept-trigger" data-concept-id="garlic" href="/zh/wiki/browse/vegetables/page/3/#concept-garlic" aria-haspopup="dialog" aria-expanded="false">蒜</a></span>片一起入锅，中火加热。蒜片滋滋作响、香气出来就倒入白菜帮，转中大火摊开，翻炒约两分钟。蒜片若上色太快，就铲到菜帮上。</p><p class="step-techniques">用到的技法 · <span><span class="concept-term"><a class="concept-trigger" data-concept-id="aromatic-oil" href="/zh/wiki/browse/technique/#concept-aromatic-oil" aria-haspopup="dialog" aria-expanded="false">用油激香</a></span></span></p><p class="step-endpoint"><strong>完成状态：</strong>菜帮的薄边略透明，用铲子轻压，中间仍挺实。</p><div class="timer"><output aria-label="剩余时间" aria-live="off">2:00</output><button type="button">开始计时</button><button type="button">重置</button></div></li><li class="step" id="step-hot-and-sour-napa-cabbage-finish" data-testid="step"><p class="eyebrow">烹饪 · 1–3 分钟</p><h3>菜叶刚塌就沿锅边烹醋</h3><p class="step-uses"><strong>这一步用到：</strong><span><span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/zh/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">大白菜</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="black-vinegar" href="/zh/wiki/browse/seasonings/#concept-black-vinegar" aria-haspopup="dialog" aria-expanded="false">香醋</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="sugar" href="/zh/wiki/browse/seasonings/page/3/#concept-sugar" aria-haspopup="dialog" aria-expanded="false">白糖</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="salt" href="/zh/wiki/browse/seasonings/page/3/#concept-salt" aria-haspopup="dialog" aria-expanded="false">盐</a></span></span></p><p>倒入菜叶，把菜帮从下面翻上来，炒一两分钟。叶子刚塌软就在锅边拨出一小块空处；有明显积水就先让水汽收一收。把碗里的醋汁再搅一下，沿这块热锅面烹入，翻匀约十五秒，趁菜帮还有脆劲就盛出。</p><p class="step-techniques"><a href="/zh/learn/black-vinegar/">只有原味米醋，这一步放多少？</a></p><figure class="step-diagram"><img src="/images/recipes/hot-and-sour-napa-cabbage--finish-1200.webp" srcset="/images/recipes/hot-and-sour-napa-cabbage--finish-600.webp 600w, /images/recipes/hot-and-sour-napa-cabbage--finish-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 800px" alt="宽平底锅里，刚下的嫩叶覆在已炒亮的菜帮上" width="1200" height="800" loading="lazy" decoding="async"/></figure><p class="step-endpoint"><strong>完成状态：</strong>能闻到醋香，叶子软软地贴着菜帮，盘里只有薄薄一层汁。</p><div class="timer"><output aria-label="剩余时间" aria-live="off">1:00</output><button type="button">开始计时</button><button type="button">重置</button></div></li></ol></section></div><!--astro:end--></astro-island><section id="nutrition" class="nutrition-panel panel content-section" data-testid="nutrition-panel"><h2>每份约</h2><dl class="nutrition-grid"><div><dt>热量</dt><dd>102 <span>千卡</span></dd></div><div><dt>蛋白质</dt><dd>2.8 <span>克</span></dd></div><div><dt>脂肪</dt><dd>7.4 <span>克</span></dd></div><div><dt>碳水化合物</dt><dd>8.5 <span>克</span></dd></div><div><dt>钠</dt><dd>362 <span>毫克</span></dd></div><div><dt>膳食纤维</dt><dd>2.3 <span>克</span></dd></div></dl><p class="small muted">每份估算，不含配餐</p></section><span data-ad-opportunity="recipe-end" class="ad-opportunity no-print" aria-hidden="true" data-pagefind-ignore="all" data-astro-cid-ygkiugat></span><section class="content-section no-print"><div class="section-head"><h2>下一道想做什么？</h2><a href="/zh/recipes/">全部菜谱 →</a></div><div class="recipe-grid"><article class="recipe-card"><a class="card-image" href="/zh/recipes/napa-sesame-salad/" tabindex="-1" aria-hidden="true"><img src="/images/recipes/napa-sesame-salad--hero-600.webp" srcset="/images/recipes/responsive/napa-sesame-salad-240.webp 240w, /images/recipes/responsive/napa-sesame-salad-400.webp 400w, /images/recipes/napa-sesame-salad--hero-600.webp 600w, /images/recipes/responsive/napa-sesame-salad-800.webp 800w, /images/recipes/napa-sesame-salad--hero-1200.webp 1200w" sizes="auto, (max-width: 460px) 112px, (max-width: 760px) calc(50vw - 1.8rem), (max-width: 1264px) 31vw, 380px" alt width="1200" height="800" loading="lazy"/></a><div><p class="card-meta">10 分钟</p><h3><a href="/zh/recipes/napa-sesame-salad/">乾隆白菜</a></h3><p>一道不用开火的北京风味凉菜：手撕白菜嫩心，淋上以香醋澥开的芝麻酱汁，加少许糖调味，最后点香油、撒熟芝麻。</p></div></article><article class="recipe-card"><a class="card-image" href="/zh/recipes/napa-cabbage-tofu-soup/" tabindex="-1" aria-hidden="true"><img src="/images/recipes/napa-cabbage-tofu-soup--hero-600.webp" srcset="/images/recipes/responsive/napa-cabbage-tofu-soup-240.webp 240w, /images/recipes/responsive/napa-cabbage-tofu-soup-400.webp 400w, /images/recipes/napa-cabbage-tofu-soup--hero-600.webp 600w, /images/recipes/responsive/napa-cabbage-tofu-soup-800.webp 800w, /images/recipes/napa-cabbage-tofu-soup--hero-1200.webp 1200w" sizes="auto, (max-width: 460px) 112px, (max-width: 760px) calc(50vw - 1.8rem), (max-width: 1264px) 31vw, 380px" alt width="1200" height="800" loading="lazy"/></a><div><p class="card-meta">24 分钟</p><h3><a href="/zh/recipes/napa-cabbage-tofu-soup/">香菇白菜豆腐汤</a></h3><p>先煸香鲜香菇、姜丝和葱白，再添清水做汤底。白菜帮先煮软，叶子和豆腐最后下，两碗清汤鲜甜，豆腐也完整。</p></div></article><article class="recipe-card"><a class="card-image" href="/zh/recipes/ground-beef-fried-rice/" tabindex="-1" aria-hidden="true"><img src="/images/recipes/ground-beef-fried-rice--hero-600.webp" srcset="/images/recipes/responsive/ground-beef-fried-rice-240.webp 240w, /images/recipes/responsive/ground-beef-fried-rice-400.webp 400w, /images/recipes/ground-beef-fried-rice--hero-600.webp 600w, /images/recipes/responsive/ground-beef-fried-rice-800.webp 800w, /images/recipes/ground-beef-fried-rice--hero-1200.webp 1200w" sizes="auto, (max-width: 460px) 112px, (max-width: 760px) calc(50vw - 1.8rem), (max-width: 1264px) 31vw, 380px" alt width="1200" height="800" loading="lazy"/></a><div><p class="card-meta">23 分钟</p><h3><a href="/zh/recipes/ground-beef-fried-rice/">白菜牛肉末炒饭</a></h3><p>先把牛肉末煸出焦香，再炒干白菜丝渗出的水。这样下锅的冷饭容易炒散，舀起一勺，饭粒间有肉末、蛋花和嫩白菜。</p></div></article></div><p><a href="/zh/collections/chinese-cabbage-recipes/">包菜和大白菜怎么做？按手里这颗菜选做法 →</a></p></section></main><footer class="site-footer" data-pagefind-ignore="all" data-astro-cid-tq46r5sz><div data-astro-cid-tq46r5sz><a class="footer-brand" href="/zh/" data-astro-cid-tq46r5sz>中餐厨房图鉴</a><p data-astro-cid-tq46r5sz>学一点，做一点。<br data-astro-cid-tq46r5sz>下厨更有把握。</p></div><nav aria-label="浏览" data-astro-cid-tq46r5sz><strong data-astro-cid-tq46r5sz>动手做顿好饭</strong><a href="/zh/recipes/" data-astro-cid-tq46r5sz>全部菜谱</a><a href="/zh/wiki/" data-astro-cid-tq46r5sz>厨房百科</a><a href="/zh/learn/" data-astro-cid-tq46r5sz>厨房课堂</a><a href="/zh/cook-with-what-you-have/" data-astro-cid-tq46r5sz>找一道菜</a><a href="/zh/feed.xml" data-astro-cid-tq46r5sz>订阅新菜谱</a></nav><nav aria-label="关于本站" data-astro-cid-tq46r5sz><strong data-astro-cid-tq46r5sz>我们的做法</strong><a href="/zh/about/" data-astro-cid-tq46r5sz>关于</a><a href="/zh/editorial-policy/" data-astro-cid-tq46r5sz>内容原则</a><a href="/zh/contact/" data-astro-cid-tq46r5sz>联系我们</a></nav><nav aria-label="网站政策" data-astro-cid-tq46r5sz><strong data-astro-cid-tq46r5sz>详细说明</strong><a href="/zh/privacy/" data-astro-cid-tq46r5sz>隐私</a><a href="/zh/terms/" data-astro-cid-tq46r5sz>使用条款</a><button type="button" class="analytics-settings no-print" data-analytics-settings hidden data-astro-cid-tq46r5sz>统计隐私设置</button></nav></footer><section id="analytics-consent" class="analytics-consent no-print" hidden role="region" aria-label="可选统计设置" tabindex="-1" data-pagefind-ignore="all" data-astro-cid-fg2vtww3><div class="analytics-consent-heading" data-astro-cid-fg2vtww3><h2 data-astro-cid-fg2vtww3>帮助我们改进菜谱与工具</h2><button type="button" data-analytics-close hidden aria-label="关闭统计设置" data-astro-cid-fg2vtww3>关闭</button></div><p data-astro-cid-fg2vtww3>可选统计帮助我们了解哪些菜谱和工具有用。允许后会使用谷歌分析；你的食材选择和搜索内容不会发送。你可以随时更改选择。 <a href="/zh/privacy/" data-astro-cid-fg2vtww3>隐私政策</a></p><div class="analytics-consent-actions" data-astro-cid-fg2vtww3><button type="button" data-analytics-choice="denied" data-astro-cid-fg2vtww3>拒绝</button><button type="button" data-analytics-choice="granted" data-astro-cid-fg2vtww3>允许统计</button></div></section><div id="analytics-config" hidden data-measurement-id="G-8FMJ92K4KT" data-production-host="chineserecipes.xyz" data-astro-cid-tq46r5sz></div><script type="module" src="/_astro/SiteLayout.astro_astro_type_script_index_0_lang.BbPup7NC.js"></script><script type="module">document.querySelectorAll(`a[href^="#"]`).forEach(e=>e.addEventListener(`click`,()=>{let t=e.hash;document.getElementById(decodeURIComponent(t.slice(1)))?.closest(`details`)?.setAttribute(`open`,``)}));</script></body></html>