quot;napa-cabbage-tofu-soup-scallion&quot;]]],&quot;techniqueLinks&quot;:[0],&quot;minutes&quot;:[1,[[0,7],[0,9]]],&quot;images&quot;:[1,[[0,{&quot;url&quot;:[0,&quot;/images/recipes/napa-cabbage-tofu-soup--cut-1200.webp&quot;],&quot;thumbnailUrl&quot;:[0,&quot;/images/recipes/napa-cabbage-tofu-soup--cut-600.webp&quot;],&quot;alt&quot;:[0,&quot;Tofu cubes and sliced shiitakes beside separate piles of napa ribs and leaves&quot;],&quot;width&quot;:[0,1200],&quot;height&quot;:[0,800]}]]]}],[0,{&quot;id&quot;:[0,&quot;napa-cabbage-tofu-soup-simmer&quot;],&quot;phase&quot;:[0,&quot;cook&quot;],&quot;title&quot;:[0,&quot;Brown the mushrooms and simmer the ribs&quot;],&quot;instruction&quot;:[0,&quot;Warm the oil in a soup pot over medium heat. Spread the mushrooms over the bottom and cook for about 3 minutes, turning once. Stir in the ginger and scallion whites for 30 seconds. Pour in the water, loosen any browned bits with a spoon and bring to a boil. Add the salt and cabbage ribs. Lower to a steady simmer for 4 minutes.&quot;],&quot;completionCue&quot;:[0,&quot;The mushroom slices have browned edges and the cabbage ribs are becoming translucent at the edges.&quot;],&quot;ingredientIds&quot;:[1,[[0,&quot;napa-cabbage-tofu-soup-oil&quot;],[0,&quot;napa-cabbage-tofu-soup-shiitake&quot;],[0,&quot;napa-cabbage-tofu-soup-ginger&quot;],[0,&quot;napa-cabbage-tofu-soup-scallion&quot;],[0,&quot;napa-cabbage-tofu-soup-water&quot;],[0,&quot;napa-cabbage-tofu-soup-salt&quot;],[0,&quot;napa-cabbage-tofu-soup-napa&quot;]]],&quot;techniqueLinks&quot;:[0],&quot;minutes&quot;:[1,[[0,11],[0,14]]],&quot;images&quot;:[1,[]]}],[0,{&quot;id&quot;:[0,&quot;napa-cabbage-tofu-soup-finish&quot;],&quot;phase&quot;:[0,&quot;cook&quot;],&quot;title&quot;:[0,&quot;Ease in the leaves and tofu&quot;],&quot;instruction&quot;:[0,&quot;Lay the cabbage leaves on the broth and press them under gently. Slide the tofu cubes into the pot on a wide spoon. Keep the liquid barely bubbling for about 3–4 minutes. Ladle into two bowls and scatter the scallion greens on top.&quot;],&quot;completionCue&quot;:[0,&quot;The leaves drape over the spoon, the thickest rib bends easily and the hot tofu cubes hold their shape.&quot;],&quot;ingredientIds&quot;:[1,[[0,&quot;napa-cabbage-tofu-soup-napa&quot;],[0,&quot;napa-cabbage-tofu-soup-tofu&quot;],[0,&quot;napa-cabbage-tofu-soup-scallion&quot;]]],&quot;techniqueLinks&quot;:[0],&quot;minutes&quot;:[1,[[0,3],[0,4]]],&quot;images&quot;:[1,[[0,{&quot;url&quot;:[0,&quot;/images/recipes/napa-cabbage-tofu-soup--finish-1200.webp&quot;],&quot;thumbnailUrl&quot;:[0,&quot;/images/recipes/napa-cabbage-tofu-soup--finish-600.webp&quot;],&quot;alt&quot;:[0,&quot;A ladle lowers intact tofu cubes into the barely simmering cabbage and mushroom broth&quot;],&quot;width&quot;:[0,1200],&quot;height&quot;:[0,800]}]]]}]]],&quot;safetyNotes&quot;:[1,[]],&quot;allergens&quot;:[1,[[0,&quot;soy&quot;]]]}],&quot;locale&quot;:[0,&quot;en&quot;],&quot;shareUrl&quot;:[0,&quot;https://chineserecipes.xyz/recipes/napa-cabbage-tofu-soup/?via=recipe-share&quot;],&quot;cooklangUrl&quot;:[0]}" ssr client="load" opts="{&quot;name&quot;:&quot;RecipeExperience&quot;,&quot;value&quot;:true}" await-children><div class="launch-recipe"><section class="recipe-session-controls launch-controls no-print" aria-label="Start cooking"><div><p class="eyebrow">2 generous soup bowls</p><h2>Ready? Let’s cook.</h2></div><button class="primary" type="button" disabled>Start cooking mode →</button><div class="launch-secondary-controls"><a href="#preparation">Ingredients</a><a href="#steps">Method</a><button type="button">Print recipe</button><details class="share-disclosure"><summary>Share recipe</summary><label class="share-manual">Copy this recipe link<input type="url" readonly value="https://chineserecipes.xyz/recipes/napa-cabbage-tofu-soup/?via=recipe-share" data-recipe-share-url="true"/></label></details><div class="select-field"><label id="unit-select-label" for="unit-select">Measurements</label><select id="unit-select"><option selected value="metric">Metric · g / mL</option><option value="us">US cups, spoons &amp; ounces</option></select></div></div></section><div id="preparation"><section class="complete-preparation panel" data-testid="preparation-inventory" aria-labelledby="complete-preparation-title"><p class="eyebrow">Before you begin</p><h2 id="complete-preparation-title">Complete preparation list</h2><p class="small muted">2 generous soup bowls</p><div class="preparation-table-wrap"><table class="preparation-table"><thead><tr><th>Ingredient</th><th>Amount</th><th>Prep</th></tr></thead><tbody><tr data-testid="preparation-line" data-ingredient-id="napa-cabbage" data-ingredient-line-id="napa-cabbage-tofu-soup-napa"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">Napa cabbage</a></span></th><td data-label="Amount">250 g</td><td data-label="Prep">Use about 9 oz after trimming. Keep the thick white ribs and crinkled leaves.</td></tr><tr data-testid="preparation-line" data-ingredient-id="firm-tofu" data-ingredient-line-id="napa-cabbage-tofu-soup-tofu"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="firm-tofu" href="/wiki/browse/tofu-soy/#concept-firm-tofu" aria-haspopup="dialog" aria-expanded="false">Firm tofu</a></span></th><td data-label="Amount">225 g</td><td data-label="Prep">Drain half a 16 oz block of plain firm tofu. House Foods Premium Firm lists water, <span class="concept-term"><a class="concept-trigger" data-concept-id="soybean" href="/wiki/browse/tofu-soy/#concept-soybean" aria-haspopup="dialog" aria-expanded="false">soybeans</a></span> and calcium sulfate and carries a gluten-free label.</td></tr><tr data-testid="preparation-line" data-ingredient-id="shiitake" data-ingredient-line-id="napa-cabbage-tofu-soup-shiitake"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="shiitake" href="/wiki/browse/mushrooms/#concept-shiitake" aria-haspopup="dialog" aria-expanded="false">Shiitake mushrooms</a></span></th><td data-label="Amount">85 g</td><td data-label="Prep">3 oz fresh shiitake caps after removing the woody stems. Look near the fresh mushrooms in the produce aisle.</td></tr><tr data-testid="preparation-line" data-ingredient-id="ginger" data-ingredient-line-id="napa-cabbage-tofu-soup-ginger"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="ginger" href="/wiki/browse/vegetables/page/3/#concept-ginger" aria-haspopup="dialog" aria-expanded="false">Fresh ginger</a></span></th><td data-label="Amount">6 g</td><td data-label="Prep">Peel a small knob and cut into fine matchsticks.</td></tr><tr data-testid="preparation-line" data-ingredient-id="scallion" data-ingredient-line-id="napa-cabbage-tofu-soup-scallion"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="scallion" href="/wiki/browse/vegetables/page/5/#concept-scallion" aria-haspopup="dialog" aria-expanded="false">Scallion</a></span></th><td data-label="Amount">8 g</td><td data-label="Prep">One small scallion, thinly sliced. Keep the white and green parts separate.</td></tr><tr data-testid="preparation-line" data-ingredient-id="neutral-oil" data-ingredient-line-id="napa-cabbage-tofu-soup-oil"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="neutral-oil" href="/wiki/browse/oils/#concept-neutral-oil" aria-haspopup="dialog" aria-expanded="false">Neutral cooking oil</a></span></th><td data-label="Amount">5 mL</td><td data-label="Prep">1 teaspoon plain canola oil.</td></tr><tr data-testid="preparation-line" data-ingredient-id="water" data-ingredient-line-id="napa-cabbage-tofu-soup-water"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="water" href="/wiki/browse/oils/#concept-water" aria-haspopup="dialog" aria-expanded="false">Water</a></span></th><td data-label="Amount">700 mL</td><td data-label="Prep">About 3 US cups drinking water for the soup.</td></tr><tr data-testid="preparation-line" data-ingredient-id="salt" data-ingredient-line-id="napa-cabbage-tofu-soup-salt"><th scope="row"><span class="concept-term"><a class="concept-trigger" data-concept-id="salt" href="/wiki/browse/seasonings/page/3/#concept-salt" aria-haspopup="dialog" aria-expanded="false">Fine salt</a></span></th><td data-label="Amount">2.5 g</td><td data-label="Prep">Fine table salt for the broth.</td></tr></tbody></table></div></section></div><section class="recipe-shopping" aria-labelledby="shopping-heading"><h2 id="shopping-heading">US shopping &amp; substitutions</h2><p>Check local stores or delivery coverage. Substitutions can change texture and nutrition.</p><details><summary>Firm tofu <span class="small muted">— Refrigerated produce/tofu case; some silken tofu is shelf-stable</span></summary><p>Buy a plain, water-packed block in the refrigerated tofu case. For the gluten-free version shown here, choose a pack labeled gluten-free. Check marinated or baked tofu separately as the seasoning can contain wheat.</p><p><a href="https://www.walmart.com/cp/food/976759" target="_blank" rel="noopener noreferrer">Walmart ↗</a> · <a href="https://www.kroger.com/p/house-foods-firm-premium-tofu/0007637101116" target="_blank" rel="noopener noreferrer">Kroger ↗</a></p></details><details><summary>Shiitake mushrooms <span class="small muted">— Fresh mushroom case; Asian produce section</span></summary><p>Buy fresh shiitake in the recipe’s fresh weight. Dried shiitake requires a different quantity and soaking step.</p><p><a href="https://www.99ranch.com/" target="_blank" rel="noopener noreferrer">99 Ranch Market ↗</a> · <a href="https://www.sayweee.com/en" target="_blank" rel="noopener noreferrer">Weee! ↗</a></p></details><details><summary>Neutral cooking oil <span class="small muted">— Cooking oils aisle</span></summary><p>Plain canola oil has a mild flavor and works for pan-frying. Buy a bottle of liquid oil so you can measure it by the teaspoon.</p><p><a href="https://www.walmart.com/browse/food/shop-all-cooking-oils-vinegars/976759_976794_4649724_4110919" target="_blank" rel="noopener noreferrer">Walmart ↗</a> · <a href="https://www.kroger.com/p/kroger-pure-canola-oil/0001111085634" target="_blank" rel="noopener noreferrer">Kroger ↗</a></p><p><strong>Refined canola oil: </strong>Use the same measured volume of refined, neutral-flavored cooking oil. This does not apply to toasted sesame or strongly flavored oils.</p><p><strong>Refined corn oil: </strong>Use the same measured volume of refined, neutral-flavored cooking oil. This does not apply to toasted sesame or strongly flavored oils.</p><p><strong>Refined soybean oil: </strong>Use the same measured volume of refined, neutral-flavored cooking oil. This does not apply to toasted sesame or strongly flavored oils.</p></details></section><section class="launch-equipment" id="equipment"><h2>Equipment</h2><ul><li><strong><span class="concept-term"><a class="concept-trigger" data-concept-id="knife-board" href="/wiki/browse/equipment/#concept-knife-board" aria-haspopup="dialog" aria-expanded="false">Knife and cutting board</a></span></strong> — A knife and board for the <span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">cabbage</a></span>, mushrooms and tofu.</li><li><strong><span class="concept-term"><a class="concept-trigger" data-concept-id="pot-lid" href="/wiki/browse/equipment/#concept-pot-lid" aria-haspopup="dialog" aria-expanded="false">Covered pot</a></span></strong> — A 3-quart saucepan or soup pot. Simmer uncovered.</li><li><strong><span class="concept-term"><a class="concept-trigger" data-concept-id="spatula" href="/wiki/browse/equipment/#concept-spatula" aria-haspopup="dialog" aria-expanded="false">Non-scratching spatula</a></span></strong> — A wide cooking spoon or ladle to lower the tofu and serve the soup.</li></ul></section><p class="allergen-line"><strong>Allergens: </strong>soy</p><section id="steps" class="launch-method" data-pagefind-body="true"><h2>The method</h2><ol class="steps"><li class="step" id="step-napa-cabbage-tofu-soup-cut" data-testid="step"><p class="eyebrow">Prepare · 7–9 min</p><h3>Separate the <span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">cabbage</a></span> and cube the tofu</h3><p class="step-uses"><strong>Use now: </strong><span><span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">Napa cabbage</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="firm-tofu" href="/wiki/browse/tofu-soy/#concept-firm-tofu" aria-haspopup="dialog" aria-expanded="false">Firm tofu</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="shiitake" href="/wiki/browse/mushrooms/#concept-shiitake" aria-haspopup="dialog" aria-expanded="false">Shiitake mushrooms</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="ginger" href="/wiki/browse/vegetables/page/3/#concept-ginger" aria-haspopup="dialog" aria-expanded="false">Fresh ginger</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="scallion" href="/wiki/browse/vegetables/page/5/#concept-scallion" aria-haspopup="dialog" aria-expanded="false">Scallion</a></span></span></p><p>Wash the <span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">cabbage</a></span>, then cut the white ribs crosswise into 1-inch pieces. Tear the leaves into slightly larger pieces. Slice the mushroom caps thinly. Cut the drained tofu into ¾-inch cubes. Set the ginger and <span class="concept-term"><a class="concept-trigger" data-concept-id="scallion" href="/wiki/browse/vegetables/page/5/#concept-scallion" aria-haspopup="dialog" aria-expanded="false">scallion</a></span> whites by the stove and keep the greens for serving.</p><p class="step-techniques"><a href="/learn/how-to-cut-napa-cabbage/">How should I cut the ribs and the leaves for this dish?</a></p><p class="step-techniques"><a href="/learn/tofu-types/">Which tofu should I use for this dish?</a></p><figure class="step-diagram"><img src="/images/recipes/napa-cabbage-tofu-soup--cut-1200.webp" srcset="/images/recipes/napa-cabbage-tofu-soup--cut-600.webp 600w, /images/recipes/napa-cabbage-tofu-soup--cut-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 800px" alt="Tofu cubes and sliced shiitakes beside separate piles of napa ribs and leaves" width="1200" height="800" loading="lazy" decoding="async"/></figure><p class="step-endpoint"><strong>Ready when: </strong>The <span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">cabbage</a></span> ribs and leaves sit in separate piles, ready to go in at different times.</p><div class="timer"><output aria-label="Time remaining" aria-live="off">7:00</output><button type="button">Start timer</button><button type="button">Reset</button></div></li><li class="step" id="step-napa-cabbage-tofu-soup-simmer" data-testid="step"><p class="eyebrow">Cook · 11–14 min</p><h3>Brown the mushrooms and simmer the ribs</h3><p class="step-uses"><strong>Use now: </strong><span><span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">Napa cabbage</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="shiitake" href="/wiki/browse/mushrooms/#concept-shiitake" aria-haspopup="dialog" aria-expanded="false">Shiitake mushrooms</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="ginger" href="/wiki/browse/vegetables/page/3/#concept-ginger" aria-haspopup="dialog" aria-expanded="false">Fresh ginger</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="scallion" href="/wiki/browse/vegetables/page/5/#concept-scallion" aria-haspopup="dialog" aria-expanded="false">Scallion</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="neutral-oil" href="/wiki/browse/oils/#concept-neutral-oil" aria-haspopup="dialog" aria-expanded="false">Neutral cooking oil</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="water" href="/wiki/browse/oils/#concept-water" aria-haspopup="dialog" aria-expanded="false">Water</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="salt" href="/wiki/browse/seasonings/page/3/#concept-salt" aria-haspopup="dialog" aria-expanded="false">Fine salt</a></span></span></p><p>Warm the oil in a soup pot over medium heat. Spread the mushrooms over the bottom and cook for about 3 minutes, turning once. Stir in the ginger and <span class="concept-term"><a class="concept-trigger" data-concept-id="scallion" href="/wiki/browse/vegetables/page/5/#concept-scallion" aria-haspopup="dialog" aria-expanded="false">scallion</a></span> whites for 30 seconds. Pour in the <span class="concept-term"><a class="concept-trigger" data-concept-id="water" href="/wiki/browse/oils/#concept-water" aria-haspopup="dialog" aria-expanded="false">water</a></span>, loosen any browned bits with a spoon and bring to a boil. Add the <span class="concept-term"><a class="concept-trigger" data-concept-id="salt" href="/wiki/browse/seasonings/page/3/#concept-salt" aria-haspopup="dialog" aria-expanded="false">salt</a></span> and <span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">cabbage</a></span> ribs. Lower to a steady simmer for 4 minutes.</p><p class="step-endpoint"><strong>Ready when: </strong>The mushroom slices have browned edges and the <span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">cabbage</a></span> ribs are becoming translucent at the edges.</p><div class="timer"><output aria-label="Time remaining" aria-live="off">11:00</output><button type="button">Start timer</button><button type="button">Reset</button></div></li><li class="step" id="step-napa-cabbage-tofu-soup-finish" data-testid="step"><p class="eyebrow">Cook · 3–4 min</p><h3>Ease in the leaves and tofu</h3><p class="step-uses"><strong>Use now: </strong><span><span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">Napa cabbage</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="firm-tofu" href="/wiki/browse/tofu-soy/#concept-firm-tofu" aria-haspopup="dialog" aria-expanded="false">Firm tofu</a></span></span><span> · <span class="concept-term"><a class="concept-trigger" data-concept-id="scallion" href="/wiki/browse/vegetables/page/5/#concept-scallion" aria-haspopup="dialog" aria-expanded="false">Scallion</a></span></span></p><p>Lay the <span class="concept-term"><a class="concept-trigger" data-concept-id="napa-cabbage" href="/wiki/browse/vegetables/page/3/#concept-napa-cabbage" aria-haspopup="dialog" aria-expanded="false">cabbage</a></span> leaves on the broth and press them under gently. Slide the tofu cubes into the pot on a wide spoon. Keep the liquid barely bubbling for about 3–4 minutes. Ladle into two bowls and scatter the <span class="concept-term"><a class="concept-trigger" data-concept-id="scallion" href="/wiki/browse/vegetables/page/5/#concept-scallion" aria-haspopup="dialog" aria-expanded="false">scallion</a></span> greens on top.</p><figure class="step-diagram"><img src="/images/recipes/napa-cabbage-tofu-soup--finish-1200.webp" srcset="/images/recipes/napa-cabbage-tofu-soup--finish-600.webp 600w, /images/recipes/napa-cabbage-tofu-soup--finish-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 800px" alt="A ladle lowers intact tofu cubes into the barely simmering cabbage and mushroom broth" width="1200" height="800" loading="lazy" decoding="async"/></figure><p class="step-endpoint"><strong>Ready when: </strong>The leaves drape over the spoon, the thickest rib bends easily and the hot tofu cubes hold their shape.</p><div class="timer"><output aria-label="Time remaining" aria-live="off">3:00</output><button type="button">Start timer</button><button type="button">Reset</button></div></li></ol></section></div><!--astro:end--></astro-island><section id="nutrition" class="nutrition-panel panel content-section" data-testid="nutrition-panel"><h2>Approx. per serving</h2><dl class="nutrition-grid"><div><dt>Calories</dt><dd>151 <span>kcal</span></dd></div><div><dt>Protein</dt><dd>11.8 <span>g</span></dd></div><div><dt>Fat</dt><dd>8.1 <span>g</span></dd></div><div><dt>Carbs</dt><dd>10.4 <span>g</span></dd></div><div><dt>Sodium</dt><dd>528 <span>mg</span></dd></div><div><dt>Fiber</dt><dd>5.4 <span>g</span></dd></div></dl><p class="small muted">Estimated per serving; sides not included</p></section><span data-ad-opportunity="recipe-end" class="ad-opportunity no-print" aria-hidden="true" data-pagefind-ignore="all" data-astro-cid-ygkiugat></span><section class="content-section no-print"><div class="section-head"><h2>What will you cook next?</h2><a href="/recipes/">All recipes →</a></div><div class="recipe-grid"><article class="recipe-card"><a class="card-image" href="/recipes/napa-sesame-salad/" tabindex="-1" aria-hidden="true"><img src="/images/recipes/napa-sesame-salad--hero-600.webp" srcset="/images/recipes/responsive/napa-sesame-salad-240.webp 240w, /images/recipes/responsive/napa-sesame-salad-400.webp 400w, /images/recipes/napa-sesame-salad--hero-600.webp 600w, /images/recipes/responsive/napa-sesame-salad-800.webp 800w, /images/recipes/napa-sesame-salad--hero-1200.webp 1200w" sizes="auto, (max-width: 460px) 112px, (max-width: 760px) calc(50vw - 1.8rem), (max-width: 1264px) 31vw, 380px" alt width="1200" height="800" loading="lazy"/></a><div><p class="card-meta">10 min</p><h3><a href="/recipes/napa-sesame-salad/">Napa Cabbage with Sesame Dressing</a></h3><p>A no-cook Beijing cold dish: tender inner napa cabbage leaves torn by hand and tossed with a pourable sesame paste dressing loosened with black vinegar, then sweetened lightly and finished with sesame oil and toasted sesame seeds.</p></div></article><article class="recipe-card"><a class="card-image" href="/recipes/chilled-tofu/" tabindex="-1" aria-hidden="true"><img src="/images/recipes/chilled-tofu--hero-600.webp" srcset="/images/recipes/responsive/chilled-tofu-240.webp 240w, /images/recipes/responsive/chilled-tofu-400.webp 400w, /images/recipes/chilled-tofu--hero-600.webp 600w, /images/recipes/responsive/chilled-tofu-800.webp 800w, /images/recipes/chilled-tofu--hero-1200.webp 1200w" sizes="auto, (max-width: 460px) 112px, (max-width: 760px) calc(50vw - 1.8rem), (max-width: 1264px) 31vw, 380px" alt width="1200" height="800" loading="lazy"/></a><div><p class="card-meta">13 min</p><h3><a href="/recipes/chilled-tofu/">Chilled Dressed Tofu</a></h3><p>A quick cold tofu dish: firm tofu blocks are briefly blanched to firm them and tame the raw bean taste, drained, then dressed with a soy, sesame, vinegar and garlic sauce and finished with scallion. Serve cool or at room temperature as a light starter or side.</p></div></article><article class="recipe-card"><a class="card-image" href="/recipes/hot-and-sour-napa-cabbage/" tabindex="-1" aria-hidden="true"><img src="/images/recipes/hot-and-sour-napa-cabbage--hero-600.webp" srcset="/images/recipes/responsive/hot-and-sour-napa-cabbage-240.webp 240w, /images/recipes/responsive/hot-and-sour-napa-cabbage-400.webp 400w, /images/recipes/hot-and-sour-napa-cabbage--hero-600.webp 600w, /images/recipes/responsive/hot-and-sour-napa-cabbage-800.webp 800w, /images/recipes/hot-and-sour-napa-cabbage--hero-1200.webp 1200w" sizes="auto, (max-width: 460px) 112px, (max-width: 760px) calc(50vw - 1.8rem), (max-width: 1264px) 31vw, 380px" alt width="1200" height="800" loading="lazy"/></a><div><p class="card-meta">13 min</p><h3><a href="/recipes/hot-and-sour-napa-cabbage/">Hot and Sour Napa Cabbage Stir-Fry</a></h3><p>Slice the white ribs thin and keep the crinkled leaves in larger pieces. A quick splash of Chinkiang vinegar gives this 12 oz skillet of napa its tang while the ribs still crunch.</p></div></article></div><p><a href="/collections/chinese-cabbage-recipes/">Chinese Cabbage Recipes for Napa and Green Cabbage →</a></p></section></main><footer class="site-footer" data-pagefind-ignore="all" data-astro-cid-tq46r5sz><div data-astro-cid-tq46r5sz><a class="footer-brand" href="/" data-astro-cid-tq46r5sz>Chinese Kitchen Atlas</a><p data-astro-cid-tq46r5sz>Small lessons.<br data-astro-cid-tq46r5sz>More confidence at the stove.</p></div><nav aria-label="Explore" data-astro-cid-tq46r5sz><strong data-astro-cid-tq46r5sz>Make something good</strong><a href="/recipes/" data-astro-cid-tq46r5sz>All recipes</a><a href="/wiki/" data-astro-cid-tq46r5sz>Kitchen encyclopedia</a><a href="/learn/" data-astro-cid-tq46r5sz>Kitchen lessons</a><a href="/cook-with-what-you-have/" data-astro-cid-tq46r5sz>Find a dish</a><a href="/feed.xml" data-astro-cid-tq46r5sz>Recipe RSS feed</a></nav><nav aria-label="About this site" data-astro-cid-tq46r5sz><strong data-astro-cid-tq46r5sz>Our approach</strong><a href="/about/" data-astro-cid-tq46r5sz>About</a><a href="/editorial-policy/" data-astro-cid-tq46r5sz>Editorial policy</a><a href="/contact/" data-astro-cid-tq46r5sz>Contact</a></nav><nav aria-label="Policies" data-astro-cid-tq46r5sz><strong data-astro-cid-tq46r5sz>The details</strong><a href="/privacy/" data-astro-cid-tq46r5sz>Privacy</a><a href="/terms/" data-astro-cid-tq46r5sz>Terms</a><button type="button" class="analytics-settings no-print" data-analytics-settings hidden data-astro-cid-tq46r5sz>Analytics choices</button></nav></footer><section id="analytics-consent" class="analytics-consent no-print" hidden role="region" aria-label="Optional analytics settings" tabindex="-1" data-pagefind-ignore="all" data-astro-cid-fg2vtww3><div class="analytics-consent-heading" data-astro-cid-fg2vtww3><h2 data-astro-cid-fg2vtww3>Help us improve recipes and tools</h2><button type="button" data-analytics-close hidden aria-label="Close analytics settings" data-astro-cid-fg2vtww3>Close</button></div><p data-astro-cid-fg2vtww3>Optional analytics help us understand which recipes and tools are useful. If you allow it, we use Google Analytics. Your ingredient selections and search text are not sent. You can change your choice at any time. <a href="/privacy/" data-astro-cid-fg2vtww3>Privacy policy</a></p><div class="analytics-consent-actions" data-astro-cid-fg2vtww3><button type="button" data-analytics-choice="denied" data-astro-cid-fg2vtww3>Decline</button><button type="button" data-analytics-choice="granted" data-astro-cid-fg2vtww3>Allow analytics</button></div></section><div id="analytics-config" hidden data-measurement-id="G-8FMJ92K4KT" data-production-host="chineserecipes.xyz" data-astro-cid-tq46r5sz></div><script type="module" src="/_astro/SiteLayout.astro_astro_type_script_index_0_lang.BbPup7NC.js"></script><script type="module">document.querySelectorAll(`a[href^="#"]`).forEach(e=>e.addEventListener(`click`,()=>{let t=e.hash;document.getElementById(decodeURIComponent(t.slice(1)))?.closest(`details`)?.setAttribute(`open`,``)}));</script></body></html>