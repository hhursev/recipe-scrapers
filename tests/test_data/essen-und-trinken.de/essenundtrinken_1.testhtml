<script type="application/ld+json">[{"name":"Kritharaki-Salat: einfacher griechischer Nudelsalat für Sommer & Grillparty","description":"Griechischer Reisnudelsalat: Mit diesem einfachen Rezept kommt mediterranes Urlaubsglück auf. Perfekt für einen Grillabend oder eine Feier!\n","image":[{"name":"Kritharaki-Salat mit Tomaten, Feta und Oliven","url":"https://image.essen-und-trinken.de/13778662/t/PX/v1/w1440/r1.7778/-/kritharaki-salat-adobestock-613124353-brebca.jpg","width":"1440","height":"810","@type":"ImageObject"},{"name":"Kritharaki-Salat mit Tomaten, Feta und Oliven","url":"https://image.essen-und-trinken.de/13778662/t/x0/v1/w1440/r1/-/kritharaki-salat-adobestock-613124353-brebca.jpg","width":"1440","height":"1440","@type":"ImageObject"},{"name":"Kritharaki-Salat mit Tomaten, Feta und Oliven","url":"https://image.essen-und-trinken.de/13778662/t/_5/v1/w1440/r1.5/-/kritharaki-salat-adobestock-613124353-brebca.jpg","width":"1440","height":"960","@type":"ImageObject"}],"mainEntityOfPage":{"@id":"https://www.essen-und-trinken.de/rezepte/kritharaki-salat-5-13778650.html","@type":"WebPage"},"datePublished":"2026-06-24T12:55:00+02:00","dateModified":"2026-06-24T12:55:35+02:00","author":{"name":"essen-und-trinken.de","@type":"Person"},"publisher":{"name":"ESSEN-UND-TRINKEN.de","logo":{"url":"https://image.essen-und-trinken.de/13986716/t/oM/v2/w240/r0/-/eut-logo-neu-schema-org.png","width":"240","height":"95","@type":"ImageObject"},"@type":"Organization"},"aggregateRating":{"ratingCount":33,"bestRating":5,"worstRating":1,"ratingValue":2.7,"@type":"AggregateRating"},"totalTime":"PT15M","recipeYield":4,"recipeIngredient":["200 g Kritharaki-Nudeln","2 Paprikaschote","100 g Cocktailtomate","0,5 Bund Frühlingszwiebel","100 g schwarze Olive","0,5 Bund glatte Petersilie","6 El Olivenöl","4 El Weißweinessig","Salz","Pfeffer","1 Tl Limettensaft","200 g Feta"],"recipeInstructions":["Kritharaki-Nudeln nach Packungsanleitung kochen. Durch ein Sieb abgießen, kalt abschrecken und abtropfen lassen. Beiseitestellen.","Paprika und Tomaten in Würfel schneiden. Frühlingszwiebeln und Oliven in Ringe schneiden. Petersilie grob hacken.","Paprika, Tomaten, Frühlingszwiebeln und Oliven mit der Petersilie in einer Schüssel mit Olivenöl und Weißweinessig mischen. Mit Salz und Pfeffer abschmecken. Limettensaft hinzugeben. Feta zerbröseln und zusammen mit den Nudeln gut mischen."],"nutrition":{"calories":436,"proteinContent":12,"fatContent":35,"carbohydrateContent":19,"@type":"NutritionInformation"},"@context":"http://schema.org","@type":"Recipe"},{"@context":"http://schema.org","@type":"BreadcrumbList","itemListElement":[{"position":1,"item":{"name":"essenundtrinken","@id":"https://www.essen-und-trinken.de/","@type":"WebPage"},"@type":"ListItem"},{"position":2,"item":{"name":"Rezepte","@id":"https://www.essen-und-trinken.de/rezepte/","@type":"WebPage"},"@type":"ListItem"},{"position":3,"item":{"name":"Kritharaki-Salat: einfacher griechischer Nudelsalat für Sommer & Grillparty","@id":"https://www.essen-und-trinken.de/rezepte/kritharaki-salat-5-13778650.html","@type":"WebPage"},"@type":"ListItem"}]}]</script></body>
