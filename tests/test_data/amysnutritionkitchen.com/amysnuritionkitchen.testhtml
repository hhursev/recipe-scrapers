-nf-usc-unit="ounce" data-nf-metric-unit="gram" data-nf-food-id="3014" data-nf-food-description="Mushrooms, brown, italian, or crimini, raw" data-amount="8">8</span>&#8211;<span class="nutrifox-unit" data-nf-original="usc" data-nf-usc="ounce" data-nf-metric="gram" data-nf-food-id="3014" data-nf-food-description="Mushrooms, brown, italian, or crimini, raw">ounces</span> <span class="nutrifox-name">baby bella mushrooms</span>, finely chopped</li><li data-tr-ingredient-checkbox=""><span class="tr-ingredient-checkbox-container"><input type="checkbox" name="ingredient_checkbox_6af348a9885b3" id="ingredient_checkbox_6af348a9885b3" aria-label="1 bunch scallions, thinly sliced"><label for="ingredient_checkbox_6af348a9885b3"></label></span><span data-amount="1">1</span> bunch scallions, thinly sliced</li><li data-tr-ingredient-checkbox=""><span class="tr-ingredient-checkbox-container"><input type="checkbox" name="ingredient_checkbox_6af348a9885b6" id="ingredient_checkbox_6af348a9885b6" aria-label="2 garlic cloves, grated"><label for="ingredient_checkbox_6af348a9885b6"></label></span><span data-amount="2">2</span> garlic cloves, grated</li><li data-tr-ingredient-checkbox=""><span class="tr-ingredient-checkbox-container"><input type="checkbox" name="ingredient_checkbox_6af348a9885ba" id="ingredient_checkbox_6af348a9885ba" aria-label="3 tablespoons hoisin sauce"><label for="ingredient_checkbox_6af348a9885ba"></label></span><span data-amount="3" data-unit="tablespoon">3 tablespoons</span> hoisin sauce</li><li data-tr-ingredient-checkbox=""><span class="tr-ingredient-checkbox-container"><input type="checkbox" name="ingredient_checkbox_6af348a9885bd" id="ingredient_checkbox_6af348a9885bd" aria-label="1 teaspoon sriracha"><label for="ingredient_checkbox_6af348a9885bd"></label></span><span data-amount="1" data-unit="teaspoon">1 teaspoon</span> sriracha</li><li data-tr-ingredient-checkbox=""><span class="tr-ingredient-checkbox-container"><input type="checkbox" name="ingredient_checkbox_6af348a9885c0" id="ingredient_checkbox_6af348a9885c0" aria-label="12 leaves butter lettuce"><label for="ingredient_checkbox_6af348a9885c0"></label></span><span data-amount="12">12</span> leaves butter lettuce</li></ul>			</div>
