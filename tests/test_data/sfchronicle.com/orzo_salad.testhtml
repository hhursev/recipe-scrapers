owEyebrows":true,"showPhoto":null,"showByline":false,"showTimestamp":false,"useImg":false,"blurb":null,"useBlurb":false,"hideBlurbOnMobile":false,"forceHideEyebrows":false},"displayedDateFormat":"h:mm aaa","sponsored":null,"videoloop":null,"slideshowImages":null,"bizRelItem":null},{"__typename":"ArticleStub","type":"article","url":"/sports/warriors/article/steve-kerr-s-viral-run-in-warriors-fans-22347230.php","title":"Kerr speaks on LeBron","excerpt":"A video has surfaced showing Steve Kerr exchanging pleasantries with some Warriors fans from his car in Las Vegas. One of the fans tells Kerr, “Hey, we need to get LeBron, man.”","abstract":"\u003cp\u003eA video has surfaced showing Steve Kerr exchanging pleasantries with some Warriors fans from his car in Las Vegas. One of the fans tells Kerr, “Hey, we need to get LeBron, man.”\u003c/p\u003e","plainTextAbstract":"A video has surfaced showing Steve Kerr exchanging pleasantries with some Warriors fans from his car in Las Vegas. One of the fans tells Kerr, “Hey, we need to get LeBron, man.”","displayedDate":"2026-07-15 19:21:55","lastModifiedDate":"2026-07-16 10:52:18","elapsedTime":null,"authorName":null,"authorHref":null,"authors":[{"id":172,"name":"Ron Kroichick","title":"Senior Sports Enterprise Reporter","url":"/author/ron-kroichick/","credit":null,"image":{"id":null,"url":"https://s.hdnux.com/photos/20/31/73/4300535/5/rawImage.jpg","base64":null,"width":768,"height":774,"guid":null,"dirPath":null,"alt":"Ron Kroichick","title":"0166.JPG"}}],"bylineObjects":[{"id":172,"name":"Ron Kroichick","title":"Senior Sports Enterprise Reporter","url":"/author/ron-kroichick/","credit":"Staff Writer","image":{"id":4300535,"url":null,"base64":"data:image/jpeg;base64,","width":768,"height":774,"guid":"photo_4300535","dirPath":"20/31/73/4300535/5","alt":"Ron Kroichick","title":"0166.JPG"}}],"eyebrow":{"isPublished":true,"linkText":"Warriors","url":"/sports/warriors/"},"badge":null,"image":{"url":"https://s.hdnux.com/photos/01/66/66/22/31155384/3/rawImage.jpg","b64":null,"width":2048,"height":1366,"caption":{"plain":"Golden State Warriors head coach Steve Kerr following the NBA game against the New York Knicks at Chase Center in San Francisco, Saturday, March 15, 2025. Warriors won 97-94. With this 558th regular season win, Kerr becomes the head coach with the most wins in Warriors franchise history.","html1":null,"serializedReact":null},"loading":"lazy","external":null,"alt":"Golden State Warriors head coach Steve Kerr following the NBA game against the New York Knicks at Chase Center in San Francisco, Saturday, March 15, 2025. ","title":"warriors-kerr0715_126374333"},"collectionConfig":{"showLabels":false,"persistentTimestamp":false,"showEyebrows":true,"showPhoto":null,"showByline":false,"showTimestamp":false,"useImg":false,"blurb":null,"useBlurb":false,"hideBlurbOnMobile":false,"forceHideEyebrows":false},"displayedDateFormat":"h:mm aaa","sponsored":null,"videoloop":null,"slideshowImages":null,"bizRelItem":null},{"__typename":"ArticleStub","type":"article","url":"/entertainment/movies-tv/article/odyssey-review-nolan-imax-22333485.php","title":"‘Odyssey’ review","excerpt":"The star-packed IMAX epic led by Matt Damon, in one of his best performances, is a massive achievement.","abstract":"\u003cp\u003eThe star-packed IMAX epic led by Matt Damon, in one of his best performances, is a massive achievement.\u003c/p\u003e","plainTextAbstract":"The star-packed IMAX epic led by Matt Damon, in one of his best performances, is a massive achievement.","displayedDate":"2026-07-15 09:00:15","lastModifiedDate":"2026-07-15 15:55:26","elapsedTime":null,"authorName":null,"authorHref":null,"authors":[{"id":1428,"name":"G. Allen Johnson","title":"Staff Writer","url":"/author/g-allen-johnson/","credit":null,"image":{"id":null,"url":"https://s.hdnux.com/photos/75/73/67/16235988/5/rawImage.jpg","base64":null,"width":2048,"height":1366,"guid":null,"dirPath":null,"alt":"San Francisco Chronicle reporter G. Allen Johns