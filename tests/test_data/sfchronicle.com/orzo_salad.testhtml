tic"}}],"bylineObjects":[{"id":163,"name":"Peter Hartlaub","title":"Culture Critic","url":"/author/peter-hartlaub/","credit":"Culture Critic","image":{"id":22148082,"url":null,"base64":"data:image/jpeg;base64,","width":1365,"height":1364,"guid":"photo_22148082","dirPath":"01/24/37/17/22148082/5","alt":"photo Peter Hartlaub, Chronicle Culture Critic from article titled \"A cable car ride for locals? New Muni service leaves the tourist trappings behind\"","title":"Peter Hartlaub, Chronicle Culture Critic"}}],"eyebrow":{"isPublished":true,"linkText":"Total SF","url":"/totalsf/"},"badge":null,"image":{"url":"https://s.hdnux.com/photos/01/66/65/76/31154091/3/rawImage.jpg","b64":null,"width":2048,"height":1366,"caption":{"plain":"A cable car on the Hyde Ride , left front, sits on the tracks along Hyde Street with other cable cars lined up behind on Friday, July 10, 2026 in San Francisco. The Hyde Ride is a cable car history tour with a docent from Market Street Railway and cable car gripman and historian Val Lupiz calling out facts and sights along a loop that starts and ends at Fisherman's Wharf and covers more track than most rides.","html1":null,"serializedReact":null},"loading":"lazy","external":null,"alt":"A cable car on the Hyde Ride sits on the tracks along Hyde Street with other cable cars lined up behind. The new route aimed at locals and sharing San Francisco history is available Friday through Sunday through October 4. ","title":"totalsf-cablecar0716"},"collectionConfig":{"showLabels":false,"persistentTimestamp":false,"showEyebrows":true,"showPhoto":null,"showByline":false,"showTimestamp":false,"useImg":false,"blurb":null,"useBlurb":false,"hideBlurbOnMobile":false,"forceHideEyebrows":false},"displayedDateFormat":"h:mm aaa","sponsored":null,"videoloop":null,"slideshowImages":null,"bizRelItem":null},{"__typename":"ArticleStub","type":"article","url":"/food/restaurants/article/maillards-smashburger-outer-sunset-22336710.php","title":"Smashburgers","excerpt":"This 