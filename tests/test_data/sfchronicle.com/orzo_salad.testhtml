,"topPadding":true},"items":[]}]}]},{"id":"heroZoneSet","layout":"1Column","options":{"excludeBottomMargin":false,"excludeMargins":true,"excludeMaxWidth":true},"zones":[{"id":"heroZone","options":{},"widgets":[{"items":[{"title":"Vibrant orzo salad showcases the best of California summer produce","subtitle":"","breadcrumbs":[{"title":"Food","url":"/food/","isPublished":true},{"title":"Recipes","url":"/food/recipes/","isPublished":true}],"authorTitle":"Contributor","authors":[{"name":"Amisha Gurbani","firstName":"Amisha","lastName":"Gurbani","title":null,"biography":null,"url":null,"slug":null,"email":null,"displayEmail":null,"facebook":null,"linkedIn":null,"instagram":null,"twitter":null,"tiktok":null,"bluesky":null,"hasContact":null,"primarySiteId":null,"sponsorLogoUrl":null,"originId":null,"image":null}],"hero":null,"publishedOnline":"2026-07-03 04:00:19","lastModifiedDate":"2026-07-03 04:00:19","lastPublishedDisplayed":"2026-07-03 04:00:19","shareTools":{"facebook":"https://www.facebook.com/dialog/feed?app_id=137086563877087\u0026link=https%3A%2F%2Fwww.sfchronicle.com%2Ffood%2Frecipes%2Farticle%2Forzo-salad-zucchini-corn-22322315.php%3Futm_campaign%3DCMS%2520Sharing%2520Tools%2520(Premium)%26utm_source%3Dfacebook.com%26utm_medium%3Dreferral\u0026name=Vibrant%20orzo%20salad%20showcases%20the%20best%20of%20California%20summer%20produce\u0026description=Basil%20vinaigrette%20ties%20together%20peaches%2C%20corn%2C%20Parmesan-baked%20zucchini%20and%20halloumi%20cheese%20in%20a%20produce-packed%20orzo%20salad%20recipe.\u0026picture=https%3A%2F%2Fs.hdnux.com%2Fphotos%2F01%2F66%2F55%2F13%2F31118019%2F5%2FrawImage.jpg\u0026redirect_uri=https%3A%2F%2Fwww.sfchronicle.com%2Ffood%2Frecipes%2Farticle%2Forzo-salad-zucchini-corn-22322315.php%3Futm_campaign%3DCMS%2520Sharing%2520Tools%2520(Premium)%26utm_source%3DUTMSOURCE%26utm_medium%3DUTMMEDIUM","twitter":"https://twitter.com/intent/tweet?url=https%3A%2F%2Fwww.sfchronicle.com%2Ffood%2Frecipes%2Farticle%2Forzo-salad-zucchini-corn-22322315.php%3Futm_campaign%3DCMS%2520Sharing%2520Tools%2520(Premium)%26utm_source%3Dt.co%26utm_medium%3Dreferral\u0026text=Vibrant%20orzo%20salad%20showcases%20the%20best%20of%20California%20summer%20produce\u0026via=sfchronicle","bluesky":"https://bsky.app/intent/compose?text=Vibrant%20orzo%20salad%20showcases%20the%20best%20of%20California%20summer%20produce%20https%3A%2F%2Fwww.sfchronicle.com%2Ffood%2Frecipes%2Farticle%2Forzo-salad-zucchini-corn-22322315.php\u0026url=https%3A%2F%2Fwww.sfchronicle.com%2Ffood%2Frecipes%2Farticle%2Forzo-salad-zucchini-corn-22322315.php%3Futm_campaign%3DCMS%2520Sharing%2520Tools%2520(Premium)%26utm_source%3Dbsky.app%26utm_medium%3Dreferral","email":"mailto:?subject=Your%20friend%20has%20shared%20a%20San%20Francisco%20Chronicle%20link%20with%20you%3A\u0026body=Vibrant%20orzo%20salad%20showcases%20the%20best%20of%20California%20summer%20produce%0A%0Ahttps%3A%2F%2Fwww.sfchronicle.com%2Ffood%2Frecipes%2Farticle%2Forzo-salad-zucchini-corn-22322315.php%3Futm_campaign%3DCMS%2520Sharing%2520Tools%2520(Premium)%26utm_source%3Dshare-by-email%26utm_medium%3Demail%0A%0ABasil%20vinaigrette%20ties%20together%20peaches%2C%20corn%2C%20Parmesan-baked%20zucchini%20and%20halloumi%20cheese%20in%20a%20produce-packed%20orzo%20salad%20recipe.%0A%0AThis%20message%20was%20sent%20via%20San%20Francisco%20Chronicle"},"followTopic":false,"followTopicAlertable":null,"__typename":"Article","type":"articleHeader"}],"id":"articleHeader","type":"ArticleHeader","options":{"placement":"main","layout":"1Column","setContentDiv":true,"removeTimestamp":false}}]}]},{"id":"zoneSet5","layout":"2ColumnRightPadded","options":{},"zones":[{"id":"zoneBody","options":{"articleBody":"1"},"widgets":[{"items":[{"body":[{"__typename":"ImageBlock","type":"image","params":{"layout":"photo","chapter":null,"chapterHeader":null,"id":31118019,"orientation":"landscape","byline":"Amisha Gurbani ","image":{"url":"https://s.hdnux.com/photos/01/66/55/13/31118019/5/rawImage.jpg","b64":null,"width":2048,"height":1365,"caption":{"plain":"Flavorful, easy to transport and tasty the day after, this abundant summer salad is perfect for summer gatherings.","html1":"\u003cp\u003eFlavorful, easy to transport and tasty the day after, this abundant summer salad is perfect for summer gatherings.\u003c/p\u003e","serializedReact":null},"loading":"lazy","external":null,"alt":"Flavorful, easy to transport and tasty the day after, this abundant summer salad is perfect for summer gatherings."}}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":"item-102852","embed":{"__type":"thirdPartyFreeformEmbed","__id":"everlit","__data":{"publicationId":"pblc_kYW067sbmBR"},"__tpId":"everlit"},"guid":"zoneInlineA","widgets":null}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eShades of green, red, orange, yellow, purple, magenta, pink greet you at the farmers market this time of year. Each stall brims with a bountiful rainbow of produce, offering an endless array of colors and textures and flavors — crisp, tender, juicy, sweet and earthy. This is California summer at its peak: colorful, abundant and endlessly inspiring.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"Shades of green, red, orange, yellow, purple, magenta, pink greet you at the farmers market this time of year. Each stall brims with a bountiful rainbow of produce, offering an endless array of colors and textures and flavors — crisp, tender, juicy, sweet and earthy. This is California summer at its peak: colorful, abundant and endlessly inspiring."}}}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":null,"embed":{},"guid":"zoneInlineA","widgets":null}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eInspired by all that color and texture, this zucchini, corn and peach orzo salad is a keeper, one that will be on repeat by anyone who makes it. \u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"Inspired by all that color and texture, this zucchini, corn and peach orzo salad is a keeper, one that will be on repeat by anyone who makes it. "}}}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":"item-101985","embed":{"__type":"blueConicFreeformEmbed","__id":"Promo","__data":{"variant":"sfcSurvey:articleParagraph"},"__tpId":"Promo"},"guid":"zoneInlineA","widgets":null}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":"item-102365","embed":{"__type":"blueConicFreeformEmbed","__id":"Promo","__data":{"variant":"inlineSFCHighMomentumInDMA:articleParagraph"},"__tpId":"Promo"},"guid":"zoneInlineA","widgets":null}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":"item-102367","embed":{"__type":"blueConicFreeformEmbed","__id":"Promo","__data":{"variant":"inlineSFCLowMomentumOutofDMA:articleParagraph"},"__tpId":"Promo"},"guid":"zoneInlineA","widgets":null}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":"item-101875","embed":{"__type":"blueConicFreeformEmbed","__id":"Promo","__data":{"variant":"standard:articleParagraph"},"__tpId":"Promo"},"guid":"zoneInlineA","widgets":null}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eProduce-rich meals have always been a part of my dinner table, and that appreciation for fruits and vegetables has naturally been passed down to my children. Growing up surrounded by a variety of seasonal produce has made them open-minded eaters, eager to try new ingredients and flavors. Their enthusiasm inspires me in the kitchen, encouraging me to create dishes that celebrate fresh produce in delicious ways.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"Produce-rich meals have always been a part of my dinner table, and that appreciation for fruits and vegetables has naturally been passed down to my children. Growing up surrounded by a variety of seasonal produce has made them open-minded eaters, eager to try new ingredients and flavors. Their enthusiasm inspires me in the kitchen, encouraging me to create dishes that celebrate fresh produce in delicious ways."}}}},{"__typename":"AdBlock","type":"ad","params":{"layout":null,"chapter":null,"chapterHeader":null,"code":null,"small":"A300","large":"CONCERT1","showInlineAdLabel":true,"adUnitPath":"hnp-sfchronicle.com/article_dtc"}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eThere is something about the combination of zucchini, sweet corn and juicy peaches that just works miraculously well. Another dish that my family demands every summer, for instance, is my cheese toast featuring them, along with some spicy green chiles and cilantro, on sourdough.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"There is something about the combination of zucchini, sweet corn and juicy peaches that just works miraculously well. Another dish that my family demands every summer, for instance, is my cheese toast featuring them, along with some spicy green chiles and cilantro, on sourdough."}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eMy orzo salad starts off with the most delicious basil vinaigrette. Made in a high speed blender, it can be stored in the fridge for up to 2 weeks — if it lasts that long. Next comes the Parmesan-baked zucchini, where zucchini is tossed in olive oil, salt and pepper, and baked in the oven after a generous sprinkle of Parmesan on each side. Flip them halfway through, another sprinkle of Parmesan and bake them to golden perfection. \u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"My orzo salad starts off with the most delicious basil vinaigrette. Made in a high speed blender, it can be stored in the fridge for up to 2 weeks — if it lasts that long. Next comes the Parmesan-baked zucchini, where zucchini is tossed in olive oil, salt and pepper, and baked in the oven after a generous sprinkle of Parmesan on each side. Flip them halfway through, another sprinkle of Parmesan and bake them to golden perfection. "}}}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":"item-104247","embed":{"__type":"thirdPartyFreeformEmbed","__id":"googlepreferredsourcesinlinemodule","__data":{"headlineText":"See more S.F. Chronicle on Google","descriptionText":"Make us a Preferred Source to get more of our news when you search.","buttonText":"Add Preferred Source","linkUrl":"https://www.google.com/preferences/source?q=sfchronicle.com","trackingName":"sfchronicle_google_preferred_source "},"__tpId":"googlepreferredsourcesinlinemodule"},"guid":"zoneInlineA","widgets":null}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eOrzo is an Italian pasta that looks like a long grain of rice or barley and is made with durum wheat semolina or flour. Cook it per the package instructions and cook the corn over a grill or a gas stovetop. If you do not have either, you can strip the corn off the cob, sauté it in a pan with a little bit of butter for a few minutes until golden brown. \u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"Orzo is an Italian pasta that looks like a long grain of rice or barley and is made with durum wheat semolina or flour. Cook it per the package instructions and cook the corn over a grill or a gas stovetop. If you do not have either, you can strip the corn off the cob, sauté it in a pan with a little bit of butter for a few minutes until golden brown. "}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eThe peach is cut simply, into small cubes. Feel free to substitute a white peach or nectarine as well. I love the pop of color from the crimson peel. The salad also has halloumi, a semi-hard, briny cheese from Cyprus that has a high melting point, allowing it to be grilled or pan seared, which gives the outside a chewy texture with soft interiors. \u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"The peach is cut simply, into small cubes. Feel free to substitute a white peach or nectarine as well. I love the pop of color from the crimson peel. The salad also has halloumi, a semi-hard, briny cheese from Cyprus that has a high melting point, allowing it to be grilled or pan seared, which gives the outside a chewy texture with soft interiors. "}}}},{"__typename":"AdBlock","type":"ad","params":{"layout":null,"chapter":null,"chapterHeader":null,"code":null,"small":"CONCERT1","large":"CONCERT2","showInlineAdLabel":true,"adUnitPath":"hnp-sfchronicle.com/article_dtc"}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eAll of the ingredients, along with finely chopped oregano and coarsely chopped pistachios, are tossed together with the basil vinaigrette. The salad is garnished with basil leaves and some more pistachios for good measure. \u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"All of the ingredients, along with finely chopped oregano and coarsely chopped pistachios, are tossed together with the basil vinaigrette. The salad is garnished with basil leaves and some more pistachios for good measure. "}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eThe best part about this orzo salad is how easy it is to transport for a summer get-together. It is best enjoyed with a light wine such as a Riesling.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"The best part about this orzo salad is how easy it is to transport for a summer get-together. It is best enjoyed with a light wine such as a Riesling."}}}},{"__typename":"ImageBlock","type":"image","params":{"layout":"photo","chapter":null,"chapterHeader":null,"id":31118018,"orientation":"portrait","byline":"Amisha Gurbani ","image":{"url":"https://s.hdnux.com/photos/01/66/55/13/31118018/5/rawImage.jpg","b64":null,"width":1365,"height":2048,"caption":{"plain":"Garnishing the orzo salad with crunchy pistachios, peach slices and basil leaves ensures each bite has a bit of crunch and sweetness. ","html1":"\u003cp\u003eGarnishing the orzo salad with crunchy pistachios, peach slices and basil leaves ensures each bite has a bit of crunch and sweetness. \u003c/p\u003e","serializedReact":null},"loading":"lazy","external":null,"alt":"Garnishing the orzo salad with crunchy pistachios, peach slices and basil leaves ensures each bite has a bit of crunch and sweetness. "}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eZucchini, Corn and Peach Orzo Salad\u003c/strong\u003e\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":{"type":"strong","key":null,"ref":null,"props":{"children":"Zucchini, Corn and Peach Orzo Salad"}}}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cem\u003eServes 6 to 8\u003c/em\u003e\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":{"type":"em","key":null,"ref":null,"props":{"children":"Serves 6 to 8"}}}}}},{"__typename":"AdBlock","type":"ad","params":{"layout":null,"chapter":null,"chapterHeader":null,"code":null,"small":"B300","large":null,"showInlineAdLabel":true,"adUnitPath":"hnp-sfchronicle.com/article_dtc"}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eWith summer produce at its peak, make this absolutely delightful and fresh salad, with oven-baked Parmesan zucchini, grilled corn, sweet and juicy peaches and grilled halloumi. An herbaceous basil vinaigrette ties it all together. This salad will be perfect for your summer soiree. \u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"With summer produce at its peak, make this absolutely delightful and fresh salad, with oven-baked Parmesan zucchini, grilled corn, sweet and juicy peaches and grilled halloumi. An herbaceous basil vinaigrette ties it all together. This salad will be perfect for your summer soiree. "}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eBasil vinaigrette\u003c/strong\u003e\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":{"type":"strong","key":null,"ref":null,"props":{"children":"Basil vinaigrette"}}}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e1 cup fresh basil, tightly packed\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"1 cup fresh basil, tightly packed"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e3 tablespoons lemon juice\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"3 tablespoons lemon juice"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e2 tablespoons sherry or champagne vinegar\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"2 tablespoons sherry or champagne vinegar"}}}},{"__typename":"AdBlock","type":"ad","params":{"layout":null,"chapter":null,"chapterHeader":null,"code":null,"small":"CONCERT2","large":null,"showInlineAdLabel":true,"adUnitPath":"hnp-sfchronicle.com/article_dtc"}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e2 garlic cloves\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"2 garlic cloves"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e1 teaspoon black pepper\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"1 teaspoon black pepper"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e¾ teaspoon salt\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"¾ teaspoon salt"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e1 tablespoon honey\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"1 tablespoon honey"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e½ cup extra-virgin olive oil\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"½ cup extra-virgin olive oil"}}}},{"__typename":"AdBlock","type":"ad","params":{"layout":null,"chapter":null,"chapterHeader":null,"code":null,"small":"S300","large":null,"showInlineAdLabel":true,"adUnitPath":"hnp-sfchronicle.com/article_dtc"}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eParmesan-baked zucchini\u003c/strong\u003e\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":{"type":"strong","key":null,"ref":null,"props":{"children":"Parmesan-baked zucchini"}}}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e1 large or 2 medium-sized zucchini, sliced vertically into half, then sliced into ¼-inch slices\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"1 large or 2 medium-sized zucchini, sliced vertically into half, then sliced into ¼-inch slices"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e2 tablespoons olive oil\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"2 tablespoons olive oil"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e½ teaspoon salt\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"½ teaspoon salt"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e½ teaspoon black pepper\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"½ teaspoon black pepper"}}}},{"__typename":"AdBlock","type":"ad","params":{"layout":null,"chapter":null,"chapterHeader":null,"code":null,"small":null,"large":null,"showInlineAdLabel":true,"adUnitPath":"hnp-sfchronicle.com/article_dtc"}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e½ teaspoon garlic powder\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"½ teaspoon garlic powder"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e⅓ cup grated Parmesan \u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"⅓ cup grated Parmesan "}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eOrzo salad\u003c/strong\u003e\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":{"type":"strong","key":null,"ref":null,"props":{"children":"Orzo salad"}}}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e8 ounces halloumi, cut into ⅓-inch slices\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"8 ounces halloumi, cut into ⅓-inch slices"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e2 cups orzo, cooked per packaged instructions\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"2 cups orzo, cooked per packaged instructions"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e1 corn on the cob, grilled\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"1 corn on the cob, grilled"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e2 yellow peaches, cut into small cubes\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"2 yellow peaches, cut into small cubes"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e2 tablespoons oregano, finely chopped\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"2 tablespoons oregano, finely chopped"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e⅓ cup pistachios, coarsely chopped\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"⅓ cup pistachios, coarsely chopped"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eGarnish\u003c/strong\u003e\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":{"type":"strong","key":null,"ref":null,"props":{"children":"Garnish"}}}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eBasil leaves\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"Basil leaves"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eYellow peach slices\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"Yellow peach slices"}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eMake the basil vinaigrette:\u003c/strong\u003e Add all the ingredients in a high-speed blender and blend to a smooth vinaigrette. Pour it into a glass jar and refrigerate until ready to use.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":[{"type":"strong","key":"0","ref":null,"props":{"children":"Make the basil vinaigrette:"}}," Add all the ingredients in a high-speed blender and blend to a smooth vinaigrette. Pour it into a glass jar and refrigerate until ready to use."]}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eMake the Parmesan-baked zucchini:\u003c/strong\u003e Preheat the oven to 400 degrees. Spray a half baking sheet with cooking spray. Add the sliced zucchini, olive oil, salt, pepper and garlic powder and toss until well combined. Lay them flat such that they are not overlapping. Sprinkle half of the Parmesan onto each zucchini slice. Bake for about 20 to 25 minutes or until the zucchini is golden brown in color. \u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":[{"type":"strong","key":"0","ref":null,"props":{"children":"Make the Parmesan-baked zucchini:"}}," Preheat the oven to 400 degrees. Spray a half baking sheet with cooking spray. Add the sliced zucchini, olive oil, salt, pepper and garlic powder and toss until well combined. Lay them flat such that they are not overlapping. Sprinkle half of the Parmesan onto each zucchini slice. Bake for about 20 to 25 minutes or until the zucchini is golden brown in color. "]}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eUsing a small offset spatula, flip them over and sprinkle the Parmesan on the slices. Bake for another 20 to 25 minutes or until the zucchini is golden brown in color. Cool completely as it will turn crisp.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"Using a small offset spatula, flip them over and sprinkle the Parmesan on the slices. Bake for another 20 to 25 minutes or until the zucchini is golden brown in color. Cool completely as it will turn crisp."}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eGrill the halloumi:\u003c/strong\u003e Spray cooking spray on a grill pan on medium heat. Add the halloumi slices, not overlapping each other, and grill for about 2-3 minutes, or until you see golden brown grill marks. Flip and repeat on the other side to get the grill marks. Set aside until ready to toss in the salad.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":[{"type":"strong","key":"0","ref":null,"props":{"children":"Grill the halloumi:"}}," Spray cooking spray on a grill pan on medium heat. Add the halloumi slices, not overlapping each other, and grill for about 2-3 minutes, or until you see golden brown grill marks. Flip and repeat on the other side to get the grill marks. Set aside until ready to toss in the salad."]}}}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":null,"embed":null,"guid":"zoneInlineB","widgets":[]}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eCombine the ingredients:\u003c/strong\u003e In a large platter, add the freshly cooked orzo, while still warm; grilled corn; peaches; grilled halloumi; and oregano. Mix in most of the pistachios, setting about 2 tablespoons aside. Pour the basil vinaigrette all over the orzo salad and toss until well combined.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":[{"type":"strong","key":"0","ref":null,"props":{"children":"Combine the ingredients:"}}," In a large platter, add the freshly cooked orzo, while still warm; grilled corn; peaches; grilled halloumi; and oregano. Mix in most of the pistachios, setting about 2 tablespoons aside. Pour the basil vinaigrette all over the orzo salad and toss until well combined."]}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003eGarnish with the chopped pistachios, basil leaves and yellow peach slices. Serve at room temperature.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":"Garnish with the chopped pistachios, basil leaves and yellow peach slices. Serve at room temperature."}}}},{"__typename":"TextBlock","type":"text","params":{"layout":"","chapter":null,"chapterHeader":null,"html1":"\u003cp\u003e\u003cstrong\u003eNote:\u003c/strong\u003e This dish can be made a day ahead and served at room temperature the next day.\u003c/p\u003e","isDropcap":false,"serializedReact":{"type":"p","key":null,"ref":null,"props":{"children":[{"type":"strong","key":"0","ref":null,"props":{"children":"Note:"}}," This dish can be made a day ahead and served at room temperature the next day."]}}}},{"__typename":"ZoneBlock","type":"zone","params":{"layout":null,"chapter":null,"chapterHeader":null,"eid":"item-101919","embed":{"__type":"blueConicFreeformEmbed","__id":"NewsletterSignup","__data":{"variant":"drinkingWithEsther:articleBottom"},"__tpId":"NewsletterSignup"},"guid":"zoneInlineA","widgets":null}}],"__typename":"Article","type":"articleBody"}],"id":"articleBody","type":"ArticleBody","options":{"hasChapters":false}},{"items":[{"authors":[{"name":"Amisha Gurbani","firstName":"Amisha","lastName":"Gurbani","title":null,"biography":null,"url":null,"slug":null,"email":null,"displayEmail":null,"facebook":null,"linkedIn":null,"instagram":null,"twitter":null,"tiktok":null,"bluesky":null,"hasContact":null,"primarySiteId":null,"sponsorLogoUrl":null,"originId":null,"image":null}],"publishedOnline":"2026-07-03 04:00:19","lastPublishedDisplayed":"2026-07-03 04:00:19","tagBubbles":[],"__typename":"Article","type":"articleFooter"}],"id":"articleFooter","type":"ArticleFooter","options":{"placement":"main","removeTimestamp":false}}]},{"id":"pzoneC","options":{},"widgets":[{"id":"0","type":"Ad","options":{"hideOnMobile":true,"sticky":true,"large":"A300","adUnitPath":"hnp-sfchronicle.com/article_dtc","hasChapters":false},"items":[]},{"eid":"collection-123603-dynamic_featured_story","collections":[],"items":[{"__typename":"Link","type":"link","id":"260127","eid":"link-260127","url":"https://www.sfchronicle.com/projects/2026/top-100-best-restaurants-san-francisco-bay-area/","title":"Top 100 Restaurants in the Bay Area","abstract":"Our restaurant critics rank the best places to eat, from 100 to the new No. 1. This year’s list reflects changes in the dining landscape — and San Francisco’s resurgence on the scene.","plainTextAbstract":"Our restaurant critics rank the best places to eat, from 100 to the new No. 1. This year’s list reflects changes in the dining landscape — and San Francisco’s resurgence on the scene.","excerpt":"Our restaurant critics rank the best places to eat, from 100 to the new No. 1. This year’s list reflects changes in the dining landscape — and San Francisco’s resurgence on the scene.","eyebrow":{"linkText":"Best Restaurants","url":"/best-restaurants/"},"badge":null,"displayedDate":"2026-04-06 08:00:00","authorName":"MacKenzie Chung Fegan","authors":[{"id":6574,"name":"MacKenzie Chung Fegan","title":"Restaurant Critic","url":"/author/mackenzie-chung-fegan/","credit":"Restaurant Critic","image":{"id":24772553,"url":null,"base64":"data:image/jpeg;base64,","width":1365,"height":2048,"guid":"photo_24772553","dirPath":"01/36/37/77/24772553/3","alt":"A portrait of San Francisco Chronicle lead restaurant critic MacKenzie Chung Fegan in San Francisco on Wednesday, Feb. 28, 2024.","title":"foodteam"}},{"id":1721,"name":"Cesar Hernandez","title":"Restaurant Critic","url":"/author/cesar-hernandez/","credit":"Restaurant Critic"