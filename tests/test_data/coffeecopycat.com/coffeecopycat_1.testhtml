n":1,"name":"Home","item":"https://coffeecopycat.com/"},{"@type":"ListItem","position":2,"name":"Coffee Copycat","item":"https://coffeecopycat.com/delicious-coffee-at-home/"},{"@type":"ListItem","position":3,"name":"Recipes","item":"https://coffeecopycat.com/category/recipes/"},{"@type":"ListItem","position":4,"name":"Easy Homemade Eggnog"}]},{"@type":"WebSite","@id":"https://coffeecopycat.com/#website","url":"https://coffeecopycat.com/","name":"coffeecopycat.com","description":"Delicious Coffee At Home!","potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://coffeecopycat.com/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Person","@id":"https://coffeecopycat.com/#/schema/person/b571eabf6943b7a3f58a63bb64da9949","name":"Megan Byrd","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https://coffeecopycat.com/#/schema/person/image/","url":"https://secure.gravatar.com/avatar/5df39a51473d96f32bae15d6155dc06aa71ba6d6dc9e6638a38865629a4e6f16?s=96&d=mm&r=g","contentUrl":"https://secure.gravatar.com/avatar/5df39a51473d96f32bae15d6155dc06aa71ba6d6dc9e6638a38865629a4e6f16?s=96&d=mm&r=g","caption":"Megan Byrd"},"url":"https://coffeecopycat.com/author/mbyrd/"},{"@type":"Question","@id":"https://coffeecopycat.com/easy-homemade-eggnog/#faq-question-1613018242329","position":1,"url":"https://coffeecopycat.com/easy-homemade-eggnog/#faq-question-1613018242329","name":"Does homemade eggnog taste like store-bought?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Homemade eggnog tastes noticeably richer and more luxurious than store-bought. It has a silky, custard-like texture and a balanced sweetness, with warm notes of cinnamon, nutmeg, and vanilla that shine through naturally. In contrast, store-bought eggnog tends to be cloyingly sweet and often leaves a synthetic aftertaste thanks to artificial extracts. <br/>","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https://coffeecopycat.com/easy-homemade-eggnog/#faq-question-1762025555056","position":2,"url":"https://coffeecopycat.com/easy-homemade-eggnog/#faq-question-1762025555056","name":"Is homemade eggnog healthy?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"No matter how you slice it, eggnog is a dessert, but the homemade version is often a healthier option than many store-bought versions. Made with real, whole ingredients like milk, cream, eggs, and spices, it skips the preservatives, thickeners, and artificial flavors often found in cartons. So while it’s indulgent, at least you know every sip comes from simple, wholesome ingredients.<br/>","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https://coffeecopycat.com/easy-homemade-eggnog/#faq-question-1762025575056","position":3,"url":"https://coffeecopycat.com/easy-homemade-eggnog/#faq-question-1762025575056","name":"Do I need heavy cream for eggnog?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"You don’t <em>have</em> to use heavy cream in eggnog, but it’s what gives the drink its rich, velvety texture. Just keep in mind the less cream you use, the thinner and less decadent your eggnog will be.<br/>","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https://coffeecopycat.com/easy-homemade-eggnog/#faq-question-1762025592222","position":4,"url":"https://coffeecopycat.com/easy-homemade-eggnog/#faq-question-1762025592222","name":"Can you freeze eggnog?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Yes, you can freeze eggnog, but be prepared for a slight change in texture once it thaws. The mixture may separate a bit or turn slightly grainy due to the cream and eggs, but a good whisk or quick blend will usually smooth it out. Pour it into an airtight container, leaving a little room at the top for expansion. When you’re ready to enjoy it, thaw it overnight in the fridge and give it a good whisk or blend before serving to restore its creamy texture. Alternatively, churn it in an ice cream maker then store and serve like ice cream!<br/>","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Recipe","name":"Easy Homemade Eggnog","author":{"@id":"https://coffeecopycat.com/#/schema/person/b571eabf6943b7a3f58a63bb64da9949"},"description":"This Easy Homemade Eggnog recipe tastes better than any store-bought version—especially with added rum.","datePublished":"2025-11-01T13:21:37+00:00","image":["https://coffeecopycat.com/wp-content/uploads/2025/10/HomemadeEggnog-1200x1200-1.jpg","https://coffeecopycat.com/wp-content/uploads/2025/10/HomemadeEggnog-1200x1200-1-500x500.jpg","https://coffeecopycat.com/wp-content/uploads/2025/10/HomemadeEggnog-1200x1200-1-500x375.jpg","https://coffeecopycat.com/wp-content/uploads/2025/10/HomemadeEggnog-1200x1200-1-480x270.jpg"],"recipeYield":["7","7 servings"],"prepTime":"PT5M","cookTime":"PT5M","totalTime":"PT10M","recipeIngredient":["6 large egg yolks","¾ cup granulated sugar","2 cups whole milk","1 cup heavy cream","½ tsp cinnamon","½ tsp nutmeg","1 tsp vanilla extract","½ cup spiced rum ((optional))"],"recipeInstructions":[{"@type":"HowToStep","text":"Place your egg yolks and granulated sugar in a medium mixing bowl and whisk until pale yellow and foamy, about 1 minute. Set aside.","name":"Place your egg yolks and granulated sugar in a medium mixing bowl and whisk until pale yellow and foamy, about 1 minute. Set aside.","url":"https://coffeecopycat.com/easy-homemade-eggnog/#wprm-recipe-7459-step-0-0"},{"@type":"HowToStep","text":"In a medium saucepan, add milk, heavy cream, cinnamon, and nutmeg and whisk to combine over medium heat. Continue whisking until the mixture barely reaches a simmer, then immediately remove from heat.","name":"In a medium saucepan, add milk, heavy cream, cinnamon, and nutmeg and whisk to combine over medium heat. Continue whisking until the mixture barely reaches a simmer, then immediately remove from heat.","url":"https://coffeecopycat.com/easy-homemade-eggnog/#wprm-recipe-7459-step-0-1"},{"@type":"HowToStep","text":"While whisking the egg mixture continuously, ladle about ¼ cup of the hot milk mixture into the bowl with the egg mixture and whisk to completely combine. Continue to do this ¼ cup at a time until you&#39;ve run out of the milk mixture. Note: this is a key step that needs to be completed gradually, and if rushed, you&#39;ll end up with scrambled eggs!","name":"While whisking the egg mixture continuously, ladle about ¼ cup of the hot milk mixture into the bowl with the egg mixture and whisk to completely combine. Continue to do this ¼ cup at a time until you&#39;ve run out of the milk mixture. Note: this is a key step that needs to be completed gradually, and if rushed, you&#39;ll end up with scrambled eggs!","url":"https://coffeecopycat.com/easy-homemade-eggnog/#wprm-recipe-7459-step-0-2"},{"@type":"HowToStep","text":"Pour the eggnog back into the saucepan and add vanilla extract and alcohol, if using.  Heat over medium heat for 1-2 minutes until slightly thickened, stirring continuously. It will continue to thicken as it cools.","name":"Pour the eggnog back into the saucepan and add vanilla extract and alcohol, if using.  Heat over medium heat for 1-2 minutes until slightly thickened, stirring continuously. It will continue to thicken as it cools.","url":"https://coffeecopycat.com/easy-homemade-eggnog/#wprm-recipe-7459-step-0-3"},{"@type":"HowToStep","text":"Strain the eggnog into a large mason jar or pitcher, then store in the fridge for up to 7 days.","name":"Strain the eggnog into a large mason jar or pitcher, then store in the fridge for up to 7 days.","url":"https://coffeecopycat.com/easy-homemade-eggnog/#wprm-recipe-7459-step-0-4"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"5","ratingCount":"1"},"recipeCategory":["Drinks"],"recipeCuisine":["American"],"keywords":"Homemade Eggnog","nutrition":{"@type":"NutritionInformation","servingSize":"0.5 cup","calories":"290 kcal","carbohydrateContent":"26 g","proteinContent":"5 g","fatContent":"18 g","sodiumContent":"41 mg","sugarContent":"26 g"},"@id":"https://coffeecopycat.com/easy-homemade-eggnog/#recipe","isPartOf":{"@id":"https://coffeecopycat.com/easy-homemade-eggnog/"},"mainEntityOfPage":"https://coffeecopycat.com/easy-homemade-eggnog/"}]}</script>
