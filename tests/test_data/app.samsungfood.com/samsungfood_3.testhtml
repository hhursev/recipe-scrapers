    "recipe": {
      "id": "10701a0b3571f7f7b13a1962c878b380cdd",
      "name": "Grain-free Granola",
      "description": "One of the biggest questions I get is “What can I have instead of cereal?” Yes, if you’re following my approach, conventional breakfast cereal is off the table. My recipe for grain-free granola gives you the satisfaction of a crunchy, lightly sweet “cereal” without the refined grains.",
      "ingredients": [
        {
          "text": "¼ cup coconut oil or butter, melted"
        },
        {
          "text": "3 cups unsweetened coconut flakes"
        },
        {
          "text": "1 cup sliced almonds"
        },
        {
          "text": "1 cup nuts; chopped, walnuts, pecans, hazelnuts, macadamia nuts"
        },
        {
          "text": "2 tablespoons chia seeds, whole"
        },
        {
          "text": "2 tablespoons pure maple syrup"
        },
        {
          "text": "2 teaspoons ground cinnamon"
        },
        {
          "text": "¼ teaspoon ground nutmeg"
        },
        {
          "text": "½ teaspoon sea salt"
        }
      ],
      "instructions": {
        "steps": [
          {
            "text": "1. Melt coconut oil or butter in a small saucepan."
          },
          {
            "text": "2. Mix with remaining ingredients."
          },
          {
            "text": "3. Spread onto a large baking sheet and bake for 25 minutes at 275 degrees until golden brown and fragrant. Be sure not to over-bake. Granola will crisp as it cools."
          },
          {
            "text": "4. Store at room temperature in an airtight container for up to 1 month."
          }
        ]
      },
