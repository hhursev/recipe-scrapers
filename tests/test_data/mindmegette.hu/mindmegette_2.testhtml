50LzFiZWU3NmI0ZDE5ZDQzNGE4NGYyMzZlMzlmNjA3NzQz.webp","4:3":"https://cdn.mindmegette.hu/2026/10/IwzOOIpYOlUEH6_9mERpHjkvX71rDY7QKWSmh9WJ-Yc/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50L2I2NmMzMmQ0MDYwMDQ1ZTRiZGNkZWMwYzNjYmJhZTUx.webp"}}],"info":[],"meta":{"responseType":"list","dataCount":6,"requestUrl":null,"filterable":[],"orderable":[],"limitable":{"pageCurrent":null,"pageMax":null,"rowAllCount":null,"rowFrom":0,"rowOnPageCount":20}}},"h":{},"s":200,"st":"OK","u":"https://api.mindmegette.hu/publicapi/hu/gastro/experience-occasion/highlighted-in-tape-list","rt":"json"},"2568095237":{"b":{"data":{"commentCount":0,"disableComments":false},"info":[],"meta":{"responseType":"item","dataCount":2,"requestUrl":null}},"h":{},"s":200,"st":"OK","u":"https://api.mindmegette.hu/publicapi/hu/recipe/1f1cbb33-e0f8-6d6c-95f6-61dcb2292acf/social-count","rt":"json"},"2859482702":{"b":{"data":{"id":"1f1cbb33-e0f8-6d6c-95f6-61dcb2292acf","title":"Rákóczi túrós torta","breadcrumbTitle":null,"slug":"a-legfinomabb-rakoczi-turos-torta","recommendedTitle":null,"coverImage":{"fullSizeUrl":"https://cdn.mindmegette.hu/2026/10/KSW5eVc2_WNx7YRFR1VCVFaN1uC4UxxhMpYwKJZnnzo/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzMxYzBmMzczNmRhMzQyNzNhMjBjOTg3YzJkMDhlNmFi.webp","thumbnailUrl":"https://cdn.mindmegette.hu/2026/10/CAL64Fm8PT2EPbm37jSuEQITV242PBUYdyG6m79NsIk/fill/0/0/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzM2NmZjNjkyNjdkYzRhZTFiM2YzOTI0NmM3ZTA2YmQw.webp"},"description":"A rögös túrót egy habverőfej segítségével szép krémesre tudjuk dolgozni. Megmarad a darabos állaga, mégis lágyabb lesz.","makingText":[{"type":"Basic.Wysiwyg.Wysiwyg","id":"03e88bee-e163-49b3-90aa-1d25c737bc0a","details":[{"type":"Basic.Wysiwyg.WysiwygDetail","key":"text","value":"\u003Col>\u003Cli>A Rákóczi túrós torta elkészítését az omlós tésztával kezdjük. Ehhez a lisztet és a porcukrot összekeverjük, hozzáadjuk a kockákra vágott margarint és a sütőport, majd kézzel formázható tésztává gyúrjuk és rögtön kinyújtjuk lisztezett felületen.\u003C/li>\u003Cli>A tésztát beleigazítjuk egy 20 centi átmérőjű tortakarikába, villával több helyen is megszurkáljuk. 160 fokon 10 percig sütjük.\u003C/li>\u003Cli>A túrótöltelékhez a túrót, a cukrot és a búzadarát összekeverjük egy tálban. A tojásokat szétválasztjuk és a sárgáját a túrós masszába dolgozzuk. A túrókrémet ezután a kisült omlós tésztára kanalazzuk, elsimítjuk és 140 fokon 30 perc alatt készre sütjük.\u003C/li>\u003Cli>A habdíszítéshez a korábban félretett tojásfehérjét (kb 10 dekát) és a cukrot vízgőz felett, folyamatos kevergetés mellett felmelegítjük annyira, hogy a cukor teljesen elolvadjon, de a tojásfehérje ne csapódjon még ki. A masszát ezután robotgépbe tesszük és kihűlésig habbá verjük.\u003C/li>\u003Cli>A felvert cukros tojásfehérjét habzsákba töltjük és feldíszítjük vele a Rákóczi túrós tortát.\u003C/li>\u003Cli>A torta tetejének közepére vékonyan kenünk egy kevés baracklekvárt.\u003C/li>\u003Cli>Zsebsárkánnyal pár másodperc alatt szépen aranybarnára pörköljük a tojáshabdíszeket, legvégül pár szelet friss gyümölccsel dekoráljuk a süteményt.\u003C/li>\u003C/ol>\u003Ch2>Videón is megnézheted, hogyan készül a legfinomabb Rákóczi túrós torta:\u003C/h2>"}],"subComponents":[]},{"type":"Media.Video.Video","id":"daa8c898-c86a-4a0c-8994-558d39d10b58","details":[{"type":"Media.Video.VideoDetail","key":"video","value":{"id":"1f1cc766-8636-653e-a440-2bf87c8488fe","slug":"rakoczi-turos-torta","videaUrl":"https://www.youtube.com/shorts/pRzj4lFQk9c","title":"Rákóczi túrós torta","lead":null,"description":null,"isActive":true,"isPublic":true,"isDeleted":false,"createdAt":"2026-10-20 11:07:15","uploadedAt":"2026-10-20 11:07:15","thumbnailUrl":"https://cmscdn.app.content.private/content/8f740c5a73cf4979b15a4cfc7f8a67fa"}}],"subComponents":[]},{"type":"Basic.Wysiwyg.Wysiwyg","id":"65bfe3ed-c6d8-4c4b-a10d-7528b1a5432c","details":[{"type":"Basic.Wysiwyg.WysiwygDetail","key":"text","value":"\u003Cp>&nbsp;\u003C/p>\u003Cp>&nbsp;\u003C/p>"}],"subComponents":[]}],"categories":[{"title":"alapanyagtípus","slug":"alapanyagtipus","hierarchicalSlug":"alapanyagtipus","lead":"alapanyagtípus","id":"fdffc15a-5ade-484b-8fae-70806b7b6a69"},{"title":"alkalom","slug":"alkalom","hierarchicalSlug":"alkalom","lead":"az étel fogyasztása a következő alkalmakkor javasolt","id":"121a2b46-e1c3-4aaa-91b0-9e542622396b"},{"title":"Allergének","slug":"allergenek","hierarchicalSlug":"allergenek","lead":"Allergének a receptben","id":"79365aff-e23b-4880-aced-60eeb8aec670"},{"title":"Buli","slug":"bulira-ajanlott","hierarchicalSlug":"alkalom/bulira-ajanlott","lead":"bulira ajánlott","id":"f571de3d-a8c4-4aa1-8eef-c127ac395f1a"},{"title":"Desszertek","slug":"desszertek","hierarchicalSlug":"desszertek","lead":"desszertek","id":"8a8e689a-c124-4923-b4a1-b0e108c5cc46"},{"title":"Glutént tartalmazó gabonafélék","slug":"glutent-tartalmazo-gabonafelek","hierarchicalSlug":"allergenek/glutent-tartalmazo-gabonafelek","lead":"Glutén","id":"81707df9-5877-4f4e-a44e-15d44d2863ad"},{"title":"Gyerekzsúr","slug":"gyerekzsur","hierarchicalSlug":"alkalom/gyerekzsur","lead":"gyerekzsúr","id":"e3b0eb83-6db3-49d3-b773-ba81cc66e002"},{"title":"Gyertyafényes vacsora","slug":"gyertyafenyes-vacsorak","hierarchicalSlug":"alkalom/gyertyafenyes-vacsorak","lead":"gyertyafényes vacsorák","id":"a471b834-879f-4731-bbd4-9a5bca5bee88"},{"title":"Húsvéti","slug":"husveti-etelek","hierarchicalSlug":"alkalom/husveti-etelek","lead":"húsvéti ételek","id":"db32c582-ba94-49cd-b596-edfb62dd0af4"},{"title":"Karácsonyi","slug":"karacsonyi-etelek","hierarchicalSlug":"alkalom/karacsonyi-etelek","lead":"karácsonyi ételek","id":"fb2dd0f6-035d-45da-b90d-1aa8b6dac94e"},{"title":"magyar","slug":"magyar-etelek","hierarchicalSlug":"nemzetiseg-orszag/magyar-etelek","lead":"magyar ételek","id":"8c485f1f-4913-4957-9f40-0a98151ed8a2"},{"title":"nemzetiség, ország","slug":"nemzetiseg-orszag","hierarchicalSlug":"nemzetiseg-orszag","