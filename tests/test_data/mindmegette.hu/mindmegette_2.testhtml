r-vizsgalat-nkfh","columnSlug":"erdekessegek","columnTitle":"Érdekességek","columnOrder":"0","columnEmphasizeOnArticleCard":0,"recommendedTitle":null,"thumbnail":"https://cdn.mindmegette.hu/2026/10/UGU9ZMPtHOB-WBUJSRmvGPyQMEctdNgX6Tu4-0rSpvQ/fill/1347/758/no/1/aHR0cHM6Ly9jbXNjZG4uYXBwLmNvbnRlbnQucHJpdmF0ZS9jb250ZW50LzVlM2VlMTUyMGIxNDQyYjdhNDM5OWM3ZmM1ZTQ2N2Ey.webp","secondaryThumbnail":null,"author":"Mindmegette  ","avatarImage":null,"columnTitleColor":null,"columnMainColor":null,"brand":"","articleSource":null,"firstTagId":null,"firstRegionId":null,"isPaywalled":"0","isRestricted":"0","isAdultsOnly":false,"hasDossiers":false,"articleMedium":null,"priorityId":"1eeb1332-e7ff-694c-99af-9dcaca4fbae4","hideThumbnailFromBody":"1","minuteToMinute":"not","difficulty":null,"cost":null,"madeForPeople":null,"totalTime":null,"isMmeWarranty":"0","isMaestroAuthor":true,"sentByUserId":null,"facebookTitle":null,"seoImage":null,"magazineCover":null,"podcastGuestName":null,"podcastGuestNameTitle":null,"seoResearchSource":null,"seoCategorySelector":null,"isOpinionType":0,"isShortNewsType":0,"isFastNewsType":0,"isNotebook":0,"isPodcastType":0,"isGalleryType":0,"isGuaranteeType":0,"mediaShows":[],"isShort":null,"videaUrl":null,"authorSlug":"mme-maestro","rank":null,"introduction":null,"thumbnailFocusedImages":[],"regions":[],"tags":[{"id":"1ef7fed8-dc3e-6de4-8e5d-95ac90e78502","slug":"mososzer-2","title":"mosószer"},{"id":"1ef81560-c4e3-6070-a82e-ff3ffdb57e19","slug":"hatosag","title":"hatóság"},{"id":"1f003e7f-0193-696c-9994-b76869056efd","slug":"nemzeti-kereskedelmi-es-fogyasztovedelmi-hatosag","title":"Nemzeti Kereskedelmi és Fogyasztóvédelmi Hatóság"},{"id":"1f1d144c-577a-6d70-9b27-4974655a3d6f","slug":"hatosagi-ellenorzes","title":"hatósági ellenőrzés"}],"likeCount":0,"dislikeCount":0,"commentCount":0,"isCommentsDisabled":false,"isLikesAndDislikesDisabled":false},{"id":"1f1d1364-c370-6496-a137-175f955c7556","contentType":"article","preTitle":null,"isVideo":"0","hasVideo":"0","hasG