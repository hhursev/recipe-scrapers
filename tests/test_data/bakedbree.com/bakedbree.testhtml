ttps:\/\/www.instagram.com\/everythingbakedbree","https:\/\/www.pinterest.com\/bakedbree\/"],"publishingPrinciples":"https:\/\/bakedbree.com\/editorial-policy"},{"@type":"Person","@id":"https:\/\/bakedbree.com\/#\/schema\/person\/57d9a21f355f4efc4379bf20f8caecf7","name":"Amy Golden","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/cdn.bakedbree.com\/uploads\/2025\/02\/Amy_Golden-96x96.jpg","url":"https:\/\/cdn.bakedbree.com\/uploads\/2025\/02\/Amy_Golden-96x96.jpg","contentUrl":"https:\/\/cdn.bakedbree.com\/uploads\/2025\/02\/Amy_Golden-96x96.jpg","caption":"Amy Golden"},"description":"Curious home cook and copyeditor, with a zest for tasting and writing.","url":"https:\/\/bakedbree.com\/author\/goldea"},{"@type":"Recipe","name":"Roasted Red Pepper Pasta","author":{"@id":"https:\/\/bakedbree.com\/#\/schema\/person\/57d9a21f355f4efc4379bf20f8caecf7"},"description":"Mix up your pasta night with this smoky, creamy Roasted Red Pepper Pasta recipe! A vibrant, flavorful alternative to traditional marinara.","datePublished":"2025-12-12T11:34:50+00:00","image":["https:\/\/cdn.bakedbree.com\/uploads\/2025\/12\/a-roasted_red_pepper_pasta-feature-1-1.jpeg","https:\/\/cdn.bakedbree.com\/uploads\/2025\/12\/a-roasted_red_pepper_pasta-feature-1-1-500x500.jpeg","https:\/\/cdn.bakedbree.com\/uploads\/2025\/12\/a-roasted_red_pepper_pasta-feature-1-1-500x375.jpeg","https:\/\/cdn.bakedbree.com\/uploads\/2025\/12\/a-roasted_red_pepper_pasta-feature-1-1-480x270.jpeg"],"recipeYield":["4","4 servings"],"prepTime":"PT10M","cookTime":"PT29M","totalTime":"PT39M","recipeIngredient":["3 medium red peppers (cut into large slices)","1 medium white onion (cut into wedges)","8 garlic cloves (whole)","Olive oil (for roasting)","Kosher salt (for seasoning)","10 ounces penne pasta","1\/2 cup half-and-half","1 tablespoon tomato paste","1 tablespoon dried oregano","1 teaspoon red pepper flakes","1 teaspoon kosher salt (plus more as needed)","1 tablespoon butter","1\/4 cup pasta water (reserved)","Grated Parmesan cheese (for serving)","Fresh basil (for garnish, optional)"],"recipeInstructions":[{"@type":"HowToStep","text":"Preheat your oven to 450°F and line a baking sheet with parchment paper. Place the red peppers, onion, and garlic on the sheet. Drizzle with olive oil and sprinkle kosher salt over the vegetables.","name":"Preheat oven","url":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta#wprm-recipe-280393-step-0-0","image":"https:\/\/cdn.bakedbree.com\/uploads\/2025\/12\/roasted_red_pepper_pasta-step-1-2.jpeg"},{"@type":"HowToStep","text":"Roast the vegetables in the oven for about 25 minutes, or until they are soft and lightly charred.","name":"Roast vegetables","url":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta#wprm-recipe-280393-step-0-1"},{"@type":"HowToStep","text":"Boil salted water in a large pot and cook the penne pasta according to the package directions. Reserve 1\/4 cup of the pasta water before draining.","name":"Cook pasta","url":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta#wprm-recipe-280393-step-0-2"},{"@type":"HowToStep","text":"Place the roasted vegetables in a blender. Add half-and-half, tomato paste, dried oregano, red pepper flakes, and an extra pinch of salt. Blend until the sauce is smooth and creamy.","name":"Blend sauce","url":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta#wprm-recipe-280393-step-0-3","image":"https:\/\/cdn.bakedbree.com\/uploads\/2025\/12\/roasted_red_pepper_pasta-step-4.jpeg"},{"@type":"HowToStep","text":"Return the drained pasta to the pot along with the butter. Pour the blended sauce over the pasta and stir over medium-low heat for 3-4 minutes, adding reserved pasta water if needed to achieve the desired consistency.","name":"Combine","url":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta#wprm-recipe-280393-step-0-4","image":"https:\/\/cdn.bakedbree.com\/uploads\/2025\/12\/roasted_red_pepper_pasta-step-5-2.jpeg"},{"@type":"HowToStep","text":"Plate the pasta and finish with a generous sprinkle of grated Parmesan cheese and a sprinkle of basil, if preferred. Enjoy your meal!","name":"Garnish","url":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta#wprm-recipe-280393-step-0-5"}],"recipeCategory":["dinner"],"recipeCuisine":["Italian"],"keywords":"Roasted Red Pepper Pasta","nutrition":{"@type":"NutritionInformation","calories":"379 kcal","carbohydrateContent":"66 g","proteinContent":"12 g","fatContent":"8 g","saturatedFatContent":"4 g","transFatContent":"0.1 g","cholesterolContent":"18 mg","sodiumContent":"673 mg","fiberContent":"6 g","sugarContent":"9 g","unsaturatedFatContent":"3 g","servingSize":"1 serving"},"@id":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta#recipe","isPartOf":{"@id":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta#article"},"mainEntityOfPage":"https:\/\/bakedbree.com\/roasted-red-pepper-pasta"}]}</script>
