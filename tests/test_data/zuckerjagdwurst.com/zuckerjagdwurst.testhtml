ality=75,format=auto,fit=scale-down/assets/7c3a3e42-966c-5d5d-b556-afbf3c39d6ef/de/ed86eb3d-1469-542f-926c-2d3f04e9bccb.png 864w, https://assets.zuckerjagdwurst.com/cdn-cgi/image/width=1120,quality=75,format=auto,fit=scale-down/assets/7c3a3e42-966c-5d5d-b556-afbf3c39d6ef/de/ed86eb3d-1469-542f-926c-2d3f04e9bccb.png 1120w, https://assets.zuckerjagdwurst.com/cdn-cgi/image/width=1216,quality=75,format=auto,fit=scale-down/assets/7c3a3e42-966c-5d5d-b556-afbf3c39d6ef/de/ed86eb3d-1469-542f-926c-2d3f04e9bccb.png 1216w, https://assets.zuckerjagdwurst.com/cdn-cgi/image/width=1472,quality=75,format=auto,fit=scale-down/assets/7c3a3e42-966c-5d5d-b556-afbf3c39d6ef/de/ed86eb3d-1469-542f-926c-2d3f04e9bccb.png 1472w, https://assets.zuckerjagdwurst.com/cdn-cgi/image/width=1728,quality=75,format=auto,fit=scale-down/assets/7c3a3e42-966c-5d5d-b556-afbf3c39d6ef/de/ed86eb3d-1469-542f-926c-2d3f04e9bccb.png 1728w, https://assets.zuckerjagdwurst.com/cdn-cgi/image/width=2240,quality=75,format=auto,fit=scale-down/assets/7c3a3e42-966c-5d5d-b556-afbf3c39d6ef/de/ed86eb3d-1469-542f-926c-2d3f04e9bccb.png 2240w64:[\"$\",\"img\",null,{\"className\":\"relative block h-auto w-full object-cover md:aspect-5/1\",\"alt\":\"Banner – E-Book – Weihnachtsmenüs\",\"loading\":\"lazy\",\"width\":750,\"height\":500,\"decoding\":\"async\",\"fetchPriority\":\"$undefined\",\"style\":\"$undefined\",\"sizes\":\"(min-width: 1280px) 1120px, (min-width: 1024px) 864px, (min-width: 768px) 736px, (min-width: 640px) 608px, calc(100vw - 32px)\",\"srcSet\":\"$70\",\"src\":\"https://assets.zuckerjagdwurst.com/cdn-cgi/image/width=2240,quality=75,format=auto,fit=scale-down/assets/7c3a3e42-966c-5d5d-b556-afbf3c39d6ef/de/ed86eb3d-1469-542f-926c-2d3f04e9bccb.png\"}]\n66:[\"$\",\"p\",\"102,0\",{\"children\":[\"400 g fertiges Rotkraut\"]}]\n67:[\"$\",\"li\",\"106,0\",{\"children\":[[\"$\",\"p\",\"105,0\",{\"children\":[\"Petersilie\"]}]]}]\n68:[\"$\",\"div\",null,{\"className\":\"w-full md:min-w-0 md:flex-1 print:flex-none\",\"children\":[[\"$\",\"div\",null,{\"data-rich-text-component\":\"\",\"children\":[\"$\",\"h3\",null,{\"className\":\"pt-0 mt-0! text-2xl leading-9 font-bold\",\"children\":\"Zubereitung\"}]}],[\"$\",\"div\",null,{\"className\":\"text-base leading-7 md:text-lg print:text-lg [\u0026\u003ep:empty]:min-h-[1lh]\",\"children\":[[\"$\",\"$1\",\"36\",{\"children\":[[\"$\",\"ol\",\"3,0\",{\"children\":[[\"$\",\"li\",\"2,0\",{\"children\":[[\"$\",\"p\",\"1,0\",{\"children\":[\"Gemüsebrühe und Sojasoße in einem großen Topf aufkochen. Seitan in dünne Streifen schneiden und in der Brühe etwa 10 Minuten köcheln lassen. Die Pul"])</script><script>self.__next_f.push([1,"led Jackfruit abgießen und nach 5 Minuten zum Seitan hinzugeben.\"]}]]}]]}],[\"$\",\"ol\",\"7,0\",{\"start\":2,\"children\":[[\"$\",\"li\",\"6,0\",{\"children\":[[\"$\",\"p\",\"5,0\",{\"children\":[\"Während Seitan und Jackfruit köcheln, für die Marinade in einer Schüssel asiatische Pilz-Würzsoße, Sojasoße, 2 Esslöffel vom Wasser, Olivenöl und Senf vermengen. Dann Majoran, Thymian, Knoblauch- und Zwiebelpulver hinzufügen und gut verrühren.\"]}]]}]]}],[\"$\",\"ol\",\"11,0\",{\"start\":3,\"children\":[[\"$\",\"li\",\"10,0\",{\"children\":[[\"$\",\"p\",\"9,0\",{\"children\":[\"Seitan und Jackfruit abgießen und in den Topf zurückgeben. Die vorbereitete Marinade hinzufügen und die Mischung erneut erhitzen. Speisestärke mit dem restlichen Wasser anrühren, zur Mischung geben und kräftig umrühren, damit die Masse besser zusammenhält.\"]}]]}]]}],[\"$\",\"ol\",\"15,0\",{\"start\":4,\"children\":[[\"$\",\"li\",\"14,0\",{\"children\":[[\"$\",\"p\",\"13,0\",{\"children\":[\"Zwei große, flache Teller nebeneinanderstellen und einen davon mit etwas Wasser befüllen. Ein Blatt Reispapier etwa 15 Sekunden im Wasser anfeuchten und anschließend auf den leeren Teller legen. Unten mittig mit der Schere einen etwa 5 Zentimeter langen Schnitt machen. Eine Zimtstange in diesen Schnitt legen und 2 Esslöffel der vorbereiteten Füllung in die Mitte des Reispapiers geben. Das Reispapier von unten, oben, links und rechts zur Mitte falten. Ein zweites Reispapier anfeuchten, die Keule anheben und das Reispapier auf den leeren Teller legen, erneut einen 5 Zentimeter langen Schnitt machen. Die Keule umdrehen und so platzieren, dass sie mit dem zweiten Reispapier eingehüllt werden kann. Die fertige Keule auf ein Blech mit Backpapier legen.\"]}]]}]]}],[\"$\",\"ol\",\"19,0\",{\"start\":5,\"children\":[[\"$\",\"li\",\"18,0\",{\"children\":[[\"$\",\"p\",\"17,0\",{\"children\":[\"Schritt 4 wiederholen, bis die Füllung aufgebraucht ist – die Zutaten reichen für vier Keulen.\"]}]]}]]}],[\"$\",\"ol\",\"23,0\",{\"start\":6,\"children\":[[\"$\",\"li\",\"22,0\",{\"children\":[[\"$\",\"p\",\"21,0\",{\"children\":[\"Den Backofen auf 190 °C (Umluft) vorheizen. Zum Bestreichen der „Haut“ Olivenöl, Sojasoße und Pilz-Würzsoße vermengen. Anschließend alle Keulen mit einem Pinsel gleichmäßig von beiden Seiten damit bestreichen und 35–40 Minuten im Ofen backen. Nach der Hälfte der Zeit die Keulen wenden. Sie sind fertig, wenn sie außen goldbraun und knusprig sind.\"]}]]}]]}],[\"$\",\"ol\",\"27,0\",{\"start\":7,\"children\":[[\"$\",\"li\",\"26,0\",{\"children\":[[\"$\",\"p\",\"25,0\",{\"children\":[\"Während der Backzeit die Klöße und das Rotkraut nach Packungsanleitung zubereiten.\"]}]]}]]}],[\"$\",\"ol\",\"31,0\",{\"start\":8,\"children\":[[\"$\",\"li\",\"30,0\",{\"children\":[[\"$\",\"p\",\"29,0\",{\"children\":[\"Für die Bratensoße Zwiebel schälen und fein würfeln. Vegane Butter in einem kleinen Topf schmelzen und die Zwiebelwürfel anschwitzen, bis sie glasig sind. Tomatenmark und Senf zugeben und bei mittlerer Hitze 5–10 Minuten anrösten, bis das Tomatenmark bräunt. Mit Mehl bestäuben und sofort mit Gemüsebrühe aufgießen. Mit einem Schneebesen stetig rühren, damit keine Klümpchen entstehen. Die Soße mit Sojasoße, Agavendicksaft und Pfeffer abschmecken.\"]}]]}]]}],\"$L71\"]}]]}]]}]\n71:[\"$\",\"ol\",\"35,0\",{\"start\":9,\"children\":[[\"$\",\"li\",\"34,0\",{\"children\":[[\"$\",\"p\",\"33,0\",{\"children\":[\"Keulen, Klöße und Rotkraut auf einem Teller servieren und mit Bratensoße übergießen. Zum Schluss noch mit etwas Petersilie garnieren.\"]}]]}]]}]\n8:null\nf:[[\"$\",\"title\",\"0\",{\"children\":\"Vegane Entenkeulen mit Klößen und Rotkraut | Rezept | Vegan | Zucker\u0026Jagdwurst\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Ein traditionelles Rezept aber in vegan! Außen unglaublich knusprig und innen schön zart: Mit diesen veganen Entenkeulen überzeugt ihr die ganze Familie.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://www.zuckerjagdwurst.com/de/rezepte/vegane-entenkeulen-mit-kloessen-und-rotkraut\"}],[\"$\",\"link\",\"3\",{\"rel\":\"alternate\",\"hrefLang\":\"en\",\"href\":\"https://www.zuckerjagdwurst.com/en/recipes/vegan-duck-legs-with-dumplings-and-red-cabbage\"}],[\"$\",\"link\",\"4\",{\"rel\":\"alternate\",\"hrefLang\":\"de\",\"href\":\"https://ww"])</script><script>self.__next_f.push([1,"w.zuckerjagdwurst.com/de/rezepte/vegane-entenkeulen-mit-kloessen-und-rotkraut\"}],[\"$\",\"link\",\"5\",{\"rel\":\"alternate\",\"hrefLang\":\"x-default\",\"href\":\"https://www.zuckerjagdwurst.com/de/rezepte/vegane-entenkeulen-mit-kloessen-und-rotkraut\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Vegane Entenkeulen mit Klößen und Rotkraut | Rezept | Vegan\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Ein traditionelles Rezept aber in vegan! Außen unglaublich knusprig und innen schön zart: Mit diesen veganen Entenkeulen überzeugt ihr die ganze Familie.\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:url\",\"content\":\"https://www.zuckerjagdwurst.com/de/rezepte/vegane-entenkeulen-mit-kloessen-und-rotkraut\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:site_name\",\"content\":\"Zucker\u0026Jagdwurst\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:locale\",\"content\":\"de_DE\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:im