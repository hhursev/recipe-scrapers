                                <div class="ingredients-box">
                                    <h3>Těsto</h3>
                                    <ul>
                                                                    <li>
                                                                                                                                                <a href="https://fresh.iprima.cz/suroviny/tvaroh">tvaroh</a>
                                                
                                                                                                    (polo- nebo plnotučný )
                                                                                            
                                                                                            <b>500 g (2 kostky)</b>
                                                                                    </li>
                                                                                                                        <li>
                                                                                                                                                <a href="https://fresh.iprima.cz/suroviny/detska-krupicka">dětská krupička</a>
                                                
                                                                                            
                                                                                            <b>140 g</b>
                                                                                    </li>
                                                                                                                        <li>
                                                                                                                                                <a href="https://fresh.iprima.cz/suroviny/hladka-mouka">hladká mouka</a>
                                                
                                                                                            
                                                                                            <b>140 g</b>
                                                                                    </li>
                                                                                                                        <li>
                                                                                                                                                <a href="https://fresh.iprima.cz/suroviny/maslo">máslo</a>
                                                
                                                                                                    (změklé )
                                                                                            
                                                                                            <b>140 g</b>
                                                                                    </li>
                                                                                                                        <li>
                                                                                                                                                <a href="https://fresh.iprima.cz/suroviny/vejce">vejce</a>
                                                
                                                                                            
                                                                                            <b>2 ks</b>
                                                                                    </li>
                                                                                                                        <li>
                                                                                                                                                <a href="https://fresh.iprima.cz/suroviny/vanilkovy-cukr">vanilkový cukr</a>
                                                
                                                                                            
                                                                                            <b>1 sáček</b>
                                                                                    </li>
                                                                                                                        <li>
                                                                                                                                                <a href="https://fresh.iprima.cz/suroviny/citronova-kura">citronová kůra</a>
                                                
                                                                                                    (nastrouhaná )
                                                                                            
                                                                                            <b>z 1 citronu</b>
                                                                                    </li>
                                                                                                                        <li>
                                                                                                                                                <a href="https://fresh.iprima.cz/suroviny/sul">sůl</a>
                                                
                                                                                            
                                                                                            <b>1 špetka</b>
                                                                                    </li>
                                                                </ul>
                                </div>
                                                                                                                
                                <div class="ingredients-box">
                                    <h3>Rozvar</h3>
                                    <ul>
