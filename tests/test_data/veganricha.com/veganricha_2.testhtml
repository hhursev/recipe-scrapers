	<div class="cwp-food-header__right">
		<div class="wprm-recipe-image wprm-block-image-square nopin"><img decoding="async" style="border-width: 0px;border-style: solid;border-color: #666666;" width="300" height="300" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20300%20300'%3E%3C/svg%3E" class="attachment-300x300 size-300x300" alt="spicy peanut butter ramen in the bowl, after adding tofu, green onions , and sesame seeds" data-lazy-srcset="https://www.veganricha.com/wp-content/uploads/2023/04/Peanut-Gochujang-Ramen-7928-300x300.jpg 300w, https://www.veganricha.com/wp-content/uploads/2023/04/Peanut-Gochujang-Ramen-7928-150x150.jpg 150w, https://www.veganricha.com/wp-content/uploads/2023/04/Peanut-Gochujang-Ramen-7928-500x500.jpg 500w, https://www.veganricha.com/wp-content/uploads/2023/04/Peanut-Gochujang-Ramen-7928-720x720.jpg 720w, https://www.veganricha.com/wp-content/uploads/2023/04/Peanut-Gochujang-Ramen-7928-360x360.jpg 360w, https://www.veganricha.com/wp-content/uploads/2023/04/Peanut-Gochujang-Ramen-7928-180x180.jpg 180w, https://www.veganricha.com/wp-content/uploads/2023/04/Peanut-Gochujang-Ramen-7928-96x96.jpg 96w" data-lazy-sizes="(max-width: 300px) 100vw, 300px" data-pin-description="Spicy peanut butter ramen is an absolute comfort food recipe with a delicious, creamy broth, gochujang flavors, and lots of ginger and garlic. It's a 30-minute, one-pan meal!" data-pin-title="Spicy Peanut Butter Ramen" data-pin-url="https://www.veganricha.com/spicy-peanut-butter-ramen/?tp_image_id=50600" data-jpibfi-post-excerpt="Spicy peanut butter ramen is an absolute comfort food recipe with a delicious, creamy broth, gochujang flavors, and lots of ginger and garlic. It's a 30-minute, one-pan meal!" data-jpibfi-post-url="https://www.veganricha.com/spicy-peanut-butter-ramen/" data-jpibfi-post-title="Peanut Gochujang Ramen" data-jpibfi-src="https://www.veganricha.com/wp-content/uploads/2023/04/Peanut-Gochujang-Ramen-7928-300x300.jpg" data-lazy-src="https://www.veganricha.com