Url\":null,\"part\":1,\"ingredients\":[{\"ingredientId\":\"dKbzPtdT2UJIrCQ6XSYc\",\"name\":\"tijm\",\"quantity\":4,\"quantityUnit\":\"sprig\",\"_quantityUnit\":\"sprig\",\"pSrc\":\"tijm\",\"src\":\"4 takje tijm\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"PnwDjhvqXLPjWXN4x1i5\",\"name\":\"laurier\",\"quantity\":4,\"quantityUnit\":\"blaadje\",\"_quantityUnit\":null,\"pSrc\":\"laurier\",\"src\":\"4 blaadje laurier\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"CTqUwHim2bWI0cNJzjAc\",\"name\":\"rozemarijn\",\"quantity\":2,\"quantityUnit\":\"sprig\",\"_quantityUnit\":\"sprig\",\"pSrc\":\"rozemarijn\",\"src\":\"2 takje rozemarijn\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"3puC0xYh7GH7WAidkPby\",\"name\":\"peterseliestengel\",\"quantity\":1,\"quantityUnit\":\"bunch\",\"_quantityUnit\":\"bunch\",\"pSrc\":\"peterseliestengel\",\"src\":\"1 bussel peterseliestengel\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"03PqpJcNfTQlI0NM5uMe\",\"name\":\"zout\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"zout\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"Uq6c4War8QleU5J7dYyh\",\"name\":\"zwarte peper\",\"quantity\":15,\"quantityUnit\":\"bolletje\",\"_quantityUnit\":null,\"pSrc\":\"bolletje zwarte peper\",\"src\":\"15 bolletje zwarte peper\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"RuLrLBxhfJKDhnwznkGW\",\"name\":\"kruidnagels\",\"quantity\":2,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"kruidnagels\",\"src\":\"2 kruidnagels\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/2/1693761967485_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/2/1693761967485_200x200\",\"howToId\":null,\"step\":3,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/95d382ef-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Voeg de verse kruiden, wat zout en de specerijen toe.\",\"tip\":\" De bolletjes peper kneus je bij voorkeur in de vijzel.\",\"translatedDescription\":{\"es\":\"Agregue las hierbas frescas, un poco de sal y las especias.\",\"fr\":\"Ajouter les herbes fraîches, un peu de sel et les épices.\",\"it\":\"Aggiungere le erbe fresche, un po' di sale e le spezie.\",\"nl\":\"Voeg de verse kruiden, wat zout en de specerijen toe.\",\"de\":\"Fügen Sie die frischen Kräuter, etwas Salz und die Gewürze hinzu.\",\"en\":\"Add the fresh herbs, some salt and the spices.\"}},{\"videoUrl\":null,\"part\":1,\"ingredients\":[{\"ingredientId\":\"sit98K4fRxTJR4J9JNjC\",\"name\":\"hoevekip\",\"quantity\":1,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"hoevekip\",\"src\":\"1 hoevekip\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/3/1693761967764_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/3/1693761967764_200x200\",\"howToId\":null,\"step\":4,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9633cb60-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Laat de bouillon kort sudderen en leg er vervolgens de kip in.\",\"tip\":\"Het is belangrijk dat de kip in warme bouillon wordt ondergedompeld.\",\"translatedDescription\":{\"es\":\"Deje que el caldo hierva a fuego lento brevemente y luego ponga el pollo en él.\",\"fr\":\"Laissez mijoter brièvement le bouillon puis mettez-y le poulet.\",\"it\":\"Lasciate sobbollire brevemente il brodo e poi metteteci dentro il pollo.\",\"nl\":\"Laat de bouillon kort sudderen en leg er vervolgens de kip in.\",\"de\":\"Die Brühe kurz köcheln lassen und dann das Hühnchen hineingeben.\",\"en\":\"Let the broth simmer briefly and then put the chicken in it.\"}},{\"videoUrl\":null,\"part\":1,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/4/1693761968230_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/4/1693761968230_200x200\",\"howToId\":null,\"step\":5,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/969b3fc1-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Laat de kippenbouillon een uurtje koken. Gebruik een schuimspaan om tussendoor het vet en onzuiverheden weg te scheppen.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Deja hervir el caldo de pollo durante una hora. Use una cuchara ranurada para quitar la grasa y las impurezas en el medio.\",\"fr\":\"Laissez bouillir le bouillon de poulet pendant une heure. Utilisez une écumoire pour écumer la graisse et les impuretés entre les deux.\",\"it\":\"Lascia bollire il brodo di pollo per un'ora. Usa una schiumarola per eliminare il grasso e le impurità nel mezzo.\",\"nl\":\"Laat de kippenbouillon een uurtje koken. Gebruik een schuimspaan om tussendoor het vet en onzuiverheden weg te scheppen.\",\"de\":\"Die Hühnerbrühe eine Stunde kochen lassen. Zwischendurch Fett und Unreinheiten mit einer Schaumkelle abschöpfen.\",\"en\":\"Let the chicken broth boil for an hour. Use a slotted spoon to skim away the fat and impurities in between.\"}},{\"videoUrl\":null,\"part\":1,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/5/1693761968506_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/5/1693761968506_200x200\",\"howToId\":null,\"step\":6,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9709b902-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Schep de gare kip uit de pot en laat ze afkoelen.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Retire el pollo cocido de la olla y déjelo enfriar.\",\"fr\":\"Retirez le poulet cuit de la casserole et laissez-le refroidir.\",\"it\":\"Rimuovere il pollo cotto dalla pentola e lasciarlo raffreddare.\",\"nl\":\"Schep de gare kip uit de pot en laat ze afkoelen.\",\"de\":\"Das gekochte Hähnchen aus dem Topf nehmen und abkühlen lassen.\",\"en\":\"Remove the cooked chicken from the pot and let it cool.\"}},{\"videoUrl\":null,\"part\":1,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/6/1693761968823_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/6/1693761968823_200x200\",\"howToId\":null,\"step\":7,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/977ec1f3-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Zeef de bouillon. Een deel ervan heb je straks nodig voor het garen van de gehaktballetjes en de bereiding van de saus.\",\"tip\":\"De rest van de bouillon kan je invriezen voor diverse soepen.\",\"translatedDescription\":{\"es\":\"Colar el caldo. Una parte la necesitarás más tarde para cocinar las albóndigas y preparar la salsa.\",\"fr\":\"Filtrer le bouillon. Vous en aurez besoin plus tard pour la cuisson des boulettes de viande et la préparation de la sauce.\",\"it\":\"Filtrare il brodo. Ne servirà una parte in seguito per cuocere le polpette e preparare il sugo.\",\"nl\":\"Zeef de bouillon. Een deel ervan heb je straks nodig voor het garen van de gehaktballetjes en de bereiding van de saus.\",\"de\":\"Die Brühe abseihen. Einen Teil davon benötigst du später zum Kochen der Fleischbällchen und zum Zubereiten der Sauce.\",\"en\":\"Strain the broth. You will need part of it later for cooking the meatballs and preparing the sauce.\"}}],\"ingredients\":[{\"ingredientId\":\"1PjaLqNkVlWTLo9coVXl\",\"name\":\"selder\",\"quantity\":4,\"quantityUnit\":\"stengel\",\"_quantityUnit\":null,\"pSrc\":\"selder\",\"src\":\"4 stengel selder\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"KWfMFHZSssSq15X8Aj1B\",\"name\":\"dikke wortelen\",\"quantity\":2,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"dikke wortelen\",\"src\":\"2 dikke wortelen\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"6HzfKbR3ShiQq3rZKKG8\",\"name\":\"preistengels\",\"quantity\":2,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"preistengels\",\"src\":\"2 preistengels\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"XReLjOddXzz4UfOMonF6\",\"name\":\"uien\",\"quantity\":3,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"uien\",\"src\":\"3 uien\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"Ew6nBUPwhee3JfyX7LmW\",\"name\":\"look\",\"quantity\":4,\"quantityUnit\":\"clove\",\"_quantityUnit\":\"clove\",\"pSrc\":\"look\",\"src\":\"4 teentje look\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"dKbzPtdT2UJIrCQ6XSYc\",\"name\":\"tijm\",\"quantity\":4,\"quantityUnit\":\"sprig\",\"_quantityUnit\":\"sprig\",\"pSrc\":\"tijm\",\"src\":\"4 takje tijm\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"PnwDjhvqXLPjWXN4x1i5\",\"name\":\"laurier\",\"quantity\":4,\"quantityUnit\":\"blaadje\",\"_quantityUnit\":null,\"pSrc\":\"laurier\",\"src\":\"4 blaadje laurier\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"CTqUwHim2bWI0cNJzjAc\",\"name\":\"rozemarijn\",\"quantity\":2,\"quantityUnit\":\"sprig\",\"_quantityUnit\":\"sprig\",\"pSrc\":\"rozemarijn\",\"src\":\"2 takje rozemarijn\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"3puC0xYh7GH7WAidkPby\",\"name\":\"peterseliestengel\",\"quantity\":1,\"quantityUnit\":\"bunch\",\"_quantityUnit\":\"bunch\",\"pSrc\":\"peterseliestengel\",\"src\":\"1 bussel peterseliestengel\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"03PqpJcNfTQlI0NM5uMe\",\"name\":\"zout\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"zout\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"Uq6c4War8QleU5J7dYyh\",\"name\":\"zwarte peper\",\"quantity\":15,\"quantityUnit\":\"bolletje\",\"_quantityUnit\":null,\"pSrc\":\"bolletje zwarte peper\",\"src\":\"15 bolletje zwarte peper\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"RuLrLBxhfJKDhnwznkGW\",\"name\":\"kruidnagels\",\"quantity\":2,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"kruidnagels\",\"src\":\"2 kruidnagels\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"sit98K4fRxTJR4J9JNjC\",\"name\":\"hoevekip\",\"quantity\":1,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"hoevekip\",\"src\":\"1 hoevekip\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"placeholderPart\":false},{\"title\":\"Bladerdeegkoekjes\",\"instructions\":[{\"videoUrl\":null,\"part\":2,\"ingredients\":[{\"ingredientId\":\"4yVbtH6cPzYsrr9VCW9l\",\"name\":\"bladerdeeg\",\"quantity\":2,\"quantityUnit\":\"vel\",\"_quantityUnit\":null,\"pSrc\":\"vel bladerdeeg\",\"src\":\"2 vel bladerdeeg\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/7/1693761972300_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/7/1693761972300_200x200\",\"howToId\":null,\"step\":8,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/97e8ce64-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Maak zelf de bladerdeegkoekjes om de vulling in te scheppen.\",\"tip\":\"Je kan de bladerdeegkoekjes natuurlijk ook aankopen bij de warme bakker.\",\"translatedDescription\":{\"es\":\"Haga las galletas de hojaldre usted mismo para verter el relleno.\",\"fr\":\"Préparez vous-même les biscuits feuilletés pour y verser la garniture.\",\"it\":\"Preparate voi stessi i biscotti di pasta sfoglia per insaporire il ripieno.\",\"nl\":\"Maak zelf de bladerdeegkoekjes om de vulling in te scheppen.\",\"de\":\"Machen Sie die Blätterteigkekse selbst, um die Füllung hineinzuschaufeln.\",\"en\":\"Make the puff pastry biscuits yourself to scoop in the filling.\"}},{\"videoUrl\":null,\"part\":2,\"ingredients\":[{\"ingredientId\":\"DxWNS7Ygw6InHZCohUPj\",\"name\":\"eierdooiers\",\"quantity\":1,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"eigeel\",\"src\":\"1 eigeel\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"eedV1oSNgj4rM00WPf1x\",\"name\":\"beetje water\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"beetje water\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/8/1693761972552_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/8/1693761972552_200x200\",\"howToId\":null,\"step\":9,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/984e6e05-0252-11e7-8f5f-00163edf48dd.jpg\",\"utensilIds\":[],\"description\":\"Klop een dooier los met een klein beetje water.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Batir una yema con un poco de agua.\",\"fr\":\"Battre un jaune avec un peu d'eau.\",\"it\":\"Sbattere un tuorlo con un po' d'acqua.\",\"nl\":\"Klop een dooier los met een klein beetje water.\",\"de\":\"Ein Eigelb mit etwas Wasser aufschlagen.\",\"en\":\"Beat a yolk with a little water.\"}},{\"videoUrl\":null,\"part\":2,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/9/1693761972805_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/9/1693761972805_200x200\",\"howToId\":null,\"step\":10,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/98ad56e6-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Verwarm de oven voor tot 180°C.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Precalentar el horno a 180°C.\",\"fr\":\"Préchauffer le four à 180°C.\",\"it\":\"Preriscaldare il forno a 180°C.\",\"nl\":\"Verwarm de oven voor tot 180°C.\",\"de\":\"Backofen auf 180°C vorheizen.\",\"en\":\"Preheat the oven to 180°C.\"}},{\"videoUrl\":null,\"part\":2,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/10/1693761973418_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/10/1693761973418_200x200\",\"howToId\":null,\"step\":11,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/99154077-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Steek per gebakje een zestal ringen uit het vel bladerdeeg. Gebruik hiervoor een grote dresseerring. Steek uit vier van elke zes lapjes een rondje met behulp van een kleinere dresseerring. Bouw elk kuipje op: onderaan een ronde lap, daarboven vier ‘ringen’ van bladerdeeg, en bovenaan opnieuw een ronde lap. Lijm alle onderdelen aan mekaar met een laagje losgeklopte dooier. Strijk ook eigeel over de bovenkant van het gebakje, zodat het glanzend uit de oven komt. Gebruik een borsteltje om handig te werken.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Cortar seis anillos de la lámina de hojaldre por hojaldre. Use un anillo de vendaje grande para esto. Corta un círculo de cuatro de cada seis piezas usando un aro más pequeño. Construya cada tina: una pieza redonda en la parte inferior, cuatro 'anillos' de hojaldre en la parte superior y otra pieza redonda en la parte superior. Pegue todas las partes con una capa de yema batida. Pintar también la yema de huevo por encima de la masa, para que salga brillante del horno. Use un cepillo para trabajar a mano.\",\"fr\":\"Découpez six cercles dans la feuille de pâte feuilletée par pâte. Utilisez un grand anneau de pansement pour cela. Coupez un cercle de quatre pièces sur six à l'aide d'un anneau de dressage plus petit. Construisez chaque pot : un morceau rond en bas, quatre \\\"anneaux\\\" de pâte feuilletée en haut et un autre morceau rond en haut. Collez toutes les pièces ensemble avec une couche de jaune battu. Badigeonnez également de jaune d'œuf le dessus de la pâte afin qu'elle ressorte du four brillante. Utilisez une brosse pour travailler à portée de main.\",\"it\":\"Tagliare sei anelli dal foglio di pasta sfoglia per pasta. Usa un grande anello di medicazione per questo. Taglia un cerchio su quattro pezzi ogni sei usando un anello di ravvivatura più piccolo. Costruisci ogni vasca: un pezzo rotondo sul fondo, quattro \\\"anelli\\\" di pasta sfoglia sopra e un altro pezzo rotondo sopra. Incolla tutte le parti insieme con uno strato di tuorlo sbattuto. Spennellare anche il tuorlo d'uovo sulla parte superiore della pasta, in modo che esca lucida dal forno. Usa un pennello per lavorare a portata di mano.\",\"nl\":\"Steek per gebakje een zestal ringen uit het vel bladerdeeg. Gebruik hiervoor een grote dresseerring. Steek uit vier van elke zes lapjes een rondje met behulp van een kleinere dresseerring. Bouw elk kuipje op: onderaan een ronde lap, daarboven vier ‘ringen’ van bladerdeeg, en bovenaan opnieuw een ronde lap. Lijm alle onderdelen aan mekaar met een laagje losgeklopte dooier. Strijk ook eigeel over de bovenkant van het gebakje, zodat het glanzend uit de oven komt. Gebruik een borsteltje om handig te werken.\",\"de\":\"Aus der Blätterteigplatte pro Gebäck sechs Ringe schneiden. Verwenden Sie dazu einen großen Dressingring. Schneiden Sie mit einem kleineren Dressingring aus vier von jeweils sechs Stücken einen Kreis aus. Bauen Sie jede Wanne auf: ein rundes Stück unten, vier Blätterteigringe oben und ein weiteres rundes Stück oben. Kleben Sie alle Teile mit einer Schicht Eigelb zusammen. Auch den Teig mit Eigelb bestreichen, damit er glänzend aus dem Ofen kommt. Verwenden Sie einen Pinsel, um handlich zu arbeiten.\",\"en\":\"Cut six rings from the sheet of puff pastry per pastry. Use a large dressing ring for this. Cut a circle out of four of every six pieces using a smaller dressing ring. Build up each tub: a round piece at the bottom, four 'rings' of puff pastry on top, and another round piece on top. Glue all parts together with a layer of beaten yolk. Also brush egg yolk over the top of the pastry, so that it comes out of the oven shiny. Use a brush to work handy.\"}},{\"videoUrl\":null,\"part\":2,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/11/1693761973693_1080x1920\",\"timers\":[1200],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/11/1693761973693_200x200\",\"howToId\":null,\"step\":12,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/99854058-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Bak de kuipjes in de oven tot ze luchtig en goudbruin zijn. Reken een baktijd van ongeveer 20 minuten op 180°C.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Hornee las tinas en el horno hasta que estén esponjosas y doradas. Cuente con un tiempo de horneado de unos 20 minutos a 180°C.\",\"fr\":\"Cuire les pots au four jusqu'à ce qu'ils soient mousseux et dorés. Comptez un temps de cuisson d'environ 20 minutes à 180°C.\",\"it\":\"Cuocere le vaschette nel forno fino a renderle spumose e dorate. Calcolate un tempo di cottura di circa 20 minuti a 180°C.\",\"nl\":\"Bak de kuipjes in de oven tot ze luchtig en goudbruin zijn. Reken een baktijd van ongeveer 20 minuten op 180°C.\",\"de\":\"Die Förmchen im Ofen backen, bis sie locker und goldbraun sind. Rechnen Sie mit einer Backzeit von ca. 20 Minuten bei 180°C.\",\"en\":\"Bake the tubs in the oven until fluffy and golden brown. Count on a baking time of about 20 minutes at 180°C.\"}}],\"ingredients\":[{\"ingredientId\":\"4yVbtH6cPzYsrr9VCW9l\",\"name\":\"bladerdeeg\",\"quantity\":2,\"quantityUnit\":\"vel\",\"_quantityUnit\":null,\"pSrc\":\"vel bladerdeeg\",\"src\":\"2 vel bladerdeeg\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"DxWNS7Ygw6InHZCohUPj\",\"name\":\"eierdooiers\",\"quantity\":1,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"eigeel\",\"src\":\"1 eigeel\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"eedV1oSNgj4rM00WPf1x\",\"name\":\"beetje water\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"beetje water\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"placeholderPart\":false},{\"title\":\"De videevulling (velouté)\",\"instructions\":[{\"videoUrl\":null,\"part\":3,\"ingredients\":[{\"ingredientId\":\"DdlFPCCDdJsXEWIB5Yz1\",\"name\":\"gehakt\",\"quantity\":300,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"gehakt\",\"src\":\"300 g gehakt\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"coF2UJWj5HMrReMYzGBY\",\"name\":\"broodkruim\",\"quantity\":1,\"quantityUnit\":\"tablespoon\",\"_quantityUnit\":\"tablespoon\",\"pSrc\":\"broodkruim\",\"src\":\"1 eetlepel broodkruim\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"GMwI6G5VRjRYvDyP8DQc\",\"name\":\"peper\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"peper\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"03PqpJcNfTQlI0NM5uMe\",\"name\":\"zout\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"zout\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/12/1693761973946_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/12/1693761973946_200x200\",\"howToId\":null,\"step\":13,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/99efc1f9-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Meng het gehakt, samen met een ei en het broodkruim. Kruid met wat peper van de molen en zout. Rol het vleesmengsel tot identieke kleine balletjes van ongeveer een centimeter diameter.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Mezclar la carne picada junto con un huevo y el pan rallado. Sazonar con un poco de pimienta del molino y sal. Enrolle la mezcla de carne en bolitas pequeñas idénticas de aproximadamente una pulgada de diámetro.\",\"fr\":\"Mélanger la viande hachée avec un œuf et la chapelure. Assaisonner d'un peu de poivre du moulin et de sel. Rouler le mélange de viande en petites boules identiques d'environ un pouce de diamètre.\",\"it\":\"Impastare la carne macinata con un uovo e il pangrattato. Condire con un po' di pepe macinato e sale. Arrotolare il composto di carne in palline identiche di circa un pollice di diametro.\",\"nl\":\"Meng het gehakt, samen met een ei en het broodkruim. Kruid met wat peper van de molen en zout. Rol het vleesmengsel tot identieke kleine balletjes van ongeveer een centimeter diameter.\",\"de\":\"Das Hackfleisch mit einem Ei und den Semmelbröseln vermengen. Mit etwas Pfeffer aus der Mühle und Salz würzen. Rollen Sie die Fleischmischung in identische kleine Kugeln mit einem Durchmesser von etwa 2,5 cm.\",\"en\":\"Mix the minced meat together with an egg and the breadcrumbs. Season with some pepper from the mill and salt. Roll the meat mixture into identical small balls about an inch in diameter.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/13/1693761974252_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/13/1693761974252_200x200\",\"howToId\":null,\"step\":14,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9a46bb9a-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Breng een deel van de (gezeefde) kippenbouillon aan de kook. Laat de balletjes daarin enkele minuten garen op een matig vuur.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Llevar a ebullición parte del caldo de pollo (tamizado). Deje que las bolas se cocinen en él durante unos minutos a fuego medio.\",\"fr\":\"Porter à ébullition une partie du bouillon de poulet (tamisé). Laissez les boules y cuire quelques minutes à feu moyen.\",\"it\":\"Portare a ebollizione parte del brodo di pollo (setacciato). Fate cuocere le palline per qualche minuto a fuoco medio.\",\"nl\":\"Breng een deel van de (gezeefde) kippenbouillon aan de kook. Laat de balletjes daarin enkele minuten garen op een matig vuur.\",\"de\":\"Einen Teil der (gesiebten) Hühnerbrühe zum Kochen bringen. Die Kugeln darin einige Minuten bei mittlerer Hitze garen lassen.\",\"en\":\"Bring part of the (sieved) chicken stock to the boil. Let the balls cook in it for a few minutes on a medium heat.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[{\"ingredientId\":\"xWFycj9msasvP75xyxar\",\"name\":\"kleine Parijse champignons\",\"quantity\":250,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"kleine parijse champignons\",\"src\":\"250 g kleine Parijse champignons\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/14/1693761974508_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/14/1693761974508_200x200\",\"howToId\":null,\"step\":15,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9aae570b-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Snij de paddenstoelen in kwartjes.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Cortar los champiñones en cuartos.\",\"fr\":\"Couper les champignons en quartiers.\",\"it\":\"Tagliare i funghi in quarti.\",\"nl\":\"Snij de paddenstoelen in kwartjes.\",\"de\":\"Pilze vierteln.\",\"en\":\"Cut the mushrooms into quarters.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[{\"ingredientId\":\"FnuTHRKRRctBODPLL6JQ\",\"name\":\"boter\",\"quantity\":1,\"quantityUnit\":\"klontje\",\"_quantityUnit\":null,\"pSrc\":\"boter\",\"src\":\"1 klontje boter\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"Ew6nBUPwhee3JfyX7LmW\",\"name\":\"look\",\"quantity\":1,\"quantityUnit\":\"clove\",\"_quantityUnit\":\"clove\",\"pSrc\":\"look\",\"src\":\"1 teentje look\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/15/1693761974786_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/15/1693761974786_200x200\",\"howToId\":null,\"step\":16,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9b11acbc-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Smelt een klont boter in een pan en bak de stukjes paddenstoel. Voeg pas tijdens het bakken een geplet teentje knoflook toe zodat de look niet kan verbranden. Voeg een beetje peper en zout toe. Laat de champignons kleuren en zet ze opzij.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Derrita una nuez de mantequilla en una sartén y fría los trozos de champiñones. Solo agregue un diente de ajo machacado durante la cocción para que el ajo no se queme. Agregue un poco de sal y pimienta. Deje que los champiñones tomen color y déjelos a un lado.\",\"fr\":\"Faites fondre une noix de beurre dans une poêle et faites revenir les morceaux de champignons. N'ajouter qu'une gousse d'ail écrasée pendant la cuisson pour que l'ail ne brûle pas. Ajouter un peu de sel et de poivre. Laissez colorer les champignons et mettez-les de côté.\",\"it\":\"Sciogliere una noce di burro in una padella e friggere i pezzi di funghi. Aggiungere solo uno spicchio d'aglio schiacciato durante la cottura in modo che l'aglio non possa bruciare. Aggiungi un po 'di sale e pepe. Fate colorire i funghi e metteteli da parte.\",\"nl\":\"Smelt een klont boter in een pan en bak de stukjes paddenstoel. Voeg pas tijdens het bakken een geplet teentje knoflook toe zodat de look niet kan verbranden. Voeg een beetje peper en zout toe. Laat de champignons kleuren en zet ze opzij.\",\"de\":\"Ein Stück Butter in einer Pfanne schmelzen und die Pilzstücke anbraten. Geben Sie während des Backens nur eine zerdrückte Knoblauchzehe hinzu, damit der Knoblauch nicht anbrennen kann. Fügen Sie ein wenig Salz und Pfeffer hinzu. Lassen Sie die Pilze färben und legen Sie sie beiseite.\",\"en\":\"Melt a knob of butter in a pan and fry the mushroom pieces. Only add a crushed garlic clove during baking so that the garlic cannot burn. Add a little salt and pepper. Let the mushrooms color and set them aside.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/16/1693761975070_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/16/1693761975070_200x200\",\"howToId\":null,\"step\":17,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9b7cca9d-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Pluk al het vlees van het karkas van de kip. Beslis hoe je de kip wil serveren: in eerder grote stukken, hapklare brokken of extra fijn. Zet het vlees even opzij.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Escoge toda la carne de la carcasa del pollo. Decide cómo quieres servir el pollo: en trozos bastante grandes, del tamaño de un bocado o extra fino. Deja la carne a un lado por ahora.\",\"fr\":\"Retirez toute la viande de la carcasse de poulet. Décidez comment vous voulez servir le poulet : en morceaux assez gros, en morceaux de la taille d'une bouchée ou extra fin. Mettez la viande de côté pour le moment.\",\"it\":\"Scegli tutta la carne dalla carcassa di pollo. Decidi come vuoi servire il pollo: in pezzi piuttosto grandi, bocconcini o extra fine. Metti da parte la carne per ora.\",\"nl\":\"Pluk al het vlees van het karkas van de kip. Beslis hoe je de kip wil serveren: in eerder grote stukken, hapklare brokken of extra fijn. Zet het vlees even opzij.\",\"de\":\"Pflücken Sie das gesamte Fleisch aus dem Hühnerkadaver. Entscheiden Sie, wie Sie das Hähnchen servieren möchten: in eher großen Stücken, mundgerechten Stücken oder extra fein. Das Fleisch vorerst beiseite stellen.\",\"en\":\"Pick all the meat from the chicken carcass. Decide how you want to serve the chicken: in rather large pieces, bite-sized chunks or extra fine. Set the meat aside for now.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[{\"ingredientId\":\"FnuTHRKRRctBODPLL6JQ\",\"name\":\"boter\",\"quantity\":60,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"boter\",\"src\":\"60 g boter\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"J4fY9vsGPhZTg65Cjvrd\",\"name\":\"bloem\",\"quantity\":80,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"bloem\",\"src\":\"80 g bloem\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/17/1693761975330_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/17/1693761975330_200x200\",\"howToId\":null,\"step\":18,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9be74c3e-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Start de bereiding van de saus met een roux. Smelt de boter in een kookpot en voeg de bloem eraan toe. Laat het bloemmengsel al roerend “opdrogen”, maar let erop dat de roux niet aanbakt.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Comience la preparación de la salsa con un roux. Derrita la mantequilla en una cacerola y agregue la harina. Permita que la mezcla de harina se “seque” mientras revuelve, pero asegúrese de que el roux no se pegue.\",\"fr\":\"Commencez la préparation de la sauce avec un roux. Faire fondre le beurre dans une casserole et ajouter la farine. Laissez le mélange de farine \\\"sécher\\\" tout en remuant, mais assurez-vous que le roux ne colle pas.\",\"it\":\"Iniziare la preparazione della salsa con un roux. Sciogliere il burro in una casseruola e aggiungere la farina. Lasciare \\\"asciugare\\\" il composto di farina mescolando, ma assicurarsi che il roux non si attacchi.\",\"nl\":\"Start de bereiding van de saus met een roux. Smelt de boter in een kookpot en voeg de bloem eraan toe. Laat het bloemmengsel al roerend “opdrogen”, maar let erop dat de roux niet aanbakt.\",\"de\":\"Beginnen Sie die Zubereitung der Sauce mit einer Mehlschwitze. Die Butter in einem Topf schmelzen und das Mehl hinzugeben. Die Mehlmischung unter Rühren „eintrocknen“ lassen, aber darauf achten, dass die Mehlschwitze nicht kleben bleibt.\",\"en\":\"Start the preparation of the sauce with a roux. Melt the butter in a saucepan and add the flour. Allow the flour mixture to “dry up” while stirring, but make sure that the roux does not stick.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[{\"ingredientId\":\"nh0UsMClP6XzyYrERBnk\",\"name\":\"kippenbouillon die je net zelf hebt gemaakt\",\"quantity\":1,\"quantityUnit\":\"liter\",\"_quantityUnit\":null,\"pSrc\":\".5 liter kippenbouillon die je net zelf hebt gemaakt\",\"src\":\"1.5 liter kippenbouillon die je net zelf hebt gemaakt\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/18/1693761975641_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/18/1693761975641_200x200\",\"howToId\":null,\"step\":19,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/977ec1f3-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Zodra je een lichte biscuitgeur ruikt, schenk je een deel van de gezeefde kippenbouillon in de pot. Blijf geduldig doorroeren met een garde om klontertjes te vermijden.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Tan pronto como sienta un ligero olor a galleta, vierta un poco del caldo de pollo colado en la olla. Continúe revolviendo pacientemente con un batidor para evitar grumos.\",\"fr\":\"Dès que vous sentez une légère odeur de biscuit, versez une partie du bouillon de poulet filtré dans la casserole. Continuer à remuer patiemment avec un fouet pour éviter les grumeaux.\",\"it\":\"Non appena senti un leggero odore di biscotto, versa nella pentola un po' di brodo di pollo filtrato. Continuate a mescolare pazientemente con una frusta per evitare grumi.\",\"nl\":\"Zodra je een lichte biscuitgeur ruikt, schenk je een deel van de gezeefde kippenbouillon in de pot. Blijf geduldig doorroeren met een garde om klontertjes te vermijden.\",\"de\":\"Sobald Sie einen leichten Keksgeruch wahrnehmen, gießen Sie etwas von der passierten Hühnerbrühe in den Topf. Rühren Sie geduldig mit einem Schneebesen weiter, um Klümpchen zu vermeiden.\",\"en\":\"As soon as you smell a light biscuit smell, pour some of the strained chicken stock into the pot. Continue to stir patiently with a whisk to avoid lumps.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/19/1693761975829_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/19/1693761975829_200x200\",\"howToId\":null,\"step\":20,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9cac7100-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Schenk er af en toe wat bouillon bij, en wacht tot de saus bubbelt. Ga door tot je een gebonden, maar tegelijk voldoende vloeibare saus krijgt.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Agregue un poco de caldo de vez en cuando y espere a que la salsa burbujee. Continúe hasta obtener una salsa unida, pero al mismo tiempo suficientemente líquida.\",\"fr\":\"Ajouter un peu de bouillon de temps en temps et attendre que la sauce bouillonne. Continuez jusqu'à ce que vous obteniez une sauce liée, mais en même temps suffisamment liquide.\",\"it\":\"Aggiungete un po' di brodo di tanto in tanto e aspettate che la salsa bolle. Continuate fino ad ottenere una salsa legata, ma allo stesso tempo sufficientemente liquida.\",\"nl\":\"Schenk er af en toe wat bouillon bij, en wacht tot de saus bubbelt. Ga door tot je een gebonden, maar tegelijk voldoende vloeibare saus krijgt.\",\"de\":\"Fügen Sie ab und zu etwas Brühe hinzu und warten Sie, bis die Sauce Blasen wirft. Fahren Sie fort, bis Sie eine gebundene, aber gleichzeitig ausreichend flüssige Sauce erhalten.\",\"en\":\"Add some stock now and then and wait for the sauce to bubble. Continue until you get a bound, but at the same time sufficiently liquid sauce.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[{\"ingredientId\":\"ny5GGKUDA67W7htjfypz\",\"name\":\"madeirawijn of sherry\",\"quantity\":1,\"quantityUnit\":\"splash\",\"_quantityUnit\":\"splash\",\"pSrc\":\"madeirawijn of sherry\",\"src\":\"scheutje madeirawijn of sherry\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"baZmSkSnZ9hIs8RpdSfS\",\"name\":\"room\",\"quantity\":1,\"quantityUnit\":\"dl\",\"_quantityUnit\":\"dl\",\"pSrc\":\".5 dl room\",\"src\":\"1.5 dl room\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/20/1693761976124_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/20/1693761976124_200x200\",\"howToId\":null,\"step\":21,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9d08c1d1-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Voeg tenslotte een scheutje madeira (of sherry) toe en ook de room. Roer de saus zorgvuldig.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Finalmente, agregue una pizca de Madeira (o jerez) y la crema. Revuelva la salsa con cuidado.\",\"fr\":\"Ajoutez enfin un trait de Madère (ou sherry) et la crème. Remuez soigneusement la sauce.\",\"it\":\"Infine, aggiungi un goccio di Madeira (o sherry) e la panna. Mescolare bene la salsa.\",\"nl\":\"Voeg tenslotte een scheutje madeira (of sherry) toe en ook de room. Roer de saus zorgvuldig.\",\"de\":\"Zum Schluss einen Schuss Madeira (oder Sherry) und die Sahne hinzugeben. Rühren Sie die Soße vorsichtig um.\",\"en\":\"Finally, add a dash of Madeira (or sherry) and the cream. Stir the sauce carefully.\"}},{\"videoUrl\":null,\"part\":3,\"ingredients\":[{\"ingredientId\":\"mO64uerO92XSLFhWtKsZ\",\"name\":\"citroenen\",\"quantity\":0.5,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\".5 citroenen\",\"src\":\"0.5 citroenen\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"dFbZe2BtxHh4bzbS8D7t\",\"name\":\"nootmuskaat\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"nootmuskaat\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/21/1693761976370_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/21/1693761976370_200x200\",\"howToId\":null,\"step\":22,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9d607ec2-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Voeg de gebakken paddenstoelen, de stukjes kip en de gehaktballetjes toe aan de saus. Druppel wat vers citroensap in het mengsel en kruid de vol au vent naar smaak met wat peper, zout en versgeraspte nootmuskaat. Roer, proef en voeg naar smaak een extra beetje madeirawijn.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Agregue los champiñones fritos, los trozos de pollo y las albóndigas a la salsa. Vierta un poco de jugo de limón fresco en la mezcla y sazone el vol au vent al gusto con un poco de pimienta, sal y nuez moscada recién rallada. Revuelva, pruebe y agregue un poco más de vino de Madeira al gusto.\",\"fr\":\"Ajouter les champignons frits, les morceaux de poulet et les boulettes de viande à la sauce. Déposez un peu de jus de citron frais dans le mélange et assaisonnez le vol au vent au goût avec du poivre, du sel et de la noix de muscade fraîchement râpée. Remuez, goûtez et ajoutez un peu de vin de Madère au goût.\",\"it\":\"Aggiungere i funghi fritti, i pezzi di pollo e le polpette alla salsa. Versare nel composto un po' di succo di limone fresco e insaporire i vol au vent con un po' di pepe, sale e noce moscata grattugiata fresca. Mescolare, assaggiare e aggiungere un po' di vino Madeira a piacere.\",\"nl\":\"Voeg de gebakken paddenstoelen, de stukjes kip en de gehaktballetjes toe aan de saus. Druppel wat vers citroensap in het mengsel en kruid de vol au vent naar smaak met wat peper, zout en versgeraspte nootmuskaat. Roer, proef en voeg naar smaak een extra beetje madeirawijn.\",\"de\":\"Die gebratenen Champignons, Hähnchenstücke und Fleischbällchen in die Sauce geben. Etwas frischen Zitronensaft in die Mischung geben und das Vol au vent mit etwas Pfeffer, Salz und frisch geriebener Muskatnuss abschmecken. Umrühren, abschmecken und nach Belieben etwas Madeirawein hinzufügen.\",\"en\":\"Add the fried mushrooms, chicken pieces and meatballs to the sauce. Drop some fresh lemon juice into the mixture and season the vol au vent to taste with some pepper, salt and freshly grated nutmeg. Stir, taste and add an extra bit of Madeira wine to taste.\"}}],\"ingredients\":[{\"ingredientId\":\"DdlFPCCDdJsXEWIB5Yz1\",\"name\":\"gehakt\",\"quantity\":300,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"gehakt\",\"src\":\"300 g gehakt\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"coF2UJWj5HMrReMYzGBY\",\"name\":\"broodkruim\",\"quantity\":1,\"quantityUnit\":\"tablespoon\",\"_quantityUnit\":\"tablespoon\",\"pSrc\":\"broodkruim\",\"src\":\"1 eetlepel broodkruim\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"GMwI6G5VRjRYvDyP8DQc\",\"name\":\"peper\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"peper\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"03PqpJcNfTQlI0NM5uMe\",\"name\":\"zout\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"zout\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"xWFycj9msasvP75xyxar\",\"name\":\"kleine Parijse champignons\",\"quantity\":250,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"kleine parijse champignons\",\"src\":\"250 g kleine Parijse champignons\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"FnuTHRKRRctBODPLL6JQ\",\"name\":\"boter\",\"quantity\":1,\"quantityUnit\":\"klontje\",\"_quantityUnit\":null,\"pSrc\":\"boter\",\"src\":\"1 klontje boter\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"Ew6nBUPwhee3JfyX7LmW\",\"name\":\"look\",\"quantity\":1,\"quantityUnit\":\"clove\",\"_quantityUnit\":\"clove\",\"pSrc\":\"look\",\"src\":\"1 teentje look\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"FnuTHRKRRctBODPLL6JQ\",\"name\":\"boter\",\"quantity\":60,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"boter\",\"src\":\"60 g boter\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"J4fY9vsGPhZTg65Cjvrd\",\"name\":\"bloem\",\"quantity\":80,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"bloem\",\"src\":\"80 g bloem\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"nh0UsMClP6XzyYrERBnk\",\"name\":\"kippenbouillon die je net zelf hebt gemaakt\",\"quantity\":1,\"quantityUnit\":\"liter\",\"_quantityUnit\":null,\"pSrc\":\".5 liter kippenbouillon die je net zelf hebt gemaakt\",\"src\":\"1.5 liter kippenbouillon die je net zelf hebt gemaakt\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"ny5GGKUDA67W7htjfypz\",\"name\":\"madeirawijn of sherry\",\"quantity\":1,\"quantityUnit\":\"splash\",\"_quantityUnit\":\"splash\",\"pSrc\":\"madeirawijn of sherry\",\"src\":\"scheutje madeirawijn of sherry\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"baZmSkSnZ9hIs8RpdSfS\",\"name\":\"room\",\"quantity\":1,\"quantityUnit\":\"dl\",\"_quantityUnit\":\"dl\",\"pSrc\":\".5 dl room\",\"src\":\"1.5 dl room\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"mO64uerO92XSLFhWtKsZ\",\"name\":\"citroenen\",\"quantity\":0.5,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\".5 citroenen\",\"src\":\"0.5 citroenen\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"dFbZe2BtxHh4bzbS8D7t\",\"name\":\"nootmuskaat\",\"quantity\":null,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":null,\"src\":\"nootmuskaat\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"placeholderPart\":false},{\"title\":\"De hollandaisesaus\",\"instructions\":[{\"videoUrl\":null,\"part\":4,\"ingredients\":[{\"ingredientId\":\"FnuTHRKRRctBODPLL6JQ\",\"name\":\"(hoeve) boter\",\"quantity\":250,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"(hoeve) boter\",\"src\":\"250 g (hoeve) boter\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/22/1693761976681_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/22/1693761976681_200x200\",\"howToId\":null,\"step\":23,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9dbecb63-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Snij de boter in kleine blokjes.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Cortar la mantequilla en cubos pequeños.\",\"fr\":\"Couper le beurre en petits cubes.\",\"it\":\"Tagliare il burro a cubetti.\",\"nl\":\"Snij de boter in kleine blokjes.\",\"de\":\"Butter in kleine Würfel schneiden.\",\"en\":\"Cut the butter into small cubes.\"}},{\"videoUrl\":null,\"part\":4,\"ingredients\":[{\"ingredientId\":\"DxWNS7Ygw6InHZCohUPj\",\"name\":\"eierdooiers\",\"quantity\":3,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"eierdooiers\",\"src\":\"3 eierdooiers\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"nvaRv5TJsSIp4Xcm3pH2\",\"name\":\"witte wijn\",\"quantity\":2,\"quantityUnit\":\"dopje\",\"_quantityUnit\":null,\"pSrc\":\"witte wijn\",\"src\":\"2 dopje witte wijn\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"eedV1oSNgj4rM00WPf1x\",\"name\":\"water\",\"quantity\":1,\"quantityUnit\":\"dopje\",\"_quantityUnit\":null,\"pSrc\":\"water\",\"src\":\"1 dopje water\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/23/1693761977025_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/23/1693761977025_200x200\",\"howToId\":null,\"step\":24,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9e20c184-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Scheid de eieren en doe de dooiers in een pan. (Gebruik bij voorkeur een pan met een bolle onderzijde.) Hou één eierdopje bij om de vloeistof voor deze saus af te meten. Voeg voor elke dooier één dopje vloeistof toe. Ik gebruik 2/3 witte wijn, en 1/3 water. (Het eiwit wordt niet gebruikt.)\",\"tip\":null,\"translatedDescription\":{\"es\":\"Separar los huevos y poner las yemas en una cacerola. (Preferiblemente use una sartén con un fondo convexo). Mantenga una huevera para medir el líquido de esta salsa. Agrega una taza de líquido por cada yema. Yo uso 2/3 de vino blanco y 1/3 de agua. (La clara de huevo no se usa.)\",\"fr\":\"Séparez les oeufs et mettez les jaunes dans une casserole. (Utilisez de préférence une casserole à fond bombé.) Gardez un coquetier pour doser le liquide de cette sauce. Ajouter une tasse de liquide pour chaque jaune. J'utilise 2/3 de vin blanc et 1/3 d'eau. (Le blanc d'œuf n'est pas utilisé.)\",\"it\":\"Separare le uova e mettere i tuorli in una casseruola. (Preferibilmente usa una padella con un fondo convesso.) Tieni un portauovo per misurare il liquido per questa salsa. Aggiungere una tazza di liquido per ogni tuorlo. Uso 2/3 di vino bianco e 1/3 di acqua. (L'albume non viene utilizzato.)\",\"nl\":\"Scheid de eieren en doe de dooiers in een pan. (Gebruik bij voorkeur een pan met een bolle onderzijde.) Hou één eierdopje bij om de vloeistof voor deze saus af te meten. Voeg voor elke dooier één dopje vloeistof toe. Ik gebruik 2/3 witte wijn, en 1/3 water. (Het eiwit wordt niet gebruikt.)\",\"de\":\"Die Eier trennen und das Eigelb in einen Topf geben. (Benutzen Sie vorzugsweise eine Pfanne mit gewölbtem Boden.) Bewahren Sie einen Eierbecher auf, um die Flüssigkeit für diese Sauce abzumessen. Fügen Sie eine Tasse Flüssigkeit für jedes Eigelb hinzu. Ich verwende 2/3 Weißwein und 1/3 Wasser. (Das Eiweiß wird nicht verwendet.)\",\"en\":\"Separate the eggs and put the yolks in a saucepan. (Preferably use a pan with a convex bottom.) Keep one egg cup to measure the liquid for this sauce. Add one cup of liquid for each yolk. I use 2/3 white wine and 1/3 water. (The egg white is not used.)\"}},{\"videoUrl\":null,\"part\":4,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/24/1693761977321_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/24/1693761977321_200x200\",\"howToId\":null,\"step\":25,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9e859dd5-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Klop het mengsel alvast schuimig, alvorens je het op het fornuis zet.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Bate la mezcla hasta que quede espumosa antes de ponerla en la estufa.\",\"fr\":\"Battre le mélange mousseux avant de le mettre sur la cuisinière.\",\"it\":\"Sbattete il composto spumoso prima di metterlo sul fuoco.\",\"nl\":\"Klop het mengsel alvast schuimig, alvorens je het op het fornuis zet.\",\"de\":\"Schlagen Sie die Mischung schaumig, bevor Sie sie auf den Herd stellen.\",\"en\":\"Beat the mixture foamy before you put it on the stove.\"}},{\"videoUrl\":null,\"part\":4,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/25/1693761977608_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/25/1693761977608_200x200\",\"howToId\":null,\"step\":26,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9eeaa136-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Zet de pan op een zacht vuur en blijf zonder ophouden kloppen met de garde. Klop tegen een flinke snelheid in een 8-vorm, of draai je pan voortdurend een kwartslag naar links en naar rechts. Neem de pan af en toe weg van het vuur. Blijf doorgaan tot je een licht gebonden schuimige saus krijgt, waarin de garde sporen nalaat. Laat ze in geen geval aanbranden of te heet worden.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Coloque la sartén a fuego lento y continúe batiendo continuamente. Bate a una velocidad rápida en forma de figura 8, o gira continuamente la sartén un cuarto de vuelta a la izquierda y a la derecha. Retire de vez en cuando la sartén del fuego. Continúe hasta obtener una salsa espumosa ligeramente espesa, en la que el batidor deja rastros. Nunca dejes que se quemen o se calienten demasiado.\",\"fr\":\"Mettez la casserole sur feu doux et continuez à fouetter sans arrêt. Battre à vive allure en forme de Figure 8, ou tourner continuellement votre casserole d'un quart de tour à gauche et à droite. Retirez de temps en temps la casserole du feu. Continuez jusqu'à obtenir une sauce mousseuse un peu épaisse, dans laquelle le fouet laisse des traces. Ne les laissez jamais brûler ou devenir trop chauds.\",\"it\":\"Mettete la padella sul fuoco basso e continuate a sbattere continuamente. Sbatti a una velocità sostenuta a forma di Figura 8 o ruota continuamente la padella di un quarto di giro a sinistra ea destra. Di tanto in tanto togliere la padella dal fuoco. Continuare fino ad ottenere una salsa spumosa leggermente densa, nella quale la frusta lascia tracce. Non lasciarli mai bruciare o diventare troppo caldi.\",\"nl\":\"Zet de pan op een zacht vuur en blijf zonder ophouden kloppen met de garde. Klop tegen een flinke snelheid in een 8-vorm, of draai je pan voortdurend een kwartslag naar links en naar rechts. Neem de pan af en toe weg van het vuur. Blijf doorgaan tot je een licht gebonden schuimige saus krijgt, waarin de garde sporen nalaat. Laat ze in geen geval aanbranden of te heet worden.\",\"de\":\"Stellen Sie die Pfanne auf eine schwache Hitze und schlagen Sie kontinuierlich weiter. Schlagen Sie mit hoher Geschwindigkeit in Form einer Acht oder drehen Sie Ihre Pfanne kontinuierlich um eine Vierteldrehung nach links und rechts. Pfanne gelegentlich vom Herd nehmen. So weitermachen, bis eine leicht dicke schaumige Sauce entsteht, in der der Schneebesen Spuren hinterlässt. Lassen Sie sie niemals brennen oder zu heiß werden.\",\"en\":\"Place the pan on a low heat and continue whisking continuously. Beat at a brisk speed in a Figure 8 shape, or continuously rotate your pan a quarter turn left and right. Occasionally remove the pan from the heat. Keep going until you get a slightly thick foamy sauce, in which the whisk leaves traces. Never let them burn or get too hot.\"}},{\"videoUrl\":null,\"part\":4,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/26/1693761977864_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/26/1693761977864_200x200\",\"howToId\":null,\"step\":27,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9f53c347-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Neem de pan van het vuur. Voeg de boterblokjes in delen toe aan de warme schuimige saus. Blijf intussen stevig kloppen met de garde.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Retire la sartén del fuego. Agregue los cubos de mantequilla en partes a la salsa espumosa tibia. Mientras tanto, seguir batiendo enérgicamente con el batidor.\",\"fr\":\"Retirer la casserole du feu. Ajouter les cubes de beurre en morceaux à la sauce mousseuse chaude. Pendant ce temps, continuez à battre vigoureusement au fouet.\",\"it\":\"Togli la padella dal fuoco. Aggiungere i cubetti di burro in parte alla salsa calda e spumosa. Nel frattempo continuate a sbattere energicamente con la frusta.\",\"nl\":\"Neem de pan van het vuur. Voeg de boterblokjes in delen toe aan de warme schuimige saus. Blijf intussen stevig kloppen met de garde.\",\"de\":\"Nimm die Pfanne von der Hitze. Die Butterwürfel portionsweise in die warme Schaumsauce geben. Währenddessen mit dem Schneebesen weiter kräftig schlagen.\",\"en\":\"Take the pan off the heat. Add the butter cubes in parts to the warm foamy sauce. Meanwhile, continue to beat vigorously with the whisk.\"}},{\"videoUrl\":null,\"part\":4,\"ingredients\":[{\"ingredientId\":\"mO64uerO92XSLFhWtKsZ\",\"name\":\"citroenen\",\"quantity\":0.5,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\".5 citroenen\",\"src\":\"0.5 citroenen\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"lpdxFaut5gruhIF7p8zM\",\"name\":\"cayennepeper\",\"quantity\":1,\"quantityUnit\":\"sniff\",\"_quantityUnit\":\"sniff\",\"pSrc\":\"cayennepeper\",\"src\":\"snuifje cayennepeper\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"03PqpJcNfTQlI0NM5uMe\",\"name\":\"zout\",\"quantity\":1,\"quantityUnit\":\"sniff\",\"_quantityUnit\":\"sniff\",\"pSrc\":\"zout\",\"src\":\"snuifje zout\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/27/1693761978075_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/27/1693761978075_200x200\",\"howToId\":null,\"step\":28,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/9fc067c8-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Knijp het citroensap erbij. Voeg ook een voorzichtig snuifje cayennepeper en wat zout toe.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Exprima el jugo de limón. También agregue una pizca cuidadosa de pimienta de cayena y un poco de sal.\",\"fr\":\"Pressez le jus de citron. Ajoutez également une pincée de poivre de Cayenne et un peu de sel.\",\"it\":\"Spremere il succo di limone. Aggiungere anche un attento pizzico di pepe di cayenna e un po' di sale.\",\"nl\":\"Knijp het citroensap erbij. Voeg ook een voorzichtig snuifje cayennepeper en wat zout toe.\",\"de\":\"Den Zitronensaft hineinpressen. Fügen Sie außerdem eine vorsichtige Prise Cayennepfeffer und etwas Salz hinzu.\",\"en\":\"Squeeze in the lemon juice. Also add a careful pinch of cayenne pepper and some salt.\"}},{\"videoUrl\":null,\"part\":4,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/28/1693761978397_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/28/1693761978397_200x200\",\"howToId\":null,\"step\":29,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/a01c1c59-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Roer en proef of de smaken in balans zijn.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Revuelva y pruebe para ver si los sabores están equilibrados.\",\"fr\":\"Remuer et goûter pour voir si les saveurs sont équilibrées.\",\"it\":\"Mescolare e assaggiare per vedere se i sapori sono equilibrati.\",\"nl\":\"Roer en proef of de smaken in balans zijn.\",\"de\":\"Rühren und probieren Sie, um zu sehen, ob die Aromen ausgewogen sind.\",\"en\":\"Stir and taste to see if the flavors are balanced.\"}}],\"ingredients\":[{\"ingredientId\":\"FnuTHRKRRctBODPLL6JQ\",\"name\":\"(hoeve) boter\",\"quantity\":250,\"quantityUnit\":\"g\",\"_quantityUnit\":\"g\",\"pSrc\":\"(hoeve) boter\",\"src\":\"250 g (hoeve) boter\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"DxWNS7Ygw6InHZCohUPj\",\"name\":\"eierdooiers\",\"quantity\":3,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\"eierdooiers\",\"src\":\"3 eierdooiers\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"nvaRv5TJsSIp4Xcm3pH2\",\"name\":\"witte wijn\",\"quantity\":2,\"quantityUnit\":\"dopje\",\"_quantityUnit\":null,\"pSrc\":\"witte wijn\",\"src\":\"2 dopje witte wijn\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"eedV1oSNgj4rM00WPf1x\",\"name\":\"water\",\"quantity\":1,\"quantityUnit\":\"dopje\",\"_quantityUnit\":null,\"pSrc\":\"water\",\"src\":\"1 dopje water\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"mO64uerO92XSLFhWtKsZ\",\"name\":\"citroenen\",\"quantity\":0.5,\"quantityUnit\":null,\"_quantityUnit\":null,\"pSrc\":\".5 citroenen\",\"src\":\"0.5 citroenen\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"lpdxFaut5gruhIF7p8zM\",\"name\":\"cayennepeper\",\"quantity\":1,\"quantityUnit\":\"sniff\",\"_quantityUnit\":\"sniff\",\"pSrc\":\"cayennepeper\",\"src\":\"snuifje cayennepeper\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}},{\"ingredientId\":\"03PqpJcNfTQlI0NM5uMe\",\"name\":\"zout\",\"quantity\":1,\"quantityUnit\":\"sniff\",\"_quantityUnit\":\"sniff\",\"pSrc\":\"zout\",\"src\":\"snuifje zout\",\"translatedDescription\":{\"es\":\"\",\"fr\":\"\",\"it\":\"\",\"nl\":\"\",\"de\":\"\",\"en\":\"\"}}],\"placeholderPart\":false},{\"title\":\"Afwerken en serveren\",\"instructions\":[{\"videoUrl\":null,\"part\":5,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/29/1693761978683_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/29/1693761978683_200x200\",\"howToId\":null,\"step\":30,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/a080837a-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Snij het dekseltje uit elk bladerdeeggebak, en schep een flinke portie van de velouté met kip, balletjes en paddentoelen in en rond het koekje.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Corta la tapa de cada hojaldre y coloca una porción generosa de velouté con pollo, albóndigas y champiñones dentro y alrededor de la galleta.\",\"fr\":\"Coupez le couvercle de chaque pâte feuilletée et déposez une généreuse portion de velouté avec du poulet, des boulettes de viande et des champignons dans et autour du biscuit.\",\"it\":\"Tagliare il coperchio di ogni pasta sfoglia e versare una generosa porzione di vellutata con pollo, polpette e funghi dentro e intorno al biscotto.\",\"nl\":\"Snij het dekseltje uit elk bladerdeeggebak, en schep een flinke portie van de velouté met kip, balletjes en paddentoelen in en rond het koekje.\",\"de\":\"Schneiden Sie den Deckel von jedem Blätterteig ab und löffeln Sie eine großzügige Portion der Velouté mit Hühnchen, Fleischbällchen und Pilzen in und um den Keks herum.\",\"en\":\"Cut the lid from each puff pastry, and spoon a generous portion of the velouté with chicken, meatballs and mushrooms into and around the biscuit.\"}},{\"videoUrl\":null,\"part\":5,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/30/1693761978952_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/30/1693761978952_200x200\",\"howToId\":null,\"step\":31,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/a0fc1c1b-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Lepel wat luchtige hollandaise over elk koninginnenhapje en zet het dekseltje van bladerdeeg erbovenop.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Vierta un poco de holandesa aireada sobre cada bocadillo de reina y coloque la tapa de hojaldre encima.\",\"fr\":\"Versez un peu de sauce hollandaise aérée sur chaque collation reine et placez le couvercle de pâte feuilletée sur le dessus.\",\"it\":\"Versare un po' di olandese arioso su ogni spuntino regina e posizionare sopra il coperchio di pasta sfoglia.\",\"nl\":\"Lepel wat luchtige hollandaise over elk koninginnenhapje en zet het dekseltje van bladerdeeg erbovenop.\",\"de\":\"Etwas luftige Hollandaise über jeden Queen-Snack geben und den Blätterteigdeckel darauf legen.\",\"en\":\"Spoon some airy hollandaise over each queen snack and place the puff pastry lid on top.\"}},{\"videoUrl\":null,\"part\":5,\"ingredients\":[],\"photoUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/31/1693761979247_1080x1920\",\"timers\":[],\"thumbnailUrl\":\"https://cdn.dagelijksekost.tv/recipes/LLwEgQWLcNsth6YQ6LrK/instructions/31/1693761979247_200x200\",\"howToId\":null,\"step\":32,\"name\":null,\"externalPhotoUrl\":\"https://images.vrt.be/orig/2017/03/06/a16cb83c-0252-11e7-8f5f-00163edf48dd.jpg\",\"description\":\"Werk elk bord af met een toef pittige tuinkers en geniet.\",\"tip\":null,\"translatedDescription\":{\"es\":\"Termina cada plato con una ramita de berro picante y disfruta.\",\"fr\":\"Terminez chaque assiette avec un brin de cresson épicé et dégustez.\",\"it\":\"Termina ogni piatto con un rametto di crescione piccante e divertiti.\",\"nl\":\"Werk elk bord af met een toef pittige tuinkers en geniet.\",\"de\":\"Beenden Sie jeden Teller mit einem Zweig würziger Gartenkresse und genießen Sie ihn.\",\"en\":\"Finish each plate with a sprig of spicy garden cress and enjoy.\"}}],\"ingredients\":[],\"placeholderPart\":false}],\"publishDate\":\"2015-02-24T17:00:00.000Z\",\"airDate\":\"2015-02-24T17:00:00.000Z\",\"isCommunity\":false},\"author\":{\"id\":\"dCmtr8SP9Lhian5TYWvnlUB883I3\",\"slug\":\"jeroen-meus\",\"creationDate\":\"2023-08-27T19:35:09.352Z\",\"lastUpdate\":null,\"isAuthor\":true,\"isHero\":true,\"isAdmin\":true,\"isAdvertiser\":true,\"displayName\":\"Jeroen Meus\",\"photoUrl\":\"https://cdn.dagelijksekost.tv/users/dCmtr8SP9Lhian5TYWvnlUB883I3/17