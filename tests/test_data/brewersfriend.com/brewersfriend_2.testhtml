			<td data-sort-value="44.7">44.7%</td>
		</tr>
		      <tr>
			<td data-sort-value="907.18474">
					2 lb			</td>
			<td>
			<i class="us flag"></i>
			<a href='/fermentables/american-white-wheat/'>American - White Wheat</a><span style='display:none;' itemprop='recipeIngredient'>2 lb White Wheat</span>			</td>
			<td data-sort-value="">
							</td>
			<td data-sort-value="40">40</td>
			<td data-sort-value="2.8">2.8</td>
			<td data-sort-value="17">17%</td>
		</tr>
		      <tr>
			<td data-sort-value="907.18474">
					2 lb			</td>
			<td>
			<i class="us flag"></i>
			<a href='/fermentables/american-pale-6-row/'>American - Pale 6-Row</a><span style='display:none;' itemprop='recipeIngredient'>2 lb Pale 6-Row</span>			</td>
			<td data-sort-value="">
