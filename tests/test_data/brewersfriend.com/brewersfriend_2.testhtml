<script type="text/javascript">
    Defer( function () {
    $(document).ready(function() {
        var bfHasAdfpvCookie = !! document.cookie.match(/^(.*;)?\s*bf_adfpv_v1\s*=\s*[^;]+(.*)?$/);
        if ( ! bfHasAdfpvCookie ) {
            var date = new Date();
            var now = new Date();
            date.setTime(date.getTime()+(10*365*24*60*60*1000));
            var expires = "; expires="+date.toGMTString();
            document.cookie = "bf_adfpv_v1="+now.toGMTString()+expires+"; path=/";
        }
                // Init ads when the visitor has the first-pageview cookie OR is a logged-out PV1 visitor.
        if ( bfHasAdfpvCookie || (typeof bfShowPv1Ads !== 'undefined' && bfShowPv1Ads) ) {
                // Initialize AdSense
                (adsbygoogle = window.adsbygoogle || []);
                
                // Affiliate ad override configuration from PHP
                var affiliateOverrides = {"top-leaderboard-ad":{"total_percentage":50,"options":[{"name":"House Ad","weight":2,"href":"\/homebrew\/signup?coupon=TAKE10","img":"\/homebrew\/images\/houseads_20211207\/take10_signup\/webp\/810X100.webp","width":810,"height":100},{"name":"Inventry brew","weight":1,"href":"https:\/\/inventry.app\/?utm_source=brewersfriend&utm_medium=house_ad&utm_campaign=bf_house_2026_08&utm_content=brew_leaderboard","img":"\/homebrew\/images\/houseads_inventry_202608\/inventry_brew_leaderboard_810x100.webp","width":810,"height":97,"target":"_blank","rel":"noopener","img_mobile":"\/homebrew\/images\/houseads_inventry_202608\/inventry_brew_leaderboard_mobile_320x100.webp","mobile_width":320,"mobile_height":107},{"name":"Inventry insure","weight":1,"href":"https:\/\/inventry.app\/?utm_source=brewersfriend&utm_medium=house_ad&utm_campaign=bf_house_2026_08&utm_content=insure_leaderboard","img":"\/homebrew\/images\/houseads_inventry_202608\/inventry_insure_leaderboard_810x100.webp","width":810,"height":97,"target":"_blank","rel":"noopener","img_mobile":"\/homebrew\/images\/houseads_inventry_202608\/inventry_insure_leaderboard_mobile_320x100.webp","mobile_width":320,"mobile_height":107}]},"inline-unit-ad":{"total_percentage":50,"options":[{"name":"House Ad","weight":2,"href":"\/homebrew\/signup?coupon=TAKE10","img":"\/homebrew\/images\/houseads_20211207\/take10_signup\/webp\/810X100.webp","width":810,"height":100},{"name":"Inventry brew","weight":1,"href":"https:\/\/inventry.app\/?utm_source=brewersfriend&utm_medium=house_ad&utm_campaign=bf_house_2026_08&utm_content=brew_inline","img":"\/homebrew\/images\/houseads_inventry_202608\/inventry_brew_leaderboard_810x100.webp","width":810,"height":97,"target":"_blank","rel":"noopener","img_mobile":"\/homebrew\/images\/houseads_inventry_202608\/inventry_brew_leaderboard_mobile_320x100.webp","mobile_width":320,"mobile_height":107},{"name":"Inventry insure","weight":1,"href":"https:\/\/inventry.app\/?utm_source=brewersfriend&utm_medium=house_ad&utm_campaign=bf_house_2026_08&utm_content=insure_inline","img":"\/homebrew\/images\/houseads_inventry_202608\/inventry_insure_leaderboard_810x100.webp","width":810,"height":97,"target":"_blank","rel":"noopener","img_mobile":"\/homebrew\/images\/houseads_inventry_202608\/inventry_insure_leaderboard_mobile_320x100.webp","mobile_width":320,"mobile_height":107}]},"sidebar-block-1-ad":{"total_percentage":50,"options":[{"name":"House Ad","weight":2,"href":"\/homebrew\/signup?coupon=TAKE10","img":"\/homebrew\/images\/houseads_20211207\/take10_signup\/webp\/300x250.webp","width":300,"height":250},{"name":"Inventry brew","weight":1,"href":"https:\/\/inventry.app\/?utm_source=brewersfriend&utm_medium=house_ad&utm_campaign=bf_house_2026_08&utm_content=brew_sidebar","img":"\/homebrew\/images\/houseads_inventry_202608\/inventry_brew_sidebar_300x250.webp","width":300,"height":250,"target":"_blank","rel":"noopener"},{"name":"Inventry insure","weight":1,"href":"https:\/\/inventry.app\/?utm_source=brewersfriend&utm_medium=house_ad&utm_campaign=bf_house_2026_08&utm_content=insure_sidebar","img":"\/homebrew\/images\/houseads_inventry_202608\/inventry_insure_sidebar_300x250.webp","width":300,"height":250,"target":"_blank","rel":"noopener"}]}};
                
                // Process each potential ad override
                if (affiliateOverrides && Object.keys(affiliateOverrides).length > 0) {
                    Object.keys(affiliateOverrides).forEach(function(adSlotId) {
                        var override = affiliateOverrides[adSlotId];
                        var adElement = document.getElementById(adSlotId);
                        
                        // Check if ad exists and should be replaced based on total percentage
                        if (adElement && override.options && override.options.length > 0 && (Math.random() * 100 < override.total_percentage)) {
                            // Choose an option based on weights
                            var option = chooseWeightedOption(override.options);
                            
                            // Build affiliate ad HTML
                            var style = option.style || '';
                            if (option.width && option.height) {
                                // Scoped to options shipping a mobile creative: see PHP.
                                style += (style ? '; ' : '') + (option.img_mobile
                                    ? 'width:100%; max-width:' + option.width + 'px; height:auto;'
                                    : 'max-width:100%;');
                            }

                            var attributes = '';
                            if (option.target) attributes += ' target="' + option.target + '"';
                            if (option.rel) attributes += ' rel="' + option.rel + '"';

                            var imgHtml = '<img src="' + option.img + '" ' +
                                'alt="Advertisement" ' +
                                'width="' + option.width + '" ' +
                                'height="' + option.height + '" ' +
                                'style="' + style + '">';

                            // Optional narrow-viewport creative: see PHP for the 600px
                            // breakpoint rationale and why the source carries its own
                            // width/height.
                            if (option.img_mobile) {
                                imgHtml = '<picture>' +
                                    '<source srcset="' + option.img_mobile + '" ' +
                                    'media="(max-width: 600px)" ' +
                                    'width="' + option.mobile_width + '" ' +
                                    'height="' + option.mobile_height + '">' +
                                    imgHtml +
                                    '</picture>';
                            }

                            var affiliateAdHtml = '<div class="affiliate-ad" style="text-align:center;margin:10px 0;">' +
                                '<a href="' + option.href + '"' + attributes + '>' +
                                imgHtml +
                                '</a></div>';

                            // Replace the AdSense container with affiliate ad
                            $(adElement).closest('ins.adsbygoogle').replaceWith(affiliateAdHtml);
                        }
                    });
                }
                
                // Helper function to select a weighted random option
                function chooseWeightedOption(options) {
                    if (!options || options.length === 0) {
                        // This case implies an issue with how options are passed or an empty configuration.
                        // Returning undefined is safer than the original's options[0] which would error.
                        return undefined; 
                    }

                    var eligibleOptions = [];
                    var totalPositiveWeight = 0;

                    // First pass: Collect options with strictly positive weights and sum these weights.
                    for (var i = 0; i < options.length; i++) {
                        var option = options[i];
                        // Ensure weight is treated as a number; default undefined/non-numeric to 0.
                        var weight = (typeof option.weight === 'number') ? option.weight : 0;
                        if (weight > 0) {
                            eligibleOptions.push(option);
                            totalPositiveWeight += weight;
                        }
                    }

                    if (totalPositiveWeight > 0) {
                        // If there are options with positive weights, choose from them.
                        var randomValue = Math.random() * totalPositiveWeight;
                        var cumulativeWeight = 0;
                        for (var j = 0; j < eligibleOptions.length; j++) {
                            // eligibleOptions[j].weight is guaranteed to be > 0 here.
                            cumulativeWeight += eligibleOptions[j].weight;
                            if (randomValue <= cumulativeWeight) {
                                return eligibleOptions[j];
                            }
                        }
                        // Fallback for rare floating-point precision issues or if randomValue is exactly totalPositiveWeight.
                        // Returning the last eligible option is a robust choice here.
                        return eligibleOptions[eligibleOptions.length - 1];
                    } else {
                        // No options with positive weight were found.
                        // This means all original options had weights <= 0 (e.g., all zeros or empty list of positive weights).
                        // In this scenario, pick one randomly from the original 'options' list,
                        // giving all of them an equal chance.
                        return options[Math.floor(Math.random() * options.length)];
                    }
                }
                
                // Initialize all remaining AdSense ads
                $("ins.adsbygoogle").each(function() {
                    $("<sc" + "ript>(adsbygoogle = window.adsbygoogle || []).push({})</scr" + "ipt>").insertAfter($(this));
                });

                var js = document.createElement("script");
                js.type = "text/javascript";
                js.async = true;
                js.crossOrigin = "anonymous";
                js.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1285096555600914";
                document.body.appendChild(js);
            }
            });
    });
    
</script>



