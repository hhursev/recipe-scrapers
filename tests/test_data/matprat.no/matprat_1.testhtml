n godt inn med blandingen. Dryss over litt salt. Sett kaldt i 20 minutter."}],"blocks":null,"preparationTime":0,"ingredients":[{"name":"kylling (ca. 1300 g)","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"stk.","amount":1,"articleLink":null,"articleIsNewTab":false,"category":"/kjøtt/kylling/høns","categoryIndex":298},{"name":"hvitløk","preText":"","middleText":"","postText":"","postText2":"","description":null,"unit":"båt","amount":4,"articleLink":null,"articleIsNewTab":false,"category":"/grønnsaker","categoryIndex":200},{"name":"frisk ingefær","preText":"","middleText":"revet","postText":"","postText2":null,"description":null,"unit":"ss","amount":0.5,"articleLink":null,"articleIsNewTab":false,"category":"/grønnsaker","categoryIndex":200},{"name":"sitronsaft","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"ss","amount":2,"articleLink":null,"articleIsNewTab":false,"category":"/frukt","categoryIndex":250}],"videoType":"no-video","videoData":null},{"id":1256554,"type":"MatPratRecipeStepPage","name":"Steg 2","displayName":"Steg 2","url":"/oppskrifter/gjester/butter-chicken---indisk-smorkylling/steg/2/","language":"no","stepName":"Steg 2","imageUrl":"https://images.matprat.no/24dh3he6rf","imageAlt":"Butter chicken trinnbilder","imageName":"02_marinade_skaal","verticalImageUrl":null,"verticalImageAlt":null,"verticalImageName":null,"content":[{"type":"html","html":"Bland sammen chilipulver, garam masala, olje og yoghurt. Tørk kyllingen med litt kjøkkenpapir og gni den godt inn med yoghurtblandingen. Plasser kyllingen på et fat og sett den kaldt i minst 4-6 timer, helst over natten."}],"blocks":null,"preparationTime":0,"ingredients":[{"name":"gresk yoghurt","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"dl","amount":1,"articleLink":null,"articleIsNewTab":false,"category":"/melk/melkeprodukter","categoryIndex":350},{"name":"chilipulver","preText":"","middleT