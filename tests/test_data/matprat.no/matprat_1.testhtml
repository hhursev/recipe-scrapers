, chilipulver, kardemomme og bukkehornkløver på middels varme til tomatene er helt myke.\u003c/p\u003e"}],"blocks":null,"preparationTime":0,"ingredients":[{"name":"tomat","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"stk.","amount":8,"articleLink":null,"articleIsNewTab":false,"category":"/grønnsaker","categoryIndex":200},{"name":"nøytral olje","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"ss","amount":2,"articleLink":null,"articleIsNewTab":false,"category":"/margarin/olje/majones","categoryIndex":450},{"name":"hvitløk","preText":"","middleText":"finhakket","postText":"","postText2":"","description":null,"unit":"båt","amount":4,"articleLink":null,"articleIsNewTab":false,"category":"/grønnsaker","categoryIndex":200},{"name":"frisk ingefær","preText":"","middleText":"revet","postText":"","postText2":null,"description":null,"unit":"ss","amount":0.5,"articleLink":null,"articleIsNewTab":false,"category":"/grønnsaker","categoryIndex":200},{"name":"chilipulver","preText":"","middleText":"","postText":"(helst indisk)","postText2":null,"description":null,"unit":"ss","amount":0.5,"articleLink":null,"articleIsNewTab":false,"category":"/krydder","categoryIndex":1200},{"name":"hel kardemomme","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"stk.","amount":2,"articleLink":null,"articleIsNewTab":false,"category":"/krydder","categoryIndex":1200},{"name":"bukkehornkløver","preText":"","middleText":"hel ","postText":"","postText2":null,"description":null,"unit":"ts","amount":2,"articleLink":null,"articleIsNewTab":false,"category":"/krydder","categoryIndex":1200}],"videoType":"no-video","videoData":null},{"id":1256559,"type":"MatPratRecipeStepPage","name":"Steg 7","displayName":"Steg 7","url":"/oppskrifter/gjester/butter-chicken---indisk-smorkylling/steg/7/","language":"no","stepName":"Steg 7","imageUrl":"https://images.matprat.no/knalqq7xvm","imageAlt":"Butter chicken trinnbilder","imageName":"05_cashewnotter_panne","verticalImageUrl":null,"verticalImageAlt":null,"verticalImageName":null,"content":[{"type":"html","html":"Tilsett cashewpuré og bruk stavmikser eller hurtigmikser til å finmose sausen. Sil gjerne sausen gjennom en grov sikt for å få ut rester av skall, hvis du vil ha den ekstra fin."}],"blocks":null,"preparationTime":0,"ingredients":[],"videoType":"no-video","videoData":null},{"id":1256560,"type":"MatPratRecipeStepPage","name":"Steg 8","displayName":"Steg 8","url":"/oppskrifter/gjester/butter-chicken---indisk-smorkylling/steg/8/","language":"no","stepName":"Steg 8","imageUrl":"https://images.matprat.no/tcn6fglvye","imageAlt":"Butter chicken trinnbilder","imageName":"07_kylling_saus","verticalImageUrl":null,"verticalImageAlt":null,"verticalImageName":null,"content":[{"type":"html","html":"Ha sausen tilbake i kjelen og la den småkoke i i noen minutter. Smak til med honning, finhakket grønn chili, salt og pepper. Visp inn fløte og romtemperert smør i den varme sausen."}],"blocks":null,"preparationTime":0,"ingredients":[{"name":"honning","preText":"","middleText":"","postText":"","postText2":"","description":null,"unit":"ss","amount":2,"articleLink":null,"articleIsNewTab":false,"category":"/tørrvarer","categoryIndex":1000},{"name":"grønn chili","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"stk.","amount":1,"articleLink":null,"articleIsNewTab":false,"category":"/grønnsaker","categoryIndex":200},{"name":"smør","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"ss","amount":2,"articleLink":null,"articleIsNewTab":false,"category":"/melk/melkeprodukter","categoryIndex":350},{"name":"kremfløte","preText":"","middleText":"","postText":"eller matfløte","postText2":"","description":null,"unit":"dl","amount":1,"articleLink":null,"articleIsNewTab":false,"category":"/melk/melkeprodukter","categoryIndex":350}],"videoType":"no-video","videoData":null},{"id":1256561,"type":"MatPratRecipeStepPage","name":"Steg 9","displayName":"Steg 9","url":"/oppskrifter/gjester/butter-chicken---indisk-smorkylling/steg/9/","language":"no","stepName":"Steg 9","imageUrl":"https://images.matprat.no/adpgh7kkhs","imageAlt":"Butter chicken trinnbilder","imageName":"08_drysse_notter","verticalImageUrl":null,"verticalImageAlt":null,"verticalImageName":null,"content":[{"type":"html","html":"Legg kyllingbitene i sausen og la alt bli gjennomvarmt. Pynt med koriander."}],"blocks":null,"preparationTime":0,"ingredients":[{"name":"frisk koriander","preText":"","middleText":"","postText":"","postText2":null,"description":null,"unit":"potte","amount":0.5,"articleLink":null,"articleIsNewTab":false,"category":"/grønnsaker","categoryIndex":200}],"videoType":"no-video","videoData":null}]}],"process":[{"type":"html","html":"\u003col\u003e\n\u003cli\u003eFjern skinnet på kyllingen og tørk den godt. Kutt dype snitt i kjøttet på hele kyllingen. Finhakk hvitløk og bland med revet ingefær og sitronsaft, og gni kyllingen godt inn med blandingen. Dryss over litt salt. Sett kaldt i 20 minutter.\u003c/li\u003e\n\u003cli\u003eBland sammen chilipulver, garam masala, olje og yoghurt. Tørk kyllingen med litt kjøkkenpapir og gni den godt inn med yoghurtblandingen. Plasser kyllingen på et fat og sett den kaldt i minst 4-6 timer, helst over natten.\u003c/li\u003e\n\u003cli\u003eStek kyllingen midt i stekeovnen ved 200 °C, eller grill den til den er gyllenbrun og gjennomstekt, ca. 50 min. - 1 time.\u003c/li\u003e\n\u003cli\u003eAvkjøl og plukk kjøttet av beina i store biter.\u003c/li\u003e\n\u003cli\u003eLag smør- og tomatcurry: Bløtlegg cashewnøtter i litt lunkent vann i minst 30 minutter. Hell av vannet og mos nøttene i hurtigmikser eller med stavmikser. Sett til side.\u003c/li\u003e\n\u003cli\u003eDel tomater i biter. Varm en sauteringspanne med olje og fres tomater, hvitløk, ingefær, chilipulver, Kardemomme og bukkehornkløver på middels varme til tomatene er helt myke.\u003c/li\u003e\n\u003cli\u003eTilsett cashewpuré og bruk stavmikser eller hurtigmikser til å finmose sausen. Sil gjerne sausen gjennom en grov sikt for å få ut rester av skall, hvis du vil ha den ekstra fin.\u003c/li\u003e\n\u003cli\u003eHa sausen tilbake i kjelen og la den småkoke i i noen minutter. Smak til med honning, finhakket grønn chili, salt og pepper. Visp inn fløte og romtemperert smør i den varme sausen.\u003c/li\u003e\n\u003cli\u003eLegg kyllingbitene i sausen og la alt bli gjennomvarmt. Pynt med koriander.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eServer rykende varm med basmatiris og/eller \u003ca title=\"Nanbrød\" href=\"/oppskrifter/kos/nanbrod/\"\u003enaanbrød\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e"}],"beforeSteps":null,"afterSteps":[{"type":"html","html":"\u003cp\u003eServer rykende varm med basmatiris og/eller \u003ca title=\"Nanbrød\" href=\"/oppskrifter/kos/nanbrod/\"\u003enaanbrød\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003e \u003c/p\u003e"}],"showNutritions":true,"nutrition":{"energy":{"value":657.355,"unit":"kcal"},"fat":{"value":44.921083333333335,"unit":"g"},"protein":{"value":46.44075000000001,"unit":"g"},"carbohydrates":{"value":15.329333333333338,"unit":"g"},"iron":{"value":null,"unit":"mg"},"iodine":{"value":null,"unit":"µg"},"vitaminD":{"value":null,"unit":"µg"}},"commentsEnabled":false,"commentsCount":26,"difficulty":"Avansert","category":"Gjester","rating":5,"ratingPrecise":4.8,"ratingCount":377,"isScalable":true,"portions":6,"maxPortions":50,"portionsInfo":null,"hideSocialBar":false,"searchTags":[{"id":23,"category":"Middagsrett","searchUrl":"/sok?category=recipes\u0026filtersActive=23"},{"id":26,"category":"Kyllingfilet","searchUrl":"/sok?category=recipes\u0026filtersActive=26"},{"id":28,"category":"Gryter","searchUrl":"/sok?category=recipes\u0026filtersActive=28"}],"moreIdeas":{"id":"e8387786-5728-4b67-80ee-378559a2bb36","contentType":"teaser-collec