:"ss","amount":1,"category":"/margarin/olje/majones","categoryIndex":450},{"name":"sitronsaft","unit":"ss","amount":1,"category":"/frukt","categoryIndex":250},{"name":"honning","unit":"ts","amount":1,"category":"/tørrvarer","categoryIndex":1000},{"name":"hvitløk","unit":"stk.","amount":1,"category":"/grønnsaker","categoryIndex":200},{"name":"nøytral olje","unit":"ts","amount":1,"category":"/margarin/olje/majones","categoryIndex":450},{"name":"gresk yoghurt","unit":"dl","amount":3,"category":"/melk/melkeprodukter","categoryIndex":350},{"name":"sitronsaft","unit":"ss","amount":1,"category":"/frukt","categoryIndex":250},{"name":"honning","unit":"ts","amount":1,"category":"/tørrvarer","categoryIndex":1000},{"name":"pitabrød","unit":"stk.","amount":4,"category":"/korn/mel/bakervarer","categoryIndex":1100},{"name":"fetaost","unit":"g","amount":50,"category":"/ost","categoryIndex":400}],"isLikable":true,"verticalImage":{"url":"https://images.matprat.no/aa4e3uhzlh","alt":"Döner kebab med kylling","name":"viral_døner_kebab_med_kylling_3","profile":"VerticalRedesign"},"image":{"url":"https://images.matprat.no/axqh4fk33y","alt":"Döner kebab med kylling","name":"viral_døner_kebab_med_kylling_4","profile":"Redesign"}},"additionalData":null},"socialThemeBoxRecipes":[{"contentId":322307,"name":"Våre beste tips til grillmaten","longDescription":"Lær deg hvordan du griller alle dine sommerfavoritter til perfeksjon!","imageUrl":"https://images.matprat.no/2nxa2lptgj","imageAlt":"Tomahawk med grillet søtpotet","imageName":"tomahawk_3.jpg","url":"/grillmat/"},{"contentId":567937,"name":"Enkelt på grillen","longDescription":null,"imageUrl":"https://images.matprat.no/je7eryblke","imageAlt":"Enkelt på grillen","imageName":null,"url":"/var/enkelt-pa-grillen/"},{"contentId":1550378,"name":"Pinsa med spekeskinke og mozzarella","longDescription":"En luftig pinsabunn toppet med coppaskinke, mozzarella, pesto, basilikum og pinjekjerner. Dette er kosemat du kan lage enten det skal gå raskt i hverdagen, eller du skal samle vennegjengen en helg. ","imageUrl":"https://images.matprat.no/fb2t5t2ze8","imageAlt":"Pinsa med spekeskinke, mozzarella og pesto","imageName":"pinsa_med_spekeskinke_mozzarella_og_pesto_bredde.jpg","url":"/oppskrifter/kos/pinsa-med-spekeskinke-og-mozzarella/"},{"contentId":1552187,"name":"Pinsa med salami og blåmuggost","longDescription":"Pinsa med salami, kremet blåmuggost, søt pære og sprø valnøtter er en perfekt kombinasjon av salt, søtt og fyldig. Den rustikke bunnen løfter smakene, og gjør dette til en pinsa som passer like godt til helgekos som når du vil servere noe litt annerledes til gjester.","imageUrl":"https://images.matprat.no/e5pb3h23dc","imageAlt":"Pinsa med salami og blåmuggost","imageName":"pinsa_med_salami_og_blåmuggost_3.jpg","url":"/oppskrifter/kos/pinsa-med-salami-og-blamuggost/"},{"contentId":1552147,"name":"Pinsa med mortadella og burrata","longDescription":"Pinsa toppet med silkemyk mortadella, kremet burrata og sprø pistasjenøtter er en av de mest populære kombinasjonene fra det moderne romerske kjøkkenet. Den luftige bunnen møter salt, søtt og kremet i perfekt balanse.","imageUrl":"https://images.matprat.no/l2erbzhj4l","imageAlt":"Pinsa med mortadella og burrata","imageName":"pinsa_med_mortadella_burrata_og_pistasjenøtter_6.jpg","url":"/oppskrifter/kos/pinsa-med-mortadella-og-burrata/"},{"contentId":93303,"name":"Kylling- og pastasalat med pesto","longDescription":"Pastasalat med deilig pestodressing, fargerike tomater og saftig kylling. Perfekt sommermat til sene kvelder på terrassen eller når du skal ha med noe godt til sommerfesten.","imageUrl":"https://images.matprat.no/hubb8776gr","imageAlt":"Kylling- og pastasalat med pesto","imageName":"kylling_og_pastasalat_med_pesto.jpg","url":"/oppskrifter/familien/kylling--og-pastasalat-med-pesto/"},{"contentId":87311,"name":"Greske kjøttboller","longDescription":"Greske kjøttboller av lam med gresk salat og tzatziki gir gode minner om sol, sommer og greske tavernaer.","imageUrl":"https://images.matprat.no/v8c3gkff8a","imageAlt":"Lammeboller med gresk salat og tzatziki","imageName":"greske_lammeboller_med_gresk_salat_2706_1.jpg","url":"/oppskrifter/kos/greske-kjottboller/"},{"contentId":1371994,"name":"Asiatisk bowl med kjøttdeig","longDescription":"Dette er en av dine nye go-to retter i hverdagen! En superenkel og rask hverdagsmiddag alle vil like. Kjøttdeig med asiatiske smaker, ris og friske grønnsaker, og vil du ha litt ekstra spice, topp med en rask chili-peanøttopping. ","imageUrl":"https://images.matprat.no/fn47ptplkn","imageAlt":"Asiatisk bowl med kjøttdeig","imageName":"asiatisk_bowl_med_kjøttdeig.jpg","url":"/oppskrifter/rask/asiatisk-bowl-med-kjottdeig/"},{"contentId":304251,"name":"Enkel kyllingramen","longDescription":"Nudelsuppe, ramen, er en tradisjonell japansk rett som opprinnelig kommer fra Kina. Det finnes utallige varianter og dette er en rask og enkel variant der du bruker ferdig kyllingkraft smakssatt med blant annet chili, hvitløk, anis og misopaste. Serveres med nudler, kokte egg, skiver av saftig kyllingkjøtt, sprøe grønnsaker og frisk koriander. ","imageUrl":"https://images.matprat.no/fx2ag8zcap","imageAlt":"Enkel kyllingramen","imageName":"23.01_055.jpg","url":"/oppskrifter/sunn/kyllingramen/"},{"contentId":1549945,"name":"Pinsa","longDescription":"Hvilken pinsa blir din nye favoritt?","imageUrl":"https://images.matprat.no/vke666zcf8","imageAlt":"Pinsa med pulled pork","imageName":"pinsa_med_pulled_pork_2_av_2_.jpg","url":"/pinsa/"},{"contentId":999196,"name":"Sommersalater","longDescription":"Sommersalater du får dilla på","imageUrl":"https://images.matprat.no/vpet8exbtr","imageAlt":"Sommersalater","imageName":null,"url":"/sommer/sommersalat/"}],"loginBanner":{"header":"Logg inn og lås opp alle personlige tjenester og verktøy","benefits":["Lag dine egne kokebøker","Legg inn dine egne oppskrifter","Lagre dine egne ukemenyer","Lagre favorittoppskrifter","Personlig opplevelse på Min side","Abonner på nyhet