:4.8,"dimension15":null,"dimension16":"Oppskrift"},"metaData":{"title":"Butter chicken | Oppskrift og video","canonicalLink":"https://www.matprat.no/oppskrifter/gjester/butter-chicken---indisk-smorkylling/","facebookAppId":"275661345875937","contentTags":[{"name":"description","content":"Butter chicken – eller murgh makhani som retten heter på indisk – er en av de mest kjente indiske curryrettene. Hovedingrediens er er kylling marinert i yoghurt og krydder. Vi bruker kyllingfilet eller lårfilet, som er mørt og saftig. Basmatiris eller ferske nanbrød serveres til."},{"name":"google-site-verification","content":"bDBv_JHA2hib0MT3FCkmnBFYqsjsbUkqVJUs_7kLQDU"}],"propertyTags":[{"property":"fb:admins","content":"100005957289931"},{"property":"fb:app_id","content":"275661345875937"},{"property":"og:title","content":"Butter chicken - indisk smørkylling"},{"property":"og:type","content":"article"},{"property":"og:url","content":"https://www.matprat.no/oppskrifter/gjester/butter-chicken---indisk-smorkylling/"},{"property":"og:description","content":"Butter chicken – eller murgh makhani som retten heter på indisk – er en av de mest kjente indiske curryrettene. Denne oppskriften har vi fått av kjøkkensjefen på restaurant Listen to Baljit i Oslo. "},{"property":"og:image","content":"https://images.matprat.no/5jm2e5m2ne-normal/710/og.png"},{"property":"og:image:width","content":"710"},{"property":"og:image:height","content":"399"},{"property":"article:section","content":"Gjester"},{"property":"article:tag","content":"rank:2"},{"property":"article:tag","content":"Gjester"},{"property":"article:tag","content":"Over 60 min"},{"property":"article:tag","content":"Avansert"},{"property":"article:tag","content":"kylling (ca. 1300 g)"},{"property":"article:tag","content":"hvitløk"},{"property":"article:tag","content":"frisk ingefær"},{"property":"article:tag","content":"sitronsaft"},{"property":"article:tag","content":"gresk yoghurt"},{"property":"article:tag","content":"chilipulver"},{"property":"article:tag","content":"garam masala"},{"property":"article:tag","content":"rapsolje"},{"property":"article:tag","content":"cashewnøtter"},{"property":"article:tag","content":"tomat"},{"property":"article:tag","content":"nøytral olje"},{"property":"article:tag","content":"hvitløk"},{"property":"article:tag","content":"frisk ingefær"},{"property":"article:tag","content":"chilipulver"},{"property":"article:tag","content":"hel kardemomme"},{"property":"article:tag","content":"bukkehornkløver"},{"property":"article:tag","content":"honning"},{"property":"article:tag","content":"grønn chili"},{"property":"article:tag","content":"smør"},{"property":"article:tag","content":"kremfløte"},{"property":"article:tag","content":"frisk koriander"}]},"breadcrumb":[{"name":"matprat.no","url":"/","isCurrent":false},{"name":"Oppskrifter","url":"/oppskrifter/","isCurrent":false},{"name":"Butter chicken - indisk smørkylling","url":"/oppskrifter/gjester/butter-chicken---indisk-smorkylling/","isCurrent":true}],"structuredData":"[{\"name\":\"Butter chicken - indisk smørkylling\",\"datePublished\":\"2019-06-11\",\"description\":\"Butter chicken – eller murgh makhani som retten heter på indisk – er en av de mest kjente indiske curryrettene. Hovedingrediens er er kylling marinert i yoghurt og krydder. Vi bruker kyllingfilet eller lårfilet, som er mørt og saftig. Basmatiris eller ferske nanbrød serveres til. Avansert vanskelighetsgrad\",\"estimatedCost\":\"$$\",\"cookTime\":\"PT80M\",\"prepTime\":\"PT80M\",\"totalTime\":\"PT80M\",\"keywords\":\"Butter chicken, smørkylling, kylling, murgh makhani, curry, gurkemeie, indisk, indisk gryte, basmatiris, koriander\",\"recipeYield\":\"6 PORSJONER\",\"recipeCategory\":[\"Kyllingfilet\",\"Gryter\"],\"recipeCuisine\":[\"Internasjonal\"],\"cookingMethod\":[\"Blande\",\"Mose\",\"Ovnssteke\",\"Skjære\"],\"video\":[{\"name\":\"Butter Chicken - kjapt og greit! | MatPrat\",\"description\":\"Butter chicken har blitt en folkefavoritt fra det indiske kjøkken. Se hvordan man lager den populære indiske retten av hel kylling og en deilig smørcurry. \\n\\nDeilige smaker og en forrykende god lukt, passer perfekt om du skal invitere til gjester. \\nServer med blant annet naanbrød, basmatiris og raita. NAM!\\n\\n➡️ Her finner du oppskriften:\\nhttps://www.matprat.no/oppskrifter/gjester/butter-chicken---indisk-smorkylling/\\n\\n➡️ Her finner du oppskrift på hjemmelaget naanbrød:\\nhttps://www.matprat.no/oppskrifter/kos/nanbrod/\\n\\n➡️ Se flere Kylling-oppskrifter:\\nhttps://www.matprat.no/kylling/\\n\\nAbonner på kanalen vår for nydelige oppskrifter og nyttige tips:\\nhttps://goo.gl/beBt6i \\n\\nFølg oss gjerne i sosiale medier: \\nFacebook | https://www.facebook.com/MatPrat \\nInstagram | https://www.instagram.com/matprat.no \\nFlere oppskrifter | https://www.matprat.no\",\"thumbnailUrl\":\"https://i.ytimg.com/vi/NwlfMV747vI/sddefault.jpg\",\"contentUrl\":\"https://youtu.be/NwlfMV747vI\",\"embedUrl\":null,\"uploadDate\":\"2021-09-22T11:00:20Z\",\"@type\":\"VideoObject\"}],\"image\":[{\"@type\":\"ImageObject\",\"url\":\"https://images.matprat.no/5jm2e5m2ne__w=1200_h=1200_autocrop=true_cropMode=zoom/image.webp\",\"width\":1200,\"height\":1200}],\"author\":{\"name\":\"Matprat\",\"@type\":\"Person\"},\"recipeIngredient\":[\" 1 stk. kylling (ca. 1300 g)\",\" 4 båter hvitløk\",\" 0,5 ss revet frisk ingefær\",\" 2 ss sitronsaft\",\" 1 dl gresk yoghurt\",\" 0,5 ss chilipulver (helst indisk)\",\" 1 ss garam masala\",\" 1 ss rapsolje eller sennepsolje\",\" 100 g cashewnøtter\",\" 8 stk. tomat\",\" 2 ss nøytral olje\",\" 4 båter finhakket hvitløk\",\" 0,5 ss revet frisk ingefær\",\" 0,5 ss chilipulver (helst indisk)\",\" 2 stk. hel kardemomme\",\" 2 ts hel  bukkehornkløver\",\" 2 ss honning\",\" 1 stk. grønn chili\",\" 2 ss smør\",\" 1 dl kremfløte eller matfløte\",\" 0,5 potte frisk koriander\"],\"@context\":\"https://schema.org\",\"@type\":\"Recipe\",\"recipeInstructions\":[{\"@type\":\"HowToStep\",\"text\":\"Fjern skinnet på kyllingen og tørk den godt. Kutt dype snitt i kjøttet på hele kyllingen. Finhakk hvitløk og bland med revet ingefær og sitronsaft, og gni kyllingen godt inn med blandingen. Dryss over litt salt. Sett kaldt i 20 minutter.\"},{\"@type\":\"HowToStep\",\"text\":\"Bland sammen chilipulver, garam masala, olje og yoghurt. Tørk kyllingen med litt kjøkkenpapir og gni den godt inn med yoghurtblandingen. Plasser kyllingen på et fat og sett den kaldt i minst 4-6 timer, helst over natten.\"},{\"@type\":\"HowToStep\",\"text\":\"Stek kyllingen midt i stekeovnen ved 200 °C, eller grill den til den er gyllenbrun og gjennomstekt, ca. 50 min. - 1 time.\"},{\"@type\":\"HowToStep\",\"text\":\"Avkjøl og plukk kjøttet av beina i store biter.\"},{\"@type\":\"HowToStep\",\"text\":\"Lag smør- og tomatcurry: Bløtlegg cashewnøtter i litt lunkent vann i minst 30 minutter. Hell av vannet og mos nøttene i hurtigmikser eller med stavmikser. Sett til side.\"},{\"@type\":\"HowToStep\",\"text\":\"Del tomater i biter. Varm en sauteringspanne med olje og fres tomater, hvitløk, ingefær, chilipulver, kardemomme og bukkehornkløver på middels varme til tomatene er helt myke.\"},{\"@type\":\"HowToStep\",\"text\":\"Tilsett cashewpuré og bruk stavmikser eller hurtigmikser til å finmose sausen. Sil gjerne sausen gjennom en grov sikt for å få ut rester av skall, hvis du vil ha den ekstra fin.\"},{\"@type\":\"HowToStep\",\"text\":\"Ha sausen tilbake i kjelen og la den småkoke i i noen minutter. Smak til med honning, finhakket grønn chili, salt og pepper. Visp inn fløte og romtemperert smør i den varme sausen.\"},{\"@type\":\"HowToStep\",\"text\":\"Legg kyllingbitene i sausen og la alt bli gjennomvarmt. Pynt med koriander.\"}],\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":4.77188328912467,\"ratingCount\":377},\"nutrition\":{\"@type\":\"NutritionInformation\",\"calories\":\"657 KCAL\",\"carbohydrateContent\":\"15 G\",\"proteinContent\":\"46 G\",\"fatContent\":\"45 G\"}},{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"url\":\"https://youtu.be/NwlfMV747vI\",\"thumbnailUrl\":\"https://i.ytimg.com/vi/NwlfMV747vI/sddefault.jpg\",\"name\":\"Butter Chicken - kjapt og greit! | MatPrat\"}]","speakableStructuredData":null,"disableLoginBanner":false,"published":"2026-07-31 08:01:50","version":"11.21.1.20069/WEB15 2026-08-01 16:28:13","versionTime":"0,422","popular":{"id":"37511ee9-f924-412d-925a-e9213210dd75","contentType":"teaser-collection","type":"grid","header":null,"layout":{"desktop":{"columns":4,"mediaRatio":"12x16"},"mobile":{"variant":"half","mediaRatio":"12x16"}},"isWide":true,"contentMode":"title","teasers":[{"id":"93184","type":"recipe","theme":"lightGreen","slots":1,"title":"Pannekaker","description":"","data":{"contentType":"MatPratRecipePage","id":93184,"name":"Pannekaker","newTab":false,"verticalImageUrl":"https://images.matprat.no/2geqmnxljh","verticalImageAlt":"Grove pannekaker","verticalImageName":"grove_pannekaker","verticalImageProfile":"VerticalRedesign","imageUrl":"https://images.matprat.no/6xn6gxppv8","imageAlt":"Pannekaker","imageName":"hverdagspannekaker","imageProfile":"Redesign","linkUrl":"/oppskrifter/familien/pannekaker/","difficulty":"Middels","preparationTime":"40–60 min","category":"Familien","portions":4,"maxPortions":50,"isScalable":true,"rating":5,"ratingPrecise":4.8,"ratingCount":4510,"ingredients":null,"isLikable":true,"image":{"url":"https://images.matprat.no/6xn6gxppv8","alt":"Pannekaker","name":"hverdagspannekaker","profile":"Redesign"},"verticalImage":{"url":"https://images.matprat.no/2geqmnxljh","alt":"Grove pannekaker","name":"grove_pannekaker","profile":"VerticalRedesign"}},"additionalData":null},{"id":"92668","type":"recipe","theme":"lightGreen","slots":1,"title":"Vafler","description":"","data":{"contentType":"MatPratRecipePage","id":92668,"name":"Vafler","newTab":false,"verticalImageUrl":"https://images.matprat.no/pdfsz8cxeu","verticalImageAlt":"Vafler jpg","verticalImageName":"vafler_med_bringebær_og_