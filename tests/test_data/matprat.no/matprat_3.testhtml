Text":null,"postText2":null,"description":null,"unit":"ss","amount":1,"articleLink":null,"articleIsNewTab":false,"category":"/hermetikk","categoryIndex":900},{"name":"soyasaus","preText":null,"middleText":null,"postText":null,"postText2":null,"description":null,"unit":"ss","amount":1,"articleLink":null,"articleIsNewTab":false,"category":"/diverse","categoryIndex":800},{"name":"tabasco","preText":null,"middleText":null,"postText":null,"postText2":null,"description":null,"unit":"ts","amount":0.5,"articleLink":null,"articleIsNewTab":false,"category":"/krydder","categoryIndex":1200}],"videoType":"no-video","videoData":null}]},{"groupName":null,"steps":[{"id":1337827,"type":"MatPratRecipeStepPage","name":"Steg 4","displayName":"Steg 4","url":"/oppskrifter/gjester/potetsalat/steg/4/","language":"no","stepName":"Steg 4","imageUrl":null,"imageAlt":null,"imageName":null,"verticalImageUrl":null,"verticalImageAlt":null,"verticalImageName":null,"content":[{"type":"html","html":"Vend potetene inn i dressingen. Sett potetsalaten kjølig et par timer før servering. Juster om nødvendig smaken med litt mer salt, pepper og sylteagurklake."}],"blocks":null,"preparationTime":0,"ingredients":[],"videoType":"no-video","videoData":null}]}],"process":[{"type":"html","html":"\u003col\u003e\n\u003cli\u003eSkrell potetene og kok dem i en kjele med vann til de er møre (bruker du nypoteter er det ikke nødvendig å skrelle dem). Hell av kokevannet og avkjøl potetene helt. Del dem i passe store biter.\u003c/li\u003e\n\u003cli\u003eFinkutt vårløk og løk og ha det i en bolle sammen med sylteagurk og potetbiter.\u003c/li\u003e\n\u003cli\u003eBland rømme, majones, sylteagurklake, soyasaus og tabasco. Smak til med litt salt og pepper. \u003c/li\u003e\n\u003cli\u003eVend potetene inn i dressingen. Sett potetsalaten kjølig et par timer før servering. Juster om nødvendig smaken med litt mer salt, pepper og sylteagurklake. \u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv data-possibleclass=\"\"\u003e \u003c/div\u003e\n\u003cdiv data-possibleclass=\"\"\u003e\u003cimg loading=\"lazy\" src=\"https://images.matprat.no/lxfkjenqpu-tinymce__w=920/potetsalat_høyde.jpg\" alt=\"Potetsalat\" class=\"tinymce-vertical\" /\u003e\u003c/div\u003e"}],"beforeSteps":null,"afterSteps":[{"type":"html","html":"\u003cdiv data-possibleclass=\"\"\u003e"},{"type":"data","data":{"id":1338554,"type":"MatPratInfoboxBlock","name":"Potetsalat","displayName":"Potetsalat","language":"no","content":[{"type":"html","html":"\u003cp\u003eBruk denne oppskriften som en grunnoppskrift, og varier den med for eksempel biter av syrlig eple, kapers, stilkselleri eller grønne oliven for å lage din helt egne spesialsalat. Finhakkede urter smaker alltid godt i potetsalat - for eksempel dill, gressløk, persille eller timian.\u003c/p\u003e"}],"theme":"lightGreen"}},{"type":"html","html":"\u003c/div\u003e\n\u003cdiv data-possibleclass=\"\"\u003e\u003cimg loading=\"lazy\" src=\"https://images.matprat.no/lxfkjenqpu-tinymce__w=920/potetsalat_høyde.jpg\" alt=\"Potetsalat\" class=\"tinymce-vertical\" /\u003e\u003c/div\u003e"}],"showNutritions":true,"nutrition":{"energy":{"value":211.60333333333338,"unit":"kcal"},"fat":{"value":10.41,"unit":"g"},"protein":{"value":4.016666666666667,"unit":"g"},"carbohydrates":{"value":23.217833333333335,"unit":"g"},"iron":{"value":null,"unit":"mg"},"iodine":{"value":null,"unit":"µg"},"vitaminD":{"value":null,"unit":"µg"}},"commentsEnabled":false,"commentsCount":10,"difficulty":"Enkel","category":"Gjester","rating":5,"ratingPrecise":4.8,"ratingCount":380,"isScalable":true,"portions":6,"maxPortions":50,"portionsInfo":null,"hideSocialBar":false,"searchTags":[{"id":39,"category":"Tilbehør","searchUrl":"/sok?category=recipes\u0026filtersActive=39"},{"id":42,"category":"Annet tilbehør","searchUrl":"/sok?category=recipes\u0026filtersActive=42"},{"id":49,"category":"Koldtbord","searchUrl":"/sok?category=recipes\u0026filtersActive=49"}],"moreIdeas":{"id":"5c2aa058-f17b-49cb-8c60-705a51408bc6","contentTy