<!DOCTYPE html><html lang="no"><head><script type="text/javascript">window.matprat = window.matprat || {}; window.matprat.IsAuthenticated = false; window.matprat.Editor = null;</script><meta charSet="utf-8" data-next-head=""/><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" data-next-head=""/><link rel="preload" href="/Sites/OEK.MatPrat.AddOn/Content/Styles/fonts/ABCROM/ABCROM-Regular.woff" crossorigin="anonymous" as="font"/><link rel="preload" href="/Sites/OEK.MatPrat.AddOn/Content/Styles/fonts/ABCROMCondensed/ABCROMCondensed-Medium.woff" crossorigin="anonymous" as="font"/><link rel="preload" href="/Sites/OEK.MatPrat.AddOn/Content/Styles/fonts/JetBrainsMono/JetBrainsMono-Regular.woff" crossorigin="anonymous" as="font"/><link rel="preload" href="/Sites/OEK.MatPrat.AddOn/Content/Styles/fonts/OTBulb/OTBulbReverse.woff" crossorigin="anonymous" as="font"/><title data-next-head="">Potetsalat | Oppskrift</title><link rel="canonical" href="https://www.matprat.no/oppskrifter/gjester/potetsalat/" data-next-head=""/><meta name="description" content="Vår klassiske oppskrift på potetsalat med rømme og majones passer like godt enten det er som tilbehør til grillmaten eller på koldtbordet." data-next-head=""/><meta name="keywords" content="oppskrift, potetsalat, " data-next-head=""/><meta name="google-site-verification" content="bDBv_JHA2hib0MT3FCkmnBFYqsjsbUkqVJUs_7kLQDU" data-next-head=""/><meta property="fb:admins" content="100005957289931" data-next-head=""/><meta property="fb:app_id" content="275661345875937" data-next-head=""/><meta property="og:title" content="Potetsalat" data-next-head=""/><meta property="og:type" content="article" data-next-head=""/><meta property="og:url" content="https://www.matprat.no/oppskrifter/gjester/potetsalat/" data-next-head=""/><meta property="og:description" content="Klassisk potetsalat med rømme og majones er populær på koldtbordet og som tilbehør til grillmaten." data-next-head=""/><meta property="og:image" content="https://images.matprat.no/283rpv278n-normal/710/og.png" data-next-head=""/><meta property="og:image:width" content="710" data-next-head=""/><meta property="og:image:height" content="399" data-next-head=""/><meta property="article:section" content="Gjester" data-next-head=""/><meta property="article:tag" content="rank:2" data-next-head=""/><meta property="article:tag" content="Gjester" data-next-head=""/><meta property="article:tag" content="40–60 min" data-next-head=""/><meta property="article:tag" content="Enkel" data-next-head=""/><meta property="article:tag" content="potet" data-next-head=""/><meta property="article:tag" content="vårløk" data-next-head=""/><meta property="article:tag" content="løk" data-next-head=""/><meta property="article:tag" content="hel sylteagurk" data-next-head=""/><meta property="article:tag" content="majones" data-next-head=""/><meta property="article:tag" content="lettrømme" data-next-head=""/><meta property="article:tag" content="lake av syltet agurk" data-next-head=""/><meta property="article:tag" content="soyasaus" data-next-head=""/><meta property="article:tag" content="tabasco" data-next-head=""/><meta name="build-version" content="11.21.1.20069/WEB13 2026-08-01 16:15:56" data-next-head=""/><meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/><meta name="theme-color" content="#fefef7"/><link rel="icon" href="https://www.matprat.no/Sites/OEK.MatPrat.AddOn/Content/Images/logo/favicon.png?v=6" type="image/png"/><link rel="preload" href="/_next/static/css/d685722e56647d62.css" as="style"/><link rel="preload" href="/_next/static/css/dd7617894e14ad01.css" as="style"/><link rel="preload" href="/_next/static/css/058201ee9089bf15.css" as="style"/><link rel="preload" href="/_next/static/css/5d1a7b7514789f2c.css" as="style"/><link rel="preload" href="/_next/static/css/a7a7c1e27c0bebb2.css" as="style"/><link rel="preload" href="/_next/static/css/ad3b2133d373063c.css" as="style"/><link rel="preload" href="/_next/static/css/0a314727edd913b3.css" as="style"/><link rel="preload" href="/_next/static/css/246008aed9323960.css" as="style"/><link rel="preload" href="/_next/static/css/58af6df0ea59b2b7.css" as="style"/><link rel="preload" href="/_next/static/css/7737f5efb5066f4e.css" as="style"/><link rel="preload" href="/_next/static/css/99dbcf5aff479a13.css" as="style"/><script type="text/javascript" data-next-head="">fbAppId = 275661345875937;</script><script type="application/ld+json" data-next-head="">[{"name":"Potetsalat","datePublished":"2014-04-01","description":"Vår klassiske oppskrift på potetsalat med rømme og majones passer like godt enten det er som tilbehør til grillmaten eller på koldtbordet. Enkel vanskelighetsgrad","totalTime":"PT60M","keywords":"kremet potetsalat, potetsalat, klassisk potetsalat, vanlig potetsalat, nypotet, tilbehør til grillmat, vårløk, løk,","recipeYield":"6 PORSJONER","recipeCategory":["Tilbehør","Koldtbord"],"recipeCuisine":["Europa","Norge"],"cookingMethod":["Blande","Koke","Skrelle"],"video":[{"name":"Matprat: 3x potetsalat","description":"Ikke 1, ikke 2, men 3 potetsalater! Har får du tips til gode varianter med dressing av rømme, olje eller smør, salt og pepper. Salater som passer perfekt til sommerens grillmat.\n\n500 g kokte poteter\n3 stk finsnittet vårløk\n1 pk reddik i båter\n2 ss finhakket gressløk\n\nKremet dressing: \n2 dl rømme\n2 ss majones\n½ ts salt \n¼ ts pepper \n\nOljebasert dressing:\n1 ss grov dijonsennep\n2 ts honning \n1 dl rapsolje\n1 ts salt\n½ ts pepper\n\nFoliepakket:\n75 g smør \n1/2 ts salt\n1/4 ts pepper\n\n1. Skjær kokte poteter i store biter\n2. Kutt reddik i båter, finhakk vårløk og gressløk. \n3. Bland sammen ingrediensene til den dressingen du ønsker, og hell den over potetene. Vend alt godt sammen, og juster eventuelt smaken med litt ekstra salt og pepper.\nTips: Til den oljebaserte dressingen lønner det seg å piske sammen sennep og honning, og deretter spe forsiktig med oljen samtidig som du pisker. Da får du en homogen blanding som setter seg bedre på potetene.\n4. Skal du lage foliepakkede poteter, ha på smør, salt og pepper. Legg pakkene på grillen i 6-7 minutter.\nServer en av potetsalatene til den deilige grillmaten din!","thumbnailUrl":"https://img.youtube.com/vi/2vpelX3-Bqc/mqdefault.jpg","contentUrl":"https://youtu.be/2vpelX3-Bqc","embedUrl":null,"uploadDate":"2016-06-01T12:52:18+02:00","@type":"VideoObject"}],"image":[{"@type":"ImageObject","url":"https://images.matprat.no/283rpv278n__w=1200_h=1200_autocrop=true_cropMode=zoom/image.webp","width":1200,"height":1200}],"author":{"name":"Matprat","@type":"Person"},"recipeIngredient":[" 1 kg potet"," 4 stk. vårløk"," 0,5 stk. løk"," 2 stk. hel sylteagurk (eller tilsvarende skivet sylteagurk)"," 4 ss majones"," 2 dl lettrømme"," 1 ss lake av syltet agurk"," 1 ss soyasaus"," 0,5 ts tabasco"," 4 ss majones"," 2 dl lettrømme"," 1 ss soyasaus"," 1 ss lake av syltet agurk"," 0,5 ts tabasco"],"@context":"https://schema.org","@type":"Recipe","recipeInstructions":[{"@type":"HowToStep","text":"Skrell potetene og kok dem i en kjele med vann til de er møre (bruker du nypoteter er det ikke nødvendig å skrelle dem). Hell av kokevannet og avkjøl potetene helt. Del dem i passe store biter."},{"@type":"HowToStep","text":"Finkutt vårløk og løk og ha det i en bolle sammen med sylteagurk og potetbiter."},{"@type":"HowToStep","text":"Bland majones, rømme, sylteagurklake, soyasaus og tabasco. Smak til med litt salt og pepper."},{"@type":"HowToStep","text":"Vend potetene inn i dressingen. Sett potetsalaten kjølig et par timer før servering. Juster om nødvendig smaken med litt mer salt, pepper og sylteagurklake."}],"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8421052631579,"ratingCount":380},"nutrition":{"@type":"NutritionInformation","calories":"212 KCAL","carbohydrateContent":"23 G","proteinContent":"4 G","fatContent":"10 G"}}]</script><script id="gtm-datalayer-init" data-nscript="beforeInteractive">window.dataLayer = window.dataLayer || []; var __d = {"dimension1":"","dimension2":"Gjester,Klassisk gjestemat,","dimension3":"40–60 min","dimension4":"Enkel","dimension5":"Potetsalat","dimension7":10,"dimension8":"Tilbehør,Koldtbord","dimension9":"Annet tilbehør","dimension11":"Regular","dimension14":4.8,"dimension15":null,"dimension16":"Oppskrift"}; var __isAuth = window.matprat && window.matprat.IsAuthenticated; __d.dimension15 = __isAuth ? "logged-in" : "logged-out"; window.dataLayer.push(__d);</script><link rel="stylesheet" href="/_next/static/css/d685722e56647d62.css" data-n-g=""/><link rel="stylesheet" href="/_next/static/css/dd7617894e14ad01.css" data-n-p=""/><link rel="stylesheet" href="/_next/static/css/058201ee9089bf15.css" data-n-p=""/><link rel="stylesheet" href="/_next/static/css/5d1a7b7514789f2c.css" data-n-p=""/><link rel="stylesheet" href="/_next/static/css/a7a7c1e27c0bebb2.css" data-n-p=""/><link rel="stylesheet" href="/_next/static/css/ad3b2133d373063c.css" data-n-p=""/><link rel="stylesheet" href="/_next/static/css/0a314727edd913b3.css"/><link rel="stylesheet" href="/_next/static/css/246008aed9323960.css"/><link rel="stylesheet" href="/_next/static/css/58af6df0ea59b2b7.css"/><link rel="stylesheet" href="/_next/static/css/7737f5efb5066f4e.css"/><link rel="stylesheet" href="/_next/static/css/99dbcf5aff479a13.css"/><noscript data-n-css=""></noscript><script defer="" noModule="" src="/_next/static/chunks/polyfills-42372ed130431b0a.js"></script><script src="https://www.youtube.com/iframe_api" defer="" data-nscript="beforeInteractive"></script><script defer="" src="/_next/static/chunks/4496.de910f6361079891.js"></script><script defer="" src="/_next/static/chunks/6032.afecd88caf3ec138.js"></script><script defer="" src="/_next/static/chunks/835.7962c60ee082ac17.js"></script><script src="/_next/static/chunks/webpack-97fdd8b8df9b9d82.js" defer=""></script><script src="/_next/static/chunks/framework-26883e0b6309ead1.js" defer=""></script><script src="/_next/sta