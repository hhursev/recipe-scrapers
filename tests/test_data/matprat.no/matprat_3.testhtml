atingRateAgaingText":"Vil du ombestemme deg? Gi en ny vurdering!","recipeRatingSaveText":"Send","recipeRatingConfirmText":"Hvor mange stjerner vil du gi denne oppskriften?","recipeRatingYummyText":"Yummy!","recipeLeftoversHeaderText":"Bruk opp restene!","recipeLeftoversAboutText":"Har du noe til overs fra du lagde denne retten? Prøv denne oppskriften!","recipeMoreIdeasHeaderText":"Du liker kanskje disse også","recipeSustainabilityAndProductionHeaderText":"Andre ting du kanskje synes er interessant","weeklyMenuPlannerText":"Legg i ukeplanen"},"planner":{"title":"Ukeplanlegger","thumbnailImageUrl":"https://images.matprat.no/dgmy8s2yb8","searchRecipesText":"Finn oppskrifter og legg dem i ukeplanen din","luckyShotText":"Ta sjansen!","addWeekText":"Legg hele uka i handlelisten","saveToWeeklyPlansText":"Lagre i mine ukeplaner","clearWeekText":"Fjern alle oppskriftene","addToPlannerText":"Legg i ukeplanleggeren","tryAgainText":"Prøv igjen","pickDayText":"Velg dag","pickWeekText":"Velg uke","addToDayText":"Legg til valgt dag","addToWeekText":"Legg til valgt uke","setWeeklyPlanNameText":"Gi ukeplanen et navn","addAllToShoppingListText":"Legg i handlelisten","addAllToPlannerText":"Legg alle oppskriftene i ukeplanen","editWeeklyPlanText":"Rediger ukeplanen","mergePlannersMessageText":"Du har lagt noen oppskrifter i ukeplanen din, før du logget inn. Vil du legge dem til, i tillegg til oppskriftene du kanskje allerede har i ukeplanen?","mergingConfirmationText":"Ja, legg til alle","cancelMergingText":"Ikke legg til","moveToOtherDayText":"Flytt til en annen dag","backToPlannerText":"Tilbake til ukeplanleggeren","saveWeeklyPlanMessageText":"Du finner planen din under Min Matprat","addAllWeeklyMenuText":"Legg til alt i planleggeren min","deleteRecipesWarningText":"Er du sikker på at du vil fjerne alle oppskriftene?","deletePlannerWarningText":"Er du sikker på at du vil fjerne planleggeren?","editPlannerTitleText":"Rediger ukeplan","editPlannerSubtitleText":"Gi planen nytt navn","filtersHeader":"Filter","noRecipesHeader":"Vi har ingen oppskrifter!","noRecipesText":"Forsøk igjen med andre ord eller fjern eventuelle valg i filteret!","clearAllFiltersText":"Tøm filter","ingredientsFilterPlaceholder":"Skriv inn ingredienser","ingredientGroupSuffixText":"Ingrediensgruppe","recipesAvailableText":"oppskrifter tilgjengelig","changeButtonText":"Bruk","fridgeLinkHeaderText":"Kast mindre mat!","fridgeLinkSubHeaderText":"Bruk opp restene dine...","addToPlannerFromWeeklyMenuPopupButtonText":"Gå til ukeplanleggeren","addToPlannerFromWeeklyMenuPopupInfoText":"Du har nå lagt denne ukemenyen i planleggeren din","addToPlannerFromWeeklyMenuMainButtonText":"Legg uka i planleggeren","weeklyMenuTitleText":"Se vårt forslag til en variert ukemeny","weeklyMenuOpenButtonText":"Ukemeny for uke","noteAddText":"Legg til notat","noteEditText":"Rediger notat","noteSaveText":"Lagre notat","noteInputPlaceholder":"Legg inn valgfri tekst (for eksempel \"Bursdag hos bestefar\" eller \"Restemiddag\"","noteConfirmDiscardQuestionText":"Er du sikker på at du vil avbryte redigeringen?","noteConfirmDiscardYesText":"Ja, avbryt","noteConfirmDiscardNoText":"Nei, gå tilbake","noteConfirmDeleteQuestionText":"Er du sikker på at du vil slette notatet ditt?","noteConfirmDeleteYesText":"Ja, slett notat","noteConfirmDeleteNoText":"Nei, gå tilbake","noteEditDateText":"Endre dato","addedRecipesToShoppingListText":"Oppskriften er lagt i handlelisten"},"cookies":{"cookiesSimpleModal":{"title":"Vi bruker cookies","content":"\u003cp\u003eVi bruker analyseverkt\u0026oslash;y for \u0026aring; m\u0026aring;le trafikken p\u0026aring; v\u0026aring;re nettsider, og informasjonskapsler som grunnlag for videreutvikling av v\u0026aring;re tjenester. Om du velger \u0026aring; bruke matprat.no blir anonymisert brukerdata samlet inn, men ingen personopplysninger om deg vil samles eller lagres.\u003c/p\u003e","showDetailsButton":"Endre innstillinger","acceptAllCookiesButton":"Godta alle"},"cookieDetailsModal":{"saveSelectedCookiesButton":"Lagre valgte","acceptAllCookiesButton":"Godta alle","rejectAllCookiesButton":"Avslå alle","selectionTabButton":"Samtykker","informationTabButton":"Detaljer","selectionTab":{"title":"\u003cp\u003eHer kan du administrere dine samtykker for bruk av cookies/ informasjonskapsler p\u0026aring; matprat.no\u003c/p\u003e","cookies":{"necessary":{"name":"Nødvendige","description":"Dette er cookies/ informasjonskapsler som er nødvendige for at nettsiden skal fungere","content":"\u003cp\u003eFor at vi skal ha mulighet til \u0026aring; drifte matprat.no og tilby helt standard funksjonalitet, m\u0026aring; et minimum av informasjonskapsler v\u0026aelig;re p\u0026aring;. Disse kan du derfor ikke velge \u0026aring; sl\u0026aring; av. Det er ikke mulig \u0026aring; spore deg som person, bare generell data om bruken av nettsiden.\u003c/p\u003e\n\u003cp\u003eHvis du ikke \u0026oslash;nsker at vi skal bruke de n\u0026oslash;dvendige informasjonskapslene heller, kan du sl\u0026aring; av disse i nettleseren din. Men da er det mange ting som ikke vil virke n\u0026aring;r du bruker nettsiden.\u003c/p\u003e"},"personalization":{"name":"Statistikk","description":"Brukes for å måle trafikk og aktivitet på siden. Informasjonen anonymiseres og ingen personopplysninger samles.","content":"\u003cp\u003eInformasjonskapslene brukes for \u0026aring; m\u0026aring;le bruk og trafikk p\u0026aring; matprat.no. Eksempler p\u0026aring; informasjon som blir lagret er antall sidevisninger, hvordan du fant nettstedet, antall bes\u0026oslash;k og hvordan du navigerer p\u0026aring; siden. Hensikten er \u0026aring; hjelpe oss til \u0026aring; \u0026oslash;ke brukervennligheten p\u0026aring; nettstedet, forbedre eksisterende og tilby ny funksjonalitet.\u0026nbsp;\u003c/p\u003e"},"marketing":{"name":"Kampanjemåling","description":"Brukes til å rapportere på hvor mange brukere som har engasjert seg i innholdet på matprat.no","content":"\u003cp\u003eInformasjonskapslene brukes til \u0026aring; rapportere p\u0026aring; hvor mange brukere som har engasjert seg i innholdet p\u0026aring; matprat.no. Det kan eksempelvis v\u0026aelig;re sett oppskrift, tid brukt p\u0026aring; side eller navigert videre inn i universet matprat.no. Denne dataen sendes til annonseplattformene, og brukes til m\u0026aring;ling og optimalisering av kommende kampanjer\u003c/p\u003e"}}},"informationTab":{"title":"\u003cp\u003eHer finner du teknisk beskrivelse av de ulike typene data vi samler og bruker.\u003c/p\u003e","cookieGroups":[{"groupTitle":null,"cookies":[{"name":"Hva er cookies/ informasjonskapsler?","description":"Informasjonskapsler er små tekstfiler som plasseres på din datamaskin når du laster ned en nettside.","content":"\u003cp\u003eSlike informasjonskapsler innhenter blant annet informasjon om nettleser, oppl\u0026oslash;sning, operativsystem hos brukerne, samt informasjon om hvorvidt brukeren er p\u0026aring;logget eller ikke.\u003c/p\u003e\n\u003cp\u003eForm\u0026aring;let med dette er \u0026aring; gj\u0026oslash;re din bruk av tjenesten raskere og bedre. Ved \u0026aring; endre innstillingene p\u0026aring; din datamaskin kan du forhindre bruk av informasjonskapsler, men du vil da kunne oppleve at ikke alle funksjoner p\u0026aring; nettstedet vil fungere. Bruker kan ogs\u0026aring; slette informasjonskapslene p\u0026aring; maskinen sin manuelt etter \u0026aring; ha bes\u0026oslash;kt et nettsted.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eLoven om elektronisk kommunikasjon krever at vi informerer brukere av nettsiden om v\u0026aring;r bruk av informasjonskapsler. Paragrafen om informasjonskapsler sier f\u0026oslash;lgende:\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"rich-text--heading3\"\u003e\u0026sect; 2-7b Bruk av informasjonskapsler/cookies\u003cbr /\u003e\u003c/span\u003e\u003cbr /\u003eLagring av opplysninger i brukers kommunikasjonsutstyr, eller \u0026aring; skaffe seg adgang til slike, er ikke tillatt uten at brukeren er informert om hvilke opplysninger som behandles, form\u0026aring;let med behandlingen, hvem som behandler opplysningene, og har samtykket til dette. F\u0026oslash;rste punktum er ikke til hinder for teknisk lagring av eller adgang til opplysninger:\u003cbr /\u003e1. utelukkende for det form\u0026aring;l \u0026aring; overf\u0026oslash;re kommunikasjon i et elektronisk kommunikasjonsnett\u003cbr /\u003e2. som er n\u0026oslash;dvendig for \u0026aring; levere en informasjonssamfunnstjeneste etter brukerens uttrykkelige foresp\u0026oslash;rsel.\u003c/p\u003e\n\u003cp\u003e\u003cspan class=\"rich-text--heading3\" style=\"font-size: 16pt;\"\u003eUnder kan du se hvilke informasjonskapsler som brukes p\u0026aring; matprat.no.\u003c/span\u003e\u003c/p\u003e"}]},{"groupTitle":"Nødvendige","cookies":[{"name":"Diverse nødvendige informasjonskapsler","description":"Disse brukes for å lagre data underveis i økten din, for eksempel hvis du vil logge inn eller legge noe i handlelisten din. Ingen persondata samles inn.","content":"\u003ctable style=\"height: 867px;\"\u003e\n\u003cthead\u003e\n\u003ctr style=\"height: 46px;\"\u003e\n\u003cth style=\"height: 46px; width: 201px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eNavn\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"height: 46px; width: 110px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eVarighet\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"height: 46px; width: 293px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eBeskrivelse\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr style=\"height: 100px;\"\u003e\n\u003ctd style=\"height: 100px; width: 201px;\"\u003e\n\u003cp\u003eARRAffinity\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 100px; width: 110px;\"\u003e\n\u003cp\u003eSession/ \u0026oslash;kt\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 100px; width: 293px;\"\u003e\n\u003cp\u003eInformasjonskapsel relatert til l\u0026oslash;sninger som benytter Windows Azure for \u0026aring; kunne differensiere trafikk mellom ulike servere.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 118px;\"\u003e\n\u003ctd style=\"height: 118px; width: 201px;\"\u003e\n\u003cp\u003e.ASPXANONYMOUS\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 118px; width: 110px;\"\u003e\n\u003cp\u003e2 m\u0026aring;neder\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 118px; width: 293px;\"\u003e\n\u003cp\u003eInformasjonskapslene er midlertidige og eksisterer kun i minnet s\u0026aring; lenge du bes\u0026oslash;ker nettsiden. Den inneholder ingen sensitiv informasjon og slettes n\u0026aring;r du lukker nettleseren.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 137px;\"\u003e\n\u003ctd style=\"height: 137px; width: 201px;\"\u003e\n\u003cp\u003eASP.NET SessionId\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 137px; width: 110px;\"\u003e\n\u003cp\u003eSession/ \u0026oslash;kt\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 137px; width: 293px;\"\u003e\n\u003cp\u003eInformasjonskapsel er kun midlertidig og eksisterer kun i minnet s\u0026aring; lenge du bes\u0026oslash;ker websiden. Denne informasjonskapselen inneholder ingen sensitiv informasjon og blir slettet n\u0026aring;r du lukker nettleseren.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 82px;\"\u003e\n\u003ctd style=\"height: 82px; width: 201px;\"\u003e\n\u003cp\u003eInternaltraffic\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 82px; width: 110px;\"\u003e\n\u003cp\u003e2 \u0026aring;r\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 82px; width: 293px;\"\u003e\n\u003cp\u003eBrukes bare internt i Matprat, s\u0026aring; v\u0026aring;r bruk av l\u0026oslash;sningene ikke telles i totaltrafikken.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 64px;\"\u003e\n\u003ctd style=\"height: 64px; width: 201px;\"\u003e\n\u003cp\u003emarketing-cookies-consent\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 64px; width: 110px;\"\u003e\n\u003cp\u003e2 \u0026aring;r\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 64px; width: 293px;\"\u003e\n\u003cp\u003eLagrer samtykket ditt, om du har godtatt markedsf\u0026oslash;ringskapsler.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 64px;\"\u003e\n\u003ctd style=\"height: 64px; width: 201px;\"\u003e\n\u003cp\u003estatistics-cookies-consent\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 64px; width: 110px;\"\u003e\n\u003cp\u003e2 \u0026aring;r\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 64px; width: 293px;\"\u003e\n\u003cp\u003eLagrer samtykket ditt, om du har godtatt kapslene for statistikk.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 82px;\"\u003e\n\u003ctd style=\"height: 82px; width: 201px;\"\u003e\n\u003cp\u003econsent-set\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 82px; width: 110px;\"\u003e\n\u003cp\u003e2 \u0026aring;r\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 82px; width: 293px;\"\u003e\n\u003cp\u003eLagrer om du har akseptert eller ikke akseptert cookies, s\u0026aring; vi vet om vi skal vise banneret igjen.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 46px;\"\u003e\n\u003ctd style=\"height: 46px; width: 201px;\"\u003e\n\u003cp\u003ecookies-revalidate\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 46px; width: 110px;\"\u003e\n\u003cp\u003e2 \u0026aring;r\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 46px; width: 293px;\"\u003e\n\u003cp\u003eIdentifiserer brukere som godtok v\u0026aring;r statistikk informasjonskapsel f\u0026oslash;r MouseFlow ble installert og vise dem informasjonskapsel-popup igjen.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 64px;\"\u003e\n\u003ctd style=\"height: 64px; width: 201px;\"\u003e\n\u003cp\u003e_GRECAPTCHA\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 64px; width: 110px;\"\u003e\n\u003cp\u003e6 m\u0026aring;neder\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 64px; width: 293px;\"\u003e\n\u003cp\u003eBeskyttelse mot spam-bots i skjemaer p\u0026aring; nettsiden.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr style=\"height: 64px;\"\u003e\n\u003ctd style=\"height: 64px; width: 201px;\"\u003e\n\u003cp\u003e_ab_test\u0026nbsp;\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 64px; width: 110px;\"\u003e\n\u003cp\u003eSession/ \u0026oslash;kt\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"height: 64px; width: 293px;\"\u003e\n\u003cp\u003eBrukes for intern a/b-testing p\u0026aring; nettsiden.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e"}]},{"groupTitle":"Statistikk","cookies":[{"name":"Google Analytics","description":"Google Analytics bruker informasjonskapsler for å gi anonymisert brukerdata for å forbedre matprat.no","content":"\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003ctable style=\"width: 655px;\" border=\"1\"\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth style=\"width: 88.0781px;\"\u003e\n\u003cp\u003e\u003cstrong\u003ePlattform\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"width: 101.094px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eNavn\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"width: 70.5312px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eVarighet\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"width: 367.297px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eBeskrivelse\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 88.0781px;\"\u003e\n\u003cp\u003eGoogle Analytics\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 101.094px;\"\u003e\n\u003cp\u003e_ga\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 70.5312px;\"\u003e\n\u003cp\u003e2 \u0026aring;r\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 367.297px;\"\u003e\n\u003cp\u003eDet brukes en identifikator best\u0026aring;ende av to tilfeldig genererte 32-biters tall. Brukes for \u0026aring; skille mellom unike, anonyme brukere.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 88.0781px;\"\u003e\n\u003cp\u003eGoogle Analytics\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 101.094px;\"\u003e\n\u003cp\u003e_gid\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 70.5312px;\"\u003e\n\u003cp\u003e24 timer\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 367.297px;\"\u003e\n\u003cp\u003eBrukes av Google Analytics for \u0026aring; skille p\u0026aring; brukere.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 88.0781px;\"\u003eGoogle Analytics\u003c/td\u003e\n\u003ctd style=\"width: 101.094px;\"\u003e_ga_QG8YWJ8KWM\u003c/td\u003e\n\u003ctd style=\"width: 70.5312px;\"\u003e2 \u0026aring;r\u003c/td\u003e\n\u003ctd style=\"width: 367.297px;\"\u003e\n\u003cp\u003eH\u0026aring;ndtere informasjon om brukersesjon\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 88.0781px;\"\u003eGoogle Analytics\u003c/td\u003e\n\u003ctd style=\"width: 101.094px;\"\u003e\u003cem\u003e_gat_UA-6021966-1\u003c/em\u003e\u003c/td\u003e\n\u003ctd style=\"width: 70.5312px;\"\u003e1 min\u003c/td\u003e\n\u003ctd style=\"width: 367.297px;\"\u003e\n\u003cp\u003eH\u0026aring;ndtere brukersignaler fra nettleser under sesjon\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 88.0781px;\"\u003eGoogle Analytics\u003c/td\u003e\n\u003ctd style=\"width: 101.094px;\"\u003e_gcl_au\u003c/td\u003e\n\u003ctd style=\"width: 70.5312px;\"\u003e3 mnd\u003c/td\u003e\n\u003ctd style=\"width: 367.297px;\"\u003e\n\u003cp\u003eBrukes til \u0026aring; lagre og spore konverteringer\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp\u003eAnalyseverkt\u0026oslash;yet Google Analytics lagrer et overordnet bilde av hvordan brukerne benytter nettstedet v\u0026aring;rt. Google Analytics bruker informasjonskapsler til \u0026aring; hente inn informasjon anonymt om hvordan bes\u0026oslash;kende benytter nettstedet. Eksempler p\u0026aring; informasjon som blir lagret er antall sidevisninger, hvordan de bes\u0026oslash;kende fant nettstedet, og antall bes\u0026oslash;k osv. Hensikten er \u0026aring; hjelpe oss til \u0026aring; \u0026oslash;ke brukervennligheten p\u0026aring; nettstedet. Informasjonen som blir opprettet under bes\u0026oslash;ket ditt blir videresendt og lagret hos Google Inc. IP-adresser blir ikke lagret, da vi bruker funksjonalitet som anonymiserer brukerne.\u003c/p\u003e\n\u003cp\u003eGoogle kan overf\u0026oslash;re den innsamlede informasjonen til tredjepart hvis det er et rettslig grunnlag for det, eller der tredjepart prosesserer informasjonen p\u0026aring; Googles vegne. Google kan ikke koble IP-adresser til andre data Google besitter. Les mer om Google Analytics her.\u003c/p\u003e\n\u003cp\u003eHer kan du lese mer om Analytics-informasjonskapsler og informasjon om personvern:\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://developers.google.com/analytics/devguides/collection/gtagjs/cookie-usage\"\u003ehttps://developers.google.com/analytics/devguides/collection/gtagjs/cookie-usage\u003c/a\u003e\u003c/p\u003e"},{"name":"Mouseflow","description":"Vi bruker Mouseflow som et verktøy for å samle anonymisert data, for å forbedre nettsiden. ","content":"\u003cp\u003eMouseflow er et analyseverkt\u0026oslash;y som viser avspilling av \u0026oslash;kter, varmekart, kundereise, skjemaanalyse, tilbakemeldinger og lignende funksjoner/funksjonalitet.\u003c/p\u003e\n\u003cp\u003eMouseflow kan registrere dine klikk, musebevegelser, skrolling og tastetrykk, i tillegg til bes\u0026oslash;kte sider og innhold, hvor lang tid du har brukt p\u0026aring; nettstedet, og hvilken nettleser, operativsystem, enhet (stasjon\u0026aelig;r/nettbrett/mobil) du bruker. Mouseflow registrerer hvilken skjermoppl\u0026oslash;sning du har, om det er f\u0026oslash;rste gang du bes\u0026oslash;ker nettsiden eller om du har v\u0026aelig;rt hos oss tidligere, hvor du kom fra, en anonymisert IP-adresse, plasseringen din (by/land), spr\u0026aring;k og lignende metadata.\u003c/p\u003e\n\u003cp\u003eCookiens varighet: 90 dager\u003c/p\u003e\n\u003cp\u003eMouseflow samler ikke inn informasjon p\u0026aring; sider der den ikke er installert, og sporer eller samler heller ikke inn informasjon utenfor nettleseren din. Hvis du \u0026oslash;nsker \u0026aring; velge bort bruk av dette verkt\u0026oslash;yet, kan du gj\u0026oslash;re det \u003ca title=\"Velg bort Mouseflow\" href=\"https://mouseflow.com/opt-out\" target=\"_blank\" rel=\"noopener\"\u003eher\u003c/a\u003e. Hvis du \u0026oslash;nsker \u0026aring; f\u0026aring; en kopi av dataene dine, foreta en rettelse eller f\u0026aring; dem slettet, vennligst kontakt oss f\u0026oslash;rst eller, som et sekund\u0026aelig;rt alternativ, kontakt Mouseflow p\u0026aring; \u003ca title=\"E-post Mouseflow\" href=\"mailto:privacy@mouseflow.com\"\u003eprivacy@mouseflow.com\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eFor mer informasjon, se \u003ca title=\"Mouseflow personvernregler\" href=\"http://mouseflow.com/privacy/\" target=\"_blank\" rel=\"noopener\"\u003eMouseflows personvernregler\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eFor mer informasjon om \u003ca title=\"Mouseflow og GDPR\" href=\"https://mouseflow.com/gdpr/\" target=\"_blank\" rel=\"noopener\"\u003eMouseflow og GDPR\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eFor mer informasjon om \u003ca title=\"Mouseflow og CCPA/VCDPA\" href=\"https://mouseflow.com/ccpa\" target=\"_blank\" rel=\"noopener\"\u003eMouseflow og CCPA/VCDPA\u003c/a\u003e\u003c/p\u003e"}]},{"groupTitle":"Kampanjemåling","cookies":[{"name":"Google","description":"Informasjonskapslene brukes til å rapportere på hvor mange brukere som har engasjert seg i innholdet på matprat.no","content":"\u003cp\u003eInformasjonskapslene brukes til \u0026aring; rapportere p\u0026aring; hvor mange brukere som har engasjert seg i innholdet p\u0026aring; matprat.no. Det kan eksempelvis v\u0026aelig;re sett oppskrift, tid brukt p\u0026aring; side eller navigert videre inn i universet matprat.no. Denne dataen sendes til annonseplattformene, og brukes til m\u0026aring;ling og optimalisering av kommende kampanjer\u003c/p\u003e\n\u003cp\u003eLes gjerne mer her: \u003ca href=\"https://policies.google.com/technologies/types?hl=en\"\u003ehttps://policies.google.com/technologies/types?hl=en\u003c/a\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e"},{"name":"Meta","description":"Informasjonskapslene brukes til å rapportere på hvor mange brukere som har engasjert seg i innholdet på matprat.no","content":"\u003cp\u003eInformasjonskapslene brukes til \u0026aring; rapportere p\u0026aring; hvor mange brukere som har engasjert seg i innholdet p\u0026aring; matprat.no. Det kan eksempelvis v\u0026aelig;re sett oppskrift, tid brukt p\u0026aring; side eller navigert videre inn i universet matprat.no. Denne dataen sendes til annonseplattformene, og brukes til m\u0026aring;ling og optimalisering av kommende kampanjer.\u003c/p\u003e\n\u003cp\u003eLes gjerne mer her om Facebook sine retningslinjer for informasjonskapsler: \u003ca href=\"https://www.facebook.com/policies/cookies\"\u003ehttps://www.facebook.com/policies/cookies\u003c/a\u003e\u0026nbsp;\u003c/p\u003e"},{"name":"SnapChat","description":"Informasjonskapslene brukes til å rapportere på hvor mange brukere som har engasjert seg i innholdet på matprat.no","content":"\u003cp\u003eInformasjonskapslene brukes til \u0026aring; rapportere p\u0026aring; hvor mange brukere som har engasjert seg i innholdet p\u0026aring; matprat.no. Det kan eksempelvis v\u0026aelig;re sett oppskrift, tid brukt p\u0026aring; side eller navigert videre inn i universet matprat.no. Denne dataen sendes til annonseplattformene, og brukes til m\u0026aring;ling og optimalisering av kommende kampanjer\u003c/p\u003e\n\u003cp\u003eHer kan du lese mer om hvordan Snapchat bruker informasjonskapsler:\u0026nbsp;\u003ca href=\"https://snap.com/en-US/privacy/cookie-information\"\u003ehttps://snap.com/en-US/privacy/cookie-information\u003c/a\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e"}]},{"groupTitle":"Annonsering (kun samtykkende innloggede brukere))","cookies":[{"name":"Data fra innloggede brukere","description":"Brukes til å vise deg tilpasset innhold i andre kanaler","content":"\u003cp\u003eSom innlogget bruker p\u0026aring; Min Matprat f\u0026aring;r du mulighet til \u0026aring; samtykke til at vi bruker dine data i markedsf\u0026oslash;ring. \u0026Oslash;nsker du \u0026aring; trekke tilbake dette samtykket, gj\u0026oslash;res det p\u0026aring; samme sted inne i profilen din.\u003c/p\u003e\n\u003cp\u003eVed \u0026aring; la oss bruke dine data fra matprat.no, kan vi vise deg tilpasset innhold i andre kanaler. Du vil se annonser som er mer relevante for deg med dette samtykket.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eUnder ser du plattformene vi annonserer p\u0026aring;.\u003c/p\u003e"},{"name":"Google","description":"Google bruker informasjonskapsler og anonymisert kundeinformasjon fra Matprat for å vise deg relevante annonser","content":"\u003cp\u003eGoogle bruker informasjonskapsler og anonymisert kundeinformasjon fra Matprat, som e-postadresser og telefonnumre, for \u0026aring; vise deg relevante annonser. Har du oppgitt samme kontaktinformasjon til b\u0026aring;de Google og Matprat, kan vi tilby deg annonser tilpasset dine interesser basert p\u0026aring; denne informasjonen.\u003c/p\u003e\n\u003cp\u003eDataene blir ikke delt med tredjeparter og slettes automatisk etter at tjenesten er utf\u0026oslash;rt.\u003c/p\u003e\n\u003cp\u003eOm du ved bes\u0026oslash;k p\u0026aring; Googles s\u0026oslash;kesider eller innlogging i nettleser med din Google-bruker, har godtatt deres bruk av cookies/informasjonskapsler, kan f\u0026oslash;lgende cookies v\u0026aelig;re i bruk. Disse kapslene settes ikke av matprat.no, men av Google, men vi lister de her for ordens skyld.\u003c/p\u003e\n\u003ctable border=\"1\"\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e\n\u003cp\u003e\u003cstrong\u003ePlattform\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth\u003e\n\u003cp\u003e\u003cstrong\u003eDomene\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth\u003e\n\u003cp\u003e\u003cstrong\u003eNavn\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth\u003e\n\u003cp\u003e\u003cstrong\u003eVarighet\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth\u003e\n\u003cp\u003e\u003cstrong\u003eBeskrivelse\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.no\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eNID\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e6 mnd\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eDe fleste Google-brukere vil ha en preferanseinformasjonskapsel kalt \u0026laquo;NID\u0026raquo; i nettleserne. En nettleser sender denne informasjonskapselen med foresp\u0026oslash;rsler til Googles nettsteder. NID-informasjonskapselen inneholder en unik ID som Google bruker for \u0026aring; huske dine preferanser og annen informasjon.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eSID\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e540 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e\u0026Aring; personalisere annonser hos s\u0026oslash;k i Google. Husker brukernes bes\u0026oslash;k p\u0026aring; annonsenes nettside, for eksempel med tanke p\u0026aring; senere markedsf\u0026oslash;ring.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eConversion\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e30 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eDisse informasjonskapslene gj\u0026oslash;r at Google og annons\u0026oslash;ren kan se om du har klikket p\u0026aring; annonsen og senere har bes\u0026oslash;kt annons\u0026oslash;rens nettside. Konverteringsinformasjonskapsler blir ikke brukt av Google for personalisert markedsf\u0026oslash;ring og er kun for en begrenset tidsperiode. Den befinner seg vanligvis i domenene googleadservices.com eller google.com.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eAID\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e30 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eBrukes til \u0026aring; spore din aktivitet p\u0026aring; tvers av ulike enheter dersom du tidligere har logget deg p\u0026aring; din Google-konto p\u0026aring; en annen enhet. Dette gj\u0026oslash;res for \u0026aring; koordinere annonsene som du ser p\u0026aring; de ulike enhetene og m\u0026aring;le konverteringshendelser. Disse informasjonskapslene kan plasseres p\u0026aring; domenene google.com/ads, google.com/ads/measurement eller googleadservices.com.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eDSID\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e30 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eBrukes til \u0026aring; spore din aktivitet p\u0026aring; tvers av ulike enheter dersom du tidligere har logget deg p\u0026aring; din Google-konto p\u0026aring; en annen enhet. Dette gj\u0026oslash;res for \u0026aring; koordinere annonsene som du ser p\u0026aring; de ulike enhetene og m\u0026aring;le konverteringshendelser. Disse informasjonskapslene kan plasseres p\u0026aring; domenene google.com/ads, google.com/ads/measurement eller googleadservices.com.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eTAID\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e30 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eBrukes til \u0026aring; spore din aktivitet p\u0026aring; tvers av ulike enheter dersom du tidligere har logget deg p\u0026aring; din Google-konto p\u0026aring; en annen enhet. Dette gj\u0026oslash;res for \u0026aring; koordinere annonsene som du ser p\u0026aring; de ulike enhetene og m\u0026aring;le konverteringshendelser. Disse informasjonskapslene kan plasseres p\u0026aring; domenene google.com/ads, google.com/ads/measurement eller googleadservices.com.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eANID\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e30 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eEn av de viktigste annonseringsinformasjonskapslene p\u0026aring; sider utenfor Google.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eFLC\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e30 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eAnnonsering p\u0026aring; sider utenfor Google.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.no\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e1P_JAR\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e30 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eTilpasser annonser etter s\u0026oslash;k/ interaksjon.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\n\u003cp\u003eGoogle\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003egoogle.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eGAPS\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003e730 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd\u003e\n\u003cp\u003eUklassifisert\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp\u003eLes gjerne mer her: \u003ca href=\"https://policies.google.com/technologies/types?hl=en\"\u003ehttps://policies.google.com/technologies/types?hl=en\u003c/a\u003e\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eVi bruker informasjonskapsler for \u0026aring; gj\u0026oslash;re annonsering mer engasjerende til brukerne og mer verdifullt for utgivere og annons\u0026oslash;rer. Vanlige m\u0026aring;ter \u0026aring; bruke informasjonskapsler p\u0026aring; er \u0026aring; velge annonser ut fra hva som er relevant for brukeren, \u0026aring; forbedre rapportering p\u0026aring; kampanjeytelse, samt \u0026aring; unng\u0026aring; \u0026aring; vise annonser som brukeren allerede har sett.\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e"},{"name":"Meta","description":"Meta bruker informasjonskapsler og anonymisert kundeinformasjon fra Matprat for å vise deg relevante annonser","content":"\u003cp\u003eMeta bruker informasjonskapsler og anonymisert kundeinformasjon fra Matprat, som e-postadresser og telefonnumre, for \u0026aring; vise deg relevante annonser. Har du oppgitt samme kontaktinformasjon til b\u0026aring;de Meta og Matprat, kan vi tilby deg annonser tilpasset dine interesser basert p\u0026aring; denne informasjonen.\u003c/p\u003e\n\u003cp\u003eDataene blir ikke delt med tredjeparter og slettes automatisk etter at tjenesten er utf\u0026oslash;rt.\u003c/p\u003e\n\u003ctable border=\"1\"\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth style=\"width: 79.3906px;\"\u003e\n\u003cp\u003e\u003cstrong\u003ePlattform\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"width: 99.7188px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eDomene\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"width: 43.5781px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eNavn\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"width: 70.5781px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eVarighet\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"width: 339.734px;\"\u003e\n\u003cp\u003e\u003cstrong\u003eBeskrivelse\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp; \u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 79.3906px;\"\u003e\n\u003cp\u003eFacebook\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 99.7188px;\"\u003e\n\u003cp\u003efacebook.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 43.5781px;\"\u003e\n\u003cp\u003e_fbp\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 70.5781px;\"\u003e\n\u003cp\u003e90 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 339.734px;\"\u003e\n\u003cp\u003eBrukes for \u0026aring; kjenne igjen brukeren.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 79.3906px;\"\u003e\n\u003cp\u003eFacebook\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 99.7188px;\"\u003e\n\u003cp\u003efacebook.com\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 43.5781px;\"\u003e\n\u003cp\u003e_fbc\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 70.5781px;\"\u003e\n\u003cp\u003e90 dager\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style=\"width: 339.734px;\"\u003e\n\u003cp\u003eBrukes for \u0026aring; kjenne igjen en bruker som har klikket p\u0026aring; en annonse p\u0026aring; Facebook.\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp\u003eLes gjerne mer her om Facebook sine retningslinjer for informasjonskapsler: \u003ca href=\"https://www.facebook.com/policies/cookies\"\u003ehttps://www.facebook.com/policies/cookies\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eVi benytter informasjonskapsler hvis du har en Facebook-konto. Vi bruker ogs\u0026aring; Facebook-produkter p\u0026aring; v\u0026aring;rt nettsted og v\u0026aring;re applikasjoner (for eksempel innlogging p\u0026aring; Min Matprat via Facebook). Informasjonkapsler gj\u0026oslash;r det mulig for Facebook \u0026aring; tilby sine produkter til deg og \u0026aring; forst\u0026aring; den informasjonen som vi mottar om deg, herunder informasjon om din bruk av andre nettsider og applikasjoner, samt om hvordan du er registrert eller logget inn.\u003c/p\u003e"},{"name":"Snapchat","description":"SnapChat bruker informasjonskapsler og anonymisert kundeinformasjon fra Matprat for å vise deg relevante annonser","content":"\u003cp\u003eSnapChat bruker informasjonskapsler og anonymisert kundeinformasjon fra Matprat, som e-postadresser og telefonnumre, for \u0026aring; vise deg relevante annonser. Har du oppgitt samme kontaktinformasjon til b\u0026aring;de SnapChat og Matprat, kan vi tilby deg annonser tilpasset dine interesser basert p\u0026aring; denne informasjonen.\u003c/p\u003e\n\u003cp\u003eDataene blir ikke delt med tredjeparter og slettes automatisk etter at tjenesten er utf\u0026oslash;rt.\u003c/p\u003e\n\u003ctable style=\"border-collapse: collapse; width: 100%;\" border=\"1\"\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth style=\"width: 16.6667%;\"\u003e\n\u003cp\u003e\u003cstrong\u003ePlattform\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style=\"width: 16.6667%;\"\u003e\u003cstrong\u003eNavn\u003c/strong\u003e\u003c/th\u003e\n\u003cth style=\"width: 15.2046%;\"\u003e\u003cstrong\u003eVarighet\u003c/strong\u003e\u003c/th\u003e\n\u003cth style=\"width: 51.462%;\"\u003e\u003cstrong\u003eBeskrivelse\u003c/strong\u003e\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 16.6667%;\"\u003eSnapchat\u003c/td\u003e\n\u003ctd style=\"width: 16.6667%;\"\u003e_scid\u003c/td\u003e\n\u003ctd style=\"width: 15.2046%;\"\u003e1 \u0026aring;r\u003c/td\u003e\n\u003ctd style=\"width: 51.462%;\"\u003eBrukes til \u0026aring; kjenne igjen brukeren.\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 16.6667%;\"\u003eSnapchat\u003c/td\u003e\n\u003ctd style=\"width: 16.6667%;\"\u003esc_at\u003c/td\u003e\n\u003ctd style=\"width: 15.2046%;\"\u003e1 \u0026aring;r\u003c/td\u003e\n\u003ctd style=\"width: 51.462%;\"\u003eBrukes til \u0026aring; kjenne igjen brukeren, p\u0026aring; tvers av plattformer.\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp\u003eHer kan du lese mer om hvordan Snapchat bruker informasjonskapsler:\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://snap.com/en-US/privacy/cookie-information\"\u003ehttps://snap.com/en-US/privacy/cookie-information\u003c/a\u003e\u003c/p\u003e"},{"name":"Norske mediehus","description":"Norske mediehus bruker anonymisert kundeinformasjon fra Matprat for å vise deg relevante annonser","content":"\u003cp\u003eNorske mediehus, som Schibsted og Amedia, bruker anonymisert kundeinformasjon fra Matprat, som e-postadresser og telefonnumre, for \u0026aring; vise deg relevante annonser. Har du oppgitt samme kontaktinformasjon til b\u0026aring;de mediehusene og Matprat, kan vi tilby deg annonser tilpasset dine interesser basert p\u0026aring; denne informasjonen.\u003c/p\u003e\n\u003cp\u003eDataene blir ikke delt med tredjeparter og slettes automatisk etter at tjenesten er utf\u0026oslash;rt.\u003c/p\u003e"}]},{"groupTitle":"Andre","cookies":[{"name":"Husk meg","description":"Brukes til å huske deg til neste gang du vil logge inn","content":"\u003cp\u003eFor \u0026aring; huske deg over tid bruker Matprat en cookie med lengre utl\u0026oslash;pstid. Dermed slipper du \u0026aring; logge inn s\u0026aring; ofte, og Min Matprat er alltid tilpasset dine preferanser p\u0026aring; best mulig m\u0026aring;te.\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e"},{"name":"A/B-testing","description":"Brukes til testing av ulike oppsett av sider","content":"\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\u003ctable style=\"border-collapse: collapse; width: 100%;\" border=\"1\"\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 25%;\"\u003e\u003cstrong\u003ePlattform\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width: 25%;\"\u003e\u003cstrong\u003eNavn\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width: 25%;\"\u003e\u003cstrong\u003eVarighet\u003c/strong\u003e\u003c/td\u003e\n\u003ctd style=\"width: 25%;\"\u003e\u003cstrong\u003eBeskrivelse\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style=\"width: 25%;\"\u003eMultivariable testing website\u003c/td\u003e\n\u003ctd style=\"width: 25%;\"\u003eX-AB\u003c/td\u003e\n\u003ctd style=\"width: 25%;\"\u003e24 timer\u003c/td\u003e\n\u003ctd style=\"width: 25%;\"\u003eBrukes til testing av ulike oppsett av sider (A/B testing)\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e"},{"name":"KI-assistent","description":"Beskriver hvordan vi behandler data samlet inn i vår chatbot","content":"\u003cp\u003eN\u0026aring;r du bruker KI-tjenesten \u0026laquo;Matprat-assistenten\u0026raquo; lagrer Matprat selve meldingen din og tidspunktet. Form\u0026aring;let for lagringen er \u0026aring; kunne svare deg i sanntid og for \u0026aring; forbedre kvaliteten p\u0026aring; svarene i fremtiden. Samtaleloggen slettes etter 30 dager. Pseudonymiserte data (hvor din identitet er skjult ved bruk av koder eller aliaser) slettes etter 24 m\u0026aring;neder. Chatten sendes via v\u0026aring;r behandlings\u0026shy;ansvarlige OpenAI (USA). Overf\u0026oslash;ringen er sikret gjennom EU sin Standard Contractual Clauses.\u003c/p\u003e"}]}]}}},"chatbot":{"isDisabled":false,"blocks":{"welcomeText":"Hei!👋Jeg er en KI-assistent og hjelper deg gjerne med spørsmålene dine. Vær oppmerksom på at jeg er kunstig intelligent, så du kan ikke stole blindt på alt jeg sier. Fyr løs!","forLoggedUsersText":"For innloggede brukere","linkText":"Spør meg om noe!","linkUrl":"/matprat-assistenten/"},"chat":{"resetButtonText":"Start på nytt","inputPlaceholder":"Skriv spørsmålet ditt her...","dataPolicyText":"\u003cp\u003eBruker du KI-assistenten, godtar du v\u0026aring;re \u003ca title=\"Vilk\u0026aring;r for bruk av Min Matprat\" href=\"/link/840d044c666f4691bcf965a0c81e9dc4.aspx\"\u003evilk\u0026aring;r for bruk\u003c/a\u003e og \u003ca title=\"Personvern\" href=\"/link/1a2254e034fe41fda834a2db7573ca69.aspx\"\u003epersonvern\u003c/a\u003e. Ikke del sensitive opplysninger!\u003c/p\u003e","loadingText":"La meg tenke","limitExceededText":"Wow! Du har jammen nådd maksgrensen for antall spørsmål i dag. Prøv igjen i morgen!","chatUnavailableText":"Sorry! Assistenten er for øyeblikket utilgjengelig. Kom tilbake senere!","exampleQuestionsText":"Noen eksempler på spørsmål...","fatalErrorText":"Oj! En uventet feil har oppstått, Prøv igjen senere!","reloadPageText":"Last inn siden på nytt","suggestedQuestions":["Er norsk kjøtt bærekraftig?","Hva skal jeg ha til middag i dag?","Har du tre gode pizzaoppskrifter?","Hvem står bak Matprat?","Jeg skal bake boller for første gang. Hjelp!"],"handoverRequestMessageText":"Den er god 😊 Rådgiverne fra Matprat er tilgjengelige mellom kl 8-18 på hverdager, og de vil svare deg her i løpet av en time. Ved stor pågang, i helger og på kvelden, kan det ta litt lengre tid. Du vil dessverre ikke kunne snakke med KI-assistenten i mellomtiden. Vil du at en levende ansatt fra Matprat skal hjelpe deg?","handoverRequestYesButtonText":"Ja, takk","handoverRequestNoButtonText":"Nei, takk","resetModal":{"resetButtonText":"Ja, start på nytt","cancelButtonText":"Nei, gå tilbake","text":"Den forrige historikken vil bli slettet.","title":"Er du sikker på at du vil starte samtalen på nytt?"},"handoverResetModal":{"resetButtonText":"Ja, jeg er sikker","cancelButtonText":"Nei, jeg vil tilbake og vente på et menneske","text":"Svarer du JA, forlater du køen og mister muligheten til å snakke med en levende Matprat-ansatt.","title":"Er du sikker på at du vil starte en ny samtale?"},"chatEndMessageText":"Chatten er avsluttet. Vi snakkes!","chatEndResetButtonText":"Start ny chat"}},"loginBanner":{"preLinkText":"Få full tilgang til alle verktøyene og funksjonene våre.","linkText":"Logg inn eller registrer","postLinkText":"deg nå!","loginUrl":"/min-matprat/autentisering/"}},"__N_SSG":true},"page":"/pages/MatPratRecipePage/[id]","query":{"id":"89724"},"buildId":"5d48fcbecbdb35a93f0756e17eda6ffe860aa1fc","isFallback":false,"isExperimentalCompile":false,"dynamicIds":[84496,86032,30835],"gsp":true,"appGip":true,"scriptLoader":[]}</script><noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NKQX9L" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript></body></html>