sinnhold","nutritionInfo":"Beregnet per porsjon basert på oppskriften. Næringsinnholdet vil variere med størrelsen på porsjon og valgt tilbehør.","nutritionTableTitle":"per \u003cb\u003eporsjon\u003c/b\u003e"},"inspirations":{"header":"Bruk opp restene!","aboutText":"Har du noe til overs fra du lagde denne retten? Prøv denne oppskriften!"},"contextButtons":{"saveButton":{"modalTitle":"Favoritter","saveButtonText":"Lagre","addToFavourites":"Lagre i favoritter","addedToFavourites":"Lagret i favoritter","addNewCookbook":"Opprett ny kokebok","submitButtonText":"Opprett","cancelButtonText":"Avbryt","createCookbookButtonText":null,"createCookbookFormLabel":"Navn på kokebok","addedToCookbookText":"Lagt til i","addedToCookbookSingularText":"kokebok","addedToCookbookPluralText":"kokebøker"},"printButton":{"printButtonText":"Skriv ut"},"plannerButton":{"plannerButtonText":"Ukeplanlegger"},"shoppingListButton":{"removeFromShoppingList":"Fjern fra handlelisten","viewShoppingList":"Vis handleliste","shoppingList":"Handleliste","addToShoppingList":"Legg i handlelisten"},"shareButton":{"shareButtonText":"Del","linkCopiedMessage":"Lenken er kopiert til utklippstavlen","linkCopyErrorMessage":"Det oppsto en feil da du kopierte lenken, vennligst prøv igjen"}}},"gtmDimensions":{"dimension1":"","dimension2":"Gjester,Klassisk gjestemat,","dimension3":"40–60 min","dimension4":"Enkel","dimension5":"Potetsalat","dimension7":10,"dimension8":"Tilbehør,Koldtbord","dimension9":"Annet tilbehør","dimension11":"Regular","dimension14":4.8,"dimension15":null,"dimension16":"Oppskrift"},"metaData":{"title":"Potetsalat | Oppskrift","canonicalLink":"https://www.matprat.no/oppskrifter/gjester/potetsalat/","facebookAppId":"275661345875937","contentTags":[{"name":"description","content":"Vår klassiske oppskrift på potetsalat med rømme og majones passer like godt enten det er som tilbehør til grillmaten eller på koldtbordet."},{"name":"keywords","content":"oppskrift, potetsalat, "},{"name":"google-site-verification","content":"bDBv_JHA2hib0MT3FCkmnBFYqsjsbUkqVJUs_7kLQDU"}],"propertyTags":[{"property":"fb:admins","content":"100005957289931"},{"property":"fb:app_id","content":"275661345875937"},{"property":"og:title","content":"Potetsalat"},{"property":"og:type","content":"article"},{"property":"og:url","content":"https://www.matprat.no/oppskrifter/gjester/potetsalat/"},{"property":"og:description","content":"Klassisk potetsalat med rømme og majones er populær på koldtbordet og som tilbehør til grillmaten."},{"property":"og:image","content":"https://images.matprat.no/283rpv278n-normal/710/og.png"},{"property":"og:image:width","content":"710"},{"property":"og:image:height","content":"399"},{"property":"article:section","content":"Gjester"},{"property":"article:tag","content":"rank:2"},{"property":"article:tag","content":"Gjester"},{"property":"article:tag","content":"40–60 min"},{"property":"article:tag","content":"Enkel"},{"property":"article:tag","content":"potet"},{"property":"article:tag","content":"vårløk"},{"property":"article:tag","content":"løk"},{"property":"article:tag","content":"hel sylteagurk"},{"property":"article:tag","content":"majones"},{"property":"article:tag","content":"lettrømme"},{"property":"article:tag","content":"lake av syltet agurk"},{"property":"article:tag","content":"soyasaus"},{"property":"article:tag","content":"tabasco"}]},"breadcrumb":[{"name":"matprat.no","url":"/","isCurrent":false},{"name":"Oppskrifter","url":"/oppskrifter/","isCurrent":false},{"name":"Potetsalat","url":"/oppskrifter/gjester/potetsalat/","isCurrent":true}],"structuredData":"[{\"name\":\"Potetsalat\",\"datePublished\":\"2014-04-01\",\"description\":\"Vår klassiske oppskrift på potetsalat med rømme og majones passer like godt enten det er som tilbehør til grillmaten eller på koldtbordet. Enkel vanskelighetsgrad\",\"totalTime\":\"PT60M\",\"keywords\":\"kremet potetsalat, potetsalat, klassisk potetsalat, vanlig potetsalat, nypotet, tilbehør til grillmat, vårløk, løk,\",\"recipeYield\":\"6 PORSJONER\",\"recipeCategory\":[\"Tilbehør\",\"Koldtbord\"],\"recipeCuisine\":[\"Europa\",\"Norge\"],\"cookingMethod\":[\"Blande\",\"Koke\",\"Skrelle\"],\"video\":[{\"name\":\"Matprat: 3x potetsalat\",\"description\":\"Ikke 1, ikke 2, men 3 potetsalater! Har får du tips til gode varianter med dressing av rømme, olje eller smør, salt og pepper. Salater som passer perfekt til sommerens grillmat.\\n\\n500 g kokte poteter\\n3 stk finsnittet vårløk\\n1 pk reddik i båter\\n2 ss finhakket gressløk\\n\\nKremet dressing: \\n2 dl rømme\\n2 ss majones\\n½ ts salt \\n¼ ts pepper \\n\\nOljebasert dressing:\\n1 ss grov dijonsennep\\n2 ts honning \\n1 dl rapsolje\\n1 ts salt\\n½ ts pepper\\n\\nFoliepakket:\\n75 g smør \\n1/2 ts salt\\n1/4 ts pepper\\n\\n1. Skjær kokte poteter i store biter\\n2. Kutt reddik i båter, finhakk vårløk og gressløk. \\n3. Bland sammen ingrediensene til den dressingen du ønsker, og hell den over potetene. Vend alt godt sammen, og juster eventuelt smaken med litt ekstra salt og pepper.\\nTips: Til den oljebaserte dressingen lønner det seg å piske sammen sennep og honning, og deretter spe forsiktig med oljen samtidig som du pisker. Da får du en homogen blanding som setter seg bedre på potetene.\\n4. Skal du lage foliepakkede poteter, ha på smør, salt og pepper. Legg pakkene på grillen i 6-7 minutter.\\nServer en av potetsalatene til den deilige grillmaten din!\",\"thumbnailUrl\":\"https://img.youtube.com/vi/2vpelX3-Bqc/mqdefault.jpg\",\"contentUrl\":\"https://youtu.be/2vpelX3-Bqc\",\"embedUrl\":null,\"uploadDate\":\"2016-06-01T12:52:18+02:00\",\"@type\":\"VideoObject\"}],\"image\":[{\"@type\":\"ImageObject\",\"url\":\"https://images.matprat.no/283rpv278n__w=1200_h=1200_autocrop=true_cropMode=zoom/image.webp\",\"width\":1200,\"height\":1200}],\"author\":{\"name\":\"Matprat\",\"@type\":\"Person\"},\"recipeIngredient\":[\" 1 kg potet\",\" 4 stk. vårløk\",\" 0,5 stk. løk\",\" 2 stk. hel sylteagurk (eller tilsvarende skivet sylteagurk)\",\" 4 ss majones\",\" 2 dl lettrømme\",\" 1 ss lake av syltet agurk\",\" 1 ss soyasaus\",\" 0,5 ts tabasco\",\" 4 ss majones\",\" 2 dl lettrømme\",\" 1 ss soyasaus\",\" 1 ss lake av syltet agurk\",\" 0,5 ts tabasco\"],\"@context\":\"https://schema.org\",\"@type\":\"Recipe\",\"recipeInstructions\":[{\"@type\":\"HowToStep\",\"text\":\"Skrell potetene og kok dem i en kjele med vann til de er møre (bruker du nypoteter er det ikke nødvendig å skrelle dem). Hell av kokevannet og avkjøl potetene helt. Del dem i passe store biter.\"},{\"@type\":\"HowToStep\",\"text\":\"Finkutt vårløk og løk og ha det i en bolle sammen med sylteagurk og potetbiter.\"},{\"@type\":\"HowToStep\",\"text\":\"Bland majones, rømme, sylteagurklake, soyasaus og tabasco. Smak til med litt salt og pepper.\"},{\"@type\":\"HowToStep\",\"text\":\"Vend potetene inn i dressingen. Sett potetsalaten kjølig et par timer før servering. Juster om nødvendig smaken med litt mer salt, pepper og sylteagurklake.\"}],\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":4.8421052631579,\"ratingCount\":380},\"nutrition\":{\"@type\":\"NutritionInformation\",\"calories\":\"212 KCAL\",\"carbohydrateContent\":\"23 G\",\"proteinContent\":\"4 G\",\"fatContent\":\"10 G\"}}]","speakableStructuredData":null,"disableLoginBanner":false,"published":"2026-08-01 07:16:42","version":"11.21.1.20069/WEB13 2026-08-01 16:15:56","versionTime":"0,351","popular":{"id":"24851ec4-9eb5-4cd4-9af5-14be76c99209","contentType":"teaser-collection","type":"grid","header":null,"layout":{"desktop":{"columns":4,"mediaRatio":"12x16"},"mobile":{"variant":"half","mediaRatio":"12x16"}},"isWide":true,"contentMode":"title","teasers":[{"id":"93184","type":"recipe","theme":"lightGreen","slots":1,"title":"Pannekaker","description":"","data":{"contentType":"MatPratRecipePage","id":93184,"name":"Pannekaker","newTab":false,"verticalImageUrl":"https://images.matprat.no/2geqmnxljh","verticalImageAlt":"Grove pannekaker","verticalImageName":"grove_pannekaker","v