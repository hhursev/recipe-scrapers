227a5674072e080ffb1ba14ac0c1079.en.html#dnt=false&amp;id=twitter-widget-0&amp;lang=en&amp;original_referer=https%3A%2F%2Fwww.ourcookingjourney.com%2Frecipe-pages%2Fpesto-al-cavolo-nero-tuscan-kale-pesto&amp;size=m&amp;text=Pesto%20Al%20Cavolo%20Nero%20-%20Tuscan%20Kale%20Pesto%20-%20Our%20Cooking%20Journey&amp;time=1794973669567&amp;type=share&amp;url=https%3A%2F%2Fwww.ourcookingjourney.com%2F2%2Fpost%2F2026%2F09%2Fpesto-al-cavolo-nero-tuscan-kale-pesto.html" style="position: static; visibility: visible; width: 66px; height: 20px;" data-url="https://www.ourcookingjourney.com/2/post/2026/09/pesto-al-cavolo-nero-tuscan-kale-pesto.html"></iframe></div>
