om\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/bakeitwithlove.com\/#organization","name":"Bake It With Love","url":"https:\/\/bakeitwithlove.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/bakeitwithlove.com\/#\/schema\/logo\/image\/","url":"https:\/\/bakeitwithlove.com\/wp-content\/uploads\/2021\/09\/bakeitwithlovesquare.png","contentUrl":"https:\/\/bakeitwithlove.com\/wp-content\/uploads\/2021\/09\/bakeitwithlovesquare.png","width":300,"height":300,"caption":"Bake It With Love"},"image":{"@id":"https:\/\/bakeitwithlove.com\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/bakeitwithloveblog","https:\/\/x.com\/bakeitwithlove","https:\/\/www.instagram.com\/bake_it_with_love\/","https:\/\/www.pinterest.com\/BakeWithLove","https:\/\/www.youtube.com\/channel\/UCltHiAyi3_GscyzP_yxYDLg"]},{"@type":"Person","@id":"https:\/\/bakeitwithlove.com\/#\/schema\/person\/b914edf5bae470ade3af8828a6bd0327","name":"Angela Latimer","description":"Angela is an at home chef that developed a passion for all things cooking and baking at a young age in her Grandma's kitchen. After many years in the food service industry, she now enjoys sharing all of her family favorite recipes and creating tasty dinner and amazing dessert recipes here at Bake It With Love!","sameAs":["https:\/\/bakeitwithlove.com\/about\/","BakeItWithLoveBlog\/","bake_it_with_love\/","BakeWithLove\/","https:\/\/x.com\/bakeitwithlove","UCltHiAyi3_GscyzP_yxYDLg"],"knowsAbout":["Food Blogging. Recipe Development","Food Photography","Baking","Desserts","Dessert Baking","Dinner Recipes","Leftover Recipes"],"knowsLanguage":["English"],"jobTitle":"Food Blogger, Founder","worksFor":"Bake It With Love","url":"https:\/\/bakeitwithlove.com\/author\/admin\/"},{"@type":"Recipe","name":"Cream Cheese Rotisserie Chicken Enchiladas","author":{"@id":"https:\/\/bakeitwithlove.com\/#\/schema\/person\/b914edf5bae470ade3af8828a6bd0327"},"description":"Indulge in these cream cheese rotisserie chicken enchiladas, featuring a rich, velvety filling and zesty RoTel for the ultimate easy, cheesy family dinner! They’re a decadent, 40-minute meal that turns simple leftover chicken into restaurant-quality comfort.1x recipe yields 8 servings (1 enchilada per serving). See more of my rotisserie chicken recipes and leftover chicken recipes for more quick dinner ideas!","datePublished":"2026-02-03T08:35:00+00:00","image":["https:\/\/bakeitwithlove.com\/wp-content\/uploads\/2026\/02\/Cream-Cheese-Rotisserie-Chicken-Enchiladas-sq.jpg","https:\/\/bakeitwithlove.com\/wp-content\/uploads\/2026\/02\/Cream-Cheese-Rotisserie-Chicken-Enchiladas-sq-500x500.jpg","https:\/\/bakeitwithlove.com\/wp-content\/uploads\/2026\/02\/Cream-Cheese-Rotisserie-Chicken-Enchiladas-sq-500x375.jpg","https:\/\/bakeitwithlove.com\/wp-content\/uploads\/2026\/02\/Cream-Cheese-Rotisserie-Chicken-Enchiladas-sq-480x270.jpg"],"recipeYield":["8","8 servings"],"prepTime":"PT10M","cookTime":"PT30M","totalTime":"PT40M","recipeIngredient":["2 lbs rotisserie chicken meat ((shredded, or about 4 cups leftover pulled chicken))","8 oz cream cheese ((softened, at room temperature))","¼ cup sour cream ((or plain Greek yogurt))","1½ tsp taco seasoning","10 oz RoTel diced tomatoes with green chilies ((drained))","1 cup pepper jack cheese ((shredded, divided))","1 cup cheddar cheese ((shredded, divided - or use fiesta blend shredded cheese))","8 8-inch flour tortillas ((see recipe))","28 oz red enchilada sauce ((divided))","1 bunch cilantro ((optional, garnish))"],"recipeInstructions":[{"@type":"HowToSection","name":"Prep &amp; Mix The Filling","itemListElement":[{"@type":"HowToStep","text":"Preheat your oven to 350°F (175°C\/Gas Mark 4) and lightly grease a 9x13 baking dish. Spread a ½ cup of enchilada sauce across the bottom of the pan in a thin layer.","name":"Preheat","url":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#wprm-recipe-189346-step-0-0"},{"@type":"HowToStep","text":"Shred the 2 lbs&#32;rotisserie chicken meat. In a large bowl, blend the softened 8 oz&#32;cream cheese, ¼ cup&#32;sour cream, and 1½ tsp&#32;taco seasoning until smooth and combined.","name":"Mix","url":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#wprm-recipe-189346-step-0-1"},{"@type":"HowToStep","text":"Stir in the shredded rotisserie chicken, drained 10 oz&#32;RoTel diced tomatoes with green chilies, and the first half of the shredded 1 cup&#32;pepper jack cheese and 1 cup 1 cup&#32;cheddar cheese then mix until the chicken is well coated.","name":"Combine","url":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#wprm-recipe-189346-step-0-2"}]},{"@type":"HowToSection","name":"Assemble Enchiladas &amp; Bake","itemListElement":[{"@type":"HowToStep","text":"Spoon the chicken mixture down the center of each of the 8 8-inch&#32;flour tortillas. Roll them tightly and place them seam-side down in the prepared baking dish.","name":"Filling","url":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#wprm-recipe-189346-step-1-0"},{"@type":"HowToStep","text":"Pour the remaining 28 oz&#32;red enchilada sauce over the assembled enchiladas and sprinkle with the rest of the shredded cheese.","name":"Assemble","url":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#wprm-recipe-189346-step-1-1"},{"@type":"HowToStep","text":"Bake until the sauce is hot and bubbling and the cheese has completely melted. For a golden finish, broil for a few minutes at the end.","name":"Bake","url":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#wprm-recipe-189346-step-1-2"},{"@type":"HowToStep","text":"Remove from the oven, serve immediately garnished with fresh 1 bunch&#32;cilantro, green onions, or parsley.","name":"Serve","url":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#wprm-recipe-189346-step-1-3"}]}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"5","ratingCount":"1","reviewCount":"1"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"I love enchiladas for leftover chicken and rotisserie chicken (since I like to buy the marked down chickens) the creamy filling makes up for any dryness or bland flavor! ~ Angela","author":{"@type":"Person","name":"Angela Latimer"},"datePublished":"2026-02-03"}],"recipeCategory":["Chicken Dishes","Dinner Recipes","Entrees","Main Course","Main Dish"],"recipeCuisine":["American","Mexican"],"keywords":"Cream Cheese Rotisserie Chicken Enchiladas, easy chicken dinner, easy enchiladas, leftover chicken recipes, quick dinner ideas","nutrition":{"@type":"NutritionInformation","calories":"594 kcal","carbohydrateContent":"37 g","proteinContent":"48 g","fatContent":"28 g","saturatedFatContent":"14 g","transFatContent":"0.05 g","cholesterolContent":"160 mg","sodiumContent":"1896 mg","fiberContent":"4 g","sugarContent":"11 g","unsaturatedFatContent":"11 g","servingSize":"1 serving"},"@id":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#recipe","isPartOf":{"@id":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/#article"},"mainEntityOfPage":"https:\/\/bakeitwithlove.com\/cream-cheese-rotisserie-chicken-enchiladas\/"}]}</script>
