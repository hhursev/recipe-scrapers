<p><img decoding="async" class="alignnone size-large wp-image-127012" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20700%201049'%3E%3C/svg%3E" alt="Serrano Sweet Pea Guacamole" width="700" height="1049" data-jpibfi-post-excerpt="" data-jpibfi-post-url="https://www.simplyscratch.com/serrano-sweet-pea-guacamole/" data-jpibfi-post-title="Serrano Sweet Pea Guacamole" data-jpibfi-src="https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-700x1049.jpg" data-lazy-srcset="https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-700x1049.jpg 700w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-410x614.jpg 410w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-768x1151.jpg 768w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-1025x1536.jpg 1025w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-1367x2048.jpg 1367w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1.jpg 1400w" data-lazy-sizes="(max-width: 700px) 100vw, 700px" data-lazy-src="https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-700x1049.jpg" /><noscript><img decoding="async" class="alignnone size-large wp-image-127012" src="https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-700x1049.jpg" alt="Serrano Sweet Pea Guacamole" width="700" height="1049" data-jpibfi-post-excerpt="" data-jpibfi-post-url="https://www.simplyscratch.com/serrano-sweet-pea-guacamole/" data-jpibfi-post-title="Serrano Sweet Pea Guacamole" data-jpibfi-src="https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-700x1049.jpg" srcset="https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-700x1049.jpg 700w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-410x614.jpg 410w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-768x1151.jpg 768w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-1025x1536.jpg 1025w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1-1367x2048.jpg 1367w, https://www.simplyscratch.com/wp-content/uploads/2024/04/Image-154-1.jpg 1400w" sizes="(max-width: 700px) 100vw, 700px" /></noscript></p>
