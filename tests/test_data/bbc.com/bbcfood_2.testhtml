ower_cheese_55471\",\"selected\":false,\"hidden\":false},{\"label\":\"Cottage pie\",\"url\":\"/food/recipes/classiccottagepie_90765\",\"selected\":false,\"hidden\":false},{\"label\":\"Chilli con carne\",\"url\":\"/food/recipes/chilliconcarne_67875\",\"selected\":false,\"hidden\":false},{\"label\":\"Toad in the hole\",\"url\":\"/food/recipes/toad_in_the_hole_with_86283\",\"selected\":false,\"hidden\":false},{\"label\":\"Lasagne\",\"url\":\"/food/recipes/mary_berrys_lasagne_al_16923\",\"selected\":false,\"hidden\":false},{\"label\":\"Spaghetti bolognese \",\"url\":\"/food/recipes/easy_spaghetti_bolognese_93639\",\"selected\":false,\"hidden\":false},{\"label\":\"Spaghetti carbonara\",\"url\":\"/food/recipes/spaghettiallacarbona_73311\",\"selected\":false,\"hidden\":false}]}],\"breadcrumbs\":[],\"noJSLink\":null,\"withExpandedHitArea\":false}},\"importance\":\"PRIMARY\",\"isPersonalised\":false,\"hasFetcher\":true},\"recipe-finder?name=BBC%20Food&url=%2Ffood%2Fsearch\":{\"name\":\"recipe-finder\",\"props\":{\"name\":\"BBC Food\",\"url\":\"/food/search\"},\"data\":{},\"importance\":\"PRIMARY\",\"isPersonalised\":false,\"hasFetcher\":false},\"recipe?env=live&recipe=%7B%22id%22%3A%22lemonpossetwithlemon_85812%22%2C%22title%22%3A%22Lemon%20posset%20with%20lemon%20shortbread%22%2C%22metaTitle%22%3A%22Lemon%20posset%22%2C%22description%22%3A%22Nothing%20could%20be%20easier%20than%20lemon%20posset%20%E2%80%93%20it's%20cream%2C%20sugar%20and%20lemon%20juice%2C%20stirred%20together.%20But%20doesn't%20it%20look%20fancy%3F%20Add%20crunch%20with%20cute%20lemon%20thumbprint%20biscuits%20on%20the%20side.%5Cr%5CnEach%20serving%20provides%20542%20kcal%2C%201.6g%20protein%2C%2026.9g%20carbohydrate%20(of%20which%2026.9g%20sugars)%2C%2047.5g%20fat%20(of%20which%2029.5g%20saturates)%2C%200.1g%20fibre%20and%200.07g%20salt.%5Cr%5Cn%22%2C%22metaDescription%22%3A%22Nothing%20could%20be%20easier%20than%20James%20Martin's%20lemon%20posset%20%E2%80%93%20it's%20cream%2C%20sugar%20and%20lemon%20juice.%20Add%20crunch%20with%20cute%20lemon%20thumbprint%20biscuits%20on%20the%20side.%22%2C%22thumbnail%22%3Anull%2C%22wines%22%3A%22%22%2C%22equipment%22%3Anull%2C%22servingsText%22%3A%22Serves%206%22%2C%22servings%22%3Anull%2C%22prepTime%22%3A%22over%202%20hours%22%2C%22cookingTime%22%3A%2210%20to%2030%20mins%22%2C%22hasImage%22%3A%22true%22%2C%22status%22%3A%22published%22%2C%22lastModified%22%3A%222026-02-03T11%3A12%3A46.000Z%22%2C%22tips%22%3A%22It's%20nice%20to%20have%20something%20crunchy%20to%20dip%20into%20possets%2C%20but%20if%20you%20don't%20fancy%20making%20biscuits%20you%20could%20buy%20thin%20shortbread%20biscuits%2C%20ginger%20snaps%20or%20lemon%20cookies.%20These%20lemon%20biscuits%20are%20very%20delicate%20and%20melt%20in%20the%20mouth.%5Cr%5Cn%5Cr%5CnIf%20your%20lemons%20are%20on%20the%20small%20side%2C%20use%20the%20zest%20of%203%20and%20the%20juice%20of%202%C2%BD.%5Cr%5Cn%5Cr%5CnWhen%20heating%20the%20cream%20and%20sugar%20in%20step%201%2C%20keep%20an%20eye%20on%20it%20and%20stir%20regularly%20as%20the%20sugar%20can%20sink%20to%20the%20bottom%20of%20the%20pan%20and%20burn.%20%22%2C%22startTime%22%3Anull%2C%22endTime%22%3Anull%2C%22canonical%22%3Anull%2C%22programmeClip%22%3Anull%2C%22food%22%3A%7B%22id%22%3A%22posset%22%2C%22title%22%3A%22posset%22%7D%2C%22course%22%3A%7B%22id%22%3A%22desserts%22%2C%22title%22%3A%22Desserts%22%7D%2C%22cuisine%22%3A%7B%22id%22%3A%22british%22%2C%22title%22%3A%22British%22%7D%2C%22programmeTopLevel%22%3A%7B%22id%22%3A%22b006v5y2%22%2C%22title%22%3A%22Saturday%20Kitchen%22%2C%22type%22%3A%22brand%22%7D%2C%22programmeEpisode%22%3A%7B%22id%22%3Anull%2C%22title%22%3Anull%7D%2C%22programmeSeries%22%3A%7B%22id%22%3Anull%2C%22title%22%3Anull%7D%2C%22chef%22%3A%7B%22id%22%3A%22james_martin%22%2C%22hasImage%22%3A%22true%22%2C%22displayName%22%3A%22James%20Martin%22%7D%2C%22datePublished%22%3A%222007-03-16T00%3A00%3A00.000Z%22%2C%22methods%22%3A%5B%7B%22technique%22%3Anull%2C%22text%22%3A%22For%20the%20posset%2C%20place%20the%20double%20cream%20and%20the%20sugar%20into%20a%20large%20pan%20over%20a%20low%20heat.%20Slowly%20bring%20to%20the%20boil%2C%20then%20boil%20for%203%20minutes%2C%20stirring%20often.%20Remove%20from%20the%20heat.%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Add%20the%20lemon%20juice%20and%20zest%20and%20whisk%20well.%20Set%20aside%20to%20cool.%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Pour%20the%20lemon%20posset%20into%206%20large%20serving%20glasses%20and%20refrigerate%20for%201%E2%80%932%20hours%2C%20or%20until%20set.%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22For%20the%20biscuits%2C%20preheat%20the%20oven%20to%20180C%2F160C%20Fan%2FGas%204%20and%20grease%20a%20muffin%20tray%20with%20butter.%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Sift%20the%20icing%20sugar%2C%20flour%20and%20cornflour%20into%20the%20bowl%20of%20a%20food%20processor%20(or%20a%20large%20mixing%20bowl).%20Add%20the%20ground%20almonds.%22%7D%2C%7B%22technique%22%3A%7B%22id%22%3A%22rubbing_in%22%2C%22title%22%3A%22Rubbing%20in%22%2C%22hasImage%22%3A%22false%22%2C%22programmeClip%22%3A%7B%22id%22%3A%22p0btkwy4%22%7D%7D%2C%22text%22%3A%22Add%20the%20butter%20and%20pulse%20briefly%20until%20there%20are%20no%20visible%20lumps%20of%20butter.%20(If%20making%20by%20hand%2C%20rub%20the%20butter%20into%20the%20dry%20ingredients%20until%20it%20resembles%20breadcrumbs.)%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Add%20the%20almond%20essence.%20Pulse%20again%2C%20then%20turn%20the%20mixture%20out%20onto%20a%20lightly%20floured%20surface%20and%20bring%20together%20to%20form%20a%20smooth%20dough.%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Roll%20the%20dough%20into%2012%20small%20balls.%20Place%20a%20ball%20in%20each%20hole%20of%20the%20muffin%20tin%2C%20flattening%20the%20tops%20slightly%20with%20your%20fingers.%20The%20dough%20should%20come%20about%20one%20third%20of%20the%20way%20up%20the%20side%20of%20each%20muffin%20cup.%20%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Bake%20for%208%E2%80%9312%20minutes%2C%20or%20until%20they%20are%20a%20light%20golden%20colour.%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Remove%20from%20the%20oven%2C%20allow%20to%20cool%20slightly%2C%20then%2C%20using%20your%20thumb%2C%20make%20a%20small%20indentation%20into%20the%20top%20of%20each%20biscuit.%20Take%20care%20as%20they%20will%20be%20hot.%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Let%20the%20shortbreads%20cool%20for%20a%20few%20minutes%2C%20then%20turn%20the%20tin%20over%20and%20carefully%20tap%20the%20shortbreads%20out.%20(Be%20gentle%2C%20as%20the%20biscuits%20are%20fragile%20while%20they%20are%20still%20warm.)%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22When%20all%20the%20shortbreads%20are%20baked%20and%20cooled%2C%20dust%20the%20tops%20with%20icing%20sugar.%20Fill%20the%20indentations%20in%20the%20biscuits%20with%20lemon%20curd.%20%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22To%20serve%2C%20place%20the%20lemon%20possets%20in%20their%20glasses%20onto%20serving%20plates%20with%20a%20biscuit%20alongside.%20Sprinkle%20a%20little%20lemon%20zest%20on%20top%2C%20if%20you%20want.%22%7D%5D%2C%22diets%22%3A%5B%7B%22id%22%3A%22egg_free%22%2C%22title%22%3A%22egg-free%22%2C%22path%22%3A%22%2Ffood%2Fdiets%2Fegg_free%22%7D%2C%7B%22id%22%3A%22pregnancy_friendly%22%2C%22title%22%3A%22pregnancy-friendly%22%2C%22path%22%3A%22%2Ffood%2Fdiets%2Fpregnancy_friendly%22%7D%2C%7B%22id%22%3A%22vegetarian%22%2C%22title%22%3A%22vegetarian%22%2C%22path%22%3A%22%2Ffood%2Fdiets%2Fvegetarian%22%7D%5D%2C%22collections%22%3A%5B%7B%22id%22%3A%221_easy_pudding_recipes%22%2C%22hasImage%22%3A%22false%22%2C%22title%22%3A%22Easy%20pudding%20recipes%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%228_lovely_lemon_puds%22%2C%22hasImage%22%3A%22true%22%2C%22title%22%3A%22Lemon%20desserts%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%22christmas_twists%22%2C%22hasImage%22%3A%22false%22%