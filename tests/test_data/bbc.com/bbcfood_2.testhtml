22easy_lemon_posset_45932%22%2C%22hasImage%22%3A%22true%22%2C%22title%22%3A%22Easy%20lemon%20posset%22%2C%22lastModified%22%3A%222025-03-17T12%3A08%3A39.000Z%22%2C%22seasons%22%3A%5B%5D%2C%22food%22%3A%7B%22id%22%3A%22posset%22%2C%22title%22%3A%22posset%22%7D%2C%22description%22%3A%22This%20lemon%20posset%20has%20to%20be%20the%20easiest%20dessert%20we%20know%20of.%20Simply%20heat%20some%20cream%20and%20sugar%20and%20whisk%20in%20lemon%20juice%20to%20create%20a%20smooth%20lemon%20mousse%20that%20makes%20the%20perfect%20finish%20to%20a%20special%20dinner%20for%20two.%22%2C%22availabilityEnd%22%3Anull%2C%22diets%22%3A%5B%7B%22id%22%3A%22egg_free%22%7D%2C%7B%22id%22%3A%22pregnancy_friendly%22%7D%2C%7B%22id%22%3A%22vegetarian%22%7D%5D%2C%22isQuickAndEasy%22%3A%22true%22%2C%22chef%22%3Anull%2C%22relations%22%3A%7B%22count%22%3A6%2C%22title%22%3A%22posset%20recipes%22%2C%22path%22%3A%22%2Ffood%2Fposset%22%7D%2C%22type%22%3A%22dish%22%2C%22url%22%3A%22%2Ffood%2Frecipes%2Feasy_lemon_posset_45932%22%2C%22image%22%3A%7B%22template%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_%7Bwidth%7D%2Frecipes%2Feasy_lemon_posset_45932_16x9.jpg%22%2C%22aceTemplate%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F%7Bwidth%7D%2Ffood%2Frecipes%2Feasy_lemon_posset_45932_16x9.jpg.webp%22%2C%22thumbnail%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_1600%2Frecipes%2Feasy_lemon_posset_45932_16x9.jpg%22%2C%22aceThumbnail%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F1600%2Ffood%2Frecipes%2Feasy_lemon_posset_45932_16x9.jpg.webp%22%2C%22sizes%22%3A%5B160%2C208%2C320%2C448%2C608%2C832%2C1600%5D%7D%7D%2C%7B%22course%22%3A%7B%22id%22%3A%22desserts%22%2C%22title%22%3A%22Desserts%22%7D%2C%22id%22%3A%22frozen_elderflower_07251%22%2C%22hasImage%22%3A%22true%22%2C%22title%22%3A%22Frozen%20elderflower%20posset%20%22%2C%22lastModified%22%3A%222025-03-17T12%3A08%3A57.000Z%22%2C%22seasons%22%3A%5B%5D%2C%22food%22%3A%7B%22id%22%3A%22posset%22%2C%22title%22%3A%22posset%22%7D%2C%22description%22%3A%22This%20frozen%20dessert%20is%20so%20fragrant%20and%20so%20easy%20to%20make%3A%20the%20ingredients%20are%20just%20whipped%20together%20and%20frozen%20and%20it%20doesn%E2%80%99t%20need%20churning.%20Serve%20with%20summer%20berries%20for%20the%20perfect%20summer%20dessert.%22%2C%22availabilityEnd%22%3A%222099-03-31T20%3A00%3A00.000Z%22%2C%22diets%22%3A%5B%7B%22id%22%3A%22egg_free%22%7D%2C%7B%22id%22%3A%22nut_free%22%7D%2C%7B%22id%22%3A%22pregnancy_friendly%22%7D%2C%7B%22id%22%3A%22vegetarian%22%7D%5D%2C%22isQuickAndEasy%22%3A%22false%22%2C%22chef%22%3A%7B%22id%22%3A%22mary_berry%22%2C%22hasImage%22%3A%22true%22%2C%22displayName%22%3A%22Mary%20Berry%22%7D%2C%22relations%22%3A%7B%22count%22%3A6%2C%22title%22%3A%22posset%20recipes%22%2C%22path%22%3A%22%2Ffood%2Fposset%22%7D%2C%22type%22%3A%22dish%22%2C%22url%22%3A%22%2Ffood%2Frecipes%2Ffrozen_elderflower_07251%22%2C%22image%22%3A%7B%22template%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_%7Bwidth%7D%2Frecipes%2Ffrozen_elderflower_07251_16x9.jpg%22%2C%22aceTemplate%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F%7Bwidth%7D%2Ffood%2Frecipes%2Ffrozen_elderflower_07251_16x9.jpg.webp%22%2C%22thumbnail%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_1600%2Frecipes%2Ffrozen_elderflower_07251_16x9.jpg%22%2C%22aceThumbnail%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F1600%2Ffood%2Frecipes%2Ffrozen_elderflower_07251_16x9.jpg.webp%22%2C%22sizes%22%3A%5B160%2C208%2C320%2C448%2C608%2C832%2C1600%5D%7D%7D%2C%7B%22course%22%3A%7B%22id%22%3A%22afternoon_tea%22%2C%22title%22%3A%22Cakes%20and%20baking%22%7D%2C%22id%22%3A%22lemon_and_lavender_79937%22%2C%22hasImage%22%3A%22true%22%2C%22title%22%3A%22Lemon%20and%20lavender%20posset%20with%20lavender%20biscuits%22%2C%22lastModified%22%3A%222025-03-17T12%3A02%3A28.000Z%22%2C%22seasons%22%3A%5B%5D%2C%22food%22%3A%7B%22id%22%3A%22posset%22%2C%22title%22%3A%22posset%22%7D%2C%22description%22%3A%22A%20posset%20is%20a%20very%20simple%20pudding%20that%20dates%20back%20to%20the%20middle%20ages.%20Some%20possets%20can%20be%20very%20heavy%20on%20the%20cream%2C%20but%20I%E2%80%99ve%20used%20lemon%20juice%20and%20fragrant%20lavender%20to%20cut%20the%20richness.%22%2C%22availabilityEnd%22%3A%222099-11-11T12%3A00%3A00.000Z%22%2C%22diets%22%3A%5B%7B%22id%22%3A%22egg_free%22%7D%2C%7B%22id%22%3A%22nut_free%22%7D%2C%7B%22id%22%3A%22pregnancy_friendly%22%7D%2C%7B%22id%22%3A%22vegetarian%22%7D%5D%2C%22isQuickAndEasy%22%3A%22false%22%2C%22chef%22%3A%7B%22id%22%3A%22paul_hollywood%22%2C%22hasImage%22%3A%22true%22%2C%22displayName%22%3A%22Paul%20Hollywood%22%7D%2C%22relations%22%3A%7B%22count%22%3A6%2C%22title%22%3A%22posset%20recipes%22%2C%22path%22%3A%22%2Ffood%2Fposset%22%7D%2C%22type%22%3A%22dish%22%2C%22url%22%3A%22%2Ffood%2Frecipes%2Flemon_and_lavender_79937%22%2C%22image%22%3A%7B%22template%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_%7Bwidth%7D%2Frecipes%2Flemon_and_lavender_79937_16x9.jpg%22%2C%22aceTemplate%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F%7Bwidth%7D%2Ffood%2Frecipes%2Flemon_and_lavender_79937_16x9.jpg.webp%22%2C%22thumbnail%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_1600%2Frecipes%2Flemon_and_lavender_79937_16x9.jpg%22%2C%22aceThumbnail%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F1600%2Ffood%2Frecipes%2Flemon_and_lavender_79937_16x9.jpg.webp%22%2C%22sizes%22%3A%5B160%2C208%2C320%2C448%2C608%2C832%2C1600%5D%7D%7D%2C%7B%22course%22%3A%7B%22id%22%3A%22desserts%22%2C%22title%22%3A%22Desserts%22%7D%2C%22id%22%3A%22lemon_posset_with_fennel_86459%22%2C%22hasImage%22%3A%22true%22%2C%22title%22%3A%22Lemon%20posset%20with%20fennel%20biscotti%20%22%2C%22lastModified%22%3A%222025-03-17T12%3A03%3A05.000Z%22%2C%22seasons%22%3A%5B%5D%2C%22food%22%3A%7B%22id%22%3A%22posset%22%2C%22title%22%3A%22posset%22%7D%2C%22description%22%3A%22Three%20simple%20ingredients%20is%20all%20it%20takes%20to%20make%20a%20zingy%2C%20refreshing%20lemon%20posset%20%5Cr%5Cn%22%2C%22availabilityEnd%22%3A%222028-10-21T20%3A00%3A00.000Z%22%2C%22diets%22%3A%5B%7B%22id%22%3A%22pregnancy_friendly%22%7D%2C%7B%22id%22%3A%22vegetarian%22%7D%5D%2C%22isQuickAndEasy%22%3A%22false%22%2C%22chef%22%3A%7B%22id%22%3A%22tom_kerridge%22%2C%22hasImage%22%3A%22true%22%2C%22displayName%22%3A%22Tom%20Kerridge%22%7D%2C%22relations%22%3A%7B%22count%22%3A6%2C%22title%22%3A%22posset%20recipes%22%2C%22path%22%3A%22%2Ffood%2Fposset%22%7D%2C%22type%22%3A%22dish%22%2C%22url%22%3A%22%2Ffood%2Frecipes%2Flemon_posset_with_fennel_86459%22%2C%22image%22%3A%7B%22template%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_%7Bwidth%7D%2Frecipes%2Flemon_posset_with_fennel_86459_16x9.jpg%22%2C%22aceTemplate%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F%7Bwidth%7D%2Ffood%2Frecipes%2Flemon_posset_with_fennel_86459_16x9.jpg.webp%22%2C%22thumbnail%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_1600%2Frecipes%2Flemon_posset_with_fennel_86459_16x9.jpg%22%2C%22aceThumbnail%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F1600%2Ffood%2Frecipes%2Flemon_posset_with_fennel_86459_16x9.jpg.webp%22%2C%22sizes%22%3A%5B160%2C208%2C320%2C448%2C608%2C832%2C1600%5D%7D%7D%5D%7D%7D\":{\"name\":\"recipe\",\"props\":{\"env\":\"live\",\"recipe\":{\"id\":\"lemonpossetwithlemon_85812\",\"title\":\"Lemon posset with lemon shortbread\",\"metaTitle\":\"Lemon posset\",\"description\":\"Nothing could be easier than lemon posset – it's cream, sugar and lemon juice, stirred together. But doesn't it look fancy? Add crunch with cute lemon thumbprint biscuits on the side.\\r\\nEach serving provides 542 kcal, 1.6g protein, 26.9g carbohydrate (of which 26.9g sugars), 47.5g fat (of which 29.5g saturates), 0.1g fibre and 0.07g salt.\\r\\n\",\"metaDescription\":\"Nothing could be easier than James Martin's lemon posset – it's cream, sugar and lemon juice. Add crunch with cute lemon thumbprint biscuits on the side.\",\"thumbnail\":null,\"wines\":\"\",\"equipment\":null,\"servingsText\":\"Serves 6\",\"servings\":null,\"prepTime\":\"over 2 hours\",\"cookingTime\":\"10 to 30 mins\",\"hasImage\":\"true\",\"status\":\"published\",\"lastModified\":\"2026-02-03T11:12:46.000Z\",\"tips\":\"It's nice to have something crunchy to dip into possets, but if you don't fancy making biscuits you could buy thin shortbread biscuits, ginger snaps or lemon cookies. These lemon biscuits are very delicate and melt in the mouth.\\r\\n\\r\\nIf your lemons are on the small side, use the zest of 3 and the juice of 2½.\\r\\n\\r\\nWhen heating the cream and sugar in step 1, keep an eye on it and stir regularly as the sugar can sink to the bottom of the pan and burn. \",\"startTime\":null,\"endTime\":null,\"canonical\":null,\"programmeClip\":null,\"food\":{\"id\":\"posset\",\"title\":\"posset\"},\"course\":{\"id\":\"desserts\",\"title\":\"Desserts\"},\"cuisine\":{\"id\":\"british\",\"title\":\"British\"},\"programmeTopLevel\":{\"id\":\"b006v5y2\",\"title\":\"Saturday Kitchen\",\"type\":\"brand\"},\"programmeEpisode\":{\"id\":null,\"title\":null},\"programmeSeries\":{\"id\":null,\"title\":null},\"chef\":{\"id\":\"james_martin\",\"hasImage\":\"true\",\"displayName\":\"James Martin\"},\"datePublished\":\"2007-03-16T00:00:00.000Z\",\"methods\":[{\"technique\":null,\"text\":\"For the posset, place the double cream and the sugar into a large pan over a low heat. Slowly bring to the boil, then boil for 3 minutes, stirring often. Remove from the heat.\"},{\"technique\":null,\"text\":\"Add the lemon juice and zest and whisk well. Set aside to cool.\"},{\"technique\":null,\"text\":\"Pour the lemon posset into 6 large serving glasses and refrigerate for 1–2 hours, or until set.\"},{\"technique\":null,\"text\":\"For the biscuits, preheat the oven to 180C/160C Fan/Gas 4 and grease a muffin tray with butter.\"},{\"technique\":null,\"text\":\"Sift the icing sugar, flour and cornflour into the bowl of a food processor (or a large mixing bowl). Add the ground almonds.\"},{\"technique\":{\"id\":\"rubbing_in\",\"title\":\"Rubbing in\",\"hasImage\":\"false\",\"programmeClip\":{\"id\":\"p0btkwy4\"}},\"text\":\"Add the butter and pulse briefly until there are no visible lumps of butter. (If making by hand, rub the butter into the dry ingredients until it resembles breadcrumbs.)\"},{\"technique\":null,\"text\":\"Add the almond essence. Pulse again, then turn the mixture out onto a lightly floured surface and bring together to form a smooth dough.\"},{\"technique\":null,\"text\":\"Roll the dough into 12 small balls. Place a ball in each hole of the muffin tin, flattening the tops slightly with your fingers. The dough should come about one third of the way up the side of each muffin cup. \"},{\"technique\":null,\"text\":\"Bake for 8–12 minutes, or until they are a light golden colour.\"},{\"technique\":null,\"text\":\"Remove from the oven, allow to cool slightly, then, using your thumb, make a small indentation into the top of each biscuit. Take care as they will be hot.\"},{\"technique\":null,\"text\":\"Let the shortbreads cool for a few minutes, then turn the tin over and carefully tap the shortbreads out. (Be gentle, as the biscuits are fragile while they are still warm.)\"},{\"technique\":null,\"text\":\"When all the shortbreads are baked and cooled, dust the tops with icing sugar. Fill the indentations in the biscuits with lemon curd. \"},{\"technique\":null,\"text\":\"To serve, place the lemon possets in their glasses onto serving plates with a biscuit alongside. Sprinkle a little lemon zest on top, if you want.\"}],\"diets\":[{\"id\":\"egg_free\",\"title\":\"egg-free\",\"path\":\"/food/diets/egg_free\"},{\"id\":\"pregnancy_friendly\",\"title\":\"pregnancy-friendly\",\"path\":\"/food/diets/pregnancy_friendly\"},{\"id\":\"vegetarian\",\"title\":\"vegetarian\",\"path\":\"/food/diets/vegetarian\"}],\"collections\":[{\"id\":\"1_easy_pudding_recipes\",\"hasImage\":\"false\",\"title\":\"Easy pudding recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"8_lovely_lemon_puds\",\"hasImage\":\"true\",\"title\":\"Lemon desserts\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_twists\",\"hasImage\":\"false\",\"title\":\"Easy Christmas dessert ideas\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"easy_festive_desserts\",\"hasImage\":\"false\",\"title\":\"Easy festive desserts\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"festive_desserts\",\"hasImage\":\"false\",\"title\":\"Christmas dessert recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"festive_puds\",\"hasImage\":\"false\",\"title\":\"Festive puds\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"luxurious_christmas_party_menu\",\"hasImage\":\"false\",\"title\":\"Luxurious Christmas party menu\",\"isMenu\":\"true\",\"chef\":null},{\"id\":\"vegetarian_boxing_day_feast\",\"hasImage\":\"true\",\"title\":\"Vegetarian Boxing Day feast\",\"isMenu\":\"true\",\"chef\":null}],\"seasons\":null,\"occasions\":[{\"id\":\"boxing_day\",\"title\":\"Boxing Day recipes\"},{\"id\":\"christmas\",\"title\":\"Christmas recipes and menus\"},{\"id\":\"dinner_party_recipes_and_ideas\",\"title\":\"Dinner party recipes and ideas\"},{\"id\":\"spring\",\"title\":\"Spring recipes \"},{\"id\":\"winter\",\"title\":\"Winter recipes\"}],\"stages\":[{\"title\":\"For the posset\",\"ingredients\":[{\"text\":\"600ml/21fl oz double cream\",\"technique\":null,\"foods\":[{\"id\":\"double_cream\",\"isKeyIngredient\":\"false\",\"title\":\"double cream\",\"supermarketLocation\":\"Dairy, eggs and chilled\"}],\"url\":{\"text\":\"double cream\",\"subjects\":[\"double cream\"],\"path\":\"/food/double_cream\"}},{\"text\":\"150g/5½oz caster sugar\",\"technique\":null,\"foods\":[{\"id\":\"caster_sugar\",\"isKeyIngredient\":\"false\",\"title\":\"caster sugar\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"caster sugar\",\"subjects\":[\"caster sugar\"],\"path\":\"/food/caster_sugar\"}},{\"text\":\"2 large lemons, zest and juice only\",\"technique\":{\"id\":\"grating_lemon_zest\",\"hasImage\":\"false\",\"title\":\"Grating lemon zest\",\"programmeClip\":{\"id\":\"p009yv67\"}},\"foods\":[{\"id\":\"lemon\",\"isKeyIngredient\":\"true\",\"title\":\"lemon\",\"supermarketLocation\":\"Fruit and vegetables\"}],\"url\":{\"text\":\"lemons\",\"subjects\":[\"lemons\"],\"path\":\"/food/lemon\"}}]},{\"title\":\"For the lemon biscuits (optional)\",\"ingredients\":[{\"text\":\"90g/3¼oz icing sugar\",\"technique\":null,\"foods\":[{\"id\":\"icing_sugar\",\"isKeyIngredient\":\"false\",\"title\":\"icing sugar\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"icing sugar\",\"subjects\":[\"icing sugar\"],\"path\":\"/food/icing_sugar\"}},{\"text\":\"185g/6½oz plain flour\",\"technique\":null,\"foods\":[{\"id\":\"plain_flour\",\"isKeyIngredient\":\"false\",\"title\":\"plain flour\",\"supermarketLocation\":\"Tins, packets and jars\"}],\"url\":{\"text\":\"plain flour\",\"subjects\":[\"plain flour\"],\"path\":\"/food/plain_flour\"}},{\"text\":\"60g/2¼oz cornflour\",\"technique\":null,\"foods\":[{\"id\":\"cornflour\",\"isKeyIngredient\":\"false\",\"title\":\"cornflour\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"cornflour\",\"subjects\":[\"cornflour\"],\"path\":\"/food/cornflour\"}},{\"text\":\"30g/1oz ground almonds\",\"technique\":null,\"foods\":[{\"id\":\"ground_almonds\",\"isKeyIngredient\":\"false\",\"title\":\"ground almonds\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"ground almonds\",\"subjects\":[\"ground almonds\"],\"path\":\"/food/ground_almonds\"}},{\"text\":\"250g/9oz butter, cut into cubes, plus extra for greasing\",\"technique\":null,\"foods\":[{\"id\":\"butter\",\"isKeyIngredient\":\"false\",\"title\":\"butter\",\"supermarketLocation\":\"Dairy, eggs and chilled\"}],\"url\":{\"text\":\"butter\",\"subjects\":[\"butter\"],\"path\":\"/food/butter\"}},{\"text\":\"2 drops almond essence\",\"technique\":null,\"foods\":[{\"id\":\"almond_essence\",\"isKeyIngredient\":\"false\",\"title\":\"almond essence\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"almond essence\",\"subjects\":[\"almond essence\"],\"path\":\"/food/almond_essence\"}},{\"text\":\"75g/2½oz lemon curd\",\"technique\":null,\"foods\":[{\"id\":\"lemon_curd\",\"isKeyIngredient\":\"false\",\"title\":\"lemon curd\",\"supermarketLocation\":\"Tins, packets and jars\"}],\"url\":{\"text\":\"lemon curd\",\"subjects\":[\"lemon curd\"],\"path\":\"/food/lemon_curd\"}},{\"text\":\"icing sugar, for dusting\",\"technique\":null,\"foods\":[{\"id\":\"icing_sugar\",\"isKeyIngredient\":\"false\",\"title\":\"icing sugar\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"icing sugar\",\"subjects\":[\"icing sugar\"],\"path\":\"/food/icing_sugar\"}}]}],\"menu\":{\"id\":\"vegetarian_boxing_day_feast\",\"title\":\"Vegetarian Boxing Day feast\",\"description\":\"Use up all those bits and bobs in a vegetarian Boxing day family feast. \",\"name\":\"Vegetarian Boxing Day feast\",\"serves\":\"\",\"chef\":null,\"keyRecipe\":{\"hasImage\":\"true\",\"id\":\"pesto_christmas_tree_53067\",\"title\":\"Pesto and cheese Christmas tree \"},\"path\":\"/food/menus/vegetarian_boxing_day_feast\"},\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/lemonpossetwithlemon_85812_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/lemonpossetwithlemon_85812_16x9.jpg.webp\",\"hero\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/lemonpossetwithlemon_85812_16x9.jpg\",\"aceHero\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/lemonpossetwithlemon_85812_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"rating\":{\"total\":59,\"value\":4.627118644067797},\"shoppingList\":[{\"locationTitle\":\"Fruit and vegetables\",\"ingredients\":[{\"text\":\"2 large lemons, zest and juice only\",\"url\":{\"text\":\"lemons\",\"subjects\":[\"lemons\"],\"path\":\"/food/lemon\"}}]},{\"locationTitle\":\"Tins, packets and jars\",\"ingredients\":[{\"text\":\"185g/6½oz plain flour\",\"url\":{\"text\":\"plain flour\",\"subjects\":[\"plain flour\"],\"path\":\"/food/plain_flour\"}},{\"text\":\"75g/2½oz lemon curd\",\"url\":{\"text\":\"lemon curd\",\"subjects\":[\"lemon curd\"],\"path\":\"/food/lemon_curd\"}}]},{\"locationTitle\":\"Cooking ingredients\",\"ingredients\":[{\"text\":\"150g/5½oz caster sugar\",\"url\":{\"text\":\"caster sugar\",\"subjects\":[\"caster sugar\"],\"path\":\"/food/caster_sugar\"}},{\"text\":\"90g/3¼oz icing sugar\",\"url\":{\"text\":\"icing sugar\",\"subjects\":[\"icing sugar\"],\"path\":\"/food/icing_sugar\"}},{\"text\":\"60g/2¼oz cornflour\",\"url\":{\"text\":\"cornflour\",\"subjects\":[\"cornflour\"],\"path\":\"/food/cornflour\"}},{\"text\":\"30g/1oz ground almonds\",\"url\":{\"text\":\"ground almonds\",\"subjects\":[\"ground almonds\"],\"path\":\"/food/ground_almonds\"}},{\"text\":\"2 drops almond essence\",\"url\":{\"text\":\"almond essence\",\"subjects\":[\"almond essence\"],\"path\":\"/food/almond_essence\"}},{\"text\":\"icing sugar, for dusting\",\"url\":{\"text\":\"icing sugar\",\"subjects\":[\"icing sugar\"],\"path\":\"/food/icing_sugar\"}}]},{\"locationTitle\":\"Dairy, eggs and chilled\",\"ingredients\":[{\"text\":\"600ml/21fl oz double cream\",\"url\":{\"text\":\"double cream\",\"subjects\":[\"double cream\"],\"path\":\"/food/double_cream\"}},{\"text\":\"250g/9oz butter, cut into cubes, plus extra for greasing\",\"url\":{\"text\":\"butter\",\"subjects\":[\"butter\"],\"path\":\"/food/butter\"}}]}],\"howToVideos\":[{\"description\":\"Watch how to rub butter into flour by hand.\",\"duration\":\"PT30S\",\"holdingImageUrl\":\"https://ichef.bbci.co.uk/images/ic/640xn/p0btkxln.jpg\",\"id\":\"p0btkwyl\",\"updatedAt\":\"2023-03-08T05:49:45.000Z\",\"techniqueUrl\":\"/food/how_to_cook/watch/rubbing_in\",\"title\":\"Rubbing in\"},{\"description\":\"Add citrus zing to cakes, biscuits and soufflés with Mary Berry.\\n\\n-Remove the zest from the lemon using a grater, make sure you remove the bright yellow zest and none of the white pith,  which is bitter.\",\"duration\":\"PT38S\",\"holdingImageUrl\":\"https://ichef.bbci.co.uk/images/ic/640xn/p02bpyqc.jpg\",\"id\":\"p009yv6b\",\"updatedAt\":\"2024-12-19T16:01:27.000Z\",\"techniqueUrl\":\"/food/how_to_cook/watch/grating_lemon_zest\",\"title\":\"Grating lemon zest\"}],\"relatedRecipes\":{\"fromEpisode\":{},\"menu\":[{\"sequence\":1,\"id\":\"pesto_christmas_tree_53067\",\"title\":\"Pesto and cheese Christmas tree \",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"10 to 30 mins\",\"hasImage\":\"true\",\"description\":\"This pesto Christmas tree is the perfect festive party food. Ideal for those afternoon parties with kids and adults. \",\"chef\":{\"displayName\":\"The BBC Food team\",\"id\":\"bbc_food_team\"},\"course\":{\"id\":\"starters_and_nibbles\",\"title\":\"Starters & nibbles\"},\"type\":\"collection\",\"url\":\"/food/recipes/pesto_christmas_tree_53067\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/pesto_christmas_tree_53067_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/pesto_christmas_tree_53067_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/pesto_christmas_tree_53067_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/pesto_christmas_tree_53067_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}},{\"sequence\":2,\"id\":\"root_vegetable_traybake_06195\",\"title\":\"Root vegetable traybake\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"30 mins to 1 hour\",\"hasImage\":\"true\",\"description\":\"This colourful all-in-one root vegetable traybake with sage and onion balls is a delicious veggie main course that all the family will love. Serve with a bowl of steamed green veg, if you like.\",\"chef\":{\"displayName\":\"The Hairy Bikers\",\"id\":\"hairy_bikers\"},\"course\":{\"id\":\"main_course\",\"title\":\"Main course\"},\"type\":\"collection\",\"url\":\"/food/recipes/root_vegetable_traybake_06195\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/root_vegetable_traybake_06195_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/root_vegetable_traybake_06195_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/root_vegetable_traybake_06195_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/root_vegetable_traybake_06195_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}},{\"sequence\":3,\"id\":\"vegan_pigs-in-blankets_77774\",\"title\":\"Vegetarian pigs in blankets \",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"10 to 30 mins\",\"hasImage\":\"true\",\"description\":\"These vegetarian pigs-in-blankets are sweet, sticky and irresistible. Use a plant-based spread if you’re vegan.\\r\\n\\r\\nFor this recipe you will need 24 toothpicks and a shallow baking dish, lined with baking paper. \\r\\n\",\"chef\":{\"displayName\":\"Philippa Davis\",\"id\":\"philippa_davis\"},\"course\":{\"id\":\"side_dishes\",\"title\":\"Side dishes\"},\"type\":\"collection\",\"url\":\"/food/recipes/vegan_pigs-in-blankets_77774\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/vegan_pigs-in-blankets_77774_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/vegan_pigs-in-blankets_77774_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/vegan_pigs-in-blankets_77774_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/vegan_pigs-in-blankets_77774_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}},{\"sequence\":4,\"id\":\"vegan_nut_loaf_99997\",\"title\":\"Perfect nut roast\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"30 mins to 1 hour\",\"hasImage\":\"true\",\"description\":\"Nut roast is a favourite for a reason as it's popular, easy to make and keeps well. Try this vegan nut roast, which is perfect served hot for Christmas dinner, or cold for your festive buffet table.\\r\\n\\r\\nEach serving provides 525 kcal, 18g protein, 32g carbohydrate (of which 18g sugars), 35g fat (of which 6g saturates), 6g fibre and 0.9g salt.\\r\\n\",\"chef\":{\"displayName\":\"Justine Pattison\",\"id\":\"justine_pattison\"},\"course\":{\"id\":\"main_course\",\"title\":\"Main course\"},\"type\":\"collection\",\"url\":\"/food/recipes/vegan_nut_loaf_99997\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/vegan_nut_loaf_99997_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/vegan_nut_loaf_99997_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/vegan_nut_loaf_99997_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/vegan_nut_loaf_99997_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}},{\"sequence\":5,\"id\":\"cauliflower_cheese_55471\",\"title\":\"Cauliflower cheese\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"30 mins to 1 hour\",\"hasImage\":\"true\",\"description\":\"A simple and delicious cauliflower cheese recipe to make as a side for \\u003ca href=\\\"https://www.bbc.co.uk/food/occasions/roast_dinner\\\">roast dinners\\u003c/a> or serve as main course – however you serve it, it's comfort on a plate. \\r\\nEach serving provides 313 kcal, 12.7g protein, 15.5g carbohydrate (of which 7.2g sugars), 21.8g fat (of which 13.2g saturates), 2.3g fibre and 0.85g salt.\\r\\n\",\"chef\":{\"displayName\":\"Jenny White\",\"id\":\"jenny_white\"},\"course\":{\"id\":\"main_course\",\"title\":\"Main course\"},\"type\":\"collection\",\"url\":\"/food/recipes/cauliflower_cheese_55471\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/cauliflower_cheese_55471_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/cauliflower_cheese_55471_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/cauliflower_cheese_55471_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/cauliflower_cheese_55471_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}},{\"sequence\":6,\"id\":\"roast_new_potatoes_with_11710\",\"title\":\"Roast new potatoes with garlic and rosemary\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"30 mins to 1 hour\",\"hasImage\":\"true\",\"description\":\"Super crispy and quick to make, these golden potatoes are all cooked in one large roasting tin – which means less time washing up and more time enjoying!\",\"chef\":{\"displayName\":\"Mary Berry\",\"id\":\"mary_berry\"},\"course\":{\"id\":\"side_dishes\",\"title\":\"Side dishes\"},\"type\":\"collection\",\"url\":\"/food/recipes/roast_new_potatoes_with_11710\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/roast_new_potatoes_with_11710_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/roast_new_potatoes_with_11710_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/roast_new_potatoes_with_11710_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/roast_new_potatoes_with_11710_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}},{\"sequence\":7,\"id\":\"brussels_sprout_slaw_67898\",\"title\":\"Brussels sprout slaw \",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"no cooking required\",\"hasImage\":\"true\",\"description\":\"Brussels sprouts are delicious raw and can be used just like cabbage in a zesty, creamy, crunchy coleslaw. \\r\\n\\r\\nIf anyone says they don’t like sprouts, give them this slaw instead and ask the question again. \\r\\n\",\"chef\":{\"displayName\":\"Nadiya Hussain\",\"id\":\"nadiya\"},\"course\":{\"id\":\"side_dishes\",\"title\":\"Side dishes\"},\"type\":\"collection\",\"url\":\"/food/recipes/brussels_sprout_slaw_67898\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/brussels_sprout_slaw_67898_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/brussels_sprout_slaw_67898_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/brussels_sprout_slaw_67898_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/brussels_sprout_slaw_67898_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}},{\"sequence\":8,\"id\":\"mulled_wine_46955\",\"title\":\"Mulled wine\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"30 mins to 1 hour\",\"hasImage\":\"true\",\"description\":\"The smell of Mary Berry's mulled wine recipe is enough to make the home feel Christmassy and festive. Mary's tip for how to make mulled wine is to give it a quick boil, then a slow simmer to extract all those lovely spice and citrus flavours.\",\"chef\":{\"displayName\":\"Mary Berry\",\"id\":\"mary_berry\"},\"course\":{\"id\":\"drinks\",\"title\":\"Drinks and cocktails\"},\"type\":\"collection\",\"url\":\"/food/recipes/mulled_wine_46955\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/mulled_wine_46955_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/mulled_wine_46955_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/mulled_wine_46955_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/mulled_wine_46955_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}},{\"sequence\":9,\"id\":\"yule_log_15656\",\"title\":\"Mary Berry's yule log\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"10 to 30 mins\",\"hasImage\":\"true\",\"description\":\"Mary Berry shows you how to make a foolproof chocolate yule log a.k.a Bûche de Noël. It's utterly delicious and a perfect alternative to Christmas pudding! \",\"chef\":{\"displayName\":\"Mary Berry\",\"id\":\"mary_berry\"},\"course\":{\"id\":\"afternoon_tea\",\"title\":\"Cakes and baking\"},\"type\":\"collection\",\"url\":\"/food/recipes/yule_log_15656\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/yule_log_15656_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/yule_log_15656_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/yule_log_15656_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/yule_log_15656_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":10,\"title\":\"Vegetarian Boxing Day feast recipes\",\"path\":\"/food/menus/vegetarian_boxing_day_feast\"}}],\"collection\":[{\"sequence\":1,\"id\":\"