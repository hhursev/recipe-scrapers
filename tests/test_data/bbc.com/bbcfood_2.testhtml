":\"Recipes\",\"contentType\":\"recipe\",\"language\":\"en-GB\",\"additionalProperties\":{\"publication_date\":\"2007-03-16T00:00:00.000Z\",\"updated_date\":\"2026-02-03T11:12:46.000Z\"}}},\"userLocationData\":{\"userLocationData\":{}},\"bbcAccountSignInPromptCustomisation\":{\"options\":{\"title\":{\"en-GB\":\"One account connects all of the BBC\"},\"subTitle\":{\"en-GB\":\"Sign in is quick and easy\"},\"experimentation\":{\"experimentId\":\"test_food_aa_signin_modal\"}}},\"metadata\":{\"metadata\":{\"title\":\"Lemon posset recipe - BBC Food\",\"description\":\"Nothing could be easier than James Martin's lemon posset – it's cream, sugar and lemon juice. Add crunch with cute lemon thumbprint biscuits on the side.\",\"image\":{\"src\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/lemonpossetwithlemon_85812_16x9.jpg\",\"alt\":\"Lemon posset with lemon shortbread\"},\"openGraph\":{\"og:description\":\"Nothing could be easier than James Martin's lemon posset – it's cream, sugar and lemon juice. Add crunch with cute lemon thumbprint biscuits on the side.\",\"og:image\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_448/recipes/lemonpossetwithlemon_85812_16x9.jpg\",\"og:image:secure_url\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_448/recipes/lemonpossetwithlemon_85812_16x9.jpg\",\"og:image:width\":\"448\",\"og:image:height\":\"224\",\"og:locale\":\"en-GB\",\"og:title\":\"Lemon posset recipe\",\"og:site_name\":\"BBC Food\",\"og:type\":\"article\",\"og:image:type\":\"image/jpeg\",\"og:image:alt\":\"Lemon posset recipe\",\"og:url\":\"https://www.bbc.co.uk/food/recipes/lemonpossetwithlemon_85812\"},\"twitterCard\":{\"twitter:card\":\"summary_large_image\",\"twitter:description\":\"Nothing could be easier than James Martin's lemon posset – it's cream, sugar and lemon juice. Add crunch with cute lemon thumbprint biscuits on the side.\",\"twitter:domain\":\"www.bbc.co.uk\",\"twitter:image:src\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_448/recipes/lemonpossetwithlemon_85812_16x9.jpg\",\"twitter:site\":\"@BBCFood\",\"twitter:title\":\"Lemon posset recipe\",\"twitter:image\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_448/recipes/lemonpossetwithlemon_85812_16x9.jpg\"},\"schemaOrg\":{\"@context\":\"https://schema.org\",\"@graph\":[{\"@context\":\"https://schema.org\",\"@type\":\"Recipe\",\"description\":\"Nothing could be easier than lemon posset – it's cream, sugar and lemon juice, stirred together. But doesn't it look fancy? Add crunch with cute lemon thumbprint biscuits on the side.\\r\\nEach serving provides 542 kcal, 1.6g protein, 26.9g carbohydrate (of which 26.9g sugars), 47.5g fat (of which 29.5g saturates), 0.1g fibre and 0.07g salt.\\r\\n\",\"headline\":\"Lemon posset with lemon shortbread\",\"image\":{\"@type\":\"ImageObject\",\"width\":1600,\"height\":900,\"url\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/lemonpossetwithlemon_85812_16x9.jpg\"},\"name\":\"Lemon posset with lemon shortbread\",\"author\":{\"@type\":\"Person\",\"name\":\"James Martin\"},\"datePublished\":\"2007-03-16T00:00:00.000Z\",\"dateModified\":\"2026-02-03T11:12:46.000Z\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"BBC\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://static.files.bbci.co.uk/core/website/assets/static/webcore/bbc_blocks_84x24.5b565ac136ea8f9cb3b0f8e02eca1e0f.svg\",\"width\":84,\"height\":24}},\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingCount\":59,\"ratingValue\":4.627118644067797},\"prepTime\":\"PT2H\",\"cookTime\":\"PT30M\",\"keywords\":\"easy pudding, lemon desserts, easy christmas dessert ideas, easy festive desserts, christmas dessert, festive puds, luxurious christmas party menu, vegetarian boxing day feast, boxing day, christmas, dinner party, spring recipes , winter, posset, lemon, egg free, pregnancy friendly, vegetarian, Saturday Kitchen\",\"nutrition\":{\"calories\":\"542kcal\",\"proteinContent\":\"1.6g\",\"carbohydrateContent\":\"26.9g\",\"fatContent\":\"47.5g\",\"fiberContent\":\"0.1g\",\"saturatedFatContent\":\"29.5g\",\"sugarContent\":\"26.9g\"},\"recipeCategory\":\"Desserts\",\"recipeCuisine\":\"British\",\"recipeIngredient\":[\"600ml/21fl oz double cream\",\"150g/5½oz caster sugar\",\"2 large lemons, zest and juice only\",\"90g/3¼oz icing sugar\",\"185g/6½oz plain flour\",\"60g/2¼oz cornflour\",\"30g/1oz ground almonds\",\"250g/9oz butter, cut into cubes, plus extra for greasing\",\"2 drops almond essence\",\"75g/2½oz lemon curd\",\"icing sugar, for dusting\"],\"recipeInstructions\":[\"For the posset, place the double cream and the sugar into a large pan over a low heat. Slowly bring to the boil, then boil for 3 minutes, stirring often. Remove from the heat.\",\"Add the lemon juice and zest and whisk well. Set aside to cool.\",\"Pour the lemon posset into 6 large serving glasses and refrigerate for 1–2 hours, or until set.\",\"For the biscuits, preheat the oven to 180C/160C Fan/Gas 4 and grease a muffin tray with butter.\",\"Sift the icing sugar, flour and cornflour into the bowl of a food processor (or a large mixing bowl). Add the ground almonds.\",\"Add the butter and pulse briefly until there are no visible lumps of butter. (If making by hand, rub the butter into the dry ingredients until it resembles breadcrumbs.)\",\"Add the almond essence. Pulse again, then turn the mixture out onto a lightly floured surface and bring together to form a smooth dough.\",\"Roll the dough into 12 small balls. Place a ball in each hole of the muffin tin, flattening the tops slightly with your fingers. The dough should come about one third of the way up the side of each muffin cup. \",\"Bake for 8–12 minutes, or until they are a light golden colour.\",\"Remove from the oven, allow to cool slightly, then, using your thumb, make a small indentation into the top of each biscuit. Take care as they will be hot.\",\"Let the shortbreads cool for a few minutes, then turn the tin over and carefully tap the shortbreads out. (Be gentle, as the biscuits are fragile while they are still warm.)\",\"When all the shortbreads are baked and cooled, dust the tops with icing sugar. Fill the indentations in the biscuits with lemon curd. \",\"To serve, place the lemon possets in their glasses onto serving plates with a biscuit alongside. Sprinkle a little lemon zest on top, if you want.\"],\"recipeYield\":\"Serves 6\",\"suitableForDiet\":[\"http://schema.org/VegetarianDiet\"]},{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"url\":\"https://www.bbc.co.uk/food\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://www.bbc.co.uk/food/search?q={query}\",\"query-input\":\"required name=query\"}},{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"description\":\"Watch how to rub butter into flour by hand.\",\"duration\":\"PT30S\",\"name\":\"Rubbing in\",\"thumbnailUrl\":[\"https://ichef.bbci.co.uk/images/ic/640xn/p0btkxln.jpg\"],\"uploadDate\":\"2023-03-08T05:49:45.000Z\"},{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"description\":\"Add citrus zing to cakes, biscuits and soufflés with Mary Berry.\\n\\n-Remove the zest from the lemon using a grater, make sure you remove the bright yellow zest and none of the white pith,  which is bitter.\",\"duration\":\"PT38S\",\"name\":\"Grating lemon zest\",\"thumbnailUrl\":[\"https://ichef.bbci.co.uk/images/ic/640xn/p02bpyqc.jpg\"],\"uploadDate\":\"2024-12-19T16:01:27.000Z\"}]}}},\"bbcAccount\":{\"signInPrompt\":{\"show\":false,\"userOrigin\":null,\"ptrt\":null},\"pageType\":\"content\",\"service\":\"food\"}},\"route\":\"/food/recipes/:id\"}";</script><script nonce="LgQ2Xl3xLNsUWyPaQQMMVfsz5Usg67l77N9hkgu86VdWA2NaLj">window.__REQUEST_CONTEXT__="{\"queryStringParameters\":{},\"headers\":{\"user-agent\":\"Belfrage\",\"signedin\":\"no\",\"language\":\"en-GB\",\"is_uk\":true,\"ctx-route-spec\":\"FoodRecipePage.Webcore\",\"ctx-dark-mode-preference\":\"on\",\"country\":\"gb\",\"belfrage-time\":\"2026-07-05T10:31:28.982504Z\",\"bbc-host\":\"www.bbc.co.uk\",\"accept-encoding\":\"gzip\",\"host\":\"www.bbc.co.uk\",\"env\":\"live\",\"nonce\":\"LgQ2Xl3xLNsUWyPaQQMMVfsz5Usg67l77N9hkgu86VdWA2NaLj\"},\"isAppRoute\":false}";</script><script nonce="LgQ2Xl3xLNsUWyPaQQMMVfsz5Usg67l77N9hkgu86VdWA2NaLj">window.__ENVIRONMENT_VARIABLES__="{\"disableChartbeat\":false,\"reportingEndpoint\":\"https://webcore.bbc-reporting-api.app/report-endpoint\",\"webVitalsSampleRate\":20}";</script><script nonce="LgQ2Xl3xLNsUWyPaQQMMVfsz5Usg67l77N9hkgu86VdWA2NaLj" crossorigin="anonymous" type="application/json" id="__LOADABLE_REQUIRED_CHUNKS__">[774,8332,5077,7897,7167,7053,8926,4140,8549,6593,6612,9693,4636,7119,3744,4206,1433,8538,7040,8035,3468,5925,4358,4006,9607,9659,8915,6654,6974,2239,4005,9884,9536,387,7757,862,3914,6141,2603,910,7453,4345,1276,3383,9423,8225,3026,8082,6782,1190,3072,5570,5857,6644,5866]</script><script nonce="LgQ2Xl3xLNsUWyPaQQMMVfsz5Usg67l77N9hkgu86VdWA2NaLj" crossorigin="anonymous" type="application/json" id="__LOADABLE_REQUIRED_CHUNKS___ext">{"namedChunks":["website-containers-global-navigation-index-js","design-system-svgs-account-index-jsx","design-system-svgs-service-identifiers-index-jsx","design-system-svgs-actions-index-jsx","website-containers-product-navigation-index-js","design-system-svgs-logo-index-jsx","website-containers-recipe-finder-index-js","website-containers-recipe-index-js","design-system-svgs-arrows-index-jsx","website-containers-static-links-index-js","website-containers-link-list-index-js","website-containers-message-banner-index-js","website-containers-simple-promo-collection-index-js","design-system-svgs-playback-avkx-index-jsx","website-containers-global-footer-index-js","website-addons-document-metadata-index-jsx","website-addons-cookies-module-index-jsx"]}</script><script nonce="LgQ2Xl3xLNsUWyPaQQMMVfsz5Usg67l77N9hkgu86VdWA2NaLj" crossorigin="anonymous" type="module" async="" data-chunk="pwa" src="https://static.files.bbci.co.uk/core/bundle-vendor-optimizely.9ab47623665878697e7e