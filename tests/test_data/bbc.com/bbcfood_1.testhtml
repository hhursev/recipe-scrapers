",\"url\":\"/food/collections/slow_cooker_recipes\",\"selected\":false,\"hidden\":false},{\"label\":\"Air fryer\",\"url\":\"/food/collections/air_fryer_recipes\",\"selected\":false,\"hidden\":false},{\"label\":\"15-minute healthy\",\"url\":\"/food/collections/15_minute_healthy_meals\",\"selected\":false,\"hidden\":false},{\"label\":\"Everyday vegetarian\",\"url\":\"/food/collections/meat_free_meal_ideas\",\"selected\":false,\"hidden\":false},{\"label\":\"High protein\",\"url\":\"/food/collections/power_up_on_protein\",\"selected\":false,\"hidden\":false},{\"label\":\"Low-carb\",\"url\":\"/food/collections/low-carb_meals\",\"selected\":false,\"hidden\":false}]},{\"title\":\"Popular recipes\",\"items\":[{\"label\":\"Pancakes\",\"url\":\"/food/recipes/how_to_make_pancakes_02824\",\"selected\":false,\"hidden\":false},{\"label\":\"American pancakes\",\"url\":\"/food/recipes/fluffyamericanpancak_74828\",\"selected\":false,\"hidden\":false},{\"label\":\"Banana bread\",\"url\":\"/food/recipes/bananabread_85720\",\"selected\":false,\"hidden\":false},{\"label\":\"Apple crumble\",\"url\":\"/food/recipes/applecrumble_2971\",\"selected\":false,\"hidden\":false},{\"label\":\"Cheesecake\",\"url\":\"/food/recipes/easy_no-cook_cheesecake_89811\",\"selected\":false,\"hidden\":false},{\"label\":\"Victoria sponge\",\"url\":\"/food/recipes/mary_berrys_perfect_34317\",\"selected\":false,\"hidden\":false},{\"label\":\"Chocolate brownies\",\"url\":\"/food/recipes/richchocolatebrownie_1933\",\"selected\":false,\"hidden\":false},{\"label\":\"Chocolate cake\",\"url\":\"/food/recipes/easy_chocolate_cake_31070\",\"selected\":false,\"hidden\":false},{\"label\":\"Flapjacks\",\"url\":\"/food/recipes/flapjacks_86993\",\"selected\":false,\"hidden\":false},{\"label\":\"Yorkshire pudding\",\"url\":\"/food/recipes/yorkshire_pudding_69240\",\"selected\":false,\"hidden\":false},{\"label\":\"Butternut squash soup\",\"url\":\"/food/recipes/roasted_butternut_squash_10281\",\"selected\":false,\"hidden\":false},{\"label\":\"Cauliflower cheese\",\"url\":\"/food/recipes/cauliflower_cheese_55471\",\"selected\":false,\"hidden\":false},{\"label\":\"Cottage pie\",\"url\":\"/food/recipes/classiccottagepie_90765\",\"selected\":false,\"hidden\":false},{\"label\":\"Chilli con carne\",\"url\":\"/food/recipes/chilliconcarne_67875\",\"selected\":false,\"hidden\":false},{\"label\":\"Toad in the hole\",\"url\":\"/food/recipes/toad_in_the_hole_with_86283\",\"selected\":false,\"hidden\":false},{\"label\":\"Lasagne\",\"url\":\"/food/recipes/mary_berrys_lasagne_al_16923\",\"selected\":false,\"hidden\":false},{\"label\":\"Spaghetti bolognese \",\"url\":\"/food/recipes/easy_spaghetti_bolognese_93639\",\"selected\":false,\"hidden\":false},{\"label\":\"Spaghetti carbonara\",\"url\":\"/food/recipes/spaghettiallacarbona_73311\",\"selected\":false,\"hidden\":false}]}],\"breadcrumbs\":[],\"noJSLink\":null,\"withExpandedHitArea\":false}},\"importance\":\"PRIMARY\",\"isPersonalised\":false,\"hasFetcher\":true},\"recipe-finder?name=BBC%20Food&url=%2Ffood%2Fsearch\":{\"name\":\"recipe-finder\",\"props\":{\"name\":\"BBC Food\",\"url\":\"/food/search\"},\"data\":{},\"importance\":\"PRIMARY\",\"isPersonalised\":false,\"hasFetcher\":false},\"recipe?env=live&recipe=%7B%22id%22%3A%22baileysandchocolatec_72293%22%2C%22title%22%3A%22Irish%20cream%20and%20chocolate%20cheesecake%22%2C%22metaTitle%22%3A%22Irish%20cream%20and%20chocolate%20cheesecake%22%2C%22description%22%3A%22Use%20a%20smooth%2C%20creamy%20Irish%20liqueur%2C%20like%20Baileys%2C%20to%20give%20this%20no-bake%20cheesecake%20the%20wow%20factor.%20Top%20with%20grated%20chocolate%20or%20a%20dusting%20of%20cocoa.%20It's%20a%20fab%20make-ahead%20Christmas%20dessert%20that's%20easy%20to%20%20put%20together%20and%20always%20impresses.%22%2C%22metaDescription%22%3A%22The%20smooth%2C%20creamy%20Irish%20cream%20liqueur%20gives%20this%20no-bake%20cheesecake%20the%20wow%20factor.%20Top%20with%20grated%20chocolate%20and%20a%20dusting%20of%20cocoa.%22%2C%22thumbnail%22%3Anull%2C%22wines%22%3A%22%22%2C%22equipment%22%3Anull%2C%22servingsText%22%3A%22Serves%206%20(makes%20a%2018cm%2F7in%20cheesecake)%22%2C%22servings%22%3A12%2C%22prepTime%22%3A%22over%202%20hours%22%2C%22cookingTime%22%3A%22less%20than%2010%20mins%22%2C%22hasImage%22%3A%22true%22%2C%22status%22%3A%22published%22%2C%22lastModified%22%3A%222025-11-12T17%3A03%3A49.000Z%22%2C%22tips%22%3A%22To%20crush%20digestive%20biscuits%2C%20put%20them%20in%20a%20food%20bag%2C%20seal%20and%20bash%20with%20a%20rolling%20pin%20until%20broken%20into%20crumbs.%20Alternatively%2C%20put%20them%20in%20a%20food%20processor%20and%20pulse%20until%20crumbs%20form.%5Cr%5Cn%5Cr%5CnIt's%20easiest%20to%20remove%20the%20cheesecake%20from%20the%20tin%20if%20there's%20some%20excess%20baking%20paper%20overhanging%20the%20base.%20To%20do%20this%2C%20cut%20a%20piece%20that%20covers%20the%20base%20with%20plenty%20to%20spare.%20Push%20the%20sides%20of%20the%20tin%20onto%20the%20base%20and%20the%20paper%2C%20so%20that%20the%20excess%20baking%20paper%20is%20on%20the%20outside%20of%20the%20tin.%20When%20it%20comes%20to%20removing%20the%20cheesecake%20from%20the%20base%2C%20run%20a%20knife%20around%20the%20sides%2C%20release%20the%20clip%20and%20lift%20away%20the%20side%20of%20the%20tin.%20Remove%20the%20base%2C%20then%20hold%20the%20baking%20paper%20with%20one%20hand%20and%20slide%20the%20cheesecake%20straight%20onto%20a%20serving%20plate.%20If%20it%20doesn't%20come%20away%20easily%20use%20a%20palette%20knife%20(or%20a%20similar%20thin%2C%20flexibile%20utensil)%20to%20loosen.%5Cr%5Cn%5Cr%5CnIf%20you%20are%20making%20this%20ahead%2C%20it's%20better%20to%20either%20decorate%20with%20grated%20chocolate%20or%2C%20if%20using%20cocoa%20powder%2C%20dust%20just%20before%20serving.%20%5Cr%5Cn%5Cr%5CnSwirls%20of%20whipped%20cream%20look%20great%20if%20you%20have%20a%20piping%20bag%20and%20large%20star%20nozzle.%20Pipe%20one%20swirl%20for%20every%20portion%2C%20spaced%20evenly%20around%20the%20edge%20of%20the%20cheesecake.%20Dust%20with%20a%20little%20cocoa%20powder%20for%20a%20professional%20finish.%22%2C%22startTime%22%3Anull%2C%22endTime%22%3Anull%2C%22canonical%22%3Anull%2C%22programmeClip%22%3Anull%2C%22food%22%3A%7B%22id%22%3A%22cheesecake%22%2C%22title%22%3A%22cheesecake%22%7D%2C%22course%22%3A%7B%22id%22%3A%22desserts%22%2C%22title%22%3A%22Desserts%22%7D%2C%22cuisine%22%3A%7B%22id%22%3A%22irish%22%2C%22title%22%3A%22Irish%22%7D%2C%22programmeTopLevel%22%3Anull%2C%22programmeEpisode%22%3Anull%2C%22programmeSeries%22%3Anull%2C%22chef%22%3A%7B%22id%22%3A%22rob_burns%22%2C%22hasImage%22%3A%22false%22%2C%22displayName%22%3A%22Rob%20Burns%22%7D%2C%22datePublished%22%3A%222010-10-28T00%3A00%3A00.000Z%22%2C%22methods%22%3A%5B%7B%22technique%22%3Anull%2C%22text%22%3A%22Line%20the%20base%20of%20a%2018cm%2F7in%20springform%20tin%20with%20baking%20paper%20and%20lightly%20grease%20the%20sides%20with%20melted%20butter.%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Melt%20the%20butter%20in%20a%20saucepan%20and%20add%20the%20crushed%20digestive%20biscuits.%20Mix%20well%20until%20the%20biscuits%20have%20absorbed%20all%20the%20butter.%20%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Press%20the%20biscuit%20mixture%20into%20the%20bottom%20of%20the%20prepared%20tin%20in%20an%20even%20layer.%20Put%20in%20the%20fridge%20for%201%20hour%20or%20until%20the%20base%20is%20firm%20and%20set.%20%20%22%7D%2C%7B%22technique%22%3A%7B%22id%22%3A%22folding%22%2C%22title%22%3A%22Folding%22%2C%22hasImage%22%3A%22false%22%2C%22programmeClip%22%3A%7B%22id%22%3A%22p0bw6yh9%22%7D%7D%2C%22text%22%3A%22Meanwhile%2C%20prepare%20the%20filling.%20Lightly%20whip%20the%20cream%20cheese%20then%20beat%20in%20the%20Irish%20cream%20and%20icing%20sugar.%20Fold%20in%20the%20whipped%20cream%20and%20grated%20chocolate.%20When%20smooth%2C%20spoon%20evenly%20on%20top%20of%20the%20biscuit%20base.%20%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Return%20to%20the%20fridge%20for%20a%20further%202%20hours%2C%20or%20until%20the%20filling%20is%20set.%20%22%7D%2C%7B%22technique%22%3Anull%2C%22text%22%3A%22Once%20set%2C%20remove%20from%20the%20tin%20and%20decorate%20with%20whipped%20cream%20(if%20using)%20and%20cocoa%20powder%20or%20grated%20chocolate%20dusted%20over%20the%20top.%20%22%7D%5D%2C%22diets%22%3A%5B%7B%22id%22%3A%22egg_free%22%2C%22title%22%3A%22egg-free%22%2C%22path%22%3A%22%2Ffood%2Fdiets%2Fegg_free%22%7D%2C%7B%22id%22%3A%22vegetarian%22%2C%22title%22%3A%22vegetarian%22%2C%22path%22%3A%22%2Ffood%2Fdiets%2Fvegetarian%22%7D%5D%2C%22collections%22%3A%5B%7B%22id%22%3A%221_our_best_cheesecake_recipes%22%2C%22hasImage%22%3A%22false%22%2C%22title%22%3A%22Our%20best%20cheesecake%20recipes%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%22alternative_christmas_cakes%22%2C%22hasImage%22%3A%22false%22%2C%22title%22%3A%22Alternative%20Christmas%20cake%20recipes%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%22boozy_bakes%22%2C%22hasImage%22%3A%22true%22%2C%22title%22%3A%22Boozy%20puddings%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%22christmas_baking%22%2C%22hasImage%22%3A%22true%22%2C%22title%22%3A%22Christmas%20baking%20recipes%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%22christmas_cheesecake_recipes%22%2C%22hasImage%22%3A%22false%22%2C%22title%22%3A%22Christmas%20cheesecake%20recipes%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%22christmas_chocolate%22%2C%22hasImage%22%3A%22false%22%2C%22title%22%3A%22Christmas%20chocolate%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%22christmas_twists%22%2C%22hasImage%22%3A%22false%22%2C%22title%22%3A%22Easy%20Christmas%20dessert%20ideas%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%22%3A%22delicious_desserts%22%2C%22hasImage%22%3A%22true%22%2C%22title%22%3A%22Decadent%20dessert%20recipes%22%2C%22isMenu%22%3A%22false%22%2C%22chef%22%3Anull%7D%2C%7B%22id%