nique\":null,\"foods\":[{\"id\":\"chocolate\",\"isKeyIngredient\":\"false\",\"title\":\"chocolate\",\"supermarketLocation\":\"Biscuits, snacks and sweets\"}],\"url\":{\"text\":\"chocolate\",\"subjects\":[\"chocolate\",\"chocolate\"],\"path\":\"/food/chocolate\"}}]},{\"title\":\"To decorate\",\"ingredients\":[{\"text\":\"200ml/7¼oz double cream, whipped (optional)\",\"technique\":null,\"foods\":[{\"id\":\"double_cream\",\"isKeyIngredient\":\"false\",\"title\":\"double cream\",\"supermarketLocation\":\"Dairy, eggs and chilled\"}],\"url\":{\"text\":\"double cream\",\"subjects\":[\"double cream\"],\"path\":\"/food/double_cream\"}},{\"text\":\"cocoa powder or more grated chocolate\",\"technique\":null,\"foods\":[{\"id\":\"chocolate\",\"isKeyIngredient\":\"false\",\"title\":\"chocolate\",\"supermarketLocation\":\"Biscuits, snacks and sweets\"},{\"id\":\"cocoa\",\"isKeyIngredient\":\"false\",\"title\":\"cocoa powder\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"cocoa powder\",\"subjects\":[\"cocoa powder\"],\"path\":\"/food/cocoa\"}}]}],\"menu\":{\"id\":\"vegetarian_st_patricks_day_menu\",\"title\":\"Vegetarian St Patrick's Day menu\",\"description\":\"You can celebrate St Patrick's Day with a marvelous meat-free menu. Fill up on delicious Irish food and wash it down with a stout or two. Slainte!\",\"name\":\"Vegetarian St Patrick's Day menu\",\"serves\":\"\",\"chef\":null,\"keyRecipe\":{\"hasImage\":\"true\",\"id\":\"vegetariancottagepie_92035\",\"title\":\"Vegetarian cottage pie\"},\"path\":\"/food/menus/vegetarian_st_patricks_day_menu\"},\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/baileysandchocolatec_72293_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/baileysandchocolatec_72293_16x9.jpg.webp\",\"hero\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/baileysandchocolatec_72293_16x9.jpg\",\"aceHero\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipe