is%20mouthwatering%20mango%20dessert%20is%20an%20Indian%20take%20on%20a%20traditional%20Thanksgiving%20pie.%20%5Cr%5Cn%5Cr%5CnFor%20this%20recipe%2C%20you%20will%20need%20two%2023cm%2F9in%20metal%20pie%20tins.%22%2C%22availabilityEnd%22%3A%222024-05-25T00%3A00%3A00.000Z%22%2C%22diets%22%3A%5B%7B%22id%22%3A%22egg_free%22%7D%2C%7B%22id%22%3A%22nut_free%22%7D%5D%2C%22isQuickAndEasy%22%3A%22false%22%2C%22chef%22%3A%7B%22id%22%3A%22samin_nosrat%22%2C%22hasImage%22%3A%22false%22%2C%22displayName%22%3A%22Samin%20Nosrat%22%7D%2C%22relations%22%3A%7B%22count%22%3A77%2C%22title%22%3A%22cheesecake%20recipes%22%2C%22path%22%3A%22%2Ffood%2Fcheesecake%22%7D%2C%22type%22%3A%22dish%22%2C%22url%22%3A%22%2Ffood%2Frecipes%2Fmango_pie_18053%22%2C%22image%22%3A%7B%22template%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_%7Bwidth%7D%2Frecipes%2Fmango_pie_18053_16x9.jpg%22%2C%22aceTemplate%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F%7Bwidth%7D%2Ffood%2Frecipes%2Fmango_pie_18053_16x9.jpg.webp%22%2C%22thumbnail%22%3A%22https%3A%2F%2Fichef.bbci.co.uk%2Ffood%2Fic%2Ffood_16x9_1600%2Frecipes%2Fmango_pie_18053_16x9.jpg%22%2C%22aceThumbnail%22%3A%22https%3A%2F%2Fichef.bbc.co.uk%2Face%2Fstandard%2F1600%2Ffood%2Frecipes%2Fmango_pie_18053_16x9.jpg.webp%22%2C%22sizes%22%3A%5B160%2C208%2C320%2C448%2C608%2C832%2C1600%5D%7D%7D%5D%7D%7D\":{\"name\":\"recipe\",\"props\":{\"env\":\"live\",\"recipe\":{\"id\":\"baileysandchocolatec_72293\",\"title\":\"Irish cream and chocolate cheesecake\",\"metaTitle\":\"Irish cream and chocolate cheesecake\",\"description\":\"Use a smooth, creamy Irish liqueur, like Baileys, to give this no-bake cheesecake the wow factor. Top with grated chocolate or a dusting of cocoa. It's a fab make-ahead Christmas dessert that's easy to  put together and always impresses.\",\"metaDescription\":\"The smooth, creamy Irish cream liqueur gives this no-bake cheesecake the wow factor. Top with grated chocolate and a dusting of cocoa.\",\"thumbnail\":null,\"wines\":\"\",\"equipment\":null,\"servingsText\":\"Serves 6 (makes a 18cm/7in cheesecake)\",\"servings\":12,\"prepTime\":\"over 2 hours\",\"cookingTime\":\"less than 10 mins\",\"hasImage\":\"true\",\"status\":\"published\",\"lastModified\":\"2025-11-12T17:03:49.000Z\",\"tips\":\"To crush digestive biscuits, put them in a food bag, seal and bash with a rolling pin until broken into crumbs. Alternatively, put them in a food processor and pulse until crumbs form.\\r\\n\\r\\nIt's easiest to remove the cheesecake from the tin if there's some excess baking paper overhanging the base. To do this, cut a piece that covers the base with plenty to spare. Push the sides of the tin onto the base and the paper, so that the excess baking paper is on the outside of the tin. When it comes to removing the cheesecake from the base, run a knife around the sides, release the clip and lift away the side of the tin. Remove the base, then hold the baking paper with one hand and slide the cheesecake straight onto a serving plate. If it doesn't come away easily use a palette knife (or a similar thin, flexibile utensil) to loosen.\\r\\n\\r\\nIf you are making this ahead, it's better to either decorate with grated chocolate or, if using cocoa powder, dust just before serving. \\r\\n\\r\\nSwirls of whipped cream look great if you have a piping bag and large star nozzle. Pipe one swirl for every portion, spaced evenly around the edge of the cheesecake. Dust with a little cocoa powder for a professional finish.\",\"startTime\":null,\"endTime\":null,\"canonical\":null,\"programmeClip\":null,\"food\":{\"id\":\"cheesecake\",\"title\":\"cheesecake\"},\"course\":{\"id\":\"desserts\",\"title\":\"Desserts\"},\"cuisine\":{\"id\":\"irish\",\"title\":\"Irish\"},\"programmeTopLevel\":null,\"programmeEpisode\":null,\"programmeSeries\":null,\"chef\":{\"id\":\"rob_burns\",\"hasImage\":\"false\",\"displayName\":\"Rob Burns\"},\"datePublished\":\"2010-10-28T00:00:00.000Z\",\"methods\":[{\"technique\":null,\"text\":\"Line the base of a 18cm/7in springform tin with baking paper and lightly grease the sides with melted butter.\"},{\"technique\":null,\"text\":\"Melt the butter in a saucepan and add the crushed digestive biscuits. Mix well until the biscuits have absorbed all the butter. \"},{\"technique\":null,\"text\":\"Press the biscuit mixture into the bottom of the prepared tin in an even layer. Put in the fridge for 1 hour or until the base is firm and set.  \"},{\"technique\":{\"id\":\"folding\",\"title\":\"Folding\",\"hasImage\":\"false\",\"programmeClip\":{\"id\":\"p0bw6yh9\"}},\"text\":\"Meanwhile, prepare the filling. Lightly whip the cream cheese then beat in the Irish cream and icing sugar. Fold in the whipped cream and grated chocolate. When smooth, spoon evenly on top of the biscuit base. \"},{\"technique\":null,\"text\":\"Return to the fridge for a further 2 hours, or until the filling is set. \"},{\"technique\":null,\"text\":\"Once set, remove from the tin and decorate with whipped cream (if using) and cocoa powder or grated chocolate dusted over the top. \"}],\"diets\":[{\"id\":\"egg_free\",\"title\":\"egg-free\",\"path\":\"/food/diets/egg_free\"},{\"id\":\"vegetarian\",\"title\":\"vegetarian\",\"path\":\"/food/diets/vegetarian\"}],\"collections\":[{\"id\":\"1_our_best_cheesecake_recipes\",\"hasImage\":\"false\",\"title\":\"Our best cheesecake recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"alternative_christmas_cakes\",\"hasImage\":\"false\",\"title\":\"Alternative Christmas cake recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"boozy_bakes\",\"hasImage\":\"true\",\"title\":\"Boozy puddings\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_baking\",\"hasImage\":\"true\",\"title\":\"Christmas baking recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_cheesecake_recipes\",\"hasImage\":\"false\",\"title\":\"Christmas cheesecake recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_chocolate\",\"hasImage\":\"false\",\"title\":\"Christmas chocolate\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_twists\",\"hasImage\":\"false\",\"title\":\"Easy Christmas dessert ideas\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"delicious_desserts\",\"hasImage\":\"true\",\"title\":\"Decadent dessert recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"eurovision_party_ideas\",\"hasImage\":\"true\",\"title\":\"Eurovision party ideas\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"fathers_day_cakes\",\"hasImage\":\"false\",\"title\":\"Father's Day cakes and bakes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"festive_puds\",\"hasImage\":\"false\",\"title\":\"Festive puds\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"irresistable_irish_food\",\"hasImage\":\"true\",\"title\":\"Irresistible Irish food\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"luxury_christmas_desserts\",\"hasImage\":\"true\",\"title\":\"Luxury Christmas desserts\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"no-bake_cheesecakes\",\"hasImage\":\"true\",\"title\":\"No-bake cheesecakes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"no-cook_christmas_recipes\",\"hasImage\":\"false\",\"title\":\"No-cook Christmas recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"no-cook_desserts\",\"hasImage\":\"true\",\"title\":\"No-cook Christmas desserts\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"vegetarian_st_patricks_day_menu\",\"hasImage\":\"true\",\"title\":\"Vegetarian St Patrick's Day menu\",\"isMenu\":\"true\",\"chef\":null}],\"seasons\":null,\"occasions\":[{\"id\":\"birthday_party\",\"title\":\"Birthday party recipes\"},{\"id\":\"christmas\",\"title\":\"Christmas recipes and menus\"},{\"id\":\"dinner_party_recipes_and_ideas\",\"title\":\"Dinner party recipes and ideas\"},{\"id\":\"mothers_day\",\"title\":\"Mother's Day recipes\"},{\"id\":\"st_patricks_day\",\"title\":\"St Patrick's Day recipes\"}],\"stages\":[{\"title\":null,\"ingredients\":[{\"text\":\"100g/3½oz butter, plus extra for greasing\",\"technique\":