ipes/pumpkincheesecake_8826_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/pumpkincheesecake_8826_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]}},{\"course\":{\"id\":\"desserts\",\"title\":\"Desserts\"},\"id\":\"mango_pie_18053\",\"hasImage\":\"true\",\"title\":\"Mango pie\",\"lastModified\":\"2026-05-08T16:04:11.000Z\",\"seasons\":[],\"food\":{\"id\":\"cheesecake\",\"title\":\"cheesecake\"},\"description\":\"This mouthwatering mango dessert is an Indian take on a traditional Thanksgiving pie. \\r\\n\\r\\nFor this recipe, you will need two 23cm/9in metal pie tins.\",\"availabilityEnd\":\"2024-05-25T00:00:00.000Z\",\"diets\":[{\"id\":\"egg_free\"},{\"id\":\"nut_free\"}],\"isQuickAndEasy\":\"false\",\"chef\":{\"id\":\"samin_nosrat\",\"hasImage\":\"false\",\"displayName\":\"Samin Nosrat\"},\"relations\":{\"count\":77,\"title\":\"cheesecake recipes\",\"path\":\"/food/cheesecake\"},\"type\":\"dish\",\"url\":\"/food/recipes/mango_pie_18053\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/mango_pie_18053_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/mango_pie_18053_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/mango_pie_18053_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/mango_pie_18053_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]}}]}}},\"data\":{},\"importance\":\"PRIMARY\",\"isPersonalised\":false,\"hasFetcher\":false},\"static-links?lazyLoadImages=true&urn=urn%3Abbc%3Atipo%3Alist%3A035d1944-57bd-494e-a37f-f33260e46601\":{\"name\":\"static-links\",\"props\":{\"urn\":\"urn:bbc:tipo:list:035d1944-57bd-494e-a37f-f33260e46601\",\"lazyLoadImages\":true},\"data\":{\"staticLinks\":[{\"url\":\"https://www.instagram.com/bbcfood/?hl=en\",\"text\":\"Instagram\",\"image\":{\"src\":\"https://ichef.bbci.co.uk/ace/standard/320/cpsprodpb/7509/live/5f672cc0-e6cf-11ee-941