[{\"name\":\"analytics\",\"importance\":\"TERTIARY\",\"props\":[{\"__typename\":\"StoreReader\",\"name\":\"page\",\"lookup\":\"page\",\"store\":\"analytics\"},{\"__typename\":\"StoreReader\",\"name\":\"title\",\"lookup\":\"title\",\"store\":\"analytics\"},{\"__typename\":\"StoreReader\",\"name\":\"sections\",\"lookup\":\"sections\",\"store\":\"analytics\"},{\"__typename\":\"StoreReader\",\"name\":\"type\",\"lookup\":\"type\",\"store\":\"analytics\"},{\"__typename\":\"StoreReader\",\"name\":\"isUkCombined\",\"lookup\":\"userLocationData.isUkCombined\",\"store\":\"userLocationData\"},{\"__typename\":\"LiteralProp\",\"name\":\"skipLocationCheck\",\"value\":true},{\"__typename\":\"StoreReader\",\"name\":\"authors\",\"lookup\":\"authors\",\"store\":\"analytics\"},{\"__typename\":\"LiteralProp\",\"name\":\"isAppRoute\",\"value\":false}]},{\"name\":\"document-metadata\",\"importance\":\"PRIMARY\",\"props\":[{\"__typename\":\"StoreReader\",\"name\":\"title\",\"lookup\":\"metadata.title\",\"store\":\"metadata\"},{\"__typename\":\"StoreReader\",\"name\":\"description\",\"lookup\":\"metadata.description\",\"store\":\"metadata\"},{\"__typename\":\"StoreReader\",\"name\":\"openGraph\",\"lookup\":\"metadata.openGraph\",\"store\":\"metadata\"},{\"__typename\":\"StoreReader\",\"name\":\"twitterCard\",\"lookup\":\"metadata.twitterCard\",\"store\":\"metadata\"},{\"__typename\":\"StoreReader\",\"name\":\"schemaOrg\",\"lookup\":\"metadata.schemaOrg\",\"store\":\"metadata\"},{\"__typename\":\"LiteralProp\",\"name\":\"serviceIcons\",\"value\":\"food\"},{\"__typename\":\"LiteralProp\",\"name\":\"linkTags\",\"value\":[{\"rel\":\"canonical\",\"href\":\"https://www.bbc.co.uk/food/recipes/baileysandchocolatec_72293\"}]}]},{\"name\":\"web-vitals\",\"importance\":\"TERTIARY\",\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"reportParams\",\"value\":{\"pageType\":\"webcore-food\"}}]},{\"name\":\"cookies-module\",\"importance\":\"PRIMARY\",\"props\":[]}],\"entry\":{\"levers\":{\"servicePalette\":\"foodLight\",\"corePalette\":\"light\",\"fontPalette\":\"sansSimple\"},\"stores\":[{\"name\":\"analytics\",\"type\":\"InMemory\",\"initialState\":{\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"page\",\"value\":{\"contentId\":\"urn:bbc:food:recipe:baileysandchocolatec_72293\",\"name\":\"\",\"destination\":\"FOOD\",\"producer\":\"BBC_FOOD\",\"section\":\"Recipes\",\"contentType\":\"recipe\",\"language\":\"en-GB\",\"additionalProperties\":{\"publication_date\":\"2010-10-28T00:00:00.000Z\",\"updated_date\":\"2025-11-12T17:03:49.000Z\"}}}]}},{\"name\":\"userLocationData\",\"type\":\"InMemory\",\"initialState\":{\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"userLocationData\",\"value\":{}}]}},{\"name\":\"bbcAccountSignInPromptCustomisation\",\"type\":\"InMemory\",\"initialState\":{\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"options\",\"value\":{\"title\":{\"en-GB\":\"One account connects all of the BBC\"},\"subTitle\":{\"en-GB\":\"Sign in is quick and easy\"},\"experimentation\":{\"experimentId\":\"test_food_aa_signin_modal\"}}}]}},{\"name\":\"metadata\",\"type\":\"InMemory\",\"initialState\":{\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"metadata\",\"value\":{\"title\":\"Irish cream and chocolate cheesecake recipe - BBC Food\",\"description\":\"The smooth, creamy Irish cream liqueur gives this no-bake cheesecake the wow factor. Top with grated chocolate and a dusting of cocoa.\",\"image\":{\"src\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/baileysandchocolatec_72293_16x9.jpg\",\"alt\":\"Irish cream and chocolate cheesecake\"},\"openGraph\":{\"og:description\":\"The smooth, creamy Irish cream liqueur gives this no-bake cheesecake the wow factor. Top with grated chocolate and a dusting of cocoa.\",\"og:image\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_448/recipes/baileysandchocolatec_72293_16x9.jpg\",\"og:image:secure_url\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_448/recipes/baileysandchocolatec_72293_16x9.jpg\",\"og:image:width\":\"448\",\"og:image:height\":\"224\",\"og:locale\":\"en-GB\",\"og:title\":\"Irish cream and chocolate cheesecake recipe\",\"og:site_name\":\"BBC Food\",\"og:type\":\"article\",\"og:image:type\":\"image/jpeg\",\"og:image:alt\":\"Irish cream and chocolate cheesecake recipe\",\"og:url\":\"https://www.bbc.co.uk/food/recipes/baileysandchocolatec_72293\"},\"twitterCard\":{\"twitter:card\":\"summary_large_image\",\"twitter:description\":\"The smooth, creamy Irish cream liqueur gives this no-bake cheesecake the wow factor. Top with grated chocolate and a dusting of cocoa.\",\"twitter:domain\":\"www.bbc.co.uk\",\"twitter:image:src\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_448/recipes/baileysandchocolatec_72293_16x9.jpg\",\"twitter:site\":\"@BBCFood\",\"twitter:title\":\"Irish cream and chocolate cheesecake recipe\",\"twitter:image\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_448/recipes/baileysandchocolatec_72293_16x9.jpg\"},\"schemaOrg\":{\"@context\":\"https://schema.org\",\"@graph\":[{\"@context\":\"https://schema.org\",\"@type\":\"Recipe\",\"description\":\"Use a smooth, creamy Irish liqueur, like Baileys, to give this no-bake cheesecake the wow factor. Top with grated chocolate or a dusting of cocoa. It's a fab make-ahead Christmas dessert that's easy to  put together and always impresses.\",\"headline\":\"Irish cream and chocolate cheesecake\",\"image\":{\"@type\":\"ImageObject\",\"width\":1600,\"height\":900,\"url\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/baileysandchocolatec_72293_16x9.jpg\"},\"name\":\"Irish cream and chocolate cheesecake\",\"author\":{\"@type\":\"Person\",\"name\":\"Rob Burns\"},\"datePublished\":\"2010-10-28T00:00:00.000Z\",\"dateModified\":\"2025-11-12T17:03:49.000Z\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"BBC\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://static.files.bbci.co.uk/core/website/assets/static/webcore/bbc_blocks_84x24.5b565ac136ea8f9cb3b0f8e02eca1e0f.svg\",\"width\":84,\"height\":24}},\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingCount\":128,\"ratingValue\":4.3671875},\"prepTime\":\"PT2H\",\"cookTime\":\"PT10M\",\"keywords\":\"our best cheesecake, alternative christmas cake, boozy puddings, christmas baking, christmas cheesecake, christmas chocolate, easy christmas dessert ideas, decadent dessert, eurovision party ideas, father's day cakes and bakes, festive puds, irresistible irish food, luxury christmas desserts, no-bake cheesecakes, no-cook christmas, no-cook christmas desserts, vegetarian st patrick's day menu, birthday party, christmas, dinner party, mother's day, st patrick's day, cheesecake, cream cheese, egg free, vegetarian\",\"recipeCategory\":\"Desserts\",\"recipeCuisine\":\"Irish\",\"recipeIngredient\":[\"100g/3½oz butter, plus extra for greasing\",\"250g/8¾oz digestive biscuits, crushed\",\"600g/1lb 5oz full-fat cream cheese\",\"25ml/1fl oz Irish cream liqueur, such as Baileys\",\"100ml/3½oz icing sugar\",\"300ml/10½oz double cream, whipped\",\"100g/3½oz grated chocolate (dark or milk chocolate)\",\"200ml/7¼oz double cream, whipped (optional)\",\"cocoa powder or more grated chocolate\"],\"recipeInstructions\":[\"Line the base of a 18cm/7in springform tin with baking paper and lightly grease the sides with melted butter.\",\"Melt the butter in a saucepan and add the crushed digestive biscuits. Mix well until the biscuits have absorbed all the butter. \",\"Press the biscuit mixture into the bottom of the prepared tin in an even layer. Put in the fridge for 1 hour or until the base is firm and set.  \",\"Meanwhile, prepare the filling. Lightly whip the cream cheese then beat in the Irish cream and icing sugar. Fold in the whipped cream and grated chocolate. When smooth, spoon evenly on top of the biscuit base. \",\"Return to the fridge for a further 2 hours, or until the filling is set. \",\"Once set, remove from the tin and decorate with whipped cream (if using) and cocoa powder or grated chocolate dusted over the top. \"],\"recipeYield\":\"Serves 6 (makes a 18cm/7in cheesecake)\",\"suitableForDiet\":[\"http://schema.org/VegetarianDiet\"]},{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"url\":\"https://www.bbc.co.uk/food\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://www.bbc.co.uk/food/search?q={query}\",\"query-input\":\"required name=query\"}},{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"description\":\"A fool-proof way to fold in flour, keeping your bakes light and airy.\",\"duration\":\"PT35S\",\"name\":\"Folding\",\"thumbnailUrl\":[\"https://ichef.bbci.co.uk/images/ic/640xn/p0bw72v0.jpg\"],\"uploadDate\":\"2025-01-20T10:39:53.000Z\"},{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"description\":\"Learn how to whip cream by following this simple video from BBC Food.\",\"duration\":\"PT57S\",\"name\":\"How to whip cream\",\"thumbnailUrl\":[\"https://ichef.bbci.co.uk/images/ic/640xn/p07f404k.jpg\"],\"uploadDate\":\"2025-01-20T17:29:09.000Z\"}]}}}]}},{\"name\":\"bbcAccount\",\"type\":\"InMemory\",\"initialState\":{\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"signInPrompt\",\"value\":{\"show\":false,\"userOrigin\":null,\"ptrt\":null}},{\"__typename\":\"LiteralProp\",\"name\":\"pageType\",\"value\":\"content\"},{\"__typename\":\"LiteralProp\",\"name\":\"service\",\"value\":\"food\"}]}}],\"pageLayout\":{\"name\":\"ThreeColumnWithHero\"},\"pageContent\":{\"zones\":[{\"name\":\"top\",\"additionalProperties\":{},\"landmarks\":[{\"element\":\"header\",\"containers\":[{\"name\":\"consent-banner\",\"importance\":\"TERTIARY\",\"hasFetcher\":false,\"props\":[]},{\"name\":\"global-navigation\",\"importance\":\"PRIMARY\",\"hasFetcher\":true,\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"showServiceIdentifiers\",\"value\":false},{\"__typename\":\"LiteralProp\",\"name\":\"country\",\"value\":\"us\"},{\"__typename\":\"StoreReader\",\"lookup\":\"page.destination\",\"name\":\"currentPageAnalyticsDestination\",\"store\":\"analytics\"},{\"__typename\":\"StoreReader\",\"name\":\"showServiceIdentifiers\",\"store\":\"global-navigation\",\"lookup\":\"showServiceIdentifiers\"},{\"__typename\":\"StoreReader\",\"name\":\"pageAnalytics\",\"store\":\"analytics\",\"lookup\":\"page\"},{\"__typename\":\"StoreWriter\",\"name\":\"setPageAnalytics\",\"store\":\"analytics\",\"lookup\":\"page\"}],\"fetchParams\":[{\"__typename\":\"LiteralProp\",\"name\":\"country\",\"value\":\"us\"},{\"__typename\":\"LiteralProp\",\"name\":\"language\",\"value\":\"en-GB\"},{\"__typename\":\"RouteParam\",\"name\":\"service\",\"lookup\":\"service\"},{\"__typename\":\"LiteralProp\",\"name\":\"service\",\"value\":\"food\"},{\"__typename\":\"StoreReader\",\"name\":\"variant\",\"store\":\"global-navigation\",\"lookup\":\"variant\"}]},{\"name\":\"product-navigation\",\"importance\":\"PRIMARY\",\"hasFetcher\":true,\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"product\",\"value\":\"food\"},{\"__typename\":\"LiteralProp\",\"name\":\"assetUri\",\"value\":\"/food/recipes/baileysandchocolatec_72293\"},{\"__typename\":\"LiteralProp\",\"name\":\"menuLabel\",\"value\":\"All Food\"},{\"__typename\":\"LiteralProp\",\"name\":\"showProductNavigation\",\"value\":true}]},{\"name\":\"recipe-finder\",\"importance\":\"PRIMARY\",\"props\":[{\"__typename\":\"LiteralProp\",\"name\":\"name\",\"value\":\"BBC Food\"},{\"__typename\":\"LiteralProp\",\"name\":\"url\",\"value\":\"/food/search\"}]}]}]},{\"name\":\"hero\",\"additionalProperties\":{},\"landmarks\":[]},{\"name\":\"before\",\"additionalProperties\":{},\"landmarks\":[]},{\"name\":\"standard\",\"additionalProperties\":{},\"landmarks\":[{\"element\":\"main\",\"containers\":[{\"name\":\"sign-in-prompt\",\"importance\":\"TERTIARY\",\"hasFetcher\":false,\"props\":[{\"__typename\":\"StoreReader\",\"name\":\"signInPrompt\",\"lookup\":\"signInPrompt\",\"store\":\"bbcAccount\"},{\"__typename\":\"StoreReader\",\"name\":\"pageType\",\"lookup\":\"pageType\",\"store\":\"bbcAccount\"},{\"__typename\":\"StoreReader\",\"name\":\"service\",\"lookup\":\"service\",\"store\":\"bbcAccount\"},{\"__typename\":\"StoreReader\",\"name\":\"signInPromptCustomisation\",\"lookup\":\"options\",\"store\":\"bbcAccountSignInPromptCustomisation\"},{\"__typename\":\"LiteralProp\",\"name\":\"useExperimentCountingLogic\",\"value\":false},{\"__typename\":\"LiteralProp\",\"name\":\"disableAutomaticSignInPrompt\",\"value\":false},{\"__typename\":\"StoreWriter\",\"name\":\"setSignInPrompt\",\"lookup\":\"signInPrompt\",\"store\":\"bbcAccount\"}]},{\"name\":\"recipe\",\"importance\":\"PRIMARY\",\"props\":[{\"__typename\":\"StoreWriter\",\"name\":\"setSignInPrompt\",\"lookup\":\"signInPrompt\",\"store\":\"bbcAccount\"},{\"__typename\":\"LiteralProp\",\"name\":\"env\",\"value\":\"live\"},{\"__typename\":\"LiteralProp\",\"name\":\"recipe\",\"value\":{\"id\":\"baileysandchocolatec_72293\",\"title\":\"Irish cream and chocolate cheesecake\",\"metaTitle\":\"Irish cream and chocolate cheesecake\",\"description\":\"Use a smooth, creamy Irish liqueur, like Baileys, to give this no-bake cheesecake the wow factor. Top with grated chocolate or a dusting of cocoa. It's a fab make-ahead Christmas dessert that's easy to  put together and always impresses.\",\"metaDescription\":\"The smooth, creamy Irish cream liqueur gives this no-bake cheesecake the wow factor. Top with grated chocolate and a dusting of cocoa.\",\"thumbnail\":null,\"wines\":\"\",\"equipment\":null,\"servingsText\":\"Serves 6 (makes a 18cm/7in cheesecake)\",\"servings\":12,\"prepTime\":\"over 2 hours\",\"cookingTime\":\"less than 10 mins\",\"hasImage\":\"true\",\"status\":\"published\",\"lastModified\":\"2025-11-12T17:03:49.000Z\",\"tips\":\"To crush digestive biscuits, put them in a food bag, seal and bash with a rolling pin until broken into crumbs. Alternatively, put them in a food processor and pulse until crumbs form.\\r\\n\\r\\nIt's easiest to remove the cheesecake from the tin if there's some excess baking paper overhanging the base. To do this, cut a piece that covers the base with plenty to spare. Push the sides of the tin onto the base and the paper, so that the excess baking paper is on the outside of the tin. When it comes to removing the cheesecake from the base, run a knife around the sides, release the clip and lift away the side of the tin. Remove the base, then hold the baking paper with one hand and slide the cheesecake straight onto a serving plate. If it doesn't come away easily use a palette knife (or a similar thin, flexibile utensil) to loosen.\\r\\n\\r\\nIf you are making this ahead, it's better to either decorate with grated chocolate or, if using cocoa powder, dust just before serving. \\r\\n\\r\\nSwirls of whipped cream look great if you have a piping bag and large star nozzle. Pipe one swirl for every portion, spaced evenly around the edge of the cheesecake. Dust with a little cocoa powder for a professional finish.\",\"startTime\":null,\"endTime\":null,\"canonical\":null,\"programmeClip\":null,\"food\":{\"id\":\"cheesecake\",\"title\":\"cheesecake\"},\"course\":{\"id\":\"desserts\",\"title\":\"Desserts\"},\"cuisine\":{\"id\":\"irish\",\"title\":\"Irish\"},\"programmeTopLevel\":null,\"programmeEpisode\":null,\"programmeSeries\":null,\"chef\":{\"id\":\"rob_burns\",\"hasImage\":\"false\",\"displayName\":\"Rob Burns\"},\"datePublished\":\"2010-10-28T00:00:00.000Z\",\"methods\":[{\"technique\":null,\"text\":\"Line the base of a 18cm/7in springform tin with baking paper and lightly grease the sides with melted butter.\"},{\"technique\":null,\"text\":\"Melt the butter in a saucepan and add the crushed digestive biscuits. Mix well until the biscuits have absorbed all the butter. \"},{\"technique\":null,\"text\":\"Press the biscuit mixture into the bottom of the prepared tin in an even layer. Put in the fridge for 1 hour or until the base is firm and set.  \"},{\"technique\":{\"id\":\"folding\",\"title\":\"Folding\",\"hasImage\":\"false\",\"programmeClip\":{\"id\":\"p0bw6yh9\"}},\"text\":\"Meanwhile, prepare the filling. Lightly whip the cream cheese then beat in the Irish cream and icing sugar. Fold in the whipped cream and grated chocolate. When smooth, spoon evenly on top of the biscuit base. \"},{\"technique\":null,\"text\":\"Return to the fridge for a further 2 hours, or until the filling is set. \"},{\"technique\":null,\"text\":\"Once set, remove from the tin and decorate with whipped cream (if using) and cocoa powder or grated chocolate dusted over the top. \"}],\"diets\":[{\"id\":\"egg_free\",\"title\":\"egg-free\",\"path\":\"/food/diets/egg_free\"},{\"id\":\"vegetarian\",\"title\":\"vegetarian\",\"path\":\"/food/diets/vegetarian\"}],\"collections\":[{\"id\":\"1_our_best_cheesecake_recipes\",\"hasImage\":\"false\",\"title\":\"Our best cheesecake recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"alternative_christmas_cakes\",\"hasImage\":\"false\",\"title\":\"Alternative Christmas cake recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"boozy_bakes\",\"hasImage\":\"true\",\"title\":\"Boozy puddings\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_baking\",\"hasImage\":\"true\",\"title\":\"Christmas baking recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_cheesecake_recipes\",\"hasImage\":\"false\",\"title\":\"Christmas cheesecake recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_chocolate\",\"hasImage\":\"false\",\"title\":\"Christmas chocolate\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"christmas_twists\",\"hasImage\":\"false\",\"title\":\"Easy Christmas dessert ideas\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"delicious_desserts\",\"hasImage\":\"true\",\"title\":\"Decadent dessert recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"eurovision_party_ideas\",\"hasImage\":\"true\",\"title\":\"Eurovision party ideas\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"fathers_day_cakes\",\"hasImage\":\"false\",\"title\":\"Father's Day cakes and bakes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"festive_puds\",\"hasImage\":\"false\",\"title\":\"Festive puds\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"irresistable_irish_food\",\"hasImage\":\"true\",\"title\":\"Irresistible Irish food\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"luxury_christmas_desserts\",\"hasImage\":\"true\",\"title\":\"Luxury Christmas desserts\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"no-bake_cheesecakes\",\"hasImage\":\"true\",\"title\":\"No-bake cheesecakes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"no-cook_christmas_recipes\",\"hasImage\":\"false\",\"title\":\"No-cook Christmas recipes\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"no-cook_desserts\",\"hasImage\":\"true\",\"title\":\"No-cook Christmas desserts\",\"isMenu\":\"false\",\"chef\":null},{\"id\":\"vegetarian_st_patricks_day_menu\",\"hasImage\":\"true\",\"title\":\"Vegetarian St Patrick's Day menu\",\"isMenu\":\"true\",\"chef\":null}],\"seasons\":null,\"occasions\":[{\"id\":\"birthday_party\",\"title\":\"Birthday party recipes\"},{\"id\":\"christmas\",\"title\":\"Christmas recipes and menus\"},{\"id\":\"dinner_party_recipes_and_ideas\",\"title\":\"Dinner party recipes and ideas\"},{\"id\":\"mothers_day\",\"title\":\"Mother's Day recipes\"},{\"id\":\"st_patricks_day\",\"title\":\"St Patrick's Day recipes\"}],\"stages\":[{\"title\":null,\"ingredients\":[{\"text\":\"100g/3½oz butter, plus extra for greasing\",\"technique\":null,\"foods\":[{\"id\":\"butter\",\"isKeyIngredient\":\"false\",\"title\":\"butter\",\"supermarketLocation\":\"Dairy, eggs and chilled\"}],\"url\":{\"text\":\"butter\",\"subjects\":[\"butter\"],\"path\":\"/food/butter\"}},{\"text\":\"250g/8¾oz digestive biscuits, crushed\",\"technique\":null,\"foods\":[{\"id\":\"digestive_biscuit\",\"isKeyIngredient\":\"false\",\"title\":\"digestive biscuit\",\"supermarketLocation\":\"Biscuits, snacks and sweets\"}],\"url\":{\"text\":\"digestive biscuits\",\"subjects\":[\"digestive biscuits\"],\"path\":\"/food/digestive_biscuit\"}},{\"text\":\"600g/1lb 5oz full-fat cream cheese\",\"technique\":null,\"foods\":[{\"id\":\"cream_cheese\",\"isKeyIngredient\":\"true\",\"title\":\"cream cheese\",\"supermarketLocation\":\"Dairy, eggs and chilled\"}],\"url\":{\"text\":\"cream cheese\",\"subjects\":[\"cream cheese\"],\"path\":\"/food/cream_cheese\"}},{\"text\":\"25ml/1fl oz Irish cream liqueur, such as Baileys\",\"technique\":null,\"foods\":[{\"id\":\"cream_liqueur\",\"isKeyIngredient\":\"false\",\"title\":\"cream liqueur\",\"supermarketLocation\":null}],\"url\":{\"text\":\"cream liqueur\",\"subjects\":[\"cream liqueur\"],\"path\":\"/food/cream_liqueur\"}},{\"text\":\"100ml/3½oz icing sugar\",\"technique\":null,\"foods\":[{\"id\":\"icing_sugar\",\"isKeyIngredient\":\"false\",\"title\":\"icing sugar\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"icing sugar\",\"subjects\":[\"icing sugar\"],\"path\":\"/food/icing_sugar\"}},{\"text\":\"300ml/10½oz double cream, whipped\",\"technique\":{\"id\":\"whipping_cream\",\"hasImage\":\"false\",\"title\":\"How to whip cream\",\"programmeClip\":{\"id\":\"p07f3zsz\"}},\"foods\":[{\"id\":\"double_cream\",\"isKeyIngredient\":\"false\",\"title\":\"double cream\",\"supermarketLocation\":\"Dairy, eggs and chilled\"}],\"url\":{\"text\":\"double cream\",\"subjects\":[\"double cream\"],\"path\":\"/food/double_cream\"}},{\"text\":\"100g/3½oz grated chocolate (dark or milk chocolate)\",\"technique\":null,\"foods\":[{\"id\":\"chocolate\",\"isKeyIngredient\":\"false\",\"title\":\"chocolate\",\"supermarketLocation\":\"Biscuits, snacks and sweets\"}],\"url\":{\"text\":\"chocolate\",\"subjects\":[\"chocolate\",\"chocolate\"],\"path\":\"/food/chocolate\"}}]},{\"title\":\"To decorate\",\"ingredients\":[{\"text\":\"200ml/7¼oz double cream, whipped (optional)\",\"technique\":null,\"foods\":[{\"id\":\"double_cream\",\"isKeyIngredient\":\"false\",\"title\":\"double cream\",\"supermarketLocation\":\"Dairy, eggs and chilled\"}],\"url\":{\"text\":\"double cream\",\"subjects\":[\"double cream\"],\"path\":\"/food/double_cream\"}},{\"text\":\"cocoa powder or more grated chocolate\",\"technique\":null,\"foods\":[{\"id\":\"chocolate\",\"isKeyIngredient\":\"false\",\"title\":\"chocolate\",\"supermarketLocation\":\"Biscuits, snacks and sweets\"},{\"id\":\"cocoa\",\"isKeyIngredient\":\"false\",\"title\":\"cocoa powder\",\"supermarketLocation\":\"Cooking ingredients\"}],\"url\":{\"text\":\"cocoa powder\",\"subjects\":[\"cocoa powder\"],\"path\":\"/food/cocoa\"}}]}],\"menu\":{\"id\":\"vegetarian_st_patricks_day_menu\",\"title\":\"Vegetarian St Patrick's Day menu\",\"description\":\"You can celebrate St Patrick's Day with a marvelous meat-free menu. Fill up on delicious Irish food and wash it down with a stout or two. Slainte!\",\"name\":\"Vegetarian St Patrick's Day menu\",\"serves\":\"\",\"chef\":null,\"keyRecipe\":{\"hasImage\":\"true\",\"id\":\"vegetariancottagepie_92035\",\"title\":\"Vegetarian cottage pie\"},\"path\":\"/food/menus/vegetarian_st_patricks_day_menu\"},\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/baileysandchocolatec_72293_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/baileysandchocolatec_72293_16x9.jpg.webp\",\"hero\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/baileysandchocolatec_72293_16x9.jpg\",\"aceHero\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/baileysandchocolatec_72293_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"rating\":{\"total\":128,\"value\":4.3671875},\"shoppingList\":[{\"locationTitle\":\"Cooking ingredients\",\"ingredients\":[{\"text\":\"100ml/3½oz icing sugar\",\"url\":{\"text\":\"icing sugar\",\"subjects\":[\"icing sugar\"],\"path\":\"/food/icing_sugar\"}}]},{\"locationTitle\":\"Biscuits, snacks and sweets\",\"ingredients\":[{\"text\":\"250g/8¾oz digestive biscuits, crushed\",\"url\":{\"text\":\"digestive biscuits\",\"subjects\":[\"digestive biscuits\"],\"path\":\"/food/digestive_biscuit\"}},{\"text\":\"100g/3½oz grated chocolate (dark or milk chocolate)\",\"url\":{\"text\":\"chocolate\",\"subjects\":[\"chocolate\",\"chocolate\"],\"path\":\"/food/chocolate\"}},{\"text\":\"cocoa powder or more grated chocolate\",\"url\":{\"text\":\"cocoa powder\",\"subjects\":[\"cocoa powder\"],\"path\":\"/food/cocoa\"}}]},{\"locationTitle\":\"Dairy, eggs and chilled\",\"ingredients\":[{\"text\":\"100g/3½oz butter, plus extra for greasing\",\"url\":{\"text\":\"butter\",\"subjects\":[\"butter\"],\"path\":\"/food/butter\"}},{\"text\":\"600g/1lb 5oz full-fat cream cheese\",\"url\":{\"text\":\"cream cheese\",\"subjects\":[\"cream cheese\"],\"path\":\"/food/cream_cheese\"}},{\"text\":\"300ml/10½oz double cream, whipped\",\"url\":{\"text\":\"double cream\",\"subjects\":[\"double cream\"],\"path\":\"/food/double_cream\"}},{\"text\":\"200ml/7¼oz double cream, whipped (optional)\",\"url\":{\"text\":\"double cream\",\"subjects\":[\"double cream\"],\"path\":\"/food/double_cream\"}}]},{\"locationTitle\":\"Other\",\"ingredients\":[{\"text\":\"25ml/1fl oz Irish cream liqueur, such as Baileys\",\"url\":{\"text\":\"cream liqueur\",\"subjects\":[\"cream liqueur\"],\"path\":\"/food/cream_liqueur\"}}]}],\"howToVideos\":[{\"description\":\"A fool-proof way to fold in flour, keeping your bakes light and airy.\",\"duration\":\"PT35S\",\"holdingImageUrl\":\"https://ichef.bbci.co.uk/images/ic/640xn/p0bw72v0.jpg\",\"id\":\"p0bw6yhh\",\"updatedAt\":\"2025-01-20T10:39:53.000Z\",\"techniqueUrl\":\"/food/how_to_cook/watch/folding\",\"title\":\"Folding\"},{\"description\":\"Learn how to whip cream by following this simple video from BBC Food.\",\"duration\":\"PT57S\",\"holdingImageUrl\":\"https://ichef.bbci.co.uk/images/ic/640xn/p07f404k.jpg\",\"id\":\"p07f3zt2\",\"updatedAt\":\"2025-01-20T17:29:09.000Z\",\"techniqueUrl\":\"/food/how_to_cook/watch/whipping_cream\",\"title\":\"How to whip cream\"}],\"relatedRecipes\":{\"fromEpisode\":{},\"menu\":[{\"sequence\":1,\"id\":\"potatosoup_11631\",\"title\":\"Potato soup\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"10 to 30 mins\",\"hasImage\":\"true\",\"description\":\"A comforting classic, this easy potato soup uses a handful of store cupboard ingredients to great effect. \\r\\n\\r\\nFor this recipe you will need a blender or food processor.\\r\\n\\r\\nEach serving provides 152 kcal, 2.5g protein, 15.3g carbohydrate (of which 2.8g sugars), 8.6g fat (of which 5.3g saturates), 1.8g fibre and 0.68g salt.\\r\\n\",\"chef\":{\"displayName\":\"Darina Allen\",\"id\":\"darina_allen\"},\"course\":{\"id\":\"starters_and_nibbles\",\"title\":\"Starters & nibbles\"},\"type\":\"collection\",\"url\":\"/food/recipes/potatosoup_11631\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/potatosoup_11631_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/potatosoup_11631_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/potatosoup_11631_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/potatosoup_11631_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":4,\"title\":\"Vegetarian St Patrick's Day menu recipes\",\"path\":\"/food/menus/vegetarian_st_patricks_day_menu\"}},{\"sequence\":2,\"id\":\"vegetariancottagepie_92035\",\"title\":\"Vegetarian cottage pie\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"30 mins to 1 hour\",\"hasImage\":\"true\",\"description\":\"A vegetarian take on a classic cottage pie. Beans and veggie mince replace meat, and root vegetables give the mash a unique twist. \",\"chef\":{\"displayName\":\"Gordon Jones\",\"id\":\"gordon_jones\"},\"course\":{\"id\":\"main_course\",\"title\":\"Main course\"},\"type\":\"collection\",\"url\":\"/food/recipes/vegetariancottagepie_92035\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/vegetariancottagepie_92035_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/vegetariancottagepie_92035_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/vegetariancottagepie_92035_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/vegetariancottagepie_92035_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":4,\"title\":\"Vegetarian St Patrick's Day menu recipes\",\"path\":\"/food/menus/vegetarian_st_patricks_day_menu\"}},{\"sequence\":3,\"id\":\"irishsodabread_67445\",\"title\":\"Easy Irish soda bread\",\"prepTime\":\"less than 30 mins\",\"cookingTime\":\"10 to 30 mins\",\"hasImage\":\"true\",\"description\":\"Try this easy soda bread recipe for when you want bread in a hurry – it's ready in less than an hour with no kneading, proving (or yeast). This makes a small loaf, but you can easily double the recipe and make two.\\r\\n\\r\\nEach serving provides 215kcal, 8g protein, 43g carbohydrate (of which 3g sugars), 1g fat (of which 0.3g saturates), 1g fibre and 1g salt.\",\"chef\":{\"displayName\":\"James Martin\",\"id\":\"james_martin\"},\"course\":{\"id\":\"afternoon_tea\",\"title\":\"Cakes and baking\"},\"type\":\"collection\",\"url\":\"/food/recipes/irishsodabread_67445\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/irishsodabread_67445_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/irishsodabread_67445_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/irishsodabread_67445_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/irishsodabread_67445_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":4,\"title\":\"Vegetarian St Patrick's Day menu recipes\",\"path\":\"/food/menus/vegetarian_st_patricks_day_menu\"}}],\"collection\":[{\"sequence\":1,\"id\":\"easy_no-cook_cheesecake_89811\",\"title\":\"Easy no bake cheesecake\",\"prepTime\":\"over 2 hours\",\"cookingTime\":\"less than 10 mins\",\"hasImage\":\"true\",\"description\":\"When you just don't have the energy to mess about with baking, an easy cheesecake is a make-ahead wonder. You can swap in all kinds of toppings for this cheesecake – fresh berries, chocolate biscuits, a shop-bought fruit compôte, or other chopped up chocolate bars. Alternatively, spread the top lightly with lemon curd and sprinkle with crushed meringues.\",\"chef\":{\"displayName\":\"Emily Angle\",\"id\":\"emily_angle\"},\"course\":{\"id\":\"desserts\",\"title\":\"Desserts\"},\"type\":\"collection\",\"url\":\"/food/recipes/easy_no-cook_cheesecake_89811\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/easy_no-cook_cheesecake_89811_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/easy_no-cook_cheesecake_89811_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/easy_no-cook_cheesecake_89811_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/easy_no-cook_cheesecake_89811_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":34,\"title\":\"Our best cheesecake recipes\",\"path\":\"/food/collections/1_our_best_cheesecake_recipes\"}}],\"ingredient\":[{\"id\":\"baked_welsh_cake_68115\",\"title\":\"Baked Welsh cake cheesecake\",\"description\":\"A Welsh take on the classic cheesecake. The chunky Welsh cakes stirred into the mixture add an interesting texture.\",\"hasImage\":\"true\",\"isQuickAndEasy\":\"false\",\"availabilityEnd\":\"2050-03-22T21:00:00.000Z\",\"lastModified\":\"2016-02-15T14:14:36.000Z\",\"course\":{\"id\":\"desserts\",\"title\":\"Desserts\"},\"food\":{\"id\":\"cheesecake\",\"title\":\"cheesecake\"},\"seasons\":[],\"diets\":[{\"id\":\"nut_free\"},{\"id\":\"pregnancy_friendly\"}],\"chef\":{\"id\":\"derith_rhisiart\",\"displayName\":\"Derith Rhisiart\",\"hasImage\":\"false\"},\"type\":\"ingredient\",\"url\":\"/food/recipes/baked_welsh_cake_68115\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/baked_welsh_cake_68115_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/baked_welsh_cake_68115_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/baked_welsh_cake_68115_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/baked_welsh_cake_68115_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":216,\"title\":\"cream cheese recipes\",\"path\":\"/food/cream_cheese\"},\"priority\":1},{\"id\":\"pumpkin_cider_cake_90964\",\"title\":\"Pumpkin cake\",\"description\":\"With its classic autumn flavour, this pumpkin cake looks just like a pumpkin! Add spices and cider and you're on to a winner. \\r\\n\\r\\nFor this recipe you will need a small bundt tin 21cm/8¼in in diameter. The key to making this look like a pumpkin is to use a tin with vertical segments, not with a twist. \",\"hasImage\":\"true\",\"isQuickAndEasy\":\"false\",\"availabilityEnd\":null,\"lastModified\":\"2022-10-24T15:46:09.000Z\",\"course\":{\"id\":\"afternoon_tea\",\"title\":\"Cakes and baking\"},\"food\":{\"id\":\"cake\",\"title\":\"cake\"},\"seasons\":[{\"id\":\"october\",\"name\":\"October\"},{\"id\":\"november\",\"name\":\"November\"}],\"diets\":[{\"id\":\"nut_free\"},{\"id\":\"vegetarian\"}],\"chef\":{\"id\":\"emily_angle\",\"displayName\":\"Emily Angle\",\"hasImage\":\"false\"},\"type\":\"ingredient\",\"url\":\"/food/recipes/pumpkin_cider_cake_90964\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/pumpkin_cider_cake_90964_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/pumpkin_cider_cake_90964_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/pumpkin_cider_cake_90964_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/pumpkin_cider_cake_90964_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":216,\"title\":\"cream cheese recipes\",\"path\":\"/food/cream_cheese\"},\"priority\":2},{\"id\":\"stuffed_chicken_breasts_14926\",\"title\":\"Stuffed chicken breasts\",\"description\":\"An easy chicken recipe for two that won’t fail to impress. Serve with steamed new potatoes for a bigger meal.\",\"hasImage\":\"true\",\"isQuickAndEasy\":\"false\",\"availabilityEnd\":\"2024-01-10T00:00:00.000Z\",\"lastModified\":\"2022-04-01T16:11:23.000Z\",\"course\":{\"id\":\"main_course\",\"title\":\"Main course\"},\"food\":{\"id\":\"baked_chicken\",\"title\":\"baked chicken\"},\"seasons\":[],\"diets\":[{\"id\":\"egg_free\"},{\"id\":\"nut_free\"}],\"chef\":{\"id\":\"annie_rigg\",\"displayName\":\"Annie Rigg\",\"hasImage\":\"false\"},\"type\":\"ingredient\",\"url\":\"/food/recipes/stuffed_chicken_breasts_14926\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/stuffed_chicken_breasts_14926_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/stuffed_chicken_breasts_14926_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/stuffed_chicken_breasts_14926_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/stuffed_chicken_breasts_14926_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]},\"relations\":{\"count\":216,\"title\":\"cream cheese recipes\",\"path\":\"/food/cream_cheese\"},\"priority\":2}],\"dish\":[{\"course\":{\"id\":\"desserts\",\"title\":\"Desserts\"},\"id\":\"whitechocolatecheese_12412\",\"hasImage\":\"true\",\"title\":\"Baked white chocolate cheesecake\",\"lastModified\":\"2018-06-05T14:46:54.000Z\",\"seasons\":[],\"food\":{\"id\":\"cheesecake\",\"title\":\"cheesecake\"},\"description\":\"This classic baked cheesecake with a naughty white chocolate centre is sure to impress your guests.\",\"availabilityEnd\":null,\"diets\":[{\"id\":\"nut_free\"},{\"id\":\"vegetarian\"}],\"isQuickAndEasy\":\"false\",\"chef\":{\"id\":\"ben_odonoghue\",\"hasImage\":\"true\",\"displayName\":\"Ben O'Donoghue\"},\"relations\":{\"count\":77,\"title\":\"cheesecake recipes\",\"path\":\"/food/cheesecake\"},\"type\":\"dish\",\"url\":\"/food/recipes/whitechocolatecheese_12412\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_{width}/recipes/whitechocolatecheese_12412_16x9.jpg\",\"aceTemplate\":\"https://ichef.bbc.co.uk/ace/standard/{width}/food/recipes/whitechocolatecheese_12412_16x9.jpg.webp\",\"thumbnail\":\"https://ichef.bbci.co.uk/food/ic/food_16x9_1600/recipes/whitechocolatecheese_12412_16x9.jpg\",\"aceThumbnail\":\"https://ichef.bbc.co.uk/ace/standard/1600/food/recipes/whitechocolatecheese_12412_16x9.jpg.webp\",\"sizes\":[160,208,320,448,608,832,1600]}},{\"course\":{\"id\":\"desserts\",\"title\":\"Desserts\"},\"id\":\"vegan_black_forest_48044\",\"hasImage\":\"true\",\"title\":\"Vegan cheesecake\",\"lastModified\":\"2024-06-28T15:46:50.000Z\",\"seasons\":[],\"food\":{\"id\":\"cheesecake\",\"title\":\"cheesecake\"},\"description\":\"This no-bake vegan cheesecake, with its boozy Black Forest cherry topping, is a luxurious twist on a retro classic. It's completely delicious and just the thing for celebrations and parties. See the recipe tips for alternative topping ideas.\\r\\n\\r\\nFor this recipe you will need a food processor or blender.\",\"availabilityEnd\":null,\"diets\":[{\"id\":\"dairy_free\"},{\"id\":\"egg_free\"},{\"id\":\"vegan\"},{\"id\":\"vegetarian\"}],\"isQuickAndEasy\":\"false\",\"chef\":{\"id\":\"sarah_cook\",\"hasImage\":\"false\",\"displayName\":\"Sarah Cook\"},\"relations\":{\"count\":77,\"title\":\"cheesecake recipes\",\"path\":\"/food/cheesecake\"},\"type\":\"dish\",\"url\":\"/food/recipes/vegan_black_forest_48044\",\"image\":{\"template\":\"https://ichef.bbci.co.uk/food/ic/food_