                    <script>
                    (function() {
                        // Animate count-up for numbers
                        function animateCountUp(el, countTo, formatter) {
                            var duration = 250, frameDuration = 1000/60;
                            var totalFrames = Math.round(duration / frameDuration);
                            var easeOutQuad = function(t) { return t * (2 - t); };
                            var frame = 0;
                            var counter = setInterval(function() {
                                frame++;
                                var progress = easeOutQuad(frame / totalFrames);
                                var currentCount = countTo * progress;
                                el.innerText = typeof formatter === "function" ? formatter(currentCount) : Math.round(currentCount);
                                if (frame >= totalFrames) clearInterval(counter);
                            }, frameDuration);
                        }

                        function formatNumber(value) {
                            return parseFloat(parseFloat(value).toFixed(1));
                        }

                        function formatDailyPercentage(value, displayAmount) {
                            // displayAmount is null when there's a valid daily value, otherwise it's the rounded display amount
                            return displayAmount == null ? formatNumber(value * 100) + "% DV" : (displayAmount > 0 ? "Exceeds DV" : "Meets DV");
                        }

                        // Serving selector change handler
                        var servingsSelect = document.getElementById("video-nutrition-servings-select");
                        if (servingsSelect) {
                            servingsSelect.addEventListener("change", function(e) {
                                var servings = e.target.value;
                                var label = document.getElementById("video-nutrition-servings");
                                if (label) {
                                    var option = e.target.querySelector('option[value="' + servings + '"]');
                                    if (option) label.innerText = option.innerText;
                                }
                                // Update calories
                                var caloriesField = document.getElementById("video-nutrient-calories");
                                if (caloriesField) {
                                    var baseCalories = caloriesField.getAttribute("data-calories");
                                    if (!isNaN(baseCalories)) {
                                        animateCountUp(caloriesField, baseCalories * servings);
                                        var ring = caloriesField.closest(".nutrition-calorie-ring");
                                        if (ring) ring.setAttribute("aria-label", Math.round(baseCalories * servings) + " Calories");
                                    }
                                }
                                // Update all nutrient values
                                document.getElementsByName("video-nutrient").forEach(function(nutrient) {
                                    var dailyValue = nutrient.getAttribute("data-daily-value");
                                    var amount = nutrient.getAttribute("data-amount");
                                    if (!isNaN(dailyValue) && !isNaN(amount)) {
                                        var newAmount = amount * servings;
                                        // Use rounded display amount for consistency (amounts < 0.05 display as "0")
                                        var displayAmount = formatNumber(newAmount);
                                        var dailyValuePercent = dailyValue > 0 ? newAmount / dailyValue : (displayAmount > 0 ? 1 : 0);
                                        var amountField = nutrient.querySelector('[name="video-nutrient-amount"]');
                                        if (amountField) animateCountUp(amountField, newAmount, formatNumber);
                                        var bar = nutrient.querySelector('[name="video-nutrient-bar"]');
                                        if (bar) bar.style.width = formatNumber(dailyValuePercent * 100) + "%";
                                        var dvField = nutrient.querySelector('[name="video-nutrient-daily-value"]');
                                        if (dvField) animateCountUp(dvField, dailyValuePercent, function(v) {
                                            return formatDailyPercentage(v, dailyValue == 0 ? displayAmount : null);
                                        });
                                    }
                                });
                            });
                        }

                        // Nutrient group expand/collapse
                        function setupExpander(groupId) {
                            var btn = document.getElementById("video-" + groupId + "-expander");
                            if (btn) {
                                btn.addEventListener("click", function() {
                                    var container = document.getElementById("video-" + groupId + "-nutrients");
                                    var list = document.getElementById("video-" + groupId + "-nutrients-list");
                                    if (container && list) {
                                        var isExpanded = container.classList.contains("nutrients-expanded");
                                        container.classList.toggle("nutrients-expanded", !isExpanded);
                                        list.setAttribute("aria-expanded", !isExpanded ? "true" : "false");
                                        btn.setAttribute("aria-expanded", !isExpanded ? "true" : "false");
                                        btn.setAttribute("aria-label", (!isExpanded ? "Collapse " : "Expand ") + groupId.charAt(0).toUpperCase() + groupId.slice(1) + " Nutrients");
                                    }
                                });
                            }
                        }
                        setupExpander("positive");
                        setupExpander("negative");
                    })();
                    </script>
            </div>
        </div>

        <div class="recipe-share-overlay">
            <div class="background"></div>
            <div class="share-box">
                <h3>Sharing options</h3>
                <div role="button" tabindex="0" class="close"><span>Close</span></div>
                <div class="networks">
                    <a tabindex="0" class="pinterest" href="https://pinterest.com/pin/create/button/?url=https%3a%2f%2fwww.relish.com%2frecipes%2f162536%2fseattlehanddoc-fried-chicken&amp;media=https%3a%2f%2fplatform.relish.com%2fwp-content%2fuploads%2f2025%2f05%2fScreen-Shot-2025-05-31-at-1.58.04-PM.png&amp;description=" target="_blank" rel="noopener noreferrer"><span>Share on Pinterest</span></a>
                    <a tabindex="0" class="facebook" href="https://www.facebook.com/sharer/sharer.php?u=https%3a%2f%2fwww.relish.com%2frecipes%2f162536%2fseattlehanddoc-fried-chicken" target="_blank" rel="noopener noreferrer"><span>Share on Facebook</span></a>
                    <a tabindex="0" class="twitter" href="https://twitter.com/intent/tweet?text=%20https%3a%2f%2fwww.relish.com%2frecipes%2f162536%2fseattlehanddoc-fried-chicken" target="_blank" rel="noopener noreferrer"><span>Share on Twitter</span></a>
