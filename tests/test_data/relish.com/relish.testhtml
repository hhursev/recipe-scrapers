    </article>
    <script>
    (function() {
        function initNutritionExpand() {
            var btn = document.getElementById('nutritionExpandBtn');
            var detail = document.getElementById('nutritionDetail');
            if (!btn || !detail) return;

            // Clone button to remove ALL event listeners, then add our single handler
            var newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);

            newBtn.addEventListener('click', function() {
                var isHidden = detail.hidden;
                detail.hidden = !isHidden;
                detail.classList.toggle('visible', isHidden);
                newBtn.classList.toggle('expanded', isHidden);
                newBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
                var labelSpan = newBtn.querySelector('span');
                if (labelSpan) {
                    labelSpan.textContent = isHidden ? 'Hide full nutrition' : 'Show full nutrition';
                }
            });
        }

        function initJumpNavActiveState() {
            var navLinks = document.querySelectorAll('.video-recipe-nav a');
            if (!navLinks.length) return;

            navLinks.forEach(function(link) {
                link.addEventListener('click', function() {
                    // Remove active from all links
                    navLinks.forEach(function(l) { l.classList.remove('active'); });
                    // Add active to clicked link
                    link.classList.add('active');
                });
            });
        }

        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                // Delay inits slightly to ensure they run AFTER main.min.js
                setTimeout(initNutritionExpand, 100);
                setTimeout(initJumpNavActiveState, 100);
            });
        } else {
            setTimeout(initNutritionExpand, 100);
            setTimeout(initJumpNavActiveState, 100);
        }
    })();
    </script>
</main>

<script type="application/ld+json">
{"@context":"https://schema.org/","@type":"Recipe","name":"Seattlehanddoc Fried Chicken","image":["https://platform.relish.com/wp-content/uploads/2025/05/Screen-Shot-2025-05-31-at-1.58.04-PM.png"],"author":{"@type":"Person","name":"@seattlehanddoc","url":"https://www.relish.com/contributors/63/seattlehanddoc"},"datePublished":"0001-01-01T00:00:00+00:00","description":"","prepTime":"20 minutes","cookTime":"25 minutes","totalTime":"45 minutes","keywords":null,"recipeYield":"8 servings","recipeCategory":null,"recipeCuisine":null,"nutrition":null,"recipeIngredient":["Boneless, Skinless Chicken Thighs","Extra Virgin Olive Oil","Fresh Basil","Garlic Clove","Vine Tomatoes","All Purpose Flour","Egg","Panko Breadcrumbs","Grated Parmesan Cheese","Unsalted Butter","Kosher Salt"],"recipeInstructions":[{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Season chicken thighs with salt.</span>"},{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Combine ⅔ cup olive oil, basil, garlic, and salt to taste into a blender and purée until basil oil is smooth.</span>"},{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Combine tomatoes with about half of the basil oil and salt in a bowl until evenly coated, creating tomato salad.</span>"},{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Place flour and beaten eggs into separate shallow dishes. Combine panko bread crumbs and Parmesan cheese in a third dish.</span>"},{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Dip a chicken thigh in flour, shake off excess, then dip in beaten egg. Shake off excess, then dip both sides in panko mixture and transfer to a rimmed baking sheet. Repeat with remaining thighs.</span>"},{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Melt butter and remaining 1⅓ cups olive oil in a deep skillet over medium-high heat. Fry 2 to 4 chicken thighs in the hot oil until bottoms are golden, about 3 minutes. Flip and fry until golden and crispy all over and cooked through, about another 3 minutes. Transfer to a paper towel-lined plate.</span>"},{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Immediately sprinkle salt over fried chicken.</span>"},{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Serve fried chicken topped with basil oil and tomato salad.</span>"},{"@type":"HowToStep","text":"<span style=\"font-weight: 400;\">Note: Adapted from the New York Times Chicken Milanese.</span>"}],"aggregateRating":null,"video":null}
</script>

