<script>
    document.addEventListener('DOMContentLoaded', function () {
	    const checkSearchspring = () => {
	        if (window.searchspring) {
	            const searchspringContent = document.querySelector('#searchspring-content');
	            if (searchspringContent) {
	                const observer = new MutationObserver((mutations) => {
	                    mutations.forEach((mutation) => {
	                        if (mutation.type === 'childList') {
	                            const productElements = searchspringContent.querySelectorAll('.ss__result');
	                            productElements.forEach((productElement) => {
	                                

	                                const links = productElement.querySelectorAll('[href="/products/gift-card"]');
	                                if(links.length > 0) {
	                                	blockUserActions(productElement);
	                                	
		                                links.forEach(link => {
		                                    link.setAttribute('href', 'https://kitchenaid.com.au/a/gc/gift-card/');
		                                });

		                                const buttons = productElement.querySelectorAll('button[name="add"]');
		                                buttons.forEach(button => {
		                                    if (!button.hasAttribute('data-replaced') && !productElement.querySelector('a[data-replaced="true"]')) {
		                                        const link = document.createElement('a');
		                                        link.href = 'https://kitchenaid.com.au/a/gc/gift-card/';
		                                        link.className = 'cursor-pointer inline-block text-white transition-colors duration-250 py-13px w-full border border-solid border-grey-100 text-grey-100 hover:bg-grey-100 hover:text-white';
		                                        link.classList.add('text-center');

		                                        const span = document.createElement('span');
		                                        span.className = 'txt block text-16px lg:text-14px xl:text-16px leading-22px font-medium uppercase text-center px-20px';
		                                        span.textContent = 'Learn More';

		                                        link.appendChild(span);
		                                        button.replaceWith(link);

		                                        link.setAttribute('data-replaced', 'true');
		                                    }
		                                });

		                                unblockUserActions(productElement);
		                            }
	                            });
	                        }
	                    });
	                });

	                observer.observe(searchspringContent, { childList: true, subtree: true });
	                return true;
	            }
	        }
	        return false;
	    };

	    const blockUserActions = (element) => {
	        element.querySelectorAll('[href], button').forEach((item) => {
	            item.dataset.blocked = "true";
	            item.addEventListener('click', preventClick, { capture: true });
	        });
	    };

	    const unblockUserActions = (element) => {
	        element.querySelectorAll('[href], button').forEach((item) => {
	            if (item.dataset.blocked === "true") {
	                item.removeEventListener('click', preventClick, { capture: true });
	                delete item.dataset.blocked;
	            }
	        });
	    };

	    const preventClick = (event) => {
	        event.stopImmediatePropagation();
	        event.preventDefault();
	    };

	    let attempts = 0;
	    const retryInterval = setInterval(() => {
	        if (checkSearchspring()) {
	            clearInterval(retryInterval);
	        }
	        attempts++;
	        if (attempts > 10) {
	            clearInterval(retryInterval);
	        }
	    }, 500);
	});
</script>

<style>
	[data-replaced="true"] + [type="submit"] {
		display: none !important;
	}
</style>
  
