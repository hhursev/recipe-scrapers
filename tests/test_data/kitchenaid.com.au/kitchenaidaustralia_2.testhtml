<script>
window.chatboxGlobal = (function() {
  var chatboxReady  = false;
  var chatboxIsOpen = false;

  var scrollThrottleTimeout = null;
  var scrollHandler = null;
  var scrollDebounce = 100;
  var scrollDebounce_normal = 100;
  var scrollDebounce_faster = 10;


  function isMobile() {
    return window.innerWidth < 768;
  }

  function getStopTrigger() {
    if (isMobile()) {
      return document.getElementById('chatbox-stop-trigger-mobile')
          || document.getElementById('chatbox-stop-trigger');
    } else {
      return document.getElementById('chatbox-stop-trigger-desktop')
          || document.getElementById('chatbox-stop-trigger');
    }
  }

  function isAtFooter(chatboxElement) {
    var stopTrigger = getStopTrigger();
    if (!stopTrigger) return false;
    var triggerRect   = stopTrigger.getBoundingClientRect();
    return triggerRect.top <= window.innerHeight - 20;
  }

  function updateChatboxPosition(chatboxElement) {
    var stopTrigger = getStopTrigger();
    if (!stopTrigger) return false;

    var triggerRect   = stopTrigger.getBoundingClientRect();
    var chatboxHeight = chatboxElement.offsetHeight;

    if (triggerRect.top <= window.innerHeight - 20) {
      chatboxElement.style.position = 'absolute';
      chatboxElement.style.top      = (window.scrollY + triggerRect.top - chatboxHeight) + 'px';
      chatboxElement.style.bottom   = 'auto';
      chatboxElement.style.right    = '';
      return true;
    } else {
      chatboxElement.style.position = '';
      chatboxElement.style.top      = '';
      chatboxElement.style.bottom   = '';
      chatboxElement.style.right    = '';
      return false;
    }
  }

  function updateButtonPosition(chatboxElement, btn) {
    var chatboxStyle = window.getComputedStyle(chatboxElement);
    var btnRight     = 14 + (12 / 2) + (64 / 2) - (26 / 2);

    if (chatboxStyle.position === 'absolute') {
      btn.style.position = 'absolute';
      btn.style.top      = (parseInt(chatboxElement.style.top) - 21) + 'px';
      btn.style.right    = btnRight + 'px';
      btn.style.bottom   = 'auto';
    } else {
      var chatboxRect    = chatboxElement.getBoundingClientRect();
      btn.style.position = 'fixed';
      btn.style.bottom   = (window.innerHeight - chatboxRect.top - 4) + 'px';
      btn.style.right    = btnRight + 'px';
      btn.style.top      = '';
    }
  }

  function updateButton(chatboxElement, btn) {
    if (chatboxIsOpen) return;

    var chatboxRect     = chatboxElement.getBoundingClientRect();
    var chatboxOnScreen = chatboxRect.top < window.innerHeight && chatboxRect.bottom > 0;
    var floatingBannerActive = document.querySelector('floating-banners.on') ? true : false;
    if (window.scrollY > window.innerHeight && chatboxOnScreen && !floatingBannerActive) {
      btn.style.visibility = 'hidden';
      updateButtonPosition(chatboxElement, btn);
      btn.style.visibility = 'visible';
    } else {
      btn.style.visibility = 'hidden';
    }
  }

  function clearChatboxStyle(chatboxElement) {
    chatboxElement.style.position = '';
    chatboxElement.style.top      = '';
    chatboxElement.style.bottom   = '';
    chatboxElement.style.right    = '';
  }

  function init() {
    var htmlEl = document.documentElement;


  }

  return {
    init:                  init,
    updateChatboxPosition: updateChatboxPosition,
    updateButton:          updateButton,
    clearChatboxStyle:     clearChatboxStyle
  };
})();

window.chatboxGlobal.init();
</script>

  
