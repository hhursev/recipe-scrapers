  </script><script>
(function () {
  /* ---------- OPTIONAL CONFIG (see Step 3) ----------
     Leave empty to push raw IDs only; segments still work. */
  var ROLLOUTS = {
    // Example:
    // '4685909': { name: 'PDP layout test',
    //              arms: { '9371733': 'control', '9404501': 'treatment' } }
  };
  // Replacement-theme tests only: 'control' in the live theme,
  // 'treatment' in the replacement theme.
  var THEME_VARIANT_LABEL = null;
  /* ------------------------------------------------- */

  var PUSHED = '__insightechRolloutsPushed';
  if (window[PUSHED]) return;
  var SELF = document.currentScript; // never read this script's own text

  // Tolerates quoted, unquoted or escaped keys, and number or string values.
  function readArray(txt, key) {
    var re = new RegExp('(?:^|[^\\w])\\\\?"?' + key +
      '\\\\?"?\\s*:\\s*\\[([^\\]]*)\\]');
    var m = txt.match(re);
    if (!m) return null;
    return m[1].split(',')
      .map(function (v) { return v.replace(/[^\w-]/g, ''); })
      .filter(function (v) { return v.length > 0; });
  }

  function getRaw() {
    var s = document.getElementsByTagName('script');
    for (var i = 0; i < s.length; i++) {
      var t = s[i].textContent || '';
      // Skip any copy of this script
      if (s[i] === SELF || t.indexOf(PUSHED) !== -1) continue;
      if (t.indexOf('rolloutTreatmentIds') === -1) continue;
      var ids = readArray(t, 'rolloutIds');
      var tids = readArray(t, 'rolloutTreatmentIds');
      if (ids || tids) return { rolloutIds: ids || [], treatmentIds: tids || [] };
    }
    return { rolloutIds: [], treatmentIds: [] };
  }

  // Only pair test + variant when the lists line up;
  // otherwise keep every variant ID on its own.
  function toAssignments(raw) {
    var paired = raw.rolloutIds.length === raw.treatmentIds.length;
    return raw.treatmentIds.map(function (tid, i) {
      return {
        rolloutId: paired ? raw.rolloutIds[i] : null,
        treatmentId: tid,
        paired: paired
      };
    });
  }

  function getCheckoutProfileId() {
    var s =
document.querySelector('script[src*="/checkouts/internal/preloads.js"]');
    var m = s && (s.getAttribute('src') ||
'').match(/[?&]configuration_id=(\d+)/);
    return m ? m[1] : null;
  }

  function getCookie(name) {
    var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return m ? decodeURIComponent(m[1]) : null;
  }

  function getUtm() {
    var p = new URLSearchParams(window.location.search);
    return {
      utmSource: p.get('utm_source'),
      utmMedium: p.get('utm_medium'),
      utmCampaign: p.get('utm_campaign')
    };
  }

  // Shopify exposes no assignment time, so record when this variant was first seen.
  function firstSeen(a) {
    var key = 'ins_rollout_' + (a.rolloutId || a.treatmentId);
    var now = new Date().toISOString();
    try {
      var saved = JSON.parse(localStorage.getItem(key) || 'null');
      if (saved && saved.treatmentId === a.treatmentId) return saved.firstSeenAt;
      localStorage.setItem(key,
        JSON.stringify({ treatmentId: a.treatmentId, firstSeenAt: now }));
    } catch (e) {}
    return now;
  }

  function run() {
    if (window[PUSHED]) return;
    var raw = getRaw();
    var assignments = toAssignments(raw);

    var S = window.Shopify || {};
    var theme = S.theme || {};
    var mobile = window.matchMedia && window.matchMedia('(max-width: 767px)').matches;
    var base = {
      visitorId: getCookie('_shopify_y'),
      device: mobile ? 'mobile' : 'desktop',
      country: S.country || null,
      currency: (S.currency && S.currency.active) || null,
      themeId: theme.id ? String(theme.id) : null,
      themeName: theme.name || null,
      themeVariantLabel: THEME_VARIANT_LABEL,
      checkoutProfileId: getCheckoutProfileId()
    };
    var utm = getUtm();

    window[PUSHED] = true;
    // For checking in the browser console
    window.insightechRollouts = { raw: raw, assignments: assignments, context: base };
    window.dataLayer = window.dataLayer || [];

    assignments.forEach(function (a) {
      var cfg = (a.rolloutId && ROLLOUTS[a.rolloutId]) || {};
      var key = (a.rolloutId || 'unpaired') + '_' + a.treatmentId;
      window.dataLayer.push({
        event: 'shopify_rollout_experiment',
        // Key IDs at the top level too, so a short JSON Path
        // (e.g. variantKey) always matches.
        rolloutId: a.rolloutId,
        treatmentId: a.treatmentId,
        variantKey: key,
        shopify_rollout: Object.assign({
          rolloutId: a.rolloutId,
          treatmentId: a.treatmentId,
          variantKey: key,
          rolloutName: cfg.name || null,
          variant: (cfg.arms && cfg.arms[a.treatmentId]) || null,
          firstSeenAt: firstSeen(a)
        }, base, utm)
      });
    });

    // Fires on every page, even with no active test,
    // so theme and checkout IDs are always captured.
    window.dataLayer.push({
      event: 'shopify_rollout_visitor_initialized',
      shopify_rollout_visitor: Object.assign({
        rolloutIds: raw.rolloutIds,
        treatmentIds: raw.treatmentIds,
        activeRollouts: assignments.map(function (a) {
          return { rolloutId: a.rolloutId, treatmentId: a.treatmentId,
                   variantKey: (a.rolloutId || 'unpaired') + '_' + a.treatmentId };
        })
      }, base)
    });
  }

  function safeRun() {
    try {
      run();
    } catch (e) {
      if (window.console) console.warn('Insightech Rollouts:', e);
    }
  }

  // Push once the page has loaded, so the Insightech tag is ready to capture
  // the events.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', safeRun);
  } else {
    safeRun();
  }
})();
</script>

