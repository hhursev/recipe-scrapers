  <script type="text/javascript">
  const showConsole = false;
  function consoleLog(msg){
    if(showConsole){
      console.log(msg)
    }
  };

  var TIMER_ABOVE_THE_FOLD_COMPONENTS = 1000 * 2;//load scripts for header shortly after pageload
  var TIMER = 1000 * 100;//for other components below the fold, load after first user's interaction (or after 100 seconds)

  var TOTAL_APP_DEPENDENCIES = 0;
  var TOTAL_APP_DEPENDENCIES_LOADED = 0;

  var MODULES = [];
  var STYLESHEETS = [];
  var TEMPLATESCRIPTS = [];

  window.moduleLoader = (function (window, document, undefined) {
    'use strict';
    var lazyLoadModule = function (moduleName, moduleUrl, timer, options, hasInitCallback = true) {
     moduleName = "squad_" + moduleName;
      
      consoleLog('lazyLoadModule '+moduleName +' timer: '+timer+ ' url: '+moduleUrl)
      const myPromise = new Promise((resolve, reject) => {
        const getTIMER = function (timer) {
          function checkIsFromGoogle() {
            const params = new Proxy(new URLSearchParams(window.location.search), {
              get: (searchParams, prop) => searchParams.get(prop),
            });
            if (params.gcid) {
              return true;
            }
            return false;
          }

          //Set Timer = 0 for Safari users
          //var isFromGoogle = checkIsFromGoogle();
          //var isFromFacebook = /facebook/.test(document.referrer);
          //var isSafari = /^((?!chrome|android|crios|fxios).)*safari/i.test(navigator.userAgent);
          //if(isFromGoogle || isFromFacebook || isSafari || isInteracted){
          //  return 0;
          //}

          var isInteracted = false;
          var USER_INTERACTED = sessionStorage.getItem('USER_INTERACTED');
          if (USER_INTERACTED == 'true') {
            isInteracted = true;
          }
          if(isInteracted) return 0;

          //Whether the PDP URL is anchored to a specific section of the page e.g #videos
          //If yes, we should load all the scripts immediately without waiting for user interaction. This is to make the below the fold components render immediately.
          var isAnchoredUrl = window.location.hash !== '';
          if(isAnchoredUrl) return 0;

          return timer;
        };

        const init = function () {
          if (window[moduleName] != true) {
            window[moduleName] = true;
            var script = document.createElement('script');
            script.setAttribute('src', moduleUrl);
            script.setAttribute('defer', 'defer');
            script.onload = function () {
              if (hasInitCallback) {
                window.LazyModule.init(options).then(() => {
                  setTimeout(() => {
                    resolve();
                    consoleLog(moduleName+" is resolved");
                  }, 50);
                });
              } else {
                setTimeout(() => {
                  resolve();
                  consoleLog(moduleName+" is resolved");
                }, 50);
              }
            };
            document.head.appendChild(script);
          }
        };

         setTimeout(() => {
          init();
        }, getTIMER(timer));

        function initOnEvent(event) {
          sessionStorage.setItem('USER_INTERACTED', 'true');
          init();
          event.currentTarget.removeEventListener('scroll', initOnEvent);
          event.currentTarget.removeEventListener('mousemove', initOnEvent);
          event.currentTarget.removeEventListener('touchstart', initOnEvent);
        }

        if (window[moduleName] != true) {
          //document.addEventListener('scroll', initOnEvent);
          document.addEventListener('mousemove', initOnEvent);
          document.addEventListener('touchstart', initOnEvent);
        }
      });

      return myPromise;
    };
    return {
      lazyLoadModule: lazyLoadModule,
    };
  })(window, document);

  function lazyLoadModules(modules = [], apps) {
    modules.map(function (params) {
      if (params.isAppDependencies) {
        TOTAL_APP_DEPENDENCIES++;
      }
    });
    consoleLog('TOTAL_APP_DEPENDENCIES: '+ TOTAL_APP_DEPENDENCIES);
    if (modules.length) {
      modules.map(function (params) {
        window.moduleLoader
          .lazyLoadModule(params.moduleName, params.moduleUrl, params.timer, params.options, params.hasInitCallback)
          .then(() => {
            if (params.isAppDependencies) {
              TOTAL_APP_DEPENDENCIES_LOADED++;
              if (TOTAL_APP_DEPENDENCIES_LOADED == TOTAL_APP_DEPENDENCIES) {
                apps.map(function (params) {
                  window.moduleLoader.lazyLoadModule(params.moduleName, params.moduleUrl, 50, {}, false).then(() => {});
                  //window.moduleLoader.lazyLoadModule(params.moduleName, params.moduleUrl, params.timer, {}, false).then(() => {});
                });
              }
            }
          });
      });
    } else {
      apps.map(function (params) {
        //window.moduleLoader.lazyLoadModule(params.moduleName, params.moduleUrl, 50, {}, false).then(() => {});
        window.moduleLoader.lazyLoadModule(params.moduleName, params.moduleUrl, params.timer, {}, false).then(() => {});
      });
    }
  }

  function lazyLoadStyleSheets(styleSheets) {
    styleSheets.map(function (href) {
      //avoid duplicates
      for (var i = 0; i < document.styleSheets.length; i++) {
        if (document.styleSheets[i].href == href) {
          return;
        }
      }
      var head = document.getElementsByTagName('head')[0];
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.type = 'text/css';
      link.href = href;
      head.appendChild(link);
    });
  }

  function addVendor_(moduleName, moduleUrl, timer = TIMER) {   
    MODULES.push({
        moduleName: moduleName,
        moduleUrl: moduleUrl,
        timer: timer,
        options: {},
        isAppDependencies: true,
        hasInitCallback: false,
      });
  }

  function addVendor(moduleName, moduleUrl, options = {}, timer = TIMER) {   
    MODULES.push({
        moduleName: moduleName,
        moduleUrl: moduleUrl,
        timer: timer,
        options: options,
        isAppDependencies: true,
        hasInitCallback: false,
      });
  }

  function addModule(moduleName, moduleUrl, options, isAppDependencies = false, hasInitCallback = true) {
    MODULES.push({
        moduleName: moduleName,
        moduleUrl: moduleUrl,
        timer: TIMER,
        options: options,
        isAppDependencies: isAppDependencies,
        hasInitCallback: hasInitCallback,
      });
  }

  function addShopifyAsyncScript(moduleName, moduleUrl) {
    MODULES.push({
      moduleName: moduleName,
      moduleUrl: moduleUrl,
      timer: TIMER,
      options: {},
      isAppDependencies: false,
      hasInitCallback: false,
    });
  }

  function addAboveTheFoldScript(moduleName, moduleUrl, timer = TIMER_ABOVE_THE_FOLD_COMPONENTS) {
    MODULES.push({
      moduleName: moduleName,
      moduleUrl: moduleUrl,
      options: {},
      timer: timer,
      isAppDependencies: true,
      hasInitCallback: false,
    });
  }

  function addApp(moduleName, moduleUrl, timer = TIMER) {
    TEMPLATESCRIPTS.push({ moduleName: moduleName, moduleUrl: moduleUrl, timer: timer });
  }
  function addStyleSheet(fileUrl) {
    STYLESHEETS.push(fileUrl);
  }

  /*
    The template JS files are lazyloaded after the base libraries are loaded.
    In case no library is added (Eg gtag.js), the lazyload function will not trigger loading the template JS files.
    Therefore, we alway load an empty `delayer` script here to ensure that the templates scripts will be loaded.
  */
  
  addVendor("delayer","//kitchenaid.com.au/cdn/shop/t/684/assets/js-build-delayer.js?v=94204933575430374531794204885", {}, TIMER);
</script>


