<script type="text/javascript">
  

  const excludedScripts = [
    `https:\/\/checkout.latitudefinancial.com\/assets\/shopify.js?containerId=latitude-interest-free-product-widget\u0026layout=standard\u0026merchantId=000418060\u0026promotionCode=2006\u0026promotionMonths=6\u0026shop=kitchenaid-australia.myshopify.com`
  ];

  function loadScripts(){
    setTimeout(function(){
      console.log('loadScripts');
      if(window.asyncLoad_urls && window.asyncLoad_urls.length){
        //load Shopify async scripts
        var urls = window.asyncLoad_urls;
        for (var i = 0; i < urls.length; i++) {
            var moduleName = "ShopifyAsyncModule"+i;
          if(excludedScripts.includes(urls[i])){
            continue;
          }
            addShopifyAsyncScript(moduleName,urls[i]);
        }
      }
      var waitForJQuery = setInterval(function () {
        if (typeof $ != 'undefined') {
          lazyLoadModules(MODULES,TEMPLATESCRIPTS);
          lazyLoadStyleSheets(STYLESHEETS);
          clearInterval(waitForJQuery);
        }
    }, 200);
    },100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadScripts);
  } else {
    loadScripts();
  }

</script>


  





































  
    

  


  
  

  
  
