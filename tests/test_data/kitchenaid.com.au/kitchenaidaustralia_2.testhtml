<style>
  .nav2{--nav2-red:#C41230;--nav2-ink:#2E2E2E;--nav2-grey:#5E5E5E;--nav2-muted:#969696;--nav2-line:#F0F0F0;--nav2-pad:56px;position:relative;background:#fff;color:var(--nav2-ink);z-index:50;letter-spacing:.2px}
  .nav2 *,.nav2 *::before,.nav2 *::after{box-sizing:border-box}
  .nav2 ul{list-style:none;margin:0;padding:0}
  .nav2 p{margin:0}
  .nav2 a{color:inherit;text-decoration:none}
  .nav2 button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer;text-align:left;letter-spacing:inherit}
  .nav2-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

  /* Top row: logo, search, utility */
  .nav2-top{display:flex;align-items:center;gap:40px;padding:20px var(--nav2-pad) 16px}
  .nav2-logo{display:inline-flex;flex:0 0 auto}
  .nav2-logo svg{width:184px;height:auto}
  .nav2-search{flex:1 1 0;min-width:0;display:flex;justify-content:center;padding-left:46px}
  .nav2-search form{position:relative;width:590px;max-width:100%}
  .nav2-search-mb{position:relative;width:100%}
  .nav2-search-icon{position:absolute;left:25px;top:50%;transform:translateY(-50%);color:var(--nav2-muted);pointer-events:none}
  .nav2-search-input{width:100%;height:48px;border:1px solid #DDD;border-radius:28px;padding:0 25px 0 54px;font-size:14px;line-height:20px;font-weight:400;letter-spacing:.2px;background:#fff;color:var(--nav2-ink);outline:none;box-shadow:0 2px 10px -6px rgba(26,20,14,.25)}
  .nav2-search-input::placeholder{color:var(--nav2-muted);opacity:1}
  .nav2-search-input:focus{border-color:var(--nav2-ink)}
  .nav2-utility{display:flex;align-items:center;justify-content:flex-end;gap:26px;flex:0 0 auto;min-width:300px}
  .nav2-utility-link{font-size:13px;line-height:18px;font-weight:400;white-space:nowrap;display:inline-flex;align-items:center;gap:8px}
  .nav2-utility-link:hover,.nav2-utility-link.is-active{color:var(--nav2-red)}
  .nav2 .nav2-cart,.nav2 .nav2-cart:hover,.nav2 .nav2-cart:focus{background:none !important;border:0 !important;box-shadow:none !important;outline-offset:2px}
  .nav2 .nav2-utility-item{display:flex;align-items:center;height:18px}
  .nav2 .nav2-cart{height:18px;line-height:18px;padding:0 !important;margin:0 !important;align-items:center}
  .nav2 .nav2-cart-icon{flex:0 0 auto;display:inline-flex;align-items:center;font-size:14px;line-height:1}
  .nav2 .nav2-cart-icon::before{line-height:1;display:block}
  .nav2 .nav2-cart,.nav2 .nav2-cart .nav2-cart-icon{color:var(--nav2-ink) !important}
  .nav2 .nav2-cart:hover,.nav2 .nav2-cart:hover .nav2-cart-icon,.nav2 .nav2-cart:focus,.nav2 .nav2-cart:focus .nav2-cart-icon{color:var(--nav2-red) !important}
  .nav2 .nav2-cart .nav2-cart-count,.nav2 .nav2-cart:hover .nav2-cart-count{background:var(--nav2-red) !important;color:#fff !important}
  .nav2 .nav2-cart-count,.nav2 .nav2-cart-count *{color:#fff !important}
  .nav2-cart-count{display:inline-flex;align-items:center;justify-content:center;min-width:27px;height:17px;padding:0 10px;border-radius:9px;background:var(--nav2-red);color:#fff;font-size:10px;line-height:14px;font-weight:800}
  .nav2-cart-count.hidden{display:none}

  /* Main bar */
  .nav2-bar{border-bottom:1px solid var(--nav2-line)}
  .nav2-bar-list{display:flex;justify-content:center;gap:42px;padding:0 var(--nav2-pad) 1px}
  .nav2-bar-link{position:relative;display:inline-flex;align-items:center;gap:9px;padding:14px 0 16px;font-size:16px;line-height:22px;font-weight:500;white-space:nowrap}
  .nav2-bar-link::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--nav2-red);opacity:0}
  .nav2-bar-link:hover,.nav2-bar-link.is-active{color:var(--nav2-red)}
  .nav2-bar-link.is-active::after{opacity:1}
  .nav2-badge{display:inline-flex;align-items:center;margin-left:10px;padding:2px 6px;border-radius:3px;background:var(--nav2-red);color:#fff;font-size:9px;line-height:11px;letter-spacing:1px;text-transform:uppercase;font-weight:800;vertical-align:2px}
  .nav2-bar-link .nav2-badge{margin-left:0;padding:4px 6px;vertical-align:0}
  .nav2-badge-text{margin-left:16px;color:var(--nav2-red);font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}

  /* Shared column pieces (mobile uses these too) */
  .nav2-col-heading{font-size:11px;line-height:13px;font-weight:800;letter-spacing:1px;text-transform:uppercase;margin-bottom:12px}
  .nav2-col-sub{font-size:13px;line-height:18px;color:var(--nav2-grey);font-weight:400}
  .nav2-link{display:block;width:100%;padding:6px 0;font-size:15px;line-height:20px;font-weight:400}
  .nav2-link:hover{color:var(--nav2-red)}
  .nav2-link--sub{font-size:14px;padding-left:12px;color:var(--nav2-grey)}
  .nav2-expand-btn{display:flex;align-items:center;justify-content:space-between;gap:8px}
  .nav2-plus{position:relative;width:10px;height:10px;flex:0 0 10px}
  .nav2-plus::before,.nav2-plus::after{content:"";position:absolute;left:0;top:50%;width:10px;height:1px;background:currentColor;transition:transform .2s}
  .nav2-plus::after{transform:rotate(90deg)}
  [aria-expanded="true"] .nav2-plus::after{transform:rotate(0)}
  .nav2-all{display:inline-block;font-size:14px;line-height:19px;font-weight:800}
  .nav2-all:hover{color:var(--nav2-red)}
  .nav2 .nav2-all--red{color:var(--nav2-red);font-size:12px;line-height:16px;letter-spacing:1px;text-transform:uppercase}
  .nav2-all--red .nav2-arrow{font-size:13px;font-weight:900;letter-spacing:.2px}
  .nav2-text-title{font-size:14px;line-height:19px;font-weight:500}
  .nav2-text-desc{font-size:13px;line-height:18px;color:var(--nav2-grey);font-weight:400;margin-top:3px}
  .nav2-swatches{display:flex;gap:16px;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
  .nav2-swatches::-webkit-scrollbar{display:none}
  .nav2-swatch{flex:0 0 72px;display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;font-size:14px;line-height:19px;font-weight:300}
  .nav2-swatch img{display:block;width:56px;height:56px;object-fit:contain}
  .nav2-swatch img.is-missing{background:#E6E6E6;border-radius:50%}
  .nav2-swatch--small{flex:0 0 40px}
  .nav2-swatch--small img{width:40px;height:40px}

  /* Desktop panels */
  .nav2-panel{position:absolute;left:0;right:0;top:100%;background:#fff;border-bottom:1px solid var(--nav2-line)}
  .nav2-panel-inner{padding:34px var(--nav2-pad) 30px}
  .nav2-panel-cols{display:flex;gap:40px;align-items:flex-start}
  .nav2-col{position:relative;flex:1 1 0;min-width:0;display:flex;flex-direction:column}
  .nav2-panel .nav2-col-heading{margin:0 0 16px}
  .nav2-panel .nav2-col-heading + .nav2-col-sub{margin:-11px 0 14px}
  .nav2-panel .nav2-divider{margin-top:12px;padding-top:13px;border-top:1px solid var(--nav2-line);display:block}
  .nav2-panel .nav2-divider--swatch{margin-top:5px;padding-top:14px}
  .nav2-panel .nav2-all--boxed{display:block;margin-top:5px;padding:10px 0;border-bottom:1px solid var(--nav2-line)}
  .nav2-panel .nav2-all--boxed + .nav2-text{margin-top:5px;padding-top:10px}
  .nav2-panel .nav2-all--after-boxed{margin-top:16px}

  /* "+" items open a flyout to the right of the column */
  .nav2 .nav2-fly-btn{display:flex;align-items:center;gap:8px;width:100%;padding:6px 0;font-size:15px;line-height:20px;font-weight:400;letter-spacing:.2px}
  .nav2-fly-btn > span:first-child{flex:1 1 auto}
  .nav2-fly-plus{flex:0 0 auto;color:var(--nav2-grey);font-weight:400}
  .nav2-fly-btn:hover,.nav2-fly-btn:hover .nav2-fly-plus,.nav2-fly-btn[aria-expanded="true"],.nav2-fly-btn[aria-expanded="true"] .nav2-fly-plus{color:var(--nav2-red)}
  .nav2-fly-btn[aria-expanded="true"] > span:first-child{font-weight:500}
  .nav2-flyout{position:absolute;left:calc(100% + 12px);top:3px;z-index:3;width:260px;padding:20px;background:#fff;border:1px solid var(--nav2-line);filter:drop-shadow(0 8px 12px rgba(46,46,46,.08))}
  .nav2-flyout[hidden]{display:none}
  .nav2-panel .nav2-flyout .nav2-col-heading{margin:0 0 14px}

  /* Large colour column (Stand Mixers) */
  .nav2-col--colour{flex:0 0 452px;gap:20px;padding-left:20px;border-left:1px solid var(--nav2-line)}
  .nav2-panel .nav2-col--colour .nav2-col-heading{margin:0}
  .nav2-col--colour .nav2-swatches:not(.nav2-swatches--small){flex-wrap:wrap;overflow:visible;gap:16px 12px;padding:4px 0 0}
  .nav2-col--colour .nav2-swatches:not(.nav2-swatches--small) .nav2-swatch{flex:0 0 66px;gap:8px;font-size:13px;line-height:17px}
  .nav2-col--colour .nav2-swatches:not(.nav2-swatches--small) .nav2-swatch img{width:44px;height:44px}
  .nav2-panel .nav2-col--colour .nav2-col-heading--label{margin:0;font-size:11px;line-height:17.6px;font-weight:900;letter-spacing:1px;color:var(--nav2-grey)}
  .nav2-col--colour .nav2-swatches--small{gap:14px;padding:5px 20px;overflow:visible;flex-wrap:wrap}
  .nav2-col--colour .nav2-all--red{align-self:flex-start}
  /* Small swatch column (Small Appliances) */
  .nav2-col--swatches .nav2-swatches{gap:14px;padding-top:0;overflow:visible;flex-wrap:wrap}
  .nav2-col--swatches .nav2-swatch{padding-bottom:4px}

  /* Promo blocks */
  .nav2-side{flex:0 0 var(--nav2-side-w,300px);width:var(--nav2-side-w,300px)}
  .nav2-panel--coffee-machines{--nav2-side-w:300px;--nav2-side-h:258px}
  .nav2-panel--cordless-collection{--nav2-side-w:420px;--nav2-side-h:258px}
  .nav2-panel--kitchenware{--nav2-side-w:640px;--nav2-side-h:274px}
  .nav2-panel--bundles-offers{--nav2-side-w:480px;--nav2-side-h:230px}
  .nav2-bottom{margin:30px auto 0;max-width:969px}

  .nav2-feature{position:relative;display:flex;overflow:hidden;background:var(--nav2-feature-bg);color:#fff;letter-spacing:.2px}
  .nav2-feature-media img{display:block;width:100%;height:100%;object-fit:cover}
  .nav2-feature-body{display:flex;flex-direction:column;align-items:flex-start}
  .nav2-feature-tag{border:1px solid rgba(255,255,255,.5);padding:4px 7px;font-size:9px;line-height:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase}
  .nav2-feature-heading{font-size:24px;line-height:32px;font-weight:500}
  .nav2-feature-text{font-size:13px;line-height:18px;font-weight:400}
  .nav2-feature-link{font-size:13px;line-height:18px;font-weight:500;text-transform:none;white-space:nowrap}

  /* Side promo, text over image (Coffee, Cordless, Bundles) */
  .nav2-feature--side{background:#2E2E2E;height:var(--nav2-side-h,258px)}
  .nav2-feature--side .nav2-feature-media{position:absolute;inset:0}
  .nav2-feature--side .nav2-feature-media::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,14,10,0) 34%,rgba(20,14,10,.72) 100%)}
  .nav2-feature--side .nav2-feature-body{position:relative;z-index:1;width:100%;margin-top:auto;padding:26px;gap:10px}
  .nav2-feature--side .nav2-feature-text{margin-top:-5px;color:rgba(255,255,255,.8)}
  .nav2-feature--side .nav2-feature-link{padding-bottom:6px;border-bottom:1px solid rgba(255,255,255,.5)}
  /* Side promo with a tag (Kitchenware): copy centred left, side gradient */
  .nav2-feature--side.nav2-feature--tagged .nav2-feature-media::after{background:linear-gradient(90deg,rgba(20,14,10,.246) 0%,rgba(20,14,10,.222) 44%,rgba(20,14,10,.084) 62%,rgba(20,14,10,0) 84%)}
  .nav2-feature--side.nav2-feature--tagged .nav2-feature-body{margin:0;align-self:stretch;justify-content:center;width:390px;max-width:100%;padding:30px;gap:8px}
  .nav2-feature--side.nav2-feature--tagged .nav2-feature-heading{font-size:20px;line-height:32px;font-weight:400}
  .nav2-feature--side.nav2-feature--tagged .nav2-feature-text{margin-top:0}
  .nav2-feature--side.nav2-feature--tagged .nav2-feature-link{margin-top:6px;padding-bottom:5px}
  .nav2-feature--side.nav2-feature--image .nav2-feature-media::after{display:none}
  .nav2-feature--side.nav2-feature--split{background:var(--nav2-feature-bg);flex-direction:row-reverse}
  .nav2-feature--side.nav2-feature--split .nav2-feature-media{position:relative;inset:auto;flex:0 0 45%}
  .nav2-feature--side.nav2-feature--split .nav2-feature-media::after{display:none}
  .nav2-feature--side.nav2-feature--split .nav2-feature-body{margin:0;justify-content:center}

  /* Bottom banner: full image, copy on the left */
  .nav2-feature--bottom{display:block;background:none}
  .nav2-feature--bottom .nav2-feature-media img{height:auto;object-fit:initial}
  .nav2-feature--bottom.nav2-feature--overlay.nav2-feature--light .nav2-feature-media::after{content:"";position:absolute;inset:0;background:rgba(0,0,0,.2)}
  .nav2-feature--bottom .nav2-feature-body{position:absolute;left:64px;top:50%;transform:translateY(-50%);z-index:1;gap:10px;max-width:470px}
  .nav2-feature--bottom .nav2-feature-heading{white-space:nowrap}
  .nav2-feature--bottom .nav2-feature-text{font-size:14px;line-height:16px;font-weight:300}
  .nav2-feature--bottom .nav2-feature-link{padding-top:20px;font-size:14px;line-height:16px;font-weight:300;text-transform:uppercase}
  .nav2-feature--bottom.nav2-feature--split{display:flex;flex-direction:row-reverse;background:var(--nav2-feature-bg)}
  .nav2-feature--bottom.nav2-feature--split .nav2-feature-media{flex:0 0 31%}
  .nav2-feature--bottom.nav2-feature--split .nav2-feature-media img{height:100%;object-fit:cover}
  .nav2-feature--bottom.nav2-feature--split .nav2-feature-body{position:static;transform:none;flex:1 1 auto;justify-content:center;padding:32px 64px;max-width:none}

  /* Bottom banner: steps layout (colour panel + 3 steps) */
  .nav2-feature--bottom.nav2-feature--steps{display:flex;align-items:center;gap:24px;min-height:165px;padding:24px 32px;background:var(--nav2-feature-bg)}
  .nav2-feature--steps .nav2-feature-body{position:static;transform:none;flex:0 0 220px;max-width:none;gap:0}
  .nav2 .nav2-feature--steps .nav2-feature-tag{border:0;padding:0;margin-bottom:10px;font-size:11px;line-height:16px;font-weight:900;letter-spacing:1px;opacity:.85}
  .nav2 .nav2-feature--steps .nav2-feature-heading{font-size:20px;line-height:26px;font-weight:400;white-space:normal}
  .nav2 .nav2-feature--steps .nav2-feature-text{margin-top:6px;font-size:13px;line-height:18px;font-weight:300}
  .nav2 .nav2-feature--steps .nav2-feature-link{padding-top:0;margin-top:22px;font-size:11px;line-height:16px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
  .nav2-steps{flex:1 1 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;min-width:0}
  .nav2-step{display:flex;align-items:center;gap:26px;min-width:0}
  .nav2-step-media{position:relative;flex:0 0 74px;width:74px;height:74px;border-radius:50%;background:#ECE6DC}
  .nav2-step-media img{position:absolute;left:50%;top:50%;width:96px;height:96px;max-width:none;object-fit:contain;transform:translate(-50%,-50%)}
  .nav2-step-num{position:absolute;left:50%;top:-10px;transform:translateX(-50%);z-index:1;display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--nav2-red);color:#fff;font-size:11px;line-height:1;font-weight:900}
  .nav2-step-copy{display:flex;flex-direction:column;gap:6px;max-width:118px}
  .nav2-step-label{font-size:11px;line-height:16px;font-weight:400;letter-spacing:1px;text-transform:uppercase;opacity:.85}
  .nav2-step-text{font-size:15px;line-height:20px;font-weight:400}
  .nav2-step-arrow{flex:0 0 auto;font-size:22px;line-height:1;font-weight:300;opacity:.7}
  .nav2 .nav2-feature--steps.nav2-feature--light .nav2-steps{color:#fff}
  .nav2 .nav2-feature--steps.nav2-feature--dark .nav2-steps{color:var(--nav2-ink)}

  /* Text colour setting */
  .nav2 .nav2-feature--light .nav2-feature-body{color:#fff}
  .nav2 .nav2-feature--dark .nav2-feature-body{color:var(--nav2-ink)}
  .nav2 .nav2-feature--side.nav2-feature--dark .nav2-feature-text{color:var(--nav2-grey)}
  .nav2 .nav2-feature--dark .nav2-feature-tag,.nav2 .nav2-feature--dark .nav2-feature-link{border-color:rgba(46,46,46,.5)}
  .nav2 .nav2-feature--side.nav2-feature--dark .nav2-feature-media::after{display:none}

  /* Inspiration flyout (utility card) */
  .nav2-panel--card{left:auto;right:var(--nav2-pad);top:calc(100% - 54px);width:auto;border:1px solid var(--nav2-line);border-radius:4px;filter:drop-shadow(0 8px 12px rgba(46,46,46,.08));overflow:visible;max-height:none}
  .nav2-panel--card .nav2-panel-inner{padding:32px}
  .nav2-panel--card .nav2-panel-cols{gap:28px;align-items:stretch}
  .nav2-panel--card .nav2-col{flex:0 0 auto}
  .nav2-panel--card .nav2-col{min-width:180px}
  .nav2-panel--card .nav2-link{white-space:nowrap}
  .nav2-panel--inspiration .nav2-col:nth-child(1){width:112px;min-width:0}
  .nav2-panel--inspiration .nav2-col:nth-child(2){width:200px;min-width:0}
  .nav2-panel--inspiration .nav2-link{display:flex;align-items:center;gap:9px}
  .nav2-panel--inspiration .nav2-link::after{content:"\2192";color:var(--nav2-muted)}
  .nav2-panel--inspiration .nav2-link:hover::after{color:var(--nav2-red)}
  .nav2-panel--card .nav2-side{flex:0 0 321px;width:321px;padding-left:28px;border-left:1px solid var(--nav2-line)}
  .nav2-feature--card{flex-direction:column;background:none;color:var(--nav2-ink)}
  .nav2-feature--card .nav2-feature-media{height:124px}
  .nav2 .nav2-feature--card .nav2-feature-body{background:#F0F0F0;padding:22px 24px;gap:6px;color:var(--nav2-ink)}
  .nav2-feature--card .nav2-feature-heading{font-size:20px;line-height:28px;font-weight:500}
  .nav2 .nav2-feature--card .nav2-feature-text{font-size:13px;line-height:20.8px;color:var(--nav2-muted)}
  .nav2 .nav2-feature--card .nav2-feature-link{margin-top:6px;padding-bottom:5px;border-bottom:1px solid var(--nav2-red);color:var(--nav2-red);font-size:13px;line-height:16px;font-weight:500}
  .nav2 .nav2-feature--card .nav2-feature-tag{color:var(--nav2-red);border-color:currentColor}

  .nav2-overlay{position:fixed;left:0;right:0;bottom:0;top:var(--header-height,170px);background:rgba(0,0,0,.35);z-index:40}
  @media (min-width:1024px){.nav2-mb{display:none !important}}

  /* Mobile drawer (Figma: Mobile Nav / content frames) */
  .nav2-drawer{position:fixed;inset:0;z-index:1000;background:#fff;overflow:hidden;flex-direction:column}
  .nav2-drawer .nav2-drawer-head{width:100%;flex:0 0 auto}
  .nav2-drawer-head{position:relative;display:flex;align-items:center;justify-content:space-between;height:60px;padding:0 20px}
  .nav2 .nav2-icon-btn{width:40px;height:40px;display:inline-flex;align-items:center;justify-content:flex-start}
  .nav2-drawer-head .nav2-logo{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%)}
  .nav2-logo--sm svg{width:103px}
  .nav2-mb-actions{display:flex;align-items:center;gap:14px}
  .nav2 .nav2-wish-mb{display:inline-flex;align-items:center;justify-content:center;color:var(--nav2-ink)}
  .nav2-cart-mb{display:inline-flex;align-items:center;gap:5px;font-size:13px;line-height:20.8px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
  .nav2-cart-mb .nav2-cart-count{min-width:17px;height:17px;padding:0 5px;font-size:10px;line-height:16px;font-weight:900}
  .nav2-screen{position:absolute;top:60px;left:0;right:0;bottom:0;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 20px;background:#fff;transform:translateX(100%);visibility:hidden;transition:transform .4s ease-in-out,visibility 0s linear .4s;will-change:transform}
  .nav2-screen.is-active,.nav2-screen--main{visibility:visible;transition:transform .4s ease-in-out,visibility 0s}
  .nav2-screen:not(.nav2-screen--main){top:0;z-index:3;padding-bottom:26px}
  .nav2-screen.is-active{transform:none}
  .nav2-screen--main{transform:none}
  .nav2-screen--main.is-behind{transform:translateX(-30%)}
  .nav2-search-mb{max-width:none;margin:0}
  .nav2-search-mb .nav2-search-input{height:46px;border:0;border-radius:28px;background:#F0F0F0;padding:0 10px 0 36px;font-size:15px;line-height:24px;letter-spacing:0;box-shadow:none;text-overflow:clip}
  .nav2-search-mb .nav2-search-input::placeholder{font-size:14px;letter-spacing:0}
  .nav2-search-mb .nav2-search-icon{overflow:visible}
  .nav2-search-mb .nav2-search-input::placeholder{color:var(--nav2-grey)}
  .nav2-search-mb .nav2-search-icon{left:13px;color:var(--nav2-muted)}
  .nav2-mb-list{padding-top:20px}
  .nav2 .nav2-mb-item{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:56px;padding:0;font-size:18px;line-height:28px;font-weight:400;letter-spacing:.2px;color:var(--nav2-ink)}
  .nav2-mb-item .nav2-badge-text{margin-left:7px;font-size:10px;line-height:16px;font-weight:900;letter-spacing:1px;vertical-align:2px}
  .nav2-chev{flex:0 0 auto;color:var(--nav2-muted);margin-right:4px}
  /* Promo: main menu */
  .nav2-feature--mobile{flex-direction:column;background:none;color:var(--nav2-ink);margin:28px 0 26px}
  .nav2-feature--mobile .nav2-feature-media{aspect-ratio:350/190;background:#F0F0F0}
  .nav2 .nav2-feature--mobile .nav2-feature-body{padding:12px 0 0;gap:5px;color:var(--nav2-ink)}
  .nav2 .nav2-feature--mobile .nav2-feature-tag{border:0;padding:0;color:var(--nav2-red);font-size:11px;line-height:17.6px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
  .nav2 .nav2-feature--mobile .nav2-feature-heading{font-size:20px;line-height:25px;font-weight:500;letter-spacing:-.5px}
  .nav2 .nav2-feature--mobile .nav2-feature-text{font-size:13px;line-height:18px;color:var(--nav2-grey)}
  .nav2 .nav2-feature--mobile .nav2-feature-link{margin-top:4px;color:var(--nav2-red);font-size:12px;line-height:16px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
  .nav2-screen--main .nav2-feature--mobile{margin:28px 0 36px}
  .nav2-screen--main .nav2-feature--mobile .nav2-feature-media{aspect-ratio:350/140}
  .nav2 .nav2-screen--main .nav2-feature--mobile .nav2-feature-body{padding-top:11px;gap:8px}
  .nav2 .nav2-screen--main .nav2-feature--mobile .nav2-feature-link{margin-top:-2px}
  .nav2 .nav2-mb-utility{margin:0 -20px;padding:22px 20px 26px;background:#F0F0F0}
  .nav2-feature--mobile .nav2-feature-media{position:relative;display:block;width:100%;overflow:hidden;min-height:0}
  .nav2-feature--mobile .nav2-feature-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .nav2 .nav2-drawer a.nav2-all.nav2-all--shopall{color:var(--nav2-red);font-weight:900}
  .nav2-mb-hero{margin:0 -20px}
  .nav2-mb-hero .nav2-feature--mobile{margin:0 0 0}
  .nav2-mb-hero .nav2-feature--mobile .nav2-feature-media{aspect-ratio:388/260}
  .nav2 .nav2-mb-hero .nav2-feature--mobile .nav2-feature-body{padding:13px 20px 0;gap:8px}
  .nav2 .nav2-mb-hero .nav2-feature--mobile .nav2-feature-tag{color:var(--nav2-grey)}
  .nav2 .nav2-mb-hero .nav2-feature--mobile .nav2-feature-link{margin-top:-2px}
  .nav2 .nav2-screen--util .nav2-mb-group .nav2-link{min-height:52px;padding:12px 0;font-size:18px;line-height:28px}
  .nav2-screen--util .nav2-mb-heading{display:none}
  .nav2-screen--util .nav2-mb-group{padding-top:28px}
  .nav2-screen--util .nav2-mb-group + .nav2-acc{margin-top:30px}
  .nav2-mb-utility a{display:flex;align-items:center;min-height:44px;font-size:14px;line-height:20px;letter-spacing:.2px;color:var(--nav2-ink)}
  /* Category screens */
  .nav2-screen-head{position:sticky;top:0;z-index:2;display:flex;align-items:center;justify-content:space-between;height:57px;background:#fff;margin:0 -20px;padding:0 16px 0 14px;border-bottom:1px solid #DDD}
  .nav2 .nav2-back{display:flex;align-items:center;gap:10px;height:44px;font-size:13px;line-height:20.8px;font-weight:900;letter-spacing:1px;text-transform:uppercase;color:var(--nav2-ink)}
  .nav2-back svg{margin:0 2px}
  .nav2 .nav2-screen-close{width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;font-size:20px;line-height:32px;color:var(--nav2-grey)}
  .nav2 .nav2-mb-shopall{display:block;margin:0;padding-top:22px;color:var(--nav2-red);font-size:15px;line-height:24px;font-weight:900;letter-spacing:.2px}
  .nav2-mb-heading{padding-top:26px;font-size:11px;line-height:17.6px;font-weight:900;letter-spacing:1px;text-transform:uppercase;color:var(--nav2-grey)}
  .nav2-mb-group{padding-top:0}
  .nav2-mb-heading + *{margin-top:6px}
  .nav2 .nav2-mb-group .nav2-link,.nav2 .nav2-mb-group .nav2-expand-btn{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12.5px 0 13.5px;font-size:15px;line-height:24px;font-weight:400;letter-spacing:.2px;color:var(--nav2-ink)}
  .nav2-mb-new{flex:0 0 auto;margin-left:8px;color:var(--nav2-red);font-size:10px;line-height:16px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
  .nav2 .nav2-drawer .nav2-all{display:block;padding:6px 0 13.5px;font-size:15px;line-height:24px;font-weight:500;letter-spacing:.2px;color:var(--nav2-ink)}
  .nav2 .nav2-drawer .nav2-all:last-child{padding-bottom:0}
  .nav2-drawer .nav2-text{padding:12.5px 0 6px}
  .nav2-drawer .nav2-text-title{font-size:15px;line-height:24px;font-weight:500}
  .nav2-drawer .nav2-text-desc{margin-top:2px;font-size:13px;line-height:18px;color:var(--nav2-grey)}
  .nav2-acc{margin:0 -20px;border-top:1px solid #DDD;border-bottom:1px solid #DDD}
  .nav2-acc + .nav2-acc{border-top:0}
  .nav2-mb-group + .nav2-acc,.nav2 .nav2-mb-shopall + .nav2-acc{margin-top:26px}
  .nav2 .nav2-acc-btn{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:58px;padding:19px 20px;font-size:13px;line-height:20.8px;font-weight:900;letter-spacing:1px;text-transform:uppercase;color:var(--nav2-ink)}
  .nav2-acc-icon{width:16px;text-align:center;font-size:18px;line-height:22px;font-weight:500;letter-spacing:.2px;color:var(--nav2-grey)}
  .nav2-acc-icon::before{content:"+"}
  [aria-expanded="true"] > .nav2-acc-icon{color:var(--nav2-ink)}
  [aria-expanded="true"] > .nav2-acc-icon::before{content:"\2212"}
  .nav2-acc-body{padding:6px 20px 20px;background:#F8F8F8}
  .nav2 .nav2-acc-body .nav2-link,.nav2 .nav2-acc-body .nav2-expand-btn{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:46px;padding:10.5px 0 11.5px;font-size:15px;line-height:24px;font-weight:400;letter-spacing:.2px;color:var(--nav2-ink)}
  .nav2 .nav2-acc-body .nav2-link--sub{padding-left:12px;color:var(--nav2-grey)}
  .nav2-acc--colour .nav2-acc-body{padding:4px 0 22px}
  .nav2-swatches--mb{flex-wrap:nowrap;overflow-x:auto;gap:16px;padding:16px 20px 0;scrollbar-width:none}
  .nav2-swatches--mb .nav2-swatch{flex:0 0 72px;gap:10px;font-size:14px;line-height:19px;font-weight:300}
  .nav2-swatches--mb .nav2-swatch img{width:56px;height:56px}
  html.nav2-lock,html.nav2-lock body{overflow:hidden}

  /* Black Friday (BFCM variant) */
  .nav2 .nav2-bar-link--bf{color:var(--nav2-red)}
  .nav2 .nav2-bar-list{justify-content:space-between;gap:10px;max-width:1440px;margin:0 auto;padding:0 var(--nav2-pad) 1px}
  @media (max-width:1180px){.nav2 .nav2-bar-list{padding:0 20px 1px}.nav2 .nav2-bar-link{font-size:14px}.nav2 .nav2-bar-link .nav2-badge{padding:3px 5px}}
  @media (max-width:1100px){.nav2 .nav2-bar-link{font-size:13px;gap:6px}}
  .nav2-panel--bf .nav2-panel-inner{padding-bottom:34px}
  .nav2-panel--bf .nav2-panel-cols{max-width:974px;margin:0 auto;justify-content:space-between;gap:24px}
  .nav2-panel--bf .nav2-col{flex:0 0 auto}
  .nav2-panel--bf .nav2-col-sub{display:none}
  .nav2-panel--bf .nav2-bottom{margin-top:40px;max-width:974px}
  .nav2 .nav2-mb-item--bf{color:var(--nav2-red)}
  .nav2-bf-main-banner .nav2-feature--mobile{margin:24px 0 28px}
  .nav2-bf-main-banner .nav2-feature--mobile .nav2-feature-media,.nav2-bf-banner .nav2-feature--mobile .nav2-feature-media{aspect-ratio:350/236}
  .nav2-screen--bf{padding-bottom:32px}
  .nav2 .nav2-screen--bf .nav2-back{color:var(--nav2-red)}
  .nav2 .nav2-screen--bf .nav2-back svg{color:var(--nav2-ink)}
  .nav2-bf-banner{padding-top:16px}
  .nav2-bf-banner .nav2-feature--mobile{margin:0}
  /* Mobile promo images: show the full image at its own size, no cropping */
  .nav2 .nav2-feature--mobile .nav2-feature-media,.nav2 .nav2-screen--main .nav2-feature--mobile .nav2-feature-media,.nav2 .nav2-mb-hero .nav2-feature--mobile .nav2-feature-media,.nav2 .nav2-bf-main-banner .nav2-feature--mobile .nav2-feature-media,.nav2 .nav2-bf-banner .nav2-feature--mobile .nav2-feature-media{aspect-ratio:auto;background:none}
  .nav2 .nav2-feature--mobile .nav2-feature-media img{position:static;inset:auto;width:100%;height:auto;object-fit:initial}
  .nav2 .nav2-bf-label{margin:32px 0 4px;padding-top:24px;border-top:1px solid #E6E6E6;color:var(--nav2-red);font-size:11px;line-height:normal;font-weight:900;letter-spacing:1px;text-transform:uppercase}
  .nav2-bf-acc{border-bottom:1px solid #E6E6E6}
  .nav2 .nav2-bf-acc-btn{display:flex;align-items:center;gap:12px;width:100%;padding:16px 4px 16px 0}
  .nav2-bf-text{flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:3px;line-height:normal}
  .nav2-bf-title{font-size:17px;font-weight:500;letter-spacing:.2px;color:var(--nav2-ink)}
  .nav2-bf-sub{font-size:13px;font-weight:400;letter-spacing:.1px;color:#6E6E6E}
  .nav2-bf-acc-btn[aria-expanded="true"] .nav2-bf-title{color:var(--nav2-red)}
  .nav2-bf-acc-btn[aria-expanded="true"] .nav2-bf-sub{display:none}
  .nav2-bf-chev{position:relative;flex:0 0 14px;width:14px;height:14px}
  .nav2-bf-chev::before{content:"";position:absolute;left:3px;top:1px;width:8px;height:8px;border-right:1px solid #969696;border-bottom:1px solid #969696;transform:rotate(45deg)}
  .nav2-bf-acc-btn[aria-expanded="true"] .nav2-bf-chev::before{top:5px;border-color:var(--nav2-red);transform:rotate(-135deg)}
  .nav2-bf-chev--right::before{left:1px;top:3px;transform:rotate(-45deg)}
  .nav2-bf-acc-body{padding:0 0 14px 14px}
  .nav2 .nav2-bf-acc-body .nav2-link{display:flex;align-items:center;padding:10px 0;font-size:15px;line-height:normal;font-weight:400;letter-spacing:.2px;color:var(--nav2-ink)}
  .nav2 .nav2-bf-card{display:flex;align-items:center;gap:12px;margin-top:24px;padding:16px 18px 16px 16px;border:1px solid #D1D1D1;color:var(--nav2-ink)}
  .nav2-bf-card + .nav2-bf-card{margin-top:12px}

  @media (max-width:1279px){.nav2{--nav2-pad:32px}.nav2-top{gap:24px}.nav2-search{padding-left:0}.nav2-utility{min-width:0;gap:16px}.nav2-bar-list{gap:24px}.nav2-bar-link{font-size:15px}.nav2-panel-cols{gap:28px}.nav2-col--colour{flex-basis:420px}}
  @media (max-width:1023px){
    .nav2-dk{display:none !important}
    .nav2-mb{display:flex}
    .nav2-drawer[hidden]{display:none}
    .nav2-top{gap:12px;padding:10px 20px;min-height:60px;justify-content:space-between}
    .nav2-logo{position:absolute;left:50%;transform:translateX(-50%)}
    .nav2-logo svg{width:120px}
    .nav2-burger{width:40px;height:40px;align-items:center}
  }
</style>

<script>
  (function () {
    var root = document.querySelector('[data-nav2]');
    if (!root || root.dataset.nav2Ready) return;
    root.dataset.nav2Ready = '1';
    var overlay = document.querySelector('[data-nav2-overlay]');
    var desktop = window.matchMedia('(min-width: 1024px)');
    var openId = null, openTimer = null, closeTimer = null, lastTrigger = null;

    function triggers(id) { return root.querySelectorAll('[data-nav2-trigger="' + id + '"]'); }
    function panel(id) { return root.querySelector('[data-nav2-panel="' + id + '"]'); }

    function openPanel(id, trigger) {
      clearTimeout(closeTimer);
      if (openId === id) return;
      closePanel();
      var p = panel(id);
      if (!p) return;
      p.hidden = false;
      triggers(id).forEach(function (t) { t.setAttribute('aria-expanded', 'true'); t.classList.add('is-active'); });
      if (overlay) overlay.hidden = false;
      openId = id;
      lastTrigger = trigger || null;
    }
    function closeFlyouts(scope, except) {
      (scope || root).querySelectorAll('[data-nav2-flyout][aria-expanded="true"]').forEach(function (b) {
        if (b === except) return;
        b.setAttribute('aria-expanded', 'false');
        if (b.nextElementSibling) b.nextElementSibling.hidden = true;
      });
    }
    function openFlyout(btn) {
      closeFlyouts(btn.closest('[data-nav2-panel]'), btn);
      btn.setAttribute('aria-expanded', 'true');
      if (btn.nextElementSibling) btn.nextElementSibling.hidden = false;
    }
    function closePanel() {
      clearTimeout(openTimer);
      closeFlyouts();
      if (!openId) return;
      var p = panel(openId);
      if (p) p.hidden = true;
      triggers(openId).forEach(function (t) { t.setAttribute('aria-expanded', 'false'); t.classList.remove('is-active'); });
      if (overlay) overlay.hidden = true;
      openId = null;
    }
    function scheduleClose() { clearTimeout(openTimer); clearTimeout(closeTimer); closeTimer = setTimeout(closePanel, 220); }

    root.querySelectorAll('[data-nav2-trigger]').forEach(function (t) {
      var id = t.getAttribute('data-nav2-trigger');
      t.addEventListener('mouseenter', function () {
        if (!desktop.matches) return;
        clearTimeout(closeTimer); clearTimeout(openTimer);
        openTimer = setTimeout(function () { openPanel(id, t); }, openId ? 0 : 120);
      });
      t.addEventListener('mouseleave', function () { if (desktop.matches) scheduleClose(); });
      t.addEventListener('click', function (e) {
        if (!desktop.matches) return;
        if (openId !== id) { e.preventDefault(); openPanel(id, t); }
      });
      t.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowDown' || e.key === ' ') {
          e.preventDefault(); openPanel(id, t);
          var first = panel(id) && panel(id).querySelector('a, button');
          if (first) first.focus();
        }
      });
    });
    root.querySelectorAll('[data-nav2-panel]').forEach(function (p) {
      p.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
      p.addEventListener('mouseleave', scheduleClose);
      p.addEventListener('focusout', function (e) {
        if (!root.contains(e.relatedTarget) || (e.relatedTarget && !p.contains(e.relatedTarget) && !e.relatedTarget.hasAttribute('data-nav2-trigger'))) scheduleClose();
      });
    });
    if (overlay) overlay.addEventListener('click', closePanel);
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (openId) { var t = lastTrigger; closePanel(); if (t) t.focus(); }
      if (!drawer.hidden) closeDrawer();
    });

    root.querySelectorAll('[data-nav2-flyout]').forEach(function (b) {
      var wrap = b.parentNode, flyTimer = null;
      b.addEventListener('mouseenter', function () { if (!desktop.matches) return; clearTimeout(flyTimer); openFlyout(b); });
      wrap.addEventListener('mouseenter', function () { clearTimeout(flyTimer); });
      wrap.addEventListener('mouseleave', function () {
        if (!desktop.matches) return;
        flyTimer = setTimeout(function () { b.setAttribute('aria-expanded', 'false'); if (b.nextElementSibling) b.nextElementSibling.hidden = true; }, 200);
      });
    });
    root.addEventListener('click', function (e) {
      var fly = e.target.closest('[data-nav2-flyout]');
      if (fly) {
        if (fly.getAttribute('aria-expanded') === 'true') closeFlyouts(); else openFlyout(fly);
        return;
      }
      if (openId && !e.target.closest('.nav2-flyout')) closeFlyouts();
      var btn = e.target.closest('[data-nav2-expand]');
      if (!btn) return;
      var body = btn.nextElementSibling;
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      if (body) body.hidden = open;
    });

    var drawer = root.querySelector('[data-nav2-drawer]');
    var burger = root.querySelector('[data-nav2-open]');
    var mainScreen = drawer.querySelector('[data-nav2-screen="main"]');
    function openDrawer() {
      var topRow = root.querySelector('.nav2-top');
      drawer.style.top = topRow ? Math.max(0, topRow.getBoundingClientRect().top) + 'px' : '0px';
      drawer.hidden = false;
      document.documentElement.classList.add('nav2-lock');
      if (burger) burger.setAttribute('aria-expanded', 'true');
      var c = drawer.querySelector('[data-nav2-close]'); if (c) c.focus();
    }
    function closeDrawer() {
      drawer.hidden = true;
      document.documentElement.classList.remove('nav2-lock');
      if (burger) { burger.setAttribute('aria-expanded', 'false'); burger.focus(); }
      drawer.querySelectorAll('[data-nav2-screen]').forEach(function (s) {
        if (s === mainScreen) { s.classList.remove('is-behind'); return; }
        s.classList.remove('is-active');
      });
    }
    if (burger) burger.addEventListener('click', openDrawer);
    root.querySelectorAll('[data-nav2-chat]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        if (typeof window.Genesys === 'function') { window.Genesys('command', 'Messenger.open'); }
      });
    });
    drawer.querySelectorAll('[data-nav2-close]').forEach(function (c) { c.addEventListener('click', closeDrawer); });
    drawer.addEventListener('click', function (e) {
      var opener = e.target.closest('[data-nav2-screen-open]');
      if (opener) {
        var s = drawer.querySelector('[data-nav2-screen="' + opener.getAttribute('data-nav2-screen-open') + '"]');
        if (!s) return;
        s.classList.add('is-active'); mainScreen.classList.add('is-behind');
        s.scrollTop = 0;
        var back = s.querySelector('[data-nav2-back]'); if (back) setTimeout(function () { back.focus({ preventScroll: true }); }, 420);
        return;
      }
      var back = e.target.closest('[data-nav2-back]');
      if (back) {
        var screen = back.closest('[data-nav2-screen]');
        screen.classList.remove('is-active');
        mainScreen.classList.remove('is-behind');
      }
    });

    desktop.addEventListener('change', function () { closePanel(); if (!drawer.hidden) closeDrawer(); });

    /* Keep the cart count pills in sync with the theme's cart updates */
    var main = document.getElementById('CartCount');
    if (main && window.MutationObserver) {
      new MutationObserver(function () {
        var n = (main.textContent || '').replace(/[^0-9]/g, '') || '0';
        if (main.textContent !== n) main.textContent = n;
        root.querySelectorAll('[data-nav2-cart-count]').forEach(function (el) {
          if (el !== main) el.textContent = n;
          el.classList.toggle('hidden', n === '0');
        });
      }).observe(main, { childList: true, characterData: true, subtree: true });
    }
  })();
</script>
</div>

<script>
    const headerContainer = document.querySelector('.header-container');
    
    function updateHeaderHeight() {
        document.documentElement.style.setProperty('--header-height', `${headerContainer.offsetHeight}px`);
        document.documentElement.style.setProperty('--window-width', `${document.documentElement.clientWidth}px`);
    }
    
    var resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(updateHeaderHeight, 500);
    });
    updateHeaderHeight();
</script>



<!-- search mb -->
<div data-search-content data-name="search" class="lg:hidden" data-height-equal-to-header data-kb-content data-kb-mobile="true">
    <span class="overlay" data-search-close data-name="search"></span>

    
    <form method="get" action="/collections/search-results-page" class="bg-gray-200 p-8px">
        <div class="form-group bg-white rounded-full flex">
            <div class="input">
                <label class="sr-only" for="search-accordion-term">Search</label>
                <input type="text" placeholder="Search" name="s" id="search-accordion-term" class="ss__autocomplete__input form-control text-15px leading-24px py-8px pl-24px">
            </div>
            <button>
                <span class="sr-only">Search</span>
                <icon class="icon-search text-14px text-grey-100 w-40px h-40px"></icon>
            </button>
        </div>
    </form>
    
</div>
<!-- end search mb -->

<!-- cart popup -->
<span class="no-scroll hidden"></span>
<div id="cart-popup" data-shopping-cart-content="" class="fixed left-0 top-0 w-full h-full">
    <span class="overlay bg-black-40 z-10 absolute" data-shopping-cart-close=""></span>
    <div class="box z-20 absolute right-0 top-0 h-full bg-white sidebar">
        <span data-cart-loading data-shopping-cart-loading class="absolute z-50 left-0 top-0 w-full h-full bg-black-8"></span>
        <div class="h-full flex flex-col">
            <div data-cart-top="">
                <div class="px-24px">
                    <div class="flex items-center justify-between py-16px">
                        <span class="block text-black-100 text-28px leading-38px lg:text-32px lg:leading-44px tracking-0.5px font-medium">Cart <i class="not-italic text-12px leading-16px tracking-1px uppercase">(<span data-cart-count>0</span> item<span data-cart-count-plural class="hidden">s</span>)</i></span>
                        <a href="#" class="flex items-center justify-center" data-shopping-cart-close="" data-name="shopping-cart">
                            <span class="sr-only">Close cart popup</span>
                            <span class="icon-close text-14px w-24px h-24px text-black-100"></span>
                        </a>
                    </div>
                </div>
                <div class="border-t border-solid border-light-grey-100 bg-light-grey-100" data-cart-mss data-sale='You qualify for <i class="not-italic text-red-100">free delivery!</i>' data-empty="Your cart is empty">
                    <span class="block text-12px leading-12px tracking-1px font-medium uppercase pt-13px pb-11px border-b-3 border-solid border-red-100 text-center " data-cart-mss-content>Your cart is empty</span>
                </div>
            </div>
            <div data-cart-bottom="" class="relative h-full flex flex-col overflow-hidden"><div data-cart-list class="h-full overflow-auto hide-scrollbar px-24px flex flex-col gap-16px py-16px md:py-20px xl:py-24px" > 
                    
                    <div class="text-center py-47px" data-cart-empty-content>
                        <img src="https://cdn.shopify.com/s/files/1/0172/8692/2294/files/Price_2_small_crop_center.png?v=1635389075" alt="PRICE MATCH POLICY" class="w-48px h-48px mx-auto mb-28px" loading="lazy">
                        <p class="text-12px leading-16px tracking-1px text-black-100 uppercase mb-7px">PRICE MATCH POLICY</p>
                        <p class="text-12px leading-18px tracking-1px text-black-100">Our price promise.<br/><a href="/pages/price-match-policy" class="underline transition-colors duration-250 hover:text-red-100">Learn more</a></p>
                    </div>
                </div>
                <div id="farage-cart-popup-summary-wrapper" data-cart-sumary="" class="sticky w-full left-0 bottom-0 z-40"><ka-cart-usp>
  <text-box>
    <text>
      <svg width="32" height="33" viewBox="0 0 32 33" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M11 27.1895C11.5523 27.1895 12 26.7463 12 26.1995C12 25.6527 11.5523 25.2095 11 25.2095C10.4477 25.2095 10 25.6527 10 26.1995C10 26.7463 10.4477 27.1895 11 27.1895Z" stroke="#C41230" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M25 27.1895C25.5523 27.1895 26 26.7463 26 26.1995C26 25.6527 25.5523 25.2095 25 25.2095C24.4477 25.2095 24 25.6527 24 26.1995C24 26.7463 24.4477 27.1895 25 27.1895Z" stroke="#C41230" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M3 5.40955H7L10 22.2395H26" stroke="#C41230" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10 18.2795H25.59C25.7056 18.2796 25.8177 18.24 25.9072 18.1674C25.9967 18.0949 26.0579 17.9939 26.0807 17.8816L27.8807 8.97167C27.8952 8.89982 27.8933 8.82568 27.8755 8.75459C27.8575 8.6835 27.8239 8.61724 27.7769 8.56059C27.73 8.50394 27.6709 8.45831 27.604 8.427C27.5371 8.39569 27.464 8.37948 27.39 8.37952H8" stroke="#C41230" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Purchasing on KitchenAid.com.au
    </text>
  </text-box>
  <list-box>
    <button
      target="_self"
      onclick="
        window.ingeniousai.open();
        if (document.getElementById('web-messenger-container')) {
          document.getElementById('web-messenger-container').classList.add('chatbox-opened-via-mini-cart');
        }
        if (window.ingeniousai.getConversations().length === 0) {
          window.ingeniousai.createConversation({ displayName: 'KitchenAid Chatbot' });
        }
      "
      class="item-box"
    >
