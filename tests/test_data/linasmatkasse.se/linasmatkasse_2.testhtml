ext-sm w-24 justify-center whitespace-nowrap">1 förp</span></label><span class="text-mono-md"><label for="_R_2cpdpb96_" class="cursor-pointer text-text-base">Grönsaksbuljong</label></span></div></li><li><div class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 py-2"><input id="_R_2kpdpb96_" type="checkbox" class="peer sr-only"/><label for="_R_2kpdpb96_" class="cursor-pointer justify-self-start peer-focus-visible:ring-2 peer-focus-visible:ring-border-contrast"><span class="inline-flex items-center justify-center gap-1 overflow-hidden text-text-base bg-surface-muted rounded-sm px-2 py-1 text-text-sm w-24 justify-center whitespace-nowrap">1 msk</span></label><span class="text-mono-md"><label for="_R_2kpdpb96_" class="cursor-pointer text-text-base">Balsamvinäger<span class="text-text-muted"> (<!-- -->Svaveldioxid<!-- -->)</span></label></span></div></li></ul></div><div class="flex flex-col gap-3"><h3 class="text-text-lg text-text-base"><strong>Fetaosttopping</strong></h3><ul class="flex flex-col gap-1"><li><div class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 py-2"><input id="_R_d9dpb96_" type="checkbox" class="peer sr-only"/><label for="_R_d9dpb96_" class="cursor-pointer justify-self-start peer-focus-visible:ring-2 peer-focus-visible:ring-border-contrast"><span class="inline-flex items-center justify-center gap-1 overflow-hidden text-text-base bg-surface-muted rounded-sm px-2 py-1 text-text-sm w-24 justify-center whitespace-nowrap">20 g</span></label><span class="text-mono-md"><label for="_R_d9dpb96_" class="cursor-pointer text-text-base">Bladpersilja</label></span></div></li><li><div class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 py-2"><input id="_R_l9dpb96_" type="checkbox" class="peer sr-only"/><label for="_R_l9dpb96_" class="cursor-pointer justify-self-start peer-focus-visible:ring-2 peer-focus-visible:ring-border-contrast"><span class="inline-flex items-center justify-center gap-1 overflow-hidden text-text-base bg-surface-muted rounded-sm px-2 py-1 text-text-sm w-24 justify-center whitespace-nowrap">50 g</span></label><span class="text-mono-md"><label for="_R_l9dpb96_" class="cursor-pointer text-text-base">Fetaost<span class="text-text-muted"> (<!-- -->Mjölk, Laktos<!-- -->)</span></label></span></div></li></ul></div><div class="flex flex-col gap-3"><h3 class="text-text-lg text-text-base"><strong>Till servering</strong></h3><ul class="flex flex-col gap-1"><li><div class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 py-2"><input id="_R_dpdpb96_" type="checkbox" class="peer sr-only"/><label for="_R_dpdpb96_" class="cursor-pointer justify-self-start peer-focus-visible:ring-2 peer-focus-visible:ring-border-contrast"><span class="inline-flex items-center justify-center gap-1 overflow-hidden text-text-base bg-surface-muted rounded-sm px-2 py-1 text-text-sm w-24 justify-center whitespace-nowrap">200 g</span></label><span class="text-mono-md"><label for="_R_dpdpb96_" class="cursor-pointer text-text-base">Linguine<span class="text-text-muted"> (<!-- -->Vete<!-- -->)</span></label></span></div></li><li><div class="grid grid-cols-[auto_1fr] items-baseline gap-x-3 py-2"><input id="_R_lpdpb96_" type="checkbox" class="peer sr-only"/><label for="_R_lpdpb96_" class="cursor-pointer justify-self-start peer-focus-visible:ring-2 peer-focus-visible:ring-border-contrast"><span class="inline-flex items-center justify-center gap-1 overflow-hidden text-text-base bg-surface-muted rounded-sm px-2 py-1 text-text-sm w-24 justify-center whitespace-nowrap">60 g</span></label><span class="text-mono-md"><label for="_R_lpdpb96_" class="cursor-pointer text-text-base">Ruccola</label></span></div></li></ul></div></div></div><div class="flex flex-col gap-6"><div class="flex flex-col gap-2"><p class="flex items-center gap-1 text-text-md text-text-base"><strong>Basvaror</strong><span aria-hidden="true" class="flex items-center gap-1 text-text-sm">(<span class="size-1.5 rounded-full bg-surface-info-solid"></span>)</span></p><p class="text-text-md text-text-muted">Bakplåtspapper<!-- -->, <!-- -->Salt<!-- -->, <!-- -->Olivolja<!-- -->, <!-- -->Socker<!-- -->, <!-- -->Svartpeppar</p></div><div class="flex flex-col gap-2"><p class="text-text-md text-text-base"><strong>Näringsinnehåll per portion</strong></p><dl class="flex flex-col gap-1 text-text-md text-text-muted"><div class="flex gap-1"><dt>Energi<!-- -->:</dt><dd>537<!-- --> <!-- -->kcal</dd></div><div class="flex gap-1"><dt>Fett<!-- -->:</dt><dd>9<!-- --> <!-- -->g</dd></div><div class="flex gap-1"><dt>Kolhydrater<!-- -->:</dt><dd>91<!-- --> <!-- -->g</dd></div><div class="flex gap-1"><dt>Protein<!-- -->:</dt><dd>24<!-- --> <!-- -->g</dd></div></dl></div><div class="flex flex-col gap-2"><p class="text-text-md text-text-base"><strong>Klimatavtryck per portion</strong></p><span class="text-text-md text-text-base">CO₂:<!-- --> <!-- -->0.917 kg CO₂e</span></div><div role="note" class="overflow-hidden rounded-md p-4 flex flex-col gap-2 bg-surface-muted text-text-base"><div class="flex items-start gap-2"><div class="flex flex-1 items-center gap-2"><div class="flex-1 text-text-md"><strong>Information om allergener</strong></div></div></div><p class="text-text-md">Allergener är tänkta som vägledande information och baseras på ingredienserna och inte &quot;spår av&quot;. Vänligen kontrollera innehållet i varorna du får i kassen.</p></div></div></section></div><div class="min-[600px]:block hidden"><section class="flex flex-col gap-8"><div class="flex flex-col gap-1"><div class="flex items-center justify-between gap-4"><h2 class="text-heading-lg">Gör så här</h2></div><p class="text-text-sm text-text-muted">Tryck på ett steg för att bocka av det</p></div><ol class="flex list-none flex-col"><li><div class="flex gap-3"><div class="flex w-6 flex-col items-center"><button type="button" aria-pressed="false" aria-label="Steg {1}" class="flex size-6 shrink-0 items-center justify-center rounded-full text-text-sm text-text-base border border-text-muted pointer-coarse:relative pointer-coarse:after:absolute pointer-coarse:after:top-1/2 pointer-coarse:after:left-1/2 pointer-coarse:after:size-full pointer-coarse:after:min-h-11 pointer-coarse:after:min-w-11 pointer-coarse:after:-translate-1/2">1</button><div class="w-px grow bg-text-muted"></div></div><div class="flex flex-col gap-1 pb-6"><div class="text-text-md text-text-base">V&auml;rm ugnen till 225&deg;C (varmluft) eller 250&deg;C (vanlig).</div></div></div></li><li><div class="flex gap-3"><div class="flex w-6 flex-col items-center"><button type="button" aria-pressed="false" aria-label="Steg {2}" class="flex size-6 shrink-0 items-center justify-center rounded-full text-text-sm text-text-base border border-text-muted pointer-coarse:relative pointer-coarse:after:absolute pointer-coarse:after:top-1/2 pointer-coarse:after:left-1/2 pointer-coarse:after:size-full pointer-coarse:after:min-h-11 pointer-coarse:after:min-w-11 pointer-coarse:after:-translate-1/2">2</button><div class="w-px grow bg-text-muted"></div></div><div class="flex flex-col gap-1 pb-6"><strong class="text-text-lg text-text-base"><strong></strong><strong>Aubergine- och tomats&aring;s</strong><div class="text-text-md text-text-base">&nbsp;</strong>Sk&auml;r aubergine i ca 1 cm tjocka skivor. L&auml;gg p&aring; en ugnspl&aring;t med bakpl&aring;tspapper och str&ouml; &ouml;ver lite salt. Rosta h&ouml;gt upp i ugnen ca 20 min, tills de f&aring;tt fin f&auml;rg.&nbsp;</div></div></div></li><li><div class="flex gap-3"><div class="flex w-6 flex-col items-center"><button type="button" aria-pressed="false" aria-label="Steg {3}" class="flex size-6 shrink-0 items-center justify-center rounded-full text-text-sm text-text-base border border-text-muted pointer-coarse:relative pointer-coarse:after:absolute pointer-coarse:after:top-1/2 pointer-coarse:after:left-1/2 pointer-coarse:after:size-full pointer-coarse:after:min-h-11 pointer-coarse:after:min-w-11 pointer-coarse:after:-translate-1/2">3</button><div class="w-px grow bg-text-muted"></div></div><div class="flex flex-col gap-1 pb-6"><div class="text-text-md text-text-base">Hetta upp olivolja i en stekgryta. Fr&auml;s pressad vitl&ouml;k och tomatpur&eacute; ca 1 min, under omr&ouml;rning. Blanda ner krossade tomater, mediterranean spice, socker och gr&ouml;nsaksbuljong. Koka upp och sjud till servering.&nbsp;</div></div></div></li><li><div class="flex gap-3"><div class="flex w-6 flex-col items-center"><button type="button" aria-pressed="false" aria-label="Steg {4}" class="flex size-6 shrink-0 items-center justify-center rounded-full text-text-sm text-text-base border border-text-muted pointer-coarse:relative pointer-coarse:after:absolute pointer-coarse:after:top-1/2 pointer-coarse:after:left-1/2 pointer-coarse:after:size-full pointer-coarse:after:min-h-11 pointer-coarse:after:min-w-11 pointer-coarse:after:-translate-1/2">4</button><div class="w-px grow bg-text-muted"></div></div><div class="flex flex-col gap-1 pb-6"><strong class="text-text-lg text-text-base"><strong>Pasta</strong><div class="text-text-md text-text-base"> </strong>Koka linguine enligt anvisning p&aring; f&ouml;rpackningen. Spara lite pastavatten n&auml;r du h&auml;ller av pastan.</div></div></div></li><li><div class="flex gap-3"><div class="flex w-6 flex-col items-center"><button type="button" aria-pressed="false" aria-label="Steg {5}" class="flex size-6 shrink-0 items-center justify-center rounded-full text-text-sm text-text-base border border-text-muted pointer-coarse:relative pointer-coarse:after:absolute pointer-coarse:after:top-1/2 pointer-coarse:after:left-1/2 pointer-coarse:after:size-full pointer-coarse:after:min-h-11 pointer-coarse:after:min-w-11 pointer-coarse:after:-translate-1/2">5</button><div class="w-px grow bg-text-muted"></div></div><div class="flex flex-col gap-1 pb-6"><strong class="text-text-lg text-text-base"><strong></strong><strong>Fetaosttopping</strong><div class="text-text-md text-text-base">&nbsp;</strong>Finstrimla bladpersilja och smula fetaost. L&auml;gg i en sk&aring;l.</div></div></div></li><li><div class="flex gap-3"><div class="flex w-6 flex-col items-center"><button type="button" aria-pressed="false" aria-label="Steg {6}" class="flex size-6 shrink-0 items-center justify-center rounded-full text-text-sm text-text-base border border-text-muted pointer-coarse:relative pointer-coarse:after:absolute pointer-coarse:after:top-1/2 pointer-coarse:after:left-1/2 pointer-coarse:after:size-full pointer-coarse:after:min-h-11 pointer-coarse:after:min-w-11 pointer-coarse:after:-translate-1/2">6</button><div class="w-px grow bg-text-muted"></div></div><div class="flex flex-col gap-1 pb-6"><strong class="text-text-lg text-text-base"><strong>Aubergine- och tomats&aring;s</strong><div class="text-text-md text-text-base">&nbsp;</strong>Blanda ner auberginen i s&aring;sen. Sp&auml;d med sparat pastavatten till &ouml;nskad konsistens.&nbsp;Smaka av med balsamvin&auml;ger, lite salt och nymald svartpeppar.&nbsp;&nbsp;</div></div></div></li><li><div class="flex gap-3"><div class="flex w-6 flex-col items-center"><button type="button" aria-pressed="false" aria-label="Steg {7}" class="flex size-6 shrink-0 items-center justify-center rounded-full text-text-sm text-text-base border border-text-muted pointer-coarse:relative pointer-coarse:after:absolute pointer-coarse:after:top-1/2 pointer-coarse:after:left-1/2 pointer-coarse:after:size-full pointer-coarse:after:min-h-11 pointer-coarse:after:min-w-11 pointer-coarse:after:-translate-1/2">7</button></div><div class="flex flex-col gap-1"><div class="text-text-md text-text-base">Blanda ner avrunnen pasta i tomats&aring;sen och servera med fetaosttopping och ruccola.</div></div></div></li></ol><strong class="text-heading-md text-text-base">Smaklig måltid!</strong></section></div></div></div></div></article></main><footer class="print:hidden"><section class="bg-surface-accent py-10 text-text-base md:py-6"><div class="mx-auto w-full max-w-page px-4 md:px-20"><div class="flex flex-col gap-10