/static/immutable/media/SerrifCompressed_Medium-s.p.3dj2e3s3uk35o.otf" as="font" type="font/otf" crossorigin="anonymous" data-next-font="size-adjust"/><link rel="preload" href="/_next/static/immutable/media/MaterialSymbolsRounded_subset-s.p.1dzurzqs6o9nq.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust"/><link nonce="" rel="preload" href="/_next/static/immutable/chunks/37b1zv3hvoxhp.css" as="style"/><link nonce="" rel="preload" href="/_next/static/immutable/chunks/3y-aqmpd2lp50.css" as="style"/><style data-next-head="">:root:root{--font-family-body:'bodyFont', 'bodyFont Fallback';--font-family-display:'displayFont', 'displayFont Fallback';--font-family-mono:'monoFont', 'monoFont Fallback';--font-family-symbols:'symbolFont', 'symbolFont Fallback'}</style><script type="application/ld+json" data-next-head="">{"@context":"https://schema.org","@type":"Recipe","inLanguage":"sv-SE","isAccessibleForFree":true,"publisher":{"@type":"Organization","name":"Linas Matkasse","logo":{"@type":"ImageObject","url":"https://ggfrontendassets.azureedge.net/publicassets/linasmatkasse/linas-logo-v2.svg"},"url":"https://www.linasmatkasse.se"},"url":"https://linasmatkasse.se/recept/90756/linguine-con-melanzane-pasta-med-aubergine-och-tomatsas-och-fetaosttopping","image":"https://pimimages.azureedge.net/images/largeResized/c03fc8b9-b110-409d-b737-2b02e756aed7.jpg","thumbnailUrl":"https://pimimages.azureedge.net/images/largeResized/c03fc8b9-b110-409d-b737-2b02e756aed7.jpg","description":"Recept på Linguine con melanzane - pasta med aubergine- och tomatsås och fetaosttopping från Linas Matkasse – ingredienser och tillagning.","prepTime":"PT20M","cookTime":"PT20M","totalTime":"PT40M","recipeIngredient":["1 st aubergine","1 st bakplåtspapper","salt","1 klyfta vitlök","½ tsk olivolja","1 förp tomatpuré","1 förp krossade tomater","½ förp mediterranean spice","2 krm socker","1 förp grönsaksbuljong","1 msk balsamvinäger","0 krm svartpeppar","20 g bladpersilja","50 g fetaost","200 g linguine","60 g ruccola"],"recipeInstructions":[{"@type":"HowToStep","name":"","text":"V&amp;auml;rm ugnen till 225&amp;deg;C (varmluft) eller 250&amp;deg;C (vanlig)."},{"@type":"HowToStep","name":"","text":"Aubergine- och tomats&amp;aring;s:&amp;nbsp;Sk&amp;auml;r aubergine i ca 1 cm tjocka skivor. L&amp;auml;gg p&amp;aring; en ugnspl&amp;aring;t med bakpl&amp;aring;tspapper och str&amp;ouml; &amp;ouml;ver lite salt. Rosta h&amp;ouml;gt upp i ugnen ca 20 min, tills de f&amp;aring;tt fin f&amp;auml;rg.&amp;nbsp;"},{"@type":"HowToStep","name":"","text":"Hetta upp olivolja i en stekgryta. Fr&amp;auml;s pressad vitl&amp;ouml;k och tomatpur&amp;eacute; ca 1 min, under omr&amp;ouml;rning. Blanda ner krossade tomater, mediterranean spice, socker och gr&amp;ouml;nsaksbuljong. Koka upp och sjud till servering.&amp;nbsp;"},{"@type":"HowToStep","name":"","text":"Pasta: Koka linguine enligt anvisning p&amp;aring; f&amp;ouml;rpackningen. Spara lite pastavatten n&amp;auml;r du h&amp;auml;ller av pastan."},{"@type":"HowToStep","name":"","text":"Fetaosttopping:&amp;nbsp;Finstrimla bladpersilja och smula fetaost. L&amp;auml;gg i en sk&amp;aring;l."},{"@type":"HowToStep","name":"","text":"Aubergine- och tomats&amp;aring;s:&amp;nbsp;Blanda ner auberginen i s&amp;aring;sen. Sp&amp;auml;d med sparat pastavatten till &amp;ouml;nskad konsistens.&amp;nbsp;Smaka av med balsamvin&amp;auml;ger, lite salt och nymald svartpeppar.&amp;nbsp;&amp;nbsp;"},{"@type":"HowToStep","name":"","text":"Blanda ner avrunnen pasta i tomats&amp;aring;sen och servera med fetaosttopping och ruccola."}],"recipeYield":"2","recipeCategory":"Dinner","nutrition":{"@type":"NutritionInformation","calories":"537 kcal"},"keywords":"Vegetariskt","name":"Linguine con melanzane","alternateName":"Linguine con melanzane - pasta med aubergine- och tomatsås och fetaosttopping","aggregateRating":{"@type":"AggregateRating","ratingValue":"3.93","reviewCount":594}}</script><script type="application/ld+json" data