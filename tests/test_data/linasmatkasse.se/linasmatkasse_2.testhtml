wAllergy":true,"parentAllergy":null},{"id":"75","name":"Vete","hasTraceOf":false,"showAllergy":true,"parentAllergy":{"id":"72"}},{"id":"20","name":"Mjölk","hasTraceOf":false,"showAllergy":true,"parentAllergy":null},{"id":"107","name":"Laktos","hasTraceOf":false,"showAllergy":true,"parentAllergy":null}],"stepSections":[{"sectionId":"258809","sectionTitle":null,"steps":[{"order":1,"step":"V\u0026auml;rm ugnen till 225\u0026deg;C (varmluft) eller 250\u0026deg;C (vanlig)."},{"order":2,"step":"\u003cstrong\u003e\u003c/strong\u003e\u003cstrong\u003eAubergine- och tomats\u0026aring;s:\u0026nbsp;\u003c/strong\u003eSk\u0026auml;r aubergine i ca 1 cm tjocka skivor. L\u0026auml;gg p\u0026aring; en ugnspl\u0026aring;t med bakpl\u0026aring;tspapper och str\u0026ouml; \u0026ouml;ver lite salt. Rosta h\u0026ouml;gt upp i ugnen ca 20 min, tills de f\u0026aring;tt fin f\u0026auml;rg.\u0026nbsp;"},{"order":3,"step":"Finhacka gul l\u0026ouml;k och vitl\u0026ouml;k. Skiva stj\u0026auml;lkselleri tunt. Hetta upp olivolja i en stekgryta. Fr\u0026auml;s all l\u0026ouml;k och selleri ca 3 min. Tills\u0026auml;tt tomatpur\u0026eacute; och fr\u0026auml;s ytterligare ca 1 min, under omr\u0026ouml;rning. Blanda ner krossade tomater, vatten, mediterranean spice och gr\u0026ouml;nsaksbuljong. Koka upp och sjud till servering.\u0026nbsp;"},{"order":4,"step":"\u003cstrong\u003ePasta: \u003c/strong\u003eKoka linguine enligt anvisning p\u0026aring; f\u0026ouml;rpackningen. Spara lite pastavatten n\u0026auml;r du h\u0026auml;ller av pastan."},{"order":5,"step":"\u003cstrong\u003e\u003c/strong\u003e\u003cstrong\u003eFetaosttopping:\u0026nbsp;\u003c/strong\u003eGrovhacka bladpersilja. Smula fetaost. Blanda allt i en sk\u0026aring;l."},{"order":6,"step":"\u003cstrong\u003eAubergine- och tomats\u0026aring;s:\u0026nbsp;\u003c/strong\u003eBlanda ner auberginen i s\u0026aring;sen. Sp\u0026auml;d med sparat pastavatten till \u0026ouml;nskad konsistens.\u0026nbsp;Smaka av med balsamvin\u0026auml;ger, lite salt och nymald svartpeppar.\u0026nbsp;\u0026nbsp;"},{"order":7,"step":"Blanda ner avrunnen pasta i tomats\u0026aring;sen och servera med fetaosttopping, ruccola och cocktailtomater."}]}],"ingredientSections":[{"sectionId":"869256","sectionTitle":"Aubergine- och tomatsås","ingredients":[{"ingredientId":18461,"order":"0","name":"aubergine","amount":"2","ingredientAmountType":"st","isBasis":false,"hasAllergyFriendlyAlternative":false,"images":{"priority":1,"isFeatured":true,"urls":[{"size":"small","url":"https://pimimages.azureedge.net/images/ingredients/resized/bfa5818a-3811-4925-babc-e681824a51a4.jpg"},{"size":"large","url":"https://pimimages.azureedge.net/images/ingredients/largeResized/bfa5818a-3811-4925-babc-e681824a51a4.jpg"}]},"imagesExtra":null,"allergies":[]},{"ingredientId":4062,"order":"1","name":"bakplåtspapper","amount":"1","ingredientAmountType":"st","isBasis":true,"hasAllergyFriendlyAlternative":false,"images":null,"imagesExtra":null,"allergies":[]},{"ingredientId":12372,"order":"2","name":"salt","amount":null,"ingredientAmountType":"krm","isBasis":true,"hasAllergyFriendlyAlternative":false,"images":{"priority":1,"isFeatured":true,"urls":[{"size":"small","url":"https://pimimages.azureedge.net/images/ingredients/resized/24726637-02f7-4494-9f20-f63c97dfdb0a.jpg"},{"size":"large","url":"https://pimimages.azureedge.net/images/ingredients/largeResized/24726637-02f7-4494-9f20-f63c97dfdb0a.jpg"}]},"imagesExtra":null,"allergies":[]},{"ingredientId":21168,"order":"3","name":"gul lök","amount":"2","ingredientAmountType":"st","isBasis":false,"hasAllergyFriendlyAlternative":false,"images":{"priority":1,"isFeatured":true,"urls":[{"size":"small","url":"https://pimimages.azureedge.net/images/ingredients/resized/0578aabc-146f-4f28-b5fd-32cfc9ab11c9.jpg"},{"size":"large","url":"https://pimimages.azureedge.net/images/ingredients/largeResized/0578aabc-146f-4f28-b5fd-32cfc9ab11c9.jpg"}]},"imagesExtra":null,"allergies":[]},{"ingredientId":18509,"order":"4","name":"vitlök","amo