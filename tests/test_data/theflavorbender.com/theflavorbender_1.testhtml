          {"@type": "HowToStep", "text": "Rinse the barley."},
          {"@type": "HowToStep", "text": "Cook the barley until tender."}
        ]
      },
      {
        "@type": "HowToSection",
        "name": "Finish bowls",
        "itemListElement": [
          {"@type": "HowToStep", "text": "Stir the dressing together."},
          {"@type": "HowToStep", "text": "Divide between bowls and add the herbs."}
        ]
      }
    ]
  }
  </script>
</head>
<body>
  <div class="wprm-recipe-container" id="wprm-recipe-container-1">
