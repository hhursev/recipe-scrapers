        <li class="wprm-recipe-ingredient"><span class="wprm-checkbox-container">&#9634; </span><span class="wprm-recipe-ingredient-amount">1</span> <span class="wprm-recipe-ingredient-unit">tsp</span> <span class="wprm-recipe-ingredient-name">oil</span></li>
      </ul>
