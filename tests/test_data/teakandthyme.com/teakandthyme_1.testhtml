cream\/#faq-question-1657511743668"},{"@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657518070708"},{"@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657519693499"}],"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/teakandthyme.com\/matcha-ice-cream\/"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#primaryimage","url":"https:\/\/teakandthyme.com\/wp-content\/uploads\/2022\/08\/matcha-ice-cream-DSC_5061-1x1-1200.jpg","contentUrl":"https:\/\/teakandthyme.com\/wp-content\/uploads\/2022\/08\/matcha-ice-cream-DSC_5061-1x1-1200.jpg","width":1200,"height":1200,"caption":"Two scoops of matcha ice cream in waffle cones"},{"@type":"BreadcrumbList","@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/teakandthyme.com\/"},{"@type":"ListItem","position":2,"name":"Recipes","item":"https:\/\/teakandthyme.com\/recipes\/"},{"@type":"ListItem","position":3,"name":"Frozen Desserts","item":"https:\/\/teakandthyme.com\/recipes\/frozen-desserts\/"},{"@type":"ListItem","position":4,"name":"Matcha Ice Cream (No-Churn)"}]},{"@type":"WebSite","@id":"https:\/\/teakandthyme.com\/#website","url":"https:\/\/teakandthyme.com\/","name":"Teak &amp; Thyme","description":"Baking &amp; Dessert Recipes","publisher":{"@id":"https:\/\/teakandthyme.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/teakandthyme.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/teakandthyme.com\/#organization","name":"Teak & Thyme","alternateName":"Teak and Thyme","url":"https:\/\/teakandthyme.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/teakandthyme.com\/#\/schema\/logo\/image\/","url":"https:\/\/teakandthyme.com\/wp-content\/uploads\/2023\/02\/teakandthyme-logo-2023-400x140-1.jpg","contentUrl":"https:\/\/teakandthyme.com\/wp-content\/uploads\/2023\/02\/teakandthyme-logo-2023-400x140-1.jpg","width":400,"height":140,"caption":"Teak & Thyme"},"image":{"@id":"https:\/\/teakandthyme.com\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/facebook.com\/teakandthyme","https:\/\/instagram.com\/teakandthyme","https:\/\/pinterest.com\/teakandthyme","https:\/\/tiktok.com\/@teakandthyme","https:\/\/youtube.com\/@teakandthyme"]},{"@type":"Person","@id":"https:\/\/teakandthyme.com\/#\/schema\/person\/64a4a5179bf2fa78e4f764ba44d7103e","name":"Gail Ng","sameAs":["https:\/\/teakandthyme.com\/about","teakandthyme"]},{"@type":"Question","@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657498133779","position":1,"url":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657498133779","name":"How long can you freeze homemade ice cream?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"You can freeze homemade ice cream for up to 2 weeks for the best texture. Homemade ice cream can start to become icy and dried out if frozen for too long as it doesn’t contain stabilizers found in other ice cream.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657511743668","position":2,"url":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657511743668","name":"What does no churn mean?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"No churn means that the ice cream is not made using an ice cream maker, which constantly churns the ice cream mixture while it freezes. No churn ice cream is simply mixed with an electric mixer and then frozen in a container.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657518070708","position":3,"url":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657518070708","name":"How to prevent no churn ice cream from being icy?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"You can prevent no churn ice cream from being icy by using a high fat whipping cream, whipping the cream well to beat lots of air into it, and using condensed milk as a high sugar sweetener. All these things help prevent ice crystals from forming during the freezing process.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657519693499","position":4,"url":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#faq-question-1657519693499","name":"What does matcha ice cream taste like?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Matcha ice cream tastes earthy, sweet, and just slightly bitter. It’s a mellow flavour that’s slightly grassy and almost savoury. It’s difficult to describe if you’ve never tried matcha before. And of course, it also tastes just like any other ice cream - creamy, cold, and melts in your mouth.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Recipe","name":"Matcha Ice Cream","author":{"@id":"https:\/\/teakandthyme.com\/#\/schema\/person\/64a4a5179bf2fa78e4f764ba44d7103e"},"description":"No-churn matcha ice cream that’s creamy and full of matcha green tea flavour. It’s made with only 4 ingredients and no ice cream maker needed.","datePublished":"2022-07-11T17:03:47+00:00","image":["https:\/\/teakandthyme.com\/wp-content\/uploads\/2022\/07\/matcha-ice-cream-DSC_5061-1x1-1600.jpg","https:\/\/teakandthyme.com\/wp-content\/uploads\/2022\/07\/matcha-ice-cream-DSC_5061-1x1-1600-500x500.jpg","https:\/\/teakandthyme.com\/wp-content\/uploads\/2022\/07\/matcha-ice-cream-DSC_5061-1x1-1600-500x375.jpg","https:\/\/teakandthyme.com\/wp-content\/uploads\/2022\/07\/matcha-ice-cream-DSC_5061-1x1-1600-480x270.jpg"],"recipeYield":["1","1 9x13” loaf tin"],"prepTime":"PT20M","totalTime":"PT380M","recipeIngredient":["600 mL whipping cream","4 tablespoons matcha powder (culinary grade)","1 tablespoon vanilla extract","300 mL sweetened condensed milk (one can)"],"recipeInstructions":[{"@type":"HowToStep","text":"In a large mixing bowl, add the whipping cream, matcha powder, and vanilla extract. Use an electric mixer fitted with a whisk attachment to whip the mixture until it becomes firm peaks.","name":"In a large mixing bowl, add the whipping cream, matcha powder, and vanilla extract. Use an electric mixer fitted with a whisk attachment to whip the mixture until it becomes firm peaks.","url":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#wprm-recipe-8212-step-0-0"},{"@type":"HowToStep","text":"With hand, drizzle the condensed milk into the whipped cream while folding it in with a silicone spatula with your other hand. Fold until combined and no streaks of condensed milk remain.","name":"With hand, drizzle the condensed milk into the whipped cream while folding it in with a silicone spatula with your other hand. Fold until combined and no streaks of condensed milk remain.","url":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#wprm-recipe-8212-step-0-1"},{"@type":"HowToStep","text":"Pour the mixture into a loaf tin or any container of your choice. Cover with plastic wrap and freeze for at least 6 hours or preferably overnight.","name":"Pour the mixture into a loaf tin or any container of your choice. Cover with plastic wrap and freeze for at least 6 hours or preferably overnight.","url":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#wprm-recipe-8212-step-0-2"},{"@type":"HowToStep","text":"When serving, run an ice cream scooper until hot water and wipe dry before scooping. Immediately return the rest of the ice cream to the freezer. Serve as is or top with dango mochi.","name":"When serving, run an ice cream scooper until hot water and wipe dry before scooping. Immediately return the rest of the ice cream to the freezer. Serve as is or top with dango mochi.","url":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#wprm-recipe-8212-step-0-3"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"5","ratingCount":"48","reviewCount":"1"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Made this and it ended up tasting just as good as the local ice cream stores near us! Will be making more throughout the summer :)","author":{"@type":"Person","name":"Meek"},"datePublished":"2022-07-11"}],"recipeCategory":["Dessert"],"recipeCuisine":["Japanese"],"keywords":"matcha, matcha ice cream","nutrition":{"@type":"NutritionInformation","calories":"3515 kcal","carbohydrateContent":"230 g","proteinContent":"78 g","fatContent":"252 g","saturatedFatContent":"160 g","cholesterolContent":"814 mg","sodiumContent":"657 mg","sugarContent":"230 g","unsaturatedFatContent":"75 g","servingSize":"1 serving"},"@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#recipe","isPartOf":{"@id":"https:\/\/teakandthyme.com\/matcha-ice-cream\/#article"},"mainEntityOfPage":"https:\/\/teakandthyme.com\/matcha-ice-cream\/"}]}</script>
