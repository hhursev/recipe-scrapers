mark\",\"pluralName\":\"Tomatenmark\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43145,\"prefix\":\"mittelscharfer\",\"quantity\":2,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":11551,\"name\":\"TL\",\"pluralName\":\"TL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"b71be6fc-f650-4458-b4fd-0410d0b006c0\",\"id\":10066,\"name\":\"Senf\",\"pluralName\":\"Senf\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43145,\"prefix\":null,\"quantity\":400,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":11546,\"name\":\"ml\",\"pluralName\":\"ml\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"58dd47f8-0092-40be-84df-e905b9c05b00\",\"id\":6236,\"name\":\"Gemüsebrühe\",\"pluralName\":\"Gemüsebrühe\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43145,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":11551,\"name\":\"TL\",\"pluralName\":\"TL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"b567bd59-d141-4144-9a89-6d303c027674\",\"id\":10301,\"name\":\"Speisestärke\",\"pluralName\":\"Speisestärke\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43145,\"prefix\":null,\"quantity\":200,\"quantityEnd\":null,\"suffix\":\"(30 % Fett)\",\"unit\":{\"id\":11546,\"name\":\"ml\",\"pluralName\":\"ml\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"b8af1b82-666d-4843-8a37-a74617628c0a\",\"id\":9441,\"name\":\"Sahne\",\"pluralName\":\"Sahne\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43145,\"prefix\":null,\"quantity\":150,\"quantityEnd\":null,\"suffix\":\"(30 % Fett)\",\"unit\":{\"id\":4371,\"name\":\"g\",\"pluralName\":\"g\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"b7d483b9-f8fe-4c61-84d4-b1897a3de91f\",\"id\":5501,\"name\":\"Crème fraîche\",\"pluralName\":\"Crème fraîche\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}]}],\"content\":[{\"__typename\":\"ParagraphText\",\"headline\":null,\"headlineHTag\":\"h2\",\"text\":\"\u003cp\u003e\u003cstrong\u003eDu benötigst: \u003c/strong\u003eSchneidebrett, Messer, Pfanne, Kochlöffel, Teelöffel, Esslöffel, Schneebesen\u003c/p\u003e\",\"showDividerBelow\":null},{\"__typename\":\"ParagraphRecipeStep\",\"id\":43137,\"image\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/2022-10/2022_filettopf_step1.jpg\",\"width\":1200,\"name\":\"2022_filettopf_step1.jpg\",\"source\":\"EINFACH KOCHEN\",\"height\":900,\"alt\":\"Filettopf - Fleisch in 2-3 cm dicke Scheiben schneiden\",\"description\":null,\"copyright\":\"Mark Kipson\",\"title\":\"Filettopf - Fleisch in 2-3 cm dicke Scheiben schneiden\",\"__typename\":\"MediaImage\",\"desktop\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/700_530/public/2022-10/2022_filettopf_step1.jpg?h=6eb229a4\u0026itok=OPI_wXQD\",\"width\":700,\"height\":530,\"__typename\":\"ImageDerivative\"},\"desktop_2x\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/1400_1060/public/2022-10/2022_filettopf_step1.jpg?h=6eb229a4\u0026itok=-ESQMbGV\",\"width\":1400,\"height\":1060,\"__typename\":\"ImageDerivative\"},\"tablet\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/973_730/public/2022-10/2022_filettopf_step1.jpg?h=6eb229a4\u0026itok=RFUA62R5\",\"width\":973,\"height\":730,\"__typename\":\"ImageDerivative\"},\"tablet_2x\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/1946_1460/public/2022-10/2022_filettopf_step1.jpg?h=6eb229a4\u0026itok=GsdKWNb0\",\"width\":1946,\"height\":1460,\"__typename\":\"ImageDerivative\"},\"mobile\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/576_432/public/2022-10/2022_filettopf_step1.jpg?h=6eb229a4\u0026itok=MkFkq0kR\",\"width\":576,\"height\":432,\"__typename\":\"ImageDerivative\"},\"mobile_2x\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/1152_864/public/2022-10/2022_filettopf_step1.jpg?h=6eb229a4\u0026itok=dDJ6Ivh3\",\"width\":1152,\"height\":864,\"__typename\":\"ImageDerivative\"}},\"ingredients\":[{\"stepId\":43137,\"prefix\":null,\"quantity\":600,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4371,\"name\":\"g\",\"pluralName\":\"g\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"ea3c0c4b-c03d-4204-b699-8a45f8146bf6\",\"id\":9906,\"name\":\"Schweinefilet\",\"pluralName\":\"Schweinefilet\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003eSchweinefilets kalt abwaschen, trocken tupfen und ggf. von Sehnen und Fett befreien. Fleisch in \u003cstrong\u003e2-3 cm dicke Scheiben\u003c/strong\u003e schneiden.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"},{\"__typename\":\"ParagraphRecipeStep\",\"id\":43138,\"image\":null,\"ingredients\":[{\"stepId\":43138,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"08e3fd9b-3456-4f20-9f44-94ccf0602669\",\"id\":11501,\"name\":\"Zwiebel\",\"pluralName\":\"Zwiebeln\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43138,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"8674acff-325c-4470-ae0f-8dd2a10a3bd7\",\"id\":7256,\"name\":\"Knoblauchzehe\",\"pluralName\":\"Knoblauchzehen\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43138,\"prefix\":null,\"quantity\":400,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4371,\"name\":\"g\",\"pluralName\":\"g\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"5a4dfe3e-3234-42f2-9d81-a106857e6fec\",\"id\":5311,\"name\":\"Champignon\",\"pluralName\":\"Champignons\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43138,\"prefix\":null,\"quantity\":0.5,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4326,\"name\":\"Bund\",\"pluralName\":\"Bund\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"5444d926-859b-4cbe-9a30-56285d0c0794\",\"id\":8661,\"name\":\"Petersilie\",\"pluralName\":\"Petersilie\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003eZwiebel und Knoblauch abziehen und fein würfeln. Champignons putzen und in Scheiben schneiden. Petersilie waschen, abtropfen lassen, die Blätter abzupfen und hacken.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"},{\"__typename\":\"ParagraphRecipeStep\",\"id\":43139,\"image\":null,\"ingredients\":[{\"stepId\":43139,\"prefix\":null,\"quantity\":null,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"85945b1a-f6ef-4cde-8ece-197e3ed6cda1\",\"id\":9556,\"name\":\"Salz\",\"pluralName\":\"Salz\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43139,\"prefix\":null,\"quantity\":2,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4351,\"name\":\"EL\",\"pluralName\":\"EL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"a79a74ed-5abe-4dab-8898-ea38de1cda72\",\"id\":10231,\"name\":\"Sonnenblumenöl\",\"pluralName\":\"Sonnenblumenöl\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43139,\"prefix\":\"frisch gemahlener\",\"quantity\":null,\"quantityEnd\":null,\"suffix\":null,\"unit\":null,\"ingredient\":{\"uuid\":\"a10659f6-04ab-47f7-9f1e-f7cc035ec595\",\"id\":8686,\"name\":\"Pfeffer\",\"pluralName\":\"Pfeffer\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003eÖl in eine Pfanne geben und erhitzen. Schweinefilet salzen, in einer Pfanne in heißem Öl von beiden Seite \u003cstrong\u003e\u003cspan data-type=\\\"timer\\\" data-min-time=\\\"2\\\" data-max-time=\\\"3\\\"\u003e\u003cspan data-type=\\\"timer\\\" data-min-time=\\\"2\\\" data-max-time=\\\"3\\\"\u003e2-3 Minuten\u003c/span\u003e\u003c/span\u003e\u003c/strong\u003e goldbraun anbraten. Aus der Pfanne nehmen, pfeffern und mit Bratensaft beiseitestellen.\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"},{\"__typename\":\"ParagraphRecipeStep\",\"id\":43140,\"image\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/2022-10/2022_filettopf_step2.jpg\",\"width\":1200,\"name\":\"2022_filettopf_step2.jpg\",\"source\":\"EINFACH KOCHEN\",\"height\":900,\"alt\":\"Filettopf - Champignons mit Zwiebel, Knoblauch, Schinkenwürfeln, Tomatenmark und Senf anschwitzen\",\"description\":null,\"copyright\":\"Mark Kipson \",\"title\":\"Filettopf - Champignons mit Zwiebel, Knoblauch, Schinkenwürfeln, Tomatenmark und Senf anschwitzen\",\"__typename\":\"MediaImage\",\"desktop\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/700_530/public/2022-10/2022_filettopf_step2.jpg?h=6eb229a4\u0026itok=qoo33QSx\",\"width\":700,\"height\":530,\"__typename\":\"ImageDerivative\"},\"desktop_2x\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/1400_1060/public/2022-10/2022_filettopf_step2.jpg?h=6eb229a4\u0026itok=dgKYkXJu\",\"width\":1400,\"height\":1060,\"__typename\":\"ImageDerivative\"},\"tablet\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/973_730/public/2022-10/2022_filettopf_step2.jpg?h=6eb229a4\u0026itok=dNX5jaom\",\"width\":973,\"height\":730,\"__typename\":\"ImageDerivative\"},\"tablet_2x\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/1946_1460/public/2022-10/2022_filettopf_step2.jpg?h=6eb229a4\u0026itok=mIiDa4EW\",\"width\":1946,\"height\":1460,\"__typename\":\"ImageDerivative\"},\"mobile\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/576_432/public/2022-10/2022_filettopf_step2.jpg?h=6eb229a4\u0026itok=Eijvwx6A\",\"width\":576,\"height\":432,\"__typename\":\"ImageDerivative\"},\"mobile_2x\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/1152_864/public/2022-10/2022_filettopf_step2.jpg?h=6eb229a4\u0026itok=jMlIh2Kq\",\"width\":1152,\"height\":864,\"__typename\":\"ImageDerivative\"}},\"ingredients\":[{\"stepId\":43140,\"prefix\":null,\"quantity\":20,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4371,\"name\":\"g\",\"pluralName\":\"g\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"58ad21bc-3daa-48a2-a6e4-82ba3ddbaede\",\"id\":5216,\"name\":\"Butter\",\"pluralName\":\"Butter\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43140,\"prefix\":null,\"quantity\":80,\"quantityEnd\":null,\"suffix\":\"(z.B. Katenschinken)\",\"unit\":{\"id\":4371,\"name\":\"g\",\"pluralName\":\"g\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"2b86bead-314e-449d-9211-306f5186f7bd\",\"id\":9716,\"name\":\"Schinkenwürfel\",\"pluralName\":\"Schinkenwürfel\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43140,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":\"(2-fach konzentriert)\",\"unit\":{\"id\":11551,\"name\":\"TL\",\"pluralName\":\"TL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"d3003afa-49a9-4c5d-9d14-5ed20d333661\",\"id\":10641,\"name\":\"Tomatenmark\",\"pluralName\":\"Tomatenmark\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43140,\"prefix\":\"mittelscharfer\",\"quantity\":2,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":11551,\"name\":\"TL\",\"pluralName\":\"TL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"b71be6fc-f650-4458-b4fd-0410d0b006c0\",\"id\":10066,\"name\":\"Senf\",\"pluralName\":\"Senf\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43140,\"prefix\":null,\"quantity\":400,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":11546,\"name\":\"ml\",\"pluralName\":\"ml\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"58dd47f8-0092-40be-84df-e905b9c05b00\",\"id\":6236,\"name\":\"Gemüsebrühe\",\"pluralName\":\"Gemüsebrühe\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003eButter in der Pfanne zerlassen, Champignons, Zwiebel- und Knoblauchwürfel zugeben und \u003cstrong\u003e\u003cspan data-type=\\\"timer\\\" data-min-time=\\\"2\\\" data-max-time=\\\"3\\\"\u003e\u003cspan data-type=\\\"timer\\\" data-min-time=\\\"2\\\" data-max-time=\\\"3\\\"\u003e2-3 Minuten\u003c/span\u003e\u003c/span\u003e\u003c/strong\u003e hellbraun anschwitzen. Schinkenwürfel, Tomatenmark und Senf zugeben und \u003c/span\u003e\u003c/span\u003e\u003cstrong\u003e\u003cspan\u003e\u003cspan\u003e1 Minute\u003c/span\u003e\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e\u003cspan\u003e anschwitzen. M\u003cspan\u003eit Gemüsebrühe ablöschen, Bratensatz lösen und \u003cstrong\u003e\u003cspan data-type=\\\"timer\\\" data-min-time=\\\"1\\\" data-max-time=\\\"2\\\"\u003e\u003cspan data-type=\\\"timer\\\" data-min-time=\\\"1\\\" data-max-time=\\\"2\\\"\u003e1-2 Minuten\u003c/span\u003e\u003c/span\u003e \u003c/strong\u003eunter Rühren köcheln lassen.\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"},{\"__typename\":\"ParagraphRecipeStep\",\"id\":43142,\"image\":null,\"ingredients\":[{\"stepId\":43142,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":11551,\"name\":\"TL\",\"pluralName\":\"TL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"b567bd59-d141-4144-9a89-6d303c027674\",\"id\":10301,\"name\":\"Speisestärke\",\"pluralName\":\"Speisestärke\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43142,\"prefix\":null,\"quantity\":1,\"quantityEnd\":null,\"suffix\":null,\"unit\":{\"id\":4351,\"name\":\"EL\",\"pluralName\":\"EL\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"ac9b1cff-316e-450f-8981-2a239fd06b9b\",\"id\":11021,\"name\":\"Wasser\",\"pluralName\":\"Wasser\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"},{\"stepId\":43142,\"prefix\":null,\"quantity\":200,\"quantityEnd\":null,\"suffix\":\"(30 % Fett)\",\"unit\":{\"id\":11546,\"name\":\"ml\",\"pluralName\":\"ml\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"b8af1b82-666d-4843-8a37-a74617628c0a\",\"id\":9441,\"name\":\"Sahne\",\"pluralName\":\"Sahne\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003e\u003cspan\u003eSpeisestärke mit 1 EL Wasser glattrühren. Schweinefilet mit Bratensaft in die Pfanne geben. Mit Sahne auffüllen und \u003cstrong\u003eca. \u003cspan data-type=\\\"timer\\\" data-min-time=\\\"2\\\" data-max-time=\\\"2\\\"\u003e\u003cspan data-type=\\\"timer\\\" data-min-time=\\\"2\\\" data-max-time=\\\"2\\\"\u003e2 Minuten\u003c/span\u003e\u003c/span\u003e\u003c/strong\u003e köcheln lassen. Angerührte Stärke hinzufügen. \u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"},{\"__typename\":\"ParagraphRecipeStep\",\"id\":43143,\"image\":null,\"ingredients\":[{\"stepId\":43143,\"prefix\":null,\"quantity\":150,\"quantityEnd\":null,\"suffix\":\"(30 % Fett)\",\"unit\":{\"id\":4371,\"name\":\"g\",\"pluralName\":\"g\",\"__typename\":\"TermUnit\"},\"ingredient\":{\"uuid\":\"b7d483b9-f8fe-4c61-84d4-b1897a3de91f\",\"id\":5501,\"name\":\"Crème fraîche\",\"pluralName\":\"Crème fraîche\",\"__typename\":\"TermIngredient\"},\"__typename\":\"IngredientWithExtraData\"}],\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003e\u003cspan\u003eCrème fraîche einrühren und mit Salz und Pfeffer abschmecken. Filettopf auf 4 Teller verteilen, mit gehackter Petersilie bestreuen und nach Wunsch mit Bandnudeln servieren. \u003cstrong\u003eGuten Appetit!\u003c/strong\u003e\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\"},{\"__typename\":\"ParagraphTipBox\",\"buttonLink\":null,\"contentTitle\":\"Filettopf mit Champignons im Backofen\",\"image\":null,\"layoutVariant\":\"right\",\"text\":\"\u003cp\u003e\u003cspan\u003e\u003cspan\u003eLege die angebratenen Filetstücke in eine Auflaufform, begieße sie mit der fertigen Soße und gare deinen Filettopf am nächsten Tag im vorgeheizten Backofen bei 140 Grad Umluft \u003cstrong\u003eca. 25 Minuten.\u003c/strong\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e\",\"title\":\"Mein Tipp\",\"showDividerBelow\":null},{\"__typename\":\"ParagraphEditorsRecommendation\",\"author\":{\"id\":4778,\"name\":\"Catherina\",\"url\":\"/autoren/catherina-faas\",\"jobTitle\":\"Food-Redakteurin\",\"photo\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/2022-07/Catherina_5031%20Kopie%202_3.jpg\",\"width\":1231,\"name\":\"catherina_portrait.jpg\",\"source\":\"EINFACH KOCHEN\",\"height\":1016,\"alt\":\"Food-Redakteurin Catherina\",\"description\":null,\"copyright\":\"Katrin Winner\",\"title\":\"Food-Redakteurin Catherina\",\"__typename\":\"MediaImage\",\"thumbnail\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/author_thumbnail/public/2022-07/Catherina_5031%20Kopie%202_3.jpg?itok=Pf4oDHv_\",\"width\":50,\"height\":50,\"__typename\":\"ImageDerivative\"},\"thumbnail_hd\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/author_thumbnail_2x/public/2022-07/Catherina_5031%20Kopie%202_3.jpg?itok=7QFtH2rJ\",\"width\":100,\"height\":100,\"__typename\":\"ImageDerivative\"},\"thumbnail_2hd\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/author_thumbnail_4x/public/2022-07/Catherina_5031%20Kopie%202_3.jpg?itok=1QNbeJYW\",\"width\":200,\"height\":200,\"__typename\":\"ImageDerivative\"},\"thumbnail_4hd\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/author_thumbnail_8x/public/2022-07/Catherina_5031%20Kopie%202_3.jpg?itok=qlM94cMK\",\"width\":400,\"height\":400,\"__typename\":\"ImageDerivative\"}},\"__typename\":\"NodeAuthorProfile\"},\"node\":{\"id\":4980,\"name\":\"Parboiled Reis kochen\",\"url\":\"/rezepte/parboiled-reis-kochen\",\"kicker\":\"Einfach \u0026 schnell\",\"introText\":\"Parboiled Reis kochen – das klappt mit unserem Rezept perfekt! Dazu ist die Zubereitung super einfach. Im Handumdrehen genießt du die perfekte Beilage!\",\"teaserText\":null,\"primaryTopic\":{\"name\":\"Reis-Rezepte\",\"__typename\":\"TermTopic\"},\"secondaryTopics\":[{\"name\":\"Rezepte\",\"__typename\":\"TermTopic\"},{\"name\":\"Vegetarische Rezepte\",\"__typename\":\"TermTopic\"}],\"image\":null,\"aufmacher\":{\"image\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/2021-07/parboiled_reis_1_0.jpg\",\"width\":2048,\"name\":\"2020_parboiled-reis-kochen_aufmacher.jpg\",\"source\":\"EINFACH KOCHEN\",\"height\":1536,\"alt\":\"Parboiled Reis kochen\",\"description\":null,\"copyright\":\"Maria Panzer\",\"title\":\"Parboiled Reis kochen\",\"__typename\":\"MediaImage\",\"desktop\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/700_530/public/2021-07/parboiled_reis_1_0.jpg?h=4521fff0\u0026itok=bufgnBc1\",\"width\":700,\"height\":530,\"__typename\":\"ImageDerivative\"},\"desktop_2x\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/1400_1060/public/2021-07/parboiled_reis_1_0.jpg?h=4521fff0\u0026itok=cPoX3asF\",\"width\":1400,\"height\":1060,\"__typename\":\"ImageDerivative\"},\"tablet\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/full_width_tablet_4_3/public/2021-07/parboiled_reis_1_0.jpg?h=4521fff0\u0026itok=dPJY_5YP\",\"width\":1024,\"height\":768,\"__typename\":\"ImageDerivative\"},\"tablet_2x\":{\"src\":\"https://www.einfachkochen.de/sites/einfachkochen.de/files/styles/full_width_tablet_4_3_2x/public/2021-07