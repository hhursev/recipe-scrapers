                                <li class="mb-3">
                <strong data-ingrient-quantity class="mr-1">
                    1/2                    gallon                </strong>
                <span data-ingredient-name>vanilla ice cream, softened</span>
            </li>
                                <li class="mb-3">
                <strong data-ingrient-quantity class="mr-1">
