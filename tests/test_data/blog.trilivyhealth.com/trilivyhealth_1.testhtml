ment_url\", \"http:\/\/www.example.com\/accessibility\")\";*\/\n      \/* uncomment the following line to override support on mobile devices*\/\n      \/* s.setAttribute(\"data-mobile\", true);*\/\n      \/* uncomment the following line to set custom trigger action for accessibility menu*\/\n      \/* s.setAttribute(\"data-trigger\", \"triggerId\")*\/\n      s.setAttribute(\"data-account\", \"8jy12llNsw\");\n      s.setAttribute(\"src\", \"https:\/\/cdn.userway.org\/widget.js\");\n      (d.body || d.head).appendChild(s);\n    })(document)\n    <\/script>\n    <noscript>Please ensure Javascript is enabled for purposes of <a href=\"https:\/\/userway.org\">website accessibility<\/a><\/noscript>\n","category":{"enumClass":"com.wixpress.live.site.data.types.CustomContentCategory","value":"ESSENTIAL"}},"domain":"optaviablog.com","name":"UserWay"},{"id":"2f594c48-d21f-43d9-88f1-7461f8e71b92","embedType":"custom","position":"head","loadOnce":false,"content":{"type":"custom","html":"<style>\n.SITE_FOOTER .ku3DBC ul {\n   list-style: none;\n}\n<\/style>","category":{"enumClass":"com.wixpress.live.site.data.types.CustomContentCategory","value":"ESSENTIAL"}},"domain":"blog.optavia.com","name":"site footer ul style none"},{"id":"91f581ee-e55f-4879-a357-bf084979a9d6","embedType":"custom","position":"head","loadOnce":false,"content":{"type":"custom","html":"<style>\n#comp-mbzo0opx {width: 155px !important;}\n<\/style>","category":{"enumClass":"com.wixpress.live.site.data.types.CustomContentCategory","value":"ESSENTIAL"}},"domain":"optaviablog.com","name":"text + spacing override adjustments"},{"id":"b5cdb4f8-2409-40e1-a28e-54ef299aa39a","embedType":"custom","position":"bodyEnd","loadOnce":true,"content":{"type":"custom","html":"<script>\n(function() {\n\n  console.log(\"ADA fix script loaded\");\n\n  function applyFix() {\n    if (typeof document === \"undefined\") {\n      console.warn(\"Document not ready yet\");\n      return;\n    }\n\n    const regions = document.querySelectorAll(\n      '[role=\"region\"][aria-label=\"Post list. Select a post to read.\"]'\n    );\n\n    console.log(\"Found regions:\", regions.length);\n\n    regions.forEach((el, i) => {\n      el.setAttribute(\"aria-label\", `Post list section ${i + 1}`);\n    });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", applyFix);\n  } else {\n    applyFix();\n  }\n\n  new MutationObserver(applyFix).observe(\n    document.body,\n    { childList: true, subtree: true }\n  );\n\n})();\n<\/script>\n","category":{"enumClass":"com.wixpress.live.site.data.types.CustomContentCategory","value":"ESSENTIAL"}},"domain":"optaviablog.com","name":"ADA-region-fix"},{"id":"635dabb1-57b9-48b8-b094-2dfbd83841c4","embedType":"custom","position":"bodyEnd","loadOnce":true,"content":{"type":"custom","html":"<script>\n(function () {\n  const SEARCH_INPUT_SELECTOR =\n    '#input_search-box-input-comp-mbzoiey6_r_comp-m2sooff0_r_comp-m1f0eie11';\n\n  const TOP_SUGGESTIONS_ID = \"comp-mbzoiey6_r_comp-m334qx1p9_r_comp-lx1lma1p\";\n  const NO_RESULTS_CONTAINER_ID = \"comp-mbzoiey6_r_comp-m8pnyftw\"; \/\/ inner rich-text div\n\n  function safeText(el) {\n    return (el && el.textContent ? el.textContent : \"\").trim();\n  }\n\n  let status = document.getElementById(\"wix-search-live-status\");\n  if (!status) {\n    status = document.createElement(\"div\");\n    status.id = \"wix-search-live-status\";\n    status.setAttribute(\"role\", \"status\");\n    status.setAttribute(\"aria-atomic\", \"true\");\n    status.setAttribute(\"aria-live\", \"polite\");\n\n    status.style.position = \"absolute\";\n    status.style.left = \"0\";\n    status.style.top = \"0\";\n    status.style.width = \"1px\";\n    status.style.height = \"1px\";\n    status.style.overflow = \"hidden\";\n    status.style.clip = \"rect(1px, 1px, 1px, 1px)\";\n    status.style.clipPath = \"inset(50%)\";\n    status.style.whiteSpace = \"nowrap\";\n\n    document.body.appendChild(status);\n  }\n\n  let announceTimer = null;\n\n  document.addEventListener(\"input\", function (e) {\n    const target = e.target;\n    if (!target || !target.matches(SEARCH_INPUT_SELECTOR)) return;\n\n    clearTimeout(announceTimer);\n\n    announceTimer = setTimeout(function () {\n      const topEl      = document.getElementById(TOP_SUGGESTIONS_ID);\n      const noResultsEl= document.getElementById(NO_RESULTS_CONTAINER_ID);\n\n      const topText    = safeText(topEl);\n      const noResults  = safeText(noResultsEl);\n\n      let message = \"\";\n\n      if (noResults) {\n        message = noResults;\n      } else if (topText) {\n        message = topText;\n      } else {\n        \/\/ Fallback if neither element is found or has text\n        message = \"Search Suggestions\";\n      }\n\n      status.textContent = \"\";\n      void status.offsetHeight;\n      status.textContent = message;\n    }, 800);\n  });\n})();\n<\/script>","category":{"enumClass":"com.wixpress.live.site.data.types.CustomContentCategory","value":"ESSENTIAL"}},"domain":"optaviablog.com","name":"ADA-search"}],"shouldLoadRequireJS":true},"componentsRegistry":{"librariesTopology":[{"artifactId":"editor-elements","namespace":"wixui","url":"https:\/\/static.parastorage.com\/services\/editor-elements\/1.15626.0"},{"artifactId":"editor-elements","namespace":"dsgnsys","url":"https:\/\/static.parastorage.com\/services\/editor-elements\/1.15626.0"}]},"consentPolicy":{"siteConsentPolicy":{"essential":true,"functional":false,"analytics":false,"advertising":false,"dataToThirdParty":true},"isWixSite":false,"isBuilderComponentModel":false},"customCss":{"gridAppId":"","appsWithCustomCss":{"49a4ef91-9d6e-43ff-94de-88cb5481cdf5":{"gridId":"86e60c12-a788-4f7e-9c02-501b66befe45","filePath":"styles\/widget.css"}},"baseUrl":"https:\/\/blog.trilivyhealth.com"},"cyclicTabbing":{"isBuilderComponentModel":false},"dataWixCodeSdk":{"gridAppId":"776983f6-b4fc-43fd-b9e7-70f584442cd0","environment":"LIVE","cloudDataUrlWithExternalBas