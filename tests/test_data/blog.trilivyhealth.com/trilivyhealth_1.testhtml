/* START STYLABLE DIRECTIVE RULES */

#comp-mbzo0opx .style-mr29252b__root:hover {
    background: #FFFFFF;
}

#comp-mbzo0opx .style-mr29252b__root .StylableButton2545352419__container{
    transition: inherit
}

#comp-mbzo0opx .style-mr29252b__root .StylableButton2545352419__label{
    transition: inherit;
    margin: 0px 4px 0px 0px;
    color: #1E1E1E;
    line-height: 0.84em;
