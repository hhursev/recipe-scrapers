ignment":1276,"codename":1796},"cookie-settings-button","b2e233c4-7d28-013b-8397-63a19c7d735e","b2e233c4_7d28_013b_8397_63a19c7d735e",{"component":1279,"kontentId":1798,"textSize":1799,"color":1434,"textAlign":1276,"codename":1800,"text":1801,"paddingTop":1079},"0a49d019-f489-0144-e608-cb7d0bdbdc82","small","n0a49d019_f489_0144_e608_cb7d0bdbdc82","\u003Ca href=\"https:\u002F\u002Frewe-group.at\u002Fde\u002Fkontakt\u002Fmeldung-illegaler-inhalte\" data-new-window=\"true\" target=\"_blank\" rel=\"noopener noreferrer\">Meldung möglicher illegaler Inhalte\u003C\u002Fa>","untitled_content_item_d1b3184",[],{"searchPlaceholder":1805,"measurementLegalLimitPerKg":1806,"greenStatusTag":1807,"greenLegendText":1808,"title":1809,"type":1810,"beforeContent":1811,"redLegendText":1815,"noResults":1816,"tableTitle":1821,"dateOfExamination":1822,"urlSlug":20,"kontentId":1823,"yellowLegendText":1824,"redStatusTag":1825,"measurementCustomLimitPerKg":1826,"measurementPesticideName":1827,"sortingRating":1828,"milligramNumberFormat":1829,"codename":21,"measurementPerKg":1830,"sortingProductName":1831,"sortingDateOfAnalysis":1832,"countryOfOrigin":1833,"legendTitle":1834,"yellowStatusTag":1835,"breadcrumbs":1836,"name":1810},"Suche nach Produkt, Land oder Pestizid","gesetzlicher Höchstwert in mg\u002Fkg","Entspricht den strengsten Kriterien","Das Produkt entspricht den strengen PRP-Kriterien von GLOBAL 2000.","Aktuelle Untersuchungsergebnisse","pesticides",[1812],{"component":1093,"kontentId":1813,"codename":1814},"f7077991-06a3-01aa-ff71-1fb892ac182b","f7077991_06a3_01aa_ff71_1fb892ac182b","Das Produkt steht unter Verdacht die Kriterien für die Verkehrsfähigkeit nicht zu erfüllen. Der betreffende Lieferant des Produkts wurde gesperrt. Das Produkt darf erst wieder geliefert werden, wenn der Lieferant glaubhaft belegen kann, dass dieses die geforderten Qualitätskriterien wieder einhält.",[1817],{"component":1279,"kontentId":1818,"text":1819,"codename":1820},"7aa79075-e936-0154-2d42-9c31f14a4ebe","Es wurden keine Ergebnisse gefunden.","n7aa79075_e936_0154_2d42_9c31f14a4ebe","Ergebnisse der Evalierung","Überprüft am {0}","f2571a4e-8db8-46e2-a08d-e6c82e80f467","Das Produkt hält die strengen PRP-Kriterien nicht ein, sehr wohl aber die gesetzlichen Höchstwerte. Zur Überprüfung der Qualität werden Folgeproben gezogen. Bei wiederholter Überschreitung wird der betreffende Lieferant gesperrt und darf das Produkt erst wieder liefern, wenn er glaubhaft belegen kann, dass dieses die geforderten Qualitätskriterien wieder einhält.","Verdacht auf Nichterfüllung der rechtlichen Höchstwerten","BILLA interner Höchstwert in mg\u002Fkg","Name Pestizid","Rating","{0} mg","Rückstand","Produkt","Datum der Probenziehung","aus {0}","Legende","Innerhalb der rechtlichen Höchstwerten",[1837],{"url":1838,"name":1809,"active":7},"\u002Fprp-tool",{"displayLinkedProducts":6,"kontentId":1840,"similarRecipes":7,"additionalContentBeforeContent":1841,"codename":31,"printButtonText":1882,"type":1883,"additionalContentBeforeContentForSpecificRecipes":1884,"videosCookieType":2110,"similarRecipesHeadline":211,"breadcrumbs":2111,"name":1883},"e1325452-075b-49bc-9e93-24dee784a422",[1842,1865],{"component":1093,"kontentId":1843,"paddingBottom":84,"visibilityOptions":1618,"codename":1844,"paddingTop":84,"content":1845},"c39a0d1b-b40e-0107-1e42-d7c3c2f08783","c39a0d1b_b40e_0107_1e42_d7c3c2f08783",[1846],{"component":1097,"kontentId":1847,"paddingLeft":13,"content":1848,"codename":1864,"paddingRight":13},"828f7a2f-bf3c-01d0-98d9-91320dcb9909",[1849],{"image":1850,"settingsOpenLinkAutomatically":6,"component":1117,"kontentId":1862,"codename":1863},[1851,1857],{"name":1852,"type":1104,"size":1853,"url":1854,"width":1107,"height":1855,"renditions":1856},"BIL_FG-Relaunch_Header_Rezeptdetailseite_V2_2000x188px_desktop.jpg",23028,"https:\u002F\u002Fassets-eu-01.kc-usercontent.com:443\u002Fcc0b17b0-a734-010a-8710-f644b7ee1f24\u002Fab40edeb-36ed-4591-981d-d7d9a6531563\u002FBIL_FG-Relaunch_Header_Rezeptde