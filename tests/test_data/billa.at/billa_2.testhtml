TjAZuvGRkrxq8+UwA" rel="modulepreload" as="script" crossorigin href="/_nuxt/Cy9ov2Pl.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-jHiaq0z0TGzsaR2QxlOBFRRPpprREMg1rSrNUmCe16dRQ/2aKHb1QaIvetcziO/O" rel="modulepreload" as="script" crossorigin href="/_nuxt/BuVwzM6z.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-cWtMYBJJ78JWzts8SpyIn37HhPFggFtlRydNR/Kl5V7GBF0VZjt5/ryrW0Come2Z" rel="modulepreload" as="script" crossorigin href="/_nuxt/DtmMnZ8Z.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-yUpgGCSYn05C9F4Z4ZU6EQ8E/X+DWu83wiMX3aU+VBU2GlNxoGTUrnasO2uniufV" rel="modulepreload" as="script" crossorigin href="/_nuxt/B774L7MN.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-auIhHejac1pi+VGIy7Hp9JyCQoWlSiQ9WHXhxfJuwGJoYWhu04c/1X0/CcrBs3Gb" rel="modulepreload" as="script" crossorigin href="/_nuxt/3Qajifnh.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-aOBS/1gd0rIkiCm0plgXWd3kIhF2G2zFvi29JqpeRitSl+ANGA1libNFygxQUE5D" rel="modulepreload" as="script" crossorigin href="/_nuxt/DyO98LSu.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-wpI5n0MoShi6sEuCZIcL4ho9IGylZ0DKU8RID4bgGv3tcGrV3Ka8qE0JHyiJmU+f" rel="modulepreload" as="script" crossorigin href="/_nuxt/C95ICXDU.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-UWhaBv88p2plQRh0IMC5aY/6cbSdkSSsFlkulLofmerqCl2hHarVrw5KQN+LFWw9" rel="modulepreload" as="script" crossorigin href="/_nuxt/BDwU__yv.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-qoNB6tFP+/lox2xdRLCXjmQXxk8v90fkXQKePjPo2sJRwLf5shDrNN/4tnInOI5b" rel="modulepreload" as="script" crossorigin href="/_nuxt/BDGEGXRM.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-2EivnUrx3sGSBt4hpNmpbIGsaWmQzzS+XEGDi9a7NfRe5g+txe/7UlqwZLgeWYkw" rel="modulepreload" as="script" crossorigin href="/_nuxt/DVz98RqT.js"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-Vj2dL78wYy0RKWrE6dlKnRrcpc55pRp7gP5+Y29IhsQzz9FHZ65sKt7/I8vkl7Oi" rel="modulepreload" as="script" crossorigin href="/_nuxt/uf0Gy_ru.js"><script nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" integrity="sha384-bnzn27nQUShJ93Vl9x34NMHm4M+fBUNm73FoERmGTb+kOKOA2o+y9akXAbq8lQ9q" type="module" src="/_nuxt/9XBSUItK.js" crossorigin></script><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" rel="prefetch" as="image" type="image/jpeg" href="/_nuxt/no-recipes-image.B6inIEgg.jpg"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" rel="canonical" href="https://www.billa.at/frischgekocht/rezept/wiener-zwiebelrostbraten-BI-24702"><link nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" rel="icon" href="https://assets-eu-01.kc-usercontent.com:443/cc0b17b0-a734-010a-8710-f644b7ee1f24/ff0150f7-0745-4842-b1de-9fc2b4499ac5/favicon.png" type="image/png"><meta content="Wiener Zwiebelrostbraten und Rezepte für jeden Tag. Einfache und schnelle Gerichte mit vielen Tipps zum Nachkochen!" name="description"><meta content="Wiener Zwiebelrostbraten und Rezepte für jeden Tag. Einfache und schnelle Gerichte mit vielen Tipps zum Nachkochen!" property="og:description"><meta content="https://assets-eu-01.kc-usercontent.com:443/0268bcf9-b34b-019e-604f-170fbe1551e7/4e1952f8-c7d5-42bd-afb0-76984575c6f2/20150901_1_l.jpg" property="og:image"><meta content="Wiener Zwiebelrostbraten" property="og:title"><meta content="website" property="og:type"><meta content="https://www.billa.at/frischgekocht/rezept/wiener-zwiebelrostbraten-BI-24702" property="og:url"><script nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" children="{&quot;@context&quot;:&quot;https://schema.org&quot;,&quot;@type&quot;:&quot;Recipe&quot;,&quot;author&quot;:{&quot;@type&quot;:&quot;Organization&quot;,&quot;url&quot;:&quot;https://www.billa.at&quot;,&quot;name&quot;:&quot;BILLA AG&quot;},&quot;cookTime&quot;:&quot;PT&quot;,&quot;datePublished&quot;:&quot;2015-09-01T00:00:00.000Z&quot;,&quot;description&quot;:&quot;Wiener Zwiebelrostbraten und Rezepte für jeden Tag. Einfache und schnelle Gerichte mit vielen Tipps zum Nachkochen!&quot;,&quot;image&quot;:[&quot;https://assets-eu-01.kc-usercontent.com:443/0268bcf9-b34b-019e-604f-170fbe1551e7/4e1952f8-c7d5-42bd-afb0-76984575c6f2/20150901_1_l.jpg&quot;],&quot;name&quot;:&quot;Wiener Zwiebelrostbraten&quot;,&quot;prepTime&quot;:&quot;PT55M&quot;,&quot;recipeCategory&quot;:[&quot;Fleisch&quot;,&quot;Hauptspeise&quot;,&quot;Österreichische Küche&quot;],&quot;recipeIngredient&quot;:[&quot;300 g gelbe Zwiebeln&quot;,&quot;200 g Karotten&quot;,&quot;250 ml Frittieröl&quot;,&quot;4 EL griffiges Mehl&quot;,&quot;4 Scheiben Ja! Natürlich Bio-Rostbraten (Zimmertemperatur)&quot;,&quot;350 g festkochende Erdäpfel (am Vortag gekocht und geschält)&quot;,&quot;30 g Butterschmalz&quot;,&quot;2 EL Schnittlauch&quot;,&quot;2 EL Sonnenblumenöl&quot;,&quot;1 TL Tomatenmark&quot;,&quot;100 ml Rotwein&quot;,&quot;400 ml Rindsuppe&quot;,&quot;40 g kalte Butter&quot;,&quot;Salz, schwarzer Pfeffer a. d. Mühle&quot;],&quot;recipeInstructions&quot;:[{&quot;@type&quot;:&quot;HowToStep&quot;,&quot;position&quot;:1,&quot;text&quot;:&quot;Zwiebeln schälen und in ca. 3 mm dicke Ringe hobeln. Karotten schälen, der Breite nach halbieren, der Länge nach in dünne Scheiben hobeln und in ca. 3 mm dicke Streifen schneiden. Frittieröl in einer tiefen Pfanne erhitzen. Zwiebeln in Mehl wenden, überschüssiges Mehl abklopfen. Zwiebeln im Öl knusprig frittieren. Mit einem Siebschöpfer herausnehmen und auf Küchenpapier abtropfen lassen. Karotten in Mehl wenden und frittieren. Beides mit Salz würzen und warm halten.&quot;},{&quot;@type&quot;:&quot;HowToStep&quot;,&quot;position&quot;:2,&quot;text&quot;:&quot;Fleisch kalt abspülen und trocken tupfen. Zwischen zwei Lagen Frischhaltefolie klopfen und am Rand mehrmals leicht einschneiden. Erdäpfel in Scheiben schneiden.&quot;},{&quot;@type&quot;:&quot;HowToStep&quot;,&quot;position&quot;:3,&quot;text&quot;:&quot;Butterschmalz in einer großen Pfanne erhitzen und die Erdäpfel darin knusprig braten. Mit Salz und Pfeffer würzen und mit Schnittlauch bestreuen.&quot;},{&quot;@type&quot;:&quot;HowToStep&quot;,&quot;position&quot;:4,&quot;text&quot;:&quot;Währenddessen Sonnenblumenöl in einer großen Pfanne erhitzen und das Fleisch darin auf jeder Seite 2 bis 3 Minuten braten. Herausnehmen und abgedeckt warm halten. Tomatenmark in derselben Pfanne kurz anrösten. Wein und Suppe angießen und etwa auf die Hälfte einkochen lassen. Butter würfeln und unterrühren, um die Sauce zu binden, dabei nicht mehr kochen lassen. Mit Salz und Pfeffer abschmecken.&quot;},{&quot;@type&quot;:&quot;HowToStep&quot;,&quot;position&quot;:5,&quot;text&quot;:&quot;Fleisch mit Sauce und Erdäpfeln anrichten. Zwiebeln und Karotten daraufgeben und servieren.&quot;}],&quot;recipeYield&quot;:4,&quot;totalTime&quot;:&quot;PT55M&quot;,&quot;url&quot;:&quot;https://www.billa.at/frischgekocht/rezept/wiener-zwiebelrostbraten-BI-24702&quot;}" type="application/ld+json"></script><script nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" children="{&quot;@context&quot;:&quot;https://schema.org&quot;,&quot;@type&quot;:&quot;Corporation&quot;,&quot;logo&quot;:&quot;/tenant/logo.svg&quot;,&quot;name&quot;:&quot;BILLA AG&quot;,&quot;acceptedPaymentMethod&quot;:&quot;Cash, Debit Card&quot;,&quot;url&quot;:&quot;https://www.billa.at&quot;,&quot;additionalProperty&quot;:{&quot;@type&quot;:&quot;PropertyValue&quot;,&quot;name&quot;:&quot;Currencies Accepted&quot;,&quot;value&quot;:&quot;EUR&quot;}}" type="application/ld+json"></script><script nonce="/Z6XpPQ0oGt6cwhe09Wfls/j" children="{&quot;@context&quot;:&quot;https://schema.org&quot;,&quot;@type&quot;:&quot;BreadcrumbList&quot;,&quot;itemListElement&quot;:[{&quot;@type&quot;:&quot;ListItem&quot;,&quot;position&quot;:1,&quot;name&quot;:&quot;Rezepte&quot;,&quot;item&quot;:&quot;https://www.billa.at/frischgekocht/rezept&quot;},{&quot;@type&quot;:&quot;ListItem&quot;,&quot;position&quot;:2,&quot;name&quot;:&quot;Wiener Zwiebelrostbraten&quot;}]}" type="application/ld+json"></script><style id="customVariables" type="text/css">@font-face {
