h6l2,3h4a2,2,0,0,1,2,2V20A2,2,0,0,1,21,22Z" fill="none" stroke="var(--color-button)" stroke-miterlimit="10"/><circle data-color="color-2" data-stroke="none" cx="4" cy="8" r="1" stroke="none"/></g></svg></span></button><button class="wprm-recipe-media-toggle wprm-toggle" data-state="off" data-recipe="44051" style="background-color: var(--color-button);color: #ffffff;border-left: 1px solid var(--color-button);" aria-label="Anleitungsmedien ausblenden"><span class="wprm-recipe-icon wprm-toggle-icon wprm-toggle-icon-active"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g class="nc-icon-wrapper" stroke-linecap="square" stroke-linejoin="miter" stroke-width="1" transform="translate(0.5 0.5)" fill="#ffffff" stroke="#ffffff"><circle data-color="color-2" cx="12" cy="12" r="4" fill="none" stroke-miterlimit="10"/><path d="M22,8v9a2,2,0,0,1-2,2H10" fill="none" stroke="#ffffff" stroke-miterlimit="10"/><path data-cap="butt" d="M2,17V8A2,2,0,0,1,4,6H7L9,3h6l2.4,3.6" fill="none" stroke="#ffffff" stroke-miterlimit="10" stroke-linecap="butt"/><line data-cap="butt" data-color="color-2" x1="23" y1="1" x2="1" y2="23" fill="none" stroke-miterlimit="10" stroke-linecap="butt"/></g></svg></span><span class="wprm-recipe-icon wprm-toggle-icon wprm-toggle-icon-inactive"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"><g class="nc-icon-wrapper" stroke-linecap="square" stroke-linejoin="miter" stroke-width="1" transform="translate(0.5 0.5)" fill="var(--color-button)" stroke="var(--color-button)"><circle data-color="color-2" cx="12" cy="12" r="4" fill="none" stroke-miterlimit="10"/><path d="M22,8v9a2,2,0,0,1-2,2H10" fill="none" stroke="var(--color-button)" stroke-miterlimit="10"/><path data-cap="butt" d="M2,17V8A2,2,0,0,1,4,6H7L9,3h6l2.4,3.6" fill="none" stroke="var(--color-button)" stroke-miterlimit="10" stroke-linecap="butt"/><line data-cap="butt" data-color="color-2" x1="23" y1="1" x2="1" y2="23" fill="none" stroke-miterlimit="10" stroke-linecap="butt"/></g></svg></span></button></div></h3><div class="wprm-recipe-instruction-group"><ul class="wprm-recipe-instructions"><li id="wprm-recipe-44051-step-0-0" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Die Würstchen in halbe Scheiben schneiden. Zwiebel schälen und in Würfel schneiden. Olivenöl in einer großen Pfanne oder einem Wok erhitzen. Zwiebelwürfel darin glasig dünsten. Wurstscheiben zufügen und kross anbraten. Tomantenmark dazugeben und mit anschwitzen. Das Buttergemüse ebenfalls untermischen. Alles mit Gemüsebrühe ablöschen.</div></li><li id="wprm-recipe-44051-step-0-1" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Sobald die Brühe kocht, die rohen Nudeln zufügen und alles bei geschlossenem Deckel etwa 15 bis 20 Minuten auf mittlerer Flamme köcheln lassen. Die letzten 10 Minuten gerne auch ohne Deckel, damit die Soße etwas eindickt.</div></li><li id="wprm-recipe-44051-step-0-2" class="wprm-recipe-instruction" style="list-style-type: decimal;"><div class="wprm-recipe-instruction-text" style="margin-bottom: 5px;">Zum Schluss mit Salz und buntem Pfeffer abschmecken.</div><div class="wprm-recipe-instruction-media wprm-recipe-instruction-image"><img decoding="async" width="200" height="300" src="https://experimenteausmeinerkueche.de/wp-content/uploads/2014/10/Wurst-Nudel-Pfanne-1-200x300.jpg" class="attachment-medium size-medium" alt="Wurst Nudel Pfanne" srcset="https://experimenteausmeinerkueche.de/wp-content/uploads/2014/10/Wurst-Nudel-Pfanne-1-200x300.jpg 200w, https://experimenteausmeinerkueche.de/wp-content/uploads/2014/10/Wurst-Nudel-Pfanne-1-683x1024.jpg 683w, https://experimenteausmeinerkueche.de/wp-content/uploads/2014/10/Wurst-Nudel-Pfanne-1-768x1152.jpg 768w, https://experimenteausmeinerkueche.de/wp-content/uploads/2014/10/Wurst-Nudel-Pfanne-1-1024x1536.jpg 1024w, https://experimenteausmeinerkueche.de/wp-content/uploads/2014/10/Wurst-Nudel-Pfanne-1.jpg 1067w" sizes="(max-width: 200px) 100vw, 200px" /></div> </li></ul></div></div>
