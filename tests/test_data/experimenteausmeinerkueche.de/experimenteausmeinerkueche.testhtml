<style id="wp-custom-css">
body.single-post { background-color: var(--color-white); }
body.single-post .wprm-recipe-container .bap-consent-embed { background: var(--color-white); border-color: var(--color-grey-light); color: var(--color-neutral-950); }
/* BEGIN eamk-seitenleiste (seitenleiste_buecher.py) */
.site-sidebar .eamk-sb { padding: var(--spacing-6); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
.site-sidebar .eamk-sb .eamk-sb__titel { margin: 0 0 var(--spacing-4); font-family: var(--font-heading); font-size: var(--font-size-2xl); font-weight: var(--font-weight-semibold); line-height: var(--line-height-tight); color: var(--color-text-primary); }
.site-sidebar .eamk-sb--yvonne { text-align: center; }
.site-sidebar .eamk-sb__portrait-link { display: block; width: 7rem; margin: 0 auto var(--spacing-4); }
.site-sidebar .eamk-sb__portrait { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 50% 18%; border-radius: 50%; border: 3px solid var(--color-bg-body); box-shadow: var(--shadow-md); }
.site-sidebar .widget .eamk-sb p { margin: 0 0 var(--spacing-4); font-size: var(--font-size-sm); line-height: var(--line-height-relaxed); color: var(--color-text-secondary); }
.site-sidebar .widget .eamk-sb .eamk-sb__mehr { display: inline-block; margin-top: var(--spacing-4); font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-primary); }
.site-sidebar .widget .eamk-sb--yvonne .eamk-sb__mehr { margin-top: 0; }
.site-sidebar .widget .eamk-sb .eamk-sb__mehr::after { content: " \2192"; }
.site-sidebar .widget .eamk-sb .eamk-sb__mehr:hover { color: var(--color-primary-hover); text-decoration: underline; }
.site-sidebar .eamk-sb--buecher > p:empty { display: none; }
.site-sidebar .eamk-sb--buecher .bap-product-grid { display: flex; flex-direction: column; gap: 0; margin: 0; }
.site-sidebar .eamk-sb--buecher .bap-product-grid .bap-product-box { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: var(--spacing-4); align-items: center; margin: 0; padding: var(--spacing-3) 0; border: 0; border-bottom: 1px solid var(--color-border); border-radius: 0; background: var(--color-transparent); overflow: visible; }
.site-sidebar .eamk-sb--buecher .bap-product-grid .bap-product-box:first-child { padding-top: 0; }
.site-sidebar .eamk-sb--buecher .bap-product-grid .bap-product-box:last-child { border-bottom: 0; }
.site-sidebar .eamk-sb--buecher .bap-product-box .bap-product-box__image { background: var(--color-transparent); }
.site-sidebar .eamk-sb--buecher .bap-product-box .bap-product-box__image img { width: 3.5rem; height: auto; aspect-ratio: 2 / 3; object-fit: cover; border-radius: var(--radius-sm); box-shadow: var(--shadow-md); }
.site-sidebar .eamk-sb--buecher .bap-product-grid .bap-product-box__body { gap: var(--spacing-1); padding: 0; }
.site-sidebar .eamk-sb--buecher .bap-product-box .bap-product-box__name { font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-text-primary); text-wrap: pretty; }
.site-sidebar .widget .eamk-sb--buecher p.bap-product-box__price { margin: 0; font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-primary); }
.site-sidebar .eamk-sb--buecher .bap-product-box__price-checked { display: none; }
.site-sidebar .eamk-sb--buecher .bap-product-box--teaser:hover .bap-product-box__name a { color: var(--color-primary); }
/* END eamk-seitenleiste */
</style>
