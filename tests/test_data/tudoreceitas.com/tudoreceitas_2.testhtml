<span class="property comensales">3 pessoas</span>
<span class="property duracion">1h 30m</span>
<span class="property dificultad">Dificuldade média</span>
</div>
<div class="properties inline">
<span class="strong">Características adicionais:</span>
Custo médio,                                                                                                                 Assado                                                                        </div>
<h2 class="titulo titulo--h3">Ingredientes:</h2>
<div class="ingredientes ">
<ul class="padding-left-0">
<li class="ingrediente titulo">
Para a massa
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-1">
<label for="ingrediente-1">
1 xícara de farinha de arroz                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-2">
<label for="ingrediente-2">
1 xícara de amido de milho ou polvilho doce                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-3">
<label for="ingrediente-3">
&frac12; xícara de farinha de aveia                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-4">
<label for="ingrediente-4">
3 colheres de sopa de margarina vegetal ou manteiga                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-5">
<label for="ingrediente-5">
0.4 xícara de azeite                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-6">
<label for="ingrediente-6">
2 ovos (1 para a massa outro para pincelar por cima da torta)
</label>
</li>
<li class="ingrediente titulo">
Para o recheio
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-8">
<label for="ingrediente-8">
1 vidro de palmito                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-9">
<label for="ingrediente-9">
1 xícara de requeijão                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-10">
<label for="ingrediente-10">
sal a gosto
</label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-11">
<label for="ingrediente-11">
1 colher de café de alho em pó                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-12">
<label for="ingrediente-12">
1 colher de café de cebola em pó                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-13">
<label for="ingrediente-13">
cebolinha verde e salsinha a gosto
</label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-14">
<label for="ingrediente-14">
2 colheres de café de amido de milho                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-15">
<label for="ingrediente-15">
1 unidade de cebola branca                                                                                                        </label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-16">
<label for="ingrediente-16">
&frac12; xícara de leite                                                                    (120 mililitros)
</label>
</li>
<li class="ingrediente">
<input type="checkbox" id="ingrediente-17">
<label for="ingrediente-17">
1 colher de chá de óleo de soja                                                                                                        </label>
</li>
</ul>
