            [{"@context":"https://schema.org","@type":"Recipe","dateModified":"2025-05-14T08:31:00+00:00","datePublished":"2025-05-14T08:31:00+00:00","name":"Tarte à la rhubarbe fondante : la meilleure recette","description":"Envie d'un dessert de saison simple et gourmand ? Cette tarte à la rhubarbe fondante est un incontournable du printemps. Découvrez notre meilleure recette pour la réussir facilement à la maison. Vous pouvez la préparer avec ou sans meringue.","recipeYield":"8 personnes","video":{"@context":"http://schema.org","@type":"VideoObject","name":"Tarte &agrave; la rhubarbe fondante&nbsp;: la meilleure recette","description":"Envie d'un dessert de saison simple et gourmand&nbsp;? Cette tarte &agrave; la rhubarbe fondante est un incontournable du printemps. D&eacute;couvrez notre meilleure recette pour la r&eacute;ussir facilement &agrave; la maison. Vous pouvez la pr&eacute;parer avec ou sans meringue.","thumbnailUrl":"https://media.ccmbg.com/tc/4421832512/277154/1613493243","uploadDate":"2025-05-14T10:31:00+02:00","contentUrl":"https://media.ccmbg.com/vc/1613493243/4421832512/277154.mp4","duration":"PT1M21S","embedUrl":"https://media.ccmbg.com/media/?format=embed&rid=277154&rkey=4421832512&site=jdf_cuisine&startMode=0","potentialAction":{"@type":"SeekToAction","target":"https://cuisine.journaldesfemmes.fr/recette/323087-tarte-a-la-rhubarbe-meringuee-extra-fondante?mp_start={seek_to_second_number}","startOffset-input":"required name=seek_to_second_number"}},"recipeCategory":"Tarte à la rhubarbe meringuée","about":[{"@type":"Thing","name":"Tarte à la rhubarbe meringuée"},{"@type":"Thing","name":"Recette végétarienne","sameAs":"https://fr.wikipedia.org/wiki/Cuisine_v%C3%A9g%C3%A9tarienne"},{"@type":"Thing","name":"Recette pâte brisée","sameAs":"https://fr.wikipedia.org/wiki/P%C3%A2te_bris%C3%A9e"}],"image":{"@type":"ImageObject","url":"https://img-3.journaldesfemmes.fr/KldaPr-VYk6KFsYbp3ZYQAmHIlk=/750x500/3f0e1736f8554020ae22c0391507364f/ccmcms-jdf/40030821.jpg"},"recipeInstructions":[{"@type":"HowToStep","name":"Préparation de la rhubarbe","url":"https://cuisine.journaldesfemmes.fr/recette/323087-tarte-a-la-rhubarbe-meringuee-extra-fondante#Preparation-de-la-rhubarbe-1","text":"Laver et éplucher la rhubarbe. La couper en petits tronçons. Placer la rhubarbe dans une passoire et la saupoudrer de sucre pour faire dégorger l'eau pendant 1h environ."},{"@type":"HowToStep","name":"Préparation de la crème et de la tarte","url":"https://cuisine.journaldesfemmes.fr/recette/323087-tarte-a-la-rhubarbe-meringuee-extra-fondante#Preparation-de-la-creme-et-de-la-tarte-2","text":"Préchauffer le four à 200°C. Étaler et foncer la pâte dans un moule à tarte. Garnir de rhubarbe. Battre un œuf entier et 3 jaunes (réserver les 3 blancs pour la meringue) avec les 100 g de sucre et le sucre vanillé. Ajouter la crème."},{"@type":"HowToStep","name":"Cuisson de la tarte à la rhubarbe","url":"https://cuisine.journaldesfemmes.fr/recette/323087-tarte-a-la-rhubarbe-meringuee-extra-fondante#Cuisson-de-la-tarte-a-la-rhubarbe-3","text":"Verser la préparation sur la rhubarbe, attention que ça ne déborde pas. Enfourner 30 minutes."},{"@type":"HowToStep","name":"Préparation de la meringue (vous pouvez passer cette étape si vous préférez la version sans meringue)","url":"https://cuisine.journaldesfemmes.fr/recette/323087-tarte-a-la-rhubarbe-meringuee-extra-fondante#Preparation-de-la-meringue-vous-pouvez-passer-cette-etape-si-vous-preferez-la-version-sans-meringue-4","text":"Battre les blancs en neige bien ferme avec une pincée de sel. Ajouter peu à peu le sucre glace tout en continuant de battre."},{"@type":"HowToStep","name":"Cuisson de la tarte à la rhubarbe meringuée (si vous optez pour la version avec meringue)","url":"https://cuisine.journaldesfemmes.fr/recette/323087-tarte-a-la-rhubarbe-meringuee-extra-fondante#Cuisson-de-la-tarte-a-la-rhubarbe-meringuee-si-vous-optez-pour-la-version-avec-meringue-5","text":"Lorsque la tarte est cuite, étaler la meringue et poursuivre la cuisson 10 minutes. Finir par quelques minutes sous le gril tout en surveillant. Pour une meringue croustillante, laisser la tarte pendant 30 minutes dans le four éteint."}],"prepTime":"PT0H30M","totalTime":"PT0H30M","cookTime":"PT0H40M","nutrition":{"@type":"NutritionInformation","calories":230},"recipeIngredient":["1 unité pâte brisée","500 g rhubarbe","4 unité oeuf","100 g sucre","1 sachet sucre vanillé","30 cl crème fraîche","180 g sucre glace","1 pincée sel"],"author":{"@type":"Person","name":"Céline","familyName":"Mazur"},"recipeCuisine":"française","keywords":"Recette été, Recette blanc d'oeuf, Recette crème fraîche, Recette rhubarbe, Recette printemps, Recette végétarienne, Recette familiale, Recette pique-nique, Recette pâte brisée, Choix de la rédaction, Tarte à la rhubarbe meringuée","mentions":[{"@type":"Thing","name":"Rhubarbe","sameAs":"https://fr.wikipedia.org/wiki/Rhubarbe"},{"@type":"Thing","name":"Oeuf","sameAs":"https://fr.wikipedia.org/wiki/%C5%92uf_(aliment)"},{"@type":"Thing","name":"Sucre","sameAs":"https://fr.wikipedia.org/wiki/Sucre"},{"@type":"Thing","name":"Sucre vanillé","sameAs":"https://fr.wikipedia.org/wiki/Sucre_vanill%C3%A9"},{"@type":"Thing","name":"Crème fraîche","sameAs":"https://fr.wikipedia.org/wiki/Cr%C3%A8me_fra%C3%AEche"},{"@type":"Thing","name":"Sucre glace","sameAs":"https://fr.wikipedia.org/wiki/Sucre_glace"},{"@type":"Thing","name":"Sel","sameAs":"https://fr.wikipedia.org/wiki/Sel_alimentaire"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"ratingCount":334,"bestRating":5,"worstRating":0}},{"@context":"https://schema.org","@type":"ItemList","itemListElement":[{"@type":"ListItem","position":1,"url":"https://cuisine.journaldesfemmes.fr/recette/323087-tarte-a-la-rhubarbe-meringuee-extra-fondante"},{"@type":"ListItem","position":2,"url":"https://cuisine.journaldesfemmes.fr/recette/3264885-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":3,"url":"https://cuisine.journaldesfemmes.fr/recette/313311-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":4,"url":"https://cuisine.journaldesfemmes.fr/recette/343320-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":5,"url":"https://cuisine.journaldesfemmes.fr/recette/335798-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":6,"url":"https://cuisine.journaldesfemmes.fr/recette/318720-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":7,"url":"https://cuisine.journaldesfemmes.fr/recette/344053-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":8,"url":"https://cuisine.journaldesfemmes.fr/recette/312525-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":9,"url":"https://cuisine.journaldesfemmes.fr/recette/323619-tarte-a-la-rhubarbe"},{"@type":"ListItem","position":10,"url":"https://cuisine.journaldesfemmes.fr/recette/342087-tarte-a-la-rhubarbe-meringuee-aux-amandes"},{"@type":"ListItem","position":11,"url":"https://cuisine.journaldesfemmes.fr/recette/351216-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":12,"url":"https://cuisine.journaldesfemmes.fr/recette/3125274-tarte-a-la-rhubarbe-meringuee-sur-pate-sablee-a-l-amande"},{"@type":"ListItem","position":13,"url":"https://cuisine.journaldesfemmes.fr/recette/325766-tarte-a-la-rhubarbe-et-amandes-meringuee"},{"@type":"ListItem","position":14,"url":"https://cuisine.journaldesfemmes.fr/recette/342977-tarte-amande-rhubarbe-meringuee"},{"@type":"ListItem","position":15,"url":"https://cuisine.journaldesfemmes.fr/recette/353768-tarte-a-la-rhubarbe-meringuee"},{"@type":"ListItem","position":16,"url":"https://cuisine.journaldesfemmes.fr/recette/3123190-tarte-rhubarbe-et-fraises-meringuee"},{"@type":"ListItem","position":17,"url":"https://cuisine.journaldesfemmes.fr/recette/3129692-tarte-a-la-rhubarbe-meringuee-sans-gluten-et-sans-lait"}]},{"@context":"https://schema.org","@type":"ViewAction","target":{"@type":"EntryPoint","urlTemplate":"android-app://com.cuisiner/https/cuisine.journaldesfemmes.fr/recette/323087-tarte-a-la-rhubarbe-meringuee-extra-fondante"}}]</script>
