<script type="application/ld+json">{
	"@context": "https://schema.org/", 
	"@type": "Recipe", 
	"@id": "https://en.petitchef.com/recipes/dessert/healthy-skyr-cake-with-chocolate-chips-fid-1576186#recipe", 
	"name": "Skyr cake with chocolate chips: the healthy dessert solution!", 
	"inLanguage": "en", 
	"recipeCategory": "Dessert", 
	"recipeCuisine": "En", 
	"image": "https://en.petitchef.com/imgupl/recipe/skyr-cake-with-chocolate-chips-the-healthy-dessert-solution--461904p729071.webp", 
	"author": { 
		"@type": "Person", 
		"name": "PetitChef_Official", 
		"url": "https://en.petitchef.com/members/petitchef-official-mid-510842/recipes" 
	}, 
	"datePublished": "2022-02-16T16:00:03+01:00", 
	"dateModified": "2025-10-11T23:36:55+02:00", 
	"description": "Skyr is an Icelandic specialty that lies between yogurt and cream cheese. It is lower in fat than Greek yogurt and is rich in protein (2.5 times more than regular yogurt). A perfect ally for health and weight loss, it can be added to desserts for guilt-free indulgence. Enjoy the deliciousness of our skyr cake with chocolate chips, guaranteed to be extra fresh!", 
	"aggregateRating": { 
		"@type": "AggregateRating", 
		"ratingValue": 4, 
		"bestRating": 5, 
		"ratingCount": 2
	}, 
	"prepTime": "PT15M", 
	"cookTime": "PT30M", 
	"totalTime": "PT47M", 
	"recipeYield": "8", 
	"nutrition": { 
		"@type": "NutritionInformation", 
		"servingSize": "108g", 
		"calories": "186Kcal", 
		"carbohydrateContent": "22.2g", 
		"fatContent": "6.5g", 
		"saturatedFatContent": "3g", 
		"proteinContent": "9.3g", 
		"fiberContent": "1g", 
		"sugarContent": "13.6g", 
		"sodiumContent": "0.1g"
	}, 
	"recipeIngredient": [ 
		"16 oz skyr", 
		"4 eggs", 
		"1\/4 cup sugar", 
		"1\/2 cup cornstarch", 
		"2\/3 cup chocolate chips"
	], 
	"recipeInstructions": [ 
		{ 
			"@type": "HowToStep", 
			"text": "Separate the egg whites from the yolks. Whisk the yolks with sugar until the mixture is foamy." 
		},  
		{ 
			"@type": "HowToStep", 
			"text": "Add skyr and cornstarch, then mix well. Add the chocolate chips and combine." 
		},  
		{ 
			"@type": "HowToStep", 
			"text": "Whisk the egg whites until stiff peaks form, then gently fold them into the mixture using a spatula, being careful not to deflate them." 
		},  
		{ 
			"@type": "HowToStep", 
			"text": "Pour the batter into a bundt pan and bake for 30 minutes at 350\u00b0F (180\u00b0C)." 
		},  
		{ 
			"@type": "HowToStep", 
			"text": "Allow the cake to cool before unmolding it onto a plate. Refrigerate for at least 1 hour. Ideally, make this cake the night before (or in the morning for the evening) to ensure an extra fresh tasting experience! Enjoy!" 
		} 
	],  
	"keywords": "cake,dessert cake recipes,chocolate,chocolate dessert recipes,chocolate cake,dessert"
}</script>
<script type="application/ld+json">{
	"@context": "https://schema.org", 
	"@type": "FAQPage", 
	"@id": "https://en.petitchef.com/recipes/dessert/healthy-skyr-cake-with-chocolate-chips-fid-1576186#faq",
	"mainEntity": [ 
	{ 
		"@type": "Question", 
		"name": "What is skyr?", 
		"acceptedAnswer": { 
			"@type": "Answer", 
			"text": "Skyr is an Icelandic yogurt made from skimmed milk. It is very low in fat and high in protein." 
		} 
	}, 
	{ 
		"@type": "Question", 
		"name": "What can replace skyr?", 
		"acceptedAnswer": { 
			"@type": "Answer", 
			"text": "You can use 0% fat cottage cheese as a substitute for skyr." 
		} 
	} 
	] 
}</script>
				
