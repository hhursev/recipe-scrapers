																		<ul class="ingredients-ul">
																									<li class="il" id="il-0">
						<input type="checkbox" id="ilg-0"><label for="ilg-0">1 burger bun</label>
					</li>
											
																														<li class="il" id="il-1">
						<input type="checkbox" id="ilg-1"><label for="ilg-1">1 slice of cheddar cheese</label>
					</li>
											
																														<li class="il" id="il-2">
						<input type="checkbox" id="ilg-2"><label for="ilg-2">1 breaded <a href="/recipes/chicken-recipes">chicken</a> fillet</label>
					</li>
											
																														<li class="il" id="il-3">
						<input type="checkbox" id="ilg-3"><label for="ilg-3">4 small romaine <a href="/recipes/lettuce-recipes">lettuce</a> leaves (approx.)</label>
					</li>
											
																														<li class="il" id="il-4">
						<input type="checkbox" id="ilg-4"><label for="ilg-4">1 tablespoon of kimchi (approx.)</label>
					</li>
											
																						
									
							</ul>
						<h3 class="i-title">Sauce:</h3>
																			<ul class="ingredients-ul">
