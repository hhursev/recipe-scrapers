					</li>
											
																														<li class="il" id="il-6">
						<input type="checkbox" id="ilg-6"><label for="ilg-6">1 teaspoon <a href="/recipes/soy-sauce-recipes">soy sauce</a></label>
					</li>
											
																														<li class="il" id="il-7">
						<input type="checkbox" id="ilg-7"><label for="ilg-7">1 teaspoon <a href="/recipes/honey-recipes">honey</a></label>
					</li>
											
																														<li class="il" id="il-8">
						<input type="checkbox" id="ilg-8"><label for="ilg-8">1 small clove garlic, minced (or garlic powder)</label>
					</li>
											
																														<li class="il" id="il-9">
