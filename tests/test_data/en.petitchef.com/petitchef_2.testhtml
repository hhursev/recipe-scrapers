<script type="application/ld+json">{
	"@context": "https://schema.org/", 
	"@type": "Recipe", 
	"@id": "https://en.petitchef.com/recipes/main-dish/korean-style-crispy-chicken-burger-with-spicy-sauce-fid-1614013#recipe", 
	"name": "Korean-style crispy chicken burger with spicy sauce", 
	"inLanguage": "en", 
	"recipeCategory": "Main Dish", 
	"recipeCuisine": "En", 
	"image": "https://en.petitchef.com/imgupl/recipe/korean-style-crispy-chicken-burger-with-spicy-sauce--502508p901923.webp", 
	"author": { 
		"@type": "Person", 
		"name": "PetitChef_Official", 
		"url": "https://en.petitchef.com/members/petitchef-official-mid-510842/recipes" 
	}, 
	"datePublished": "2026-08-16T09:30:04+02:00", 
	"dateModified": "2026-08-16T09:30:04+02:00", 
	"description": "Looking for a burger that changes things up? This  Korean-style breaded chicken burger  combines  ultra-crispy  chicken, a tender  melt-in-your-mouth  center and a sauce full of character.\r\n\r\nWith its  spicy , slightly  sweet  and umami-rich flavors, it\u2019s a generous homemade burger that turns a simple meal into a real comfort food treat.", 
	"prepTime": "PT10M", 
	"cookTime": "PT10M", 
	"totalTime": "PT20M", 
	"recipeYield": "1", 
	"recipeIngredient": [ 
		"1 burger bun", 
		"1 slice of cheddar cheese", 
		"1 breaded chicken fillet", 
		"4 small romaine lettuce leaves (approx.)", 
		"1 tablespoon of kimchi (approx.)", 
		"2 tablespoons mayonnaise", 
		"1 teaspoon soy sauce", 
		"1 teaspoon honey", 
		"1 small clove garlic, minced (or garlic powder)", 
		"1 teaspoon gochujang (approx.)", 
		"1 teaspoon sesame seeds", 
		"1\/2 teaspoon sesame oil"
	], 
	"recipeInstructions": [ 
		{ 
			"@type": "HowToStep", 
			"image": "https://en.petitchef.com/imgupl/recipe-step/502508s2374360.jpg", 
			"text": "Cook the breaded chicken tender for the time indicated on the package. I cooked this one for 10 minutes in the air fryer at 390\u00b0F\/200\u00b0C." 
		},  
		{ 
			"@type": "HowToStep", 
			"image": "https://en.petitchef.com/imgupl/recipe-step/502508s2374361.jpg", 
			"text": "Toast the burger buns for 2 minutes in a toaster (or 2 minutes in an air fryer at 370\u00b0F\/190\u00b0C)." 
		},  
		{ 
			"@type": "HowToStep", 
			"image": "https://en.petitchef.com/imgupl/recipe-step/502508s2374362.jpg", 
			"text": "Prepare the sauce by mixing together the mayonnaise, soy sauce, honey, minced garlic, gochujang, sesame seeds, and sesame oil." 
		},  
		{ 
			"@type": "HowToStep", 
			"image": "https://en.petitchef.com/imgupl/recipe-step/502508s2374363.jpg", 
			"text": "Spread the sauce over the entire surface of the bread base." 
		},  
		{ 
			"@type": "HowToStep", 
			"image": "https://en.petitchef.com/imgupl/recipe-step/502508s2374364.jpg", 
			"text": "Add the cheese on top. Then place the breaded chicken on top." 
		},  
		{ 
			"@type": "HowToStep", 
			"image": "https://en.petitchef.com/imgupl/recipe-step/502508s2374365.jpg", 
			"text": "Add the lettuce leaves (you can also chop the lettuce finely if you like). Scatter the kimchi pieces on top." 
		},  
		{ 
			"@type": "HowToStep", 
			"image": "https://en.petitchef.com/imgupl/recipe-step/502508s2374366.jpg", 
			"text": "Finish by adding the top half of the burger bun, spread with sauce... and it\u0027s ready!" 
		} 
	],  
	"keywords": "crispy chicken,burger,chicken,main dish"
}</script>
<script type="application/ld+json">{
	"@context": "https://schema.org", 
	"@type": "FAQPage", 
	"@id": "https://en.petitchef.com/recipes/main-dish/korean-style-crispy-chicken-burger-with-spicy-sauce-fid-1614013#faq",
	"mainEntity": [ 
	{ 
		"@type": "Question", 
		"name": "Can you use something other than a breaded chicken fillet?", 
		"acceptedAnswer": { 
			"@type": "Answer", 
			"text": "Yes, you can use any breaded cutlet, including chicken, fish, or a plant-based alternative. We used a cheese-filled chicken cutlet here and it is also a delicious option." 
		} 
	}, 
	{ 
		"@type": "Question", 
		"name": "What is gochujang?", 
		"acceptedAnswer": { 
			"@type": "Answer", 
			"text": "Gochujang is a Korean fermented chili paste with a spicy, slightly sweet, and savory flavor. It\u0027s a key ingredient in many Korean recipes." 
		} 
	}, 
	{ 
		"@type": "Question", 
		"name": "What is kimchi?", 
		"acceptedAnswer": { 
			"@type": "Answer", 
			"text": "Kimchi is a traditional Korean side dish made from fermented vegetables, most commonly Napa cabbage, seasoned with chili and spices." 
		} 
	}, 
	{ 
		"@type": "Question", 
		"name": "How can you customize a Korean-style chicken burger?", 
		"acceptedAnswer": { 
			"@type": "Answer", 
			"text": "Add toppings like cucumber, cilantro, pickled onions, or extra cheese to make it your own." 
		} 
	}, 
	{ 
		"@type": "Question", 
		"name": "What is the best bun for a Korean chicken burger?", 
		"acceptedAnswer": { 
			"@type": "Answer", 
			"text": "A soft brioche or sesame seed bun works best, balancing the spicy, savory flavors while holding the fillings together." 
		} 
	} 
	] 
}</script>
				
